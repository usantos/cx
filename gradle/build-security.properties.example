# Copy to .local/build-security.properties; obtain real public values from authorized configuration.
SIMLO_PRD_FIREBASE_APP_ID=<PUBLIC_VALUE>
SIMLO_PRD_FIREBASE_API_KEY=<PUBLIC_VALUE>
SIMLO_PRD_FIREBASE_PROJECT_ID=<PUBLIC_VALUE>
SIMLO_PRD_FIREBASE_SENDER_ID=<PUBLIC_VALUE>
SIMLO_TQS_FIREBASE_APP_ID=<PUBLIC_VALUE>
SIMLO_TQS_FIREBASE_API_KEY=<PUBLIC_VALUE>
SIMLO_TQS_FIREBASE_PROJECT_ID=<PUBLIC_VALUE>
SIMLO_TQS_FIREBASE_SENDER_ID=<PUBLIC_VALUE>
SIMLO_AUTOMACAO_FIREBASE_APP_ID=<PUBLIC_VALUE>
SIMLO_AUTOMACAO_FIREBASE_API_KEY=<PUBLIC_VALUE>
SIMLO_AUTOMACAO_FIREBASE_PROJECT_ID=<PUBLIC_VALUE>
SIMLO_AUTOMACAO_FIREBASE_SENDER_ID=<PUBLIC_VALUE>

# JSON array: each host must have at least one valid sha256/<base64-of-32-bytes> pin.
SIMLO_TLS_DEFAULT_PINS=[{"hostname":"<APPROVED_HOST>","pins":["sha256/<CURRENT_PIN>","sha256/<BACKUP_PIN>"]}]
# Public verification keys only. Never put private keys here or in Firebase.
SIMLO_KEYSET_TRUSTED_SIGNERS=root-a=<PUBLIC_SPKI_BASE64URL>,root-b=<PUBLIC_SPKI_BASE64URL>,root-c=<PUBLIC_SPKI_BASE64URL>
SIMLO_KEYSET_SIGNATURE_THRESHOLD=2
