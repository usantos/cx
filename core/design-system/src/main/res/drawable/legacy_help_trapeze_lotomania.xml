<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >

    <!-- Retângulo colorido -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="72dp"
                android:height="56dp" />
            <solid android:color="#f58220" />
        </shape>
    </item>

    <!-- Este retângulo corresponde ao lado direito -->
    <!-- Sua cor deve ser a mesma do fundo do layout -->
    <item
        android:right="-250dp"
        android:left="81dp"
        android:top="-113dp"
        android:bottom="-48dp">
        <rotate
            android:fromDegrees="20">
            <shape android:shape="rectangle">
                <solid android:color="#f99d1c" />
            </shape>
        </rotate>
    </item>

</layer-list>