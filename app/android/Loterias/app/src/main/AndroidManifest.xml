<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="caixa.gov.br.loterias">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ui.IntroducaoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LoginActivity_"
            android:configChanges="orientation"
            android:label="@string/title_activity_login"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".ui.CadastrarActivity_" />

        <service android:name="org.jboss.aerogear.android.authorization.oauth2.OAuth2AuthzService" />

        <activity
            android:name=".ui.CadastrarPasso2Activity_"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.HomeActivity_"
            android:configChanges="orientation"
            android:label="@string/title_activity_home"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".ui.SimularApostaActivity_"
            android:configChanges="orientation"
            android:label="@string/title_activity_home"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ConfirmadoInclusaoCarrinhoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.CarrinhoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_carrinho"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.FormaPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_forma_pagamento"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.ConfirmacaoPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_confirmacao_pagamento"
            android:screenOrientation="portrait" />
        <activity android:name=".ui.NovaFormaPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_confirmacao_pagamento"
            android:screenOrientation="portrait" />
    </application>

</manifest>