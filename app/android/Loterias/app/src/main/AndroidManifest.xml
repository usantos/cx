<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="caixa.gov.br.loterias">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".view.IntroducaoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.LoginActivity_"
            android:configChanges="orientation"
            android:label="@string/title_activity_login"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity android:name=".view.CadastrarActivity_" />

        <service android:name="org.jboss.aerogear.android.authorization.oauth2.OAuth2AuthzService" />

        <activity
            android:name=".view.CadastrarPasso2Activity_"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.SimularApostaActivity_"
            android:configChanges="orientation"
            android:label="@string/title_activity_home"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.ConfirmadoInclusaoCarrinhoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.CarrinhoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_carrinho"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.FormaPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_forma_pagamento"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.ConfirmacaoPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_confirmacao_pagamento"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.NovaFormaPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_forma_pagamento"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.PrincipalActivity"
            android:label=""
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.TermosUsoActivity"
            android:label="@string/title_activity_termos_uso"
            android:parentActivityName=".view.PrincipalActivity"
            android:theme="@style/AppTheme.DegradeActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="caixa.gov.br.loterias.view.PrincipalActivity" />
        </activity>
    </application>

</manifest>