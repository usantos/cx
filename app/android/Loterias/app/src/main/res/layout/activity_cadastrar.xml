<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    tools:context="caixa.gov.br.loterias.view.CadastrarActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:windowSoftInputMode="adjustPan">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textViewTituloCadastrar"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:text="Cadastrar"
                android:textColor="@color/cinza"
                android:textSize="16sp"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/imageViewIcoPasso1"
                android:layout_width="53dp"
                android:layout_height="21dp"
                android:layout_below="@id/textViewTituloCadastrar"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="71dp"
                app:srcCompat="@drawable/passo1" />

            <TextView
                android:id="@+id/textViewTituloCadastrar2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageViewIcoPasso1"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text=""
                android:textColor="@color/verdeazul"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textViewTituloCadastrar3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/textViewTituloCadastrar2"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="O cadastro é bem rápido \n Para começar, informe os dados abaixo:"
                android:textColor="@color/cinza"
                android:textSize="14sp" />


            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextCpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/textViewTituloCadastrar3"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="63dp">

                <com.github.pinball83.maskededittext.MaskedEditText
                    android:id="@+id/editTextCpfContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:hint="CPF"
                    android:inputType="number"
                    android:textColor="@color/cinza"
                    android:textSize="16sp"
                    app:mask="***.***.***-**"
                    app:notMaskedSymbol="*" />

            </android.support.design.widget.TextInputLayout>

            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextCpf"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextNomeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:hint="Nome"
                    android:inputType="textPersonName"
                    android:textColor="@color/cinza"
                    android:textSize="16sp" />
            </android.support.design.widget.TextInputLayout>


            <caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButtonGroup
                android:id="@+id/segmentedButtonSexo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@id/editTextNome"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp"
                android:elevation="2dp"
                app:sb_textStyle="bold"
                app:sbg_animateSelector="fastOutSlowIn"
                app:sbg_animateSelectorDuration="1000"
                app:sbg_backgroundColor="@color/cinzaclaro"
                app:sbg_position="0"
                app:sbg_ripple="true"
                app:sbg_selectorColor="@color/verdeazul">

                <caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    app:sb_text="Masculino"
                    app:sb_textColor="@color/verdeazul"
                    app:sb_textColor_onSelection="@color/branco"
                    app:sb_textStyle="bold" />

                <caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    app:sb_text="Feminino"
                    app:sb_textColor="@color/verdeazul"
                    app:sb_textColor_onSelection="@color/branco"
                    app:sb_textStyle="bold" />

            </caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButtonGroup>


            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextNomeMae"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/segmentedButtonSexo"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextNomeMaeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:hint="Nome da Mãe"
                    android:inputType="textPersonName"
                    android:textColor="@color/cinza"
                    android:textSize="16sp" />
            </android.support.design.widget.TextInputLayout>

            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextCEP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextNomeMae"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <com.github.pinball83.maskededittext.MaskedEditText
                    android:id="@+id/editTextCepContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:hint="CEP"
                    android:inputType="number"
                    android:textColor="@color/cinza"
                    android:textSize="16sp"
                    app:mask="*****-***"
                    app:notMaskedSymbol="*" />
            </android.support.design.widget.TextInputLayout>


            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextUF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextCEP"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextUFContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/combo"
                    android:ems="10"
                    android:focusableInTouchMode="false"
                    android:hint="UF"
                    android:inputType="textPersonName"
                    android:textColor="@color/cinza"
                    android:textSize="16sp" />
            </android.support.design.widget.TextInputLayout>


            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextMunicipio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextUF"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextMunicipioContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableRight="@drawable/combo"
                    android:ems="10"
                    android:focusableInTouchMode="false"
                    android:hint="Município"
                    android:inputType="textPersonName"
                    android:textColor="@color/cinza"
                    android:textSize="16sp" />
            </android.support.design.widget.TextInputLayout>

            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextNascimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextMunicipio"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <com.github.pinball83.maskededittext.MaskedEditText
                    android:id="@+id/editTextNascimentoContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:hint="Nascimento"
                    android:inputType="number"
                    android:textColor="@color/cinza"
                    android:textSize="16sp"
                    app:mask="**/**/****"
                    app:notMaskedSymbol="*" />
            </android.support.design.widget.TextInputLayout>


            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextNascimento"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextEmailContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:hint="E-mail"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/cinza"
                    android:textSize="16sp" />
            </android.support.design.widget.TextInputLayout>

            <Button
                android:id="@+id/buttonContinuarIntroducao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextEmail"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp"
                android:background="@color/amarelo"
                android:text="Continuar"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </RelativeLayout>
    </ScrollView>


</android.support.constraint.ConstraintLayout>
