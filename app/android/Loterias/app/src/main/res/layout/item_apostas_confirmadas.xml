<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:gravity="center"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:id="@+id/stripe"
        tools:background="#642475"
        android:layout_width="5dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/modalidadeTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:textColor="#642475"
            tools:text="lotofácil"/>

        <TextView
            android:id="@+id/concursoTxt"
            android:layout_marginStart="10dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/azulescuroapostafavorita"
            tools:text="Conc. 0000 a 0000"
            />

        <TextView
            android:id="@+id/valorTxt"
            android:layout_marginStart="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/cinza"
            tools:text="R$ 4,50"
            />

    </LinearLayout>

    <ImageView
        android:id="@+id/favoriteBtn"
        android:layout_width="21dp"
        android:layout_height="21dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/icon_favoritas2" />

    <ImageView
        android:id="@+id/reloadBtn"
        android:layout_marginEnd="@dimen/activity_horizontal_margin"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/icon_reload"/>

</LinearLayout>