<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_row_aposta_partida_lotogol"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    android:orientation="vertical"
    android:paddingBottom="14dp"
    android:paddingTop="16dp">

    <caixa.gov.br.loterias.view.custom.ApostaEquipeLototgolView_
        android:id="@+id/aposta_equipe_lotogol_um"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/ArialMT"
        android:id="@+id/aposta_versus_lotogol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="21dp"
        android:layout_marginTop="9dp"
        android:text="@string/label_x_minusculo"
        android:textColor="@color/cinza"
        android:textSize="14sp"/>

    <caixa.gov.br.loterias.view.custom.ApostaEquipeLototgolView_
        android:id="@+id/aposta_equipe_lotogol_dois"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />


</LinearLayout>