<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    >

    <com.yarolegovich.discretescrollview.DiscreteScrollView
        android:id="@+id/recyclerPartidasLotogol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_gravity="center_horizontal"
        app:dsv_orientation="horizontal"
        />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/megasenamedio"
        android:layout_marginTop="10dp"
        android:id="@+id/tracoViewDivisoriaResultado"
        ></View>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Premiados"
        android:textColor="@color/branco"
        android:textSize="15.8sp"
        android:fontFamily="@font/futura_std_bold"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="16dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/linearlayoutPremiadosListaText"
        android:orientation="vertical">

    </LinearLayout>

    <Button
        android:layout_width="246dp"
        android:layout_height="56dp"
        android:text="Veja mais detalhes"
        android:background="@drawable/button_border"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/branco"
        android:layout_marginVertical="20dp"/>

</LinearLayout>