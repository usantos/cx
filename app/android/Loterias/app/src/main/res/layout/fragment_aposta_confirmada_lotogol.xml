<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="caixa.gov.br.loterias.view.fragment.ApostaConfirmadaLotogolFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:weightSum="1">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:orientation="vertical">

            <TextView
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_concurso"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/concursoCabecalhoTextView"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_concurso"
                android:textColor="@color/branco"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:orientation="vertical">

            <TextView
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_sua_aposta"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:textStyle="bold" />

            <caixa.gov.br.loterias.view.custom.ExpandableHeightRecyclerView
                android:id="@+id/listaPartidasApostadasExpandebleRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="71dp"
                android:layout_marginTop="23dp"
                android:nestedScrollingEnabled="false" />

            <Button
                android:id="@+id/conferirResultadoButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="25dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/button_border"
                android:text="@string/label_conferir_resultado"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
