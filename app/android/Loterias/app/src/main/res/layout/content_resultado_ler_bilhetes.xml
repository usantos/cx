<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resultadoApostaScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.ResultadoLerBilhetesActivity"
    tools:showIn="@layout/activity_resultado_ler_bilhetes">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/corpoBilhetePremiadoLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <caixa.gov.br.loterias.view.custom.ContenteResultadoPremiado_
                android:id="@+id/contenteResultadoPremiado"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="40dp"
                android:text="@string/label_veja_retirar_premio"
                android:textColor="@color/verdeazul"
                android:textSize="14.2sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="39dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shape_linha_divisiva"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/colorAccent"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_mock_titulo_como_retirar_premio"
                        android:textColor="@color/cinza"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_mock_sub_titulo_como_retirar_premio"
                        android:textColor="@color/cinza"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="31dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shape_linha_divisiva"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/colorAccent"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_mock_titulo_como_retirar_premio"
                        android:textColor="@color/cinza"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_mock_sub_titulo_como_retirar_premio"
                        android:textColor="@color/cinza"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <caixa.gov.br.loterias.view.custom.ExpandableHeightRecyclerView
                android:id="@+id/listaComoRetirarPremio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:clickable="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/corpoBilheteNaoPremiadoLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="111dp"
                android:background="@color/megasenaescuro">

                <TextView
                    android:id="@+id/statusResultadoNaoPremiadTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mensagemNaoPremiadoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/branco">

                <TextView
                    android:id="@+id/mensagemNaoPremiadoTextView"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="68dp"
                    android:layout_marginStart="68dp"
                    android:layout_marginTop="41dp"
                    android:text="@string/label_aposte_agora"
                    android:textAlignment="center"
                    android:textColor="@color/cinza"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</ScrollView>
