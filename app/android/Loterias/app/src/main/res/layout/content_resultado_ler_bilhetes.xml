<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.ResultadoLerBilhetesActivity"
    tools:showIn="@layout/activity_resultado_ler_bilhetes">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/topoModalidadeResultadoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/megasenaclaro"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/fundoBackgroundTrapezeResultadoLinearLayout"
                    android:layout_width="90dp"
                    android:layout_height="56dp"
                    android:background="@drawable/background_trapeze_megasena">

                    <ImageView
                        android:layout_width="22sp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="16dp"
                        android:src="@drawable/trevo" />
                </LinearLayout>


                <TextView
                    android:id="@+id/tituloModalidadeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/futura_std_bold"
                    android:text="mega-sena"
                    android:textColor="@color/branco"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/topo2ModalidadeResultadoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="111dp"
                android:background="@color/megasenaescuro">

                <TextView
                    android:id="@+id/statusResultadoTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/futura_std_bold"
                    android:text="Não foi dessa vez :("
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="21sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dadosModalidadeLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:background="@color/cinza"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="78dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="40dp"
                            android:fontFamily="@font/arialmt"
                            android:text="Limite diário"
                            android:textAlignment="textStart"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/limiteDiarioResultadoTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:fontFamily="@font/arialmt"
                            android:text="nº 1456"
                            android:textAlignment="textStart"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="78dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="16dp"
                            android:layout_marginTop="40dp"
                            android:fontFamily="@font/arialmt"
                            android:text="Próximo sorteio"
                            android:textAlignment="textEnd"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/proximoSorteioTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="16dp"
                            android:fontFamily="@font/arialmt"
                            android:text="09/12"
                            android:textAlignment="textEnd"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp" />


                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="78dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/arialmt"
                            android:text="Abertura da aposta"
                            android:textAlignment="textStart"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/aberturaApostaResultadoTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:fontFamily="@font/arialmt"
                            android:text="10/04 | 18:00"
                            android:textAlignment="textStart"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="78dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="16dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/arialmt"
                            android:text="Encerramento"
                            android:textAlignment="textEnd"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/encerramentoResultadoTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="16dp"
                            android:fontFamily="@font/arialmt"
                            android:text="11/04 | 15h50"
                            android:textAlignment="textEnd"
                            android:textColor="@color/branco"
                            android:textSize="14.2sp" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mensagemNaoPremiadoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/branco"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mensagemNaoPremiadoTextView"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="68dp"
                    android:layout_marginStart="68dp"
                    android:layout_marginTop="41dp"
                    android:textAlignment="center"
                    android:textColor="@color/cinza"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/premioGanhoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/branco"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:fontFamily="@font/arialmt"
                    android:text="Prêmio"
                    android:textAlignment="center"
                    android:textColor="@color/cinza"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/premioResultadoTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="R$ 999.999.999,99"
                    android:textAlignment="center"
                    android:textColor="@color/verdeazul"
                    android:textSize="20.1sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/listaFaixaPremiacaoLinearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="22dp"
                    android:layout_marginStart="19dp"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/cabecalhoListaFaixaPremiacaoLinearLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.24"
                            android:text="@string/label_concurso"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_gravity="bottom"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.27"
                            android:text="@string/label_faixa_premiacao"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.24"
                            android:text="@string/label_sorteio_case"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_gravity="bottom"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.25"
                            android:text="@string/label_premiacao"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_gravity="bottom"/>
                    </LinearLayout>

                    <caixa.gov.br.loterias.view.custom.ExpandableHeightRecyclerView
                        android:id="@+id/listaFaixaPremiacaoExpandableHeightRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="29dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/drawer_linha_divisao_bg" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
