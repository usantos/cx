<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_centerVertical="true"
        android:background="@color/cinzaclaro" />

    <TextView
        android:id="@+id/numerosText"
        style="@style/editTextArialMTTheme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="14dp"
        android:gravity="start"
        android:text="TextView"
        android:textAlignment="textStart"
        android:textColor="@color/cinza"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toRightOf="@+id/tipoAposta"
        app:layout_constraintRight_toLeftOf="@+id/valorAposta"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <RelativeLayout
        android:id="@+id/layoutCabecalhoLoteca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        android:gravity="start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toRightOf="@+id/tipoAposta"
        app:layout_constraintRight_toLeftOf="@+id/valorAposta"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/texto_coluna_loteca"
            style="@style/editTextArialMTTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_coluna"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/texto_time_loteca"
            style="@style/editTextArialMTTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/texto_coluna_loteca"
            android:layout_marginStart="14dp"
            android:text="@string/label_time"
            android:textStyle="bold" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tipoAposta"
        style="@style/editTextArialMTTheme"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="14dp"
        android:text="Mega-sena"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/valorAposta"
        style="@style/editTextArialMTTheme"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginEnd="35dp"
        android:layout_marginRight="35dp"
        android:layout_marginTop="14dp"
        android:gravity="start"
        android:text="R$ 0,00"
        android:textAlignment="textEnd"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="RtlCompat" />

    <Button
        android:id="@+id/excluirApostaCarrinho"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginBottom="14dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/close"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <caixa.gov.br.loterias.view.custom.ExpandableHeightRecyclerView
        android:id="@+id/recycleViewDetalheAposta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:clickable="false"
        android:nestedScrollingEnabled="false"
        app:layout_constraintLeft_toLeftOf="@+id/numerosText"
        app:layout_constraintTop_toTopOf="parent" />
</android.support.constraint.ConstraintLayout>