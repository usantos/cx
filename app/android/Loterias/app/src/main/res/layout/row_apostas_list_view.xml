<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:drag_edge="left">

    <LinearLayout
        android:id="@+id/dadosApostaCarrinho"
        android:layout_width="229dp"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/dadosCarrinho"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/labelQuantidadeApostadas"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/label_voce_apostou"
                android:textColor="@color/branco" />

            <TextView
                android:id="@+id/labelQuantidadeSorteios"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="31dp"
                android:text="@string/label_para"
                android:textColor="@color/branco" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quantidadeApostadas"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/label_voce_apostou"
                android:textColor="@color/branco"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quantidadeSorteios"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:text="@string/label_para"
                android:textColor="@color/branco"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/dadosCarrinho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/tipoAposta"
                style="@style/editTextArialMTTheme"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="13dp"
                android:paddingEnd="0dp"
                android:text="Mega-sena" />

            <RelativeLayout
                android:id="@+id/layoutCabecalhoLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_toRightOf="@+id/tipoAposta"
                android:visibility="gone">

                <TextView
                    android:id="@+id/texto_coluna_loteca"
                    style="@style/editTextArialMTTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_coluna"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/texto_time_loteca"
                    style="@style/editTextArialMTTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_toRightOf="@+id/texto_coluna_loteca"
                    android:text="@string/label_time"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/numerosText"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@+id/tipoAposta"
                android:layout_toStartOf="@+id/valorAposta"
                android:text="Dezenas"
                android:textColor="@color/cinza" />

            <TextView
                android:id="@+id/valorAposta"
                style="@style/editTextArialMTTheme"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:layout_marginEnd="11dp"
                android:layout_toStartOf="@+id/excluirApostaCarrinho"
                android:text="R$ 0,00"
                android:textAlignment="textEnd"
                android:textSize="12sp" />

            <Button
                android:id="@+id/excluirApostaCarrinho"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/close" />
        </RelativeLayout>

        <caixa.gov.br.loterias.view.custom.ExpandableHeightRecyclerView
            android:id="@+id/recycleViewDetalheAposta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="90dp"
            android:clickable="false"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>

</com.daimajia.swipe.SwipeLayout>


