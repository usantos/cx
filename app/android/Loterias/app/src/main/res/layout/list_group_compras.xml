<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="13dp"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="12dp">




        <LinearLayout
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:orientation="vertical"
            android:id="@+id/LinearLayoutGroupComprasLeft">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compra 001"
                android:textSize="14.2sp"
                android:textColor="@color/cinza"
                android:fontFamily="@font/arialmt"
                android:id="@+id/itemCompraOrdemTextView"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23/07/2017"
                android:textSize="14.2sp"
                android:textColor="@color/cinza"
                android:fontFamily="@font/arialmt"
                android:id="@+id/dataCompra"/>
        </LinearLayout>





        <LinearLayout
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:orientation="horizontal"
            android:id="@+id/LinearLayoutGroupComprasCenter"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14.2sp"
                android:textColor="@color/cinza"
                android:fontFamily="@font/arialmt"
                android:text="Mega-sena, lotomania, lotofácil, Mega-sena, lotomania, lotofácil, Mega-sena, lotomania, lotofácil, Mega-sena, lotomania, lotofácil"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:orientation="vertical"
            android:id="@+id/LinearLayoutGroupComprasRight"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="R$ 4,50"
                android:id="@+id/valorCompra"
                android:textSize="14.2sp"
                android:textColor="@color/cinza"
                android:fontFamily="@font/arialmt"
                android:gravity="end"
                />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/seta_verde"
                android:layout_marginTop="20dp"
                android:layout_gravity="end"
                android:id="@+id/setaComprasGroup"
                />
        </LinearLayout>


    </LinearLayout>
</RelativeLayout>

