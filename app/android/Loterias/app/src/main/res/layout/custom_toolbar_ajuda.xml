<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="caixa.gov.br.loterias.view.AjudaActivity">

    <android.support.design.widget.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:theme="@style/AppTheme.AppBarOverlay">

        <android.support.v7.widget.Toolbar
            android:id="@+id/toolBarAjuda"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            app:contentInsetStart="0dp"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="56dp"
                android:background="@drawable/background_trapeze_loteca_tollbar"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ic_trevo_modalidade"
                    android:layout_width="22dp"
                    android:layout_height="23dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/icon_trevo" />
            </LinearLayout>

            <TextView
                android:id="@+id/titulo_modalidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="203dp"
                android:layout_marginTop="17dp"
                android:text="loteca"
                android:textColor="@color/branco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/action_fechar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="18dp"
                android:src="@drawable/icon_fechar" />
        </android.support.v7.widget.Toolbar>
    </android.support.design.widget.AppBarLayout>

    <include layout="@layout/activity_ajuda"></include>
</android.support.design.widget.CoordinatorLayout>
