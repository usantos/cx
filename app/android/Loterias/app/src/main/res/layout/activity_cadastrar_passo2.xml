<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="caixa.gov.br.loterias.view.CadastrarPasso2Activity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:windowSoftInputMode="adjustPan">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textViewTituloCadastrarPasso2"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="10dp"
                android:text="Cadastrar"
                android:textColor="@color/cinza"
                android:textSize="16sp"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/imageViewIcoPasso2"
                android:layout_width="53dp"
                android:layout_height="21dp"
                android:layout_below="@id/textViewTituloCadastrarPasso2"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="71dp"
                app:srcCompat="@drawable/passo2" />

            <TextView
                android:id="@+id/textViewTituloCadastrar2Passo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/imageViewIcoPasso2"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="Precisamos que você informe\numa lotérica de sua preferência."
                android:textColor="@color/verdeazul"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/textViewTituloCadastrar3Passo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/textViewTituloCadastrar2Passo2"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:text="Para isso, encontre a lotérica através\nde seu endereço, CEP ou código."
                android:textColor="@color/cinza"
                android:textSize="14sp" />

            <caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButtonGroup
                android:id="@+id/segmentedButtonTipoBuscaLoterica"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@id/textViewTituloCadastrar3Passo2"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:elevation="2dp"
                app:sb_textStyle="bold"
                app:sbg_animateSelector="fastOutSlowIn"
                app:sbg_animateSelectorDuration="1000"
                app:sbg_backgroundColor="@color/cinzaclaro"
                app:sbg_position="0"
                app:sbg_ripple="true"
                app:sbg_selectorColor="@color/verdeazul">

                <caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButton
                    android:id="@+id/segmentedButtonLocalizacao"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:sb_text="Localização"
                    app:sb_textColor="@color/verdeazul"
                    app:sb_textColor_onSelection="@color/branco"
                    app:sb_textStyle="bold" />

                <caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButton
                    android:id="@+id/segmentedButtonCEP"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:sb_text="CEP"
                    app:sb_textColor="@color/verdeazul"
                    app:sb_textColor_onSelection="@color/branco"
                    app:sb_textStyle="bold" />

                <caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButton
                    android:id="@+id/segmentedButtonCodigoLoterica"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:sb_text="Código da lotérica"
                    app:sb_textColor="@color/verdeazul"
                    app:sb_textColor_onSelection="@color/branco"
                    app:sb_textStyle="bold" />

            </caixa.gov.br.loterias.utils.segmentedbutton.SegmentedButtonGroup>

            <LinearLayout
                android:id="@+id/encontrarLoterica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/segmentedButtonTipoBuscaLoterica"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/localizacaoLoterica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/LinearLayoutLayoutHoriontalUfMunicipio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <android.support.design.widget.TextInputLayout
                            android:id="@+id/editTextUFPasso2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <EditText
                                android:id="@+id/editTextUFPasso2Content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableRight="@drawable/combo"
                                android:ems="10"
                                android:focusableInTouchMode="false"
                                android:hint="UF"
                                android:inputType="textPersonName"
                                android:textColor="@color/cinza"
                                android:textSize="16sp" />
                        </android.support.design.widget.TextInputLayout>

                        <android.support.design.widget.TextInputLayout
                            android:id="@+id/editTextMunicipioPasso2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <EditText
                                android:id="@+id/editTextMunicipioPasso2Content"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawableRight="@drawable/combo"
                                android:ems="10"
                                android:focusableInTouchMode="false"
                                android:hint="Cidade"
                                android:inputType="textPersonName"
                                android:textColor="@color/cinza"
                                android:textSize="16sp" />
                        </android.support.design.widget.TextInputLayout>
                    </LinearLayout>

                    <android.support.design.widget.TextInputLayout
                        android:id="@+id/editTextBairroPasso2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/LinearLayoutLayoutHoriontalUfMunicipio"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginTop="20dp">

                        <EditText
                            android:id="@+id/editTextBairroPasso2Content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/combo"
                            android:ems="10"
                            android:focusableInTouchMode="false"
                            android:hint="Bairro"
                            android:inputType="textPersonName"
                            android:textColor="@color/cinza"
                            android:textSize="16sp" />
                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cepLoterica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <android.support.design.widget.TextInputLayout
                        android:id="@+id/editTextCEPPasso2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginTop="20dp">

                        <com.github.pinball83.maskededittext.MaskedEditText
                            android:id="@+id/editTextCEPPasso2Content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ems="10"
                            android:hint="@string/CEP"
                            android:inputType="number"
                            android:textColor="@color/cinza"
                            android:textSize="16sp"
                            app:mask="*****-***"
                            app:notMaskedSymbol="*" />
                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/codigoLoterica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <android.support.design.widget.TextInputLayout
                        android:id="@+id/editTextCodigoLotericaPasso2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginTop="20dp">

                        <EditText
                            android:id="@+id/editTextCodigoLotericaPasso2Content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/icon_duvida"
                            android:ems="10"
                            android:hint="@string/codigo_loterica"
                            android:inputType="textPersonName"
                            android:textColor="@color/cinza"
                            android:textSize="16sp" />
                    </android.support.design.widget.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <RadioGroup
                android:id="@+id/radioListLoterias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@id/encontrarLoterica">
            </RadioGroup>

            <!--<ListView-->
            <!--android:id="@+id/ListViewLoterias"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="wrap_content"-->
            <!--android:layout_below="@id/encontrarLoterica"-->
            <!--android:layout_marginLeft="16dp"-->
            <!--android:layout_marginRight="16dp"-->
            <!--android:layout_marginTop="20dp" >-->
            <!--</ListView>>-->

            <LinearLayout
                android:id="@+id/LinearLayoutLayoutHoriontalDeclararAceite"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_below="@id/radioListLoterias"
                android:layout_marginTop="20dp"
                android:background="@color/cinzaclaro"
                android:orientation="horizontal">

                <android.support.v7.widget.AppCompatCheckBox
                    android:id="@+id/aceiteTermo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="30dp"
                    android:background="@drawable/check_box_selected"
                    android:button="@color/transparente50" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="30dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/declaracao_termo_uso_politica_privacidade" />

                    <TextView
                        android:id="@+id/termoPolitica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/termo_de_uso_underline_política_de_privacidade" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LinearLayoutLayoutHoriontalBotao"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_below="@id/LinearLayoutLayoutHoriontalDeclararAceite"
                android:background="@color/cinzaclaro"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonFinalizarCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:background="@color/amarelo"
                    android:text="@string/btn_finalizar"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="16sp" />
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

</android.support.constraint.ConstraintLayout>
