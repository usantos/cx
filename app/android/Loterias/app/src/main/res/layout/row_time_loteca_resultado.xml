<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_time_loteca_resultado"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="17dp"
    android:gravity="center"
    android:orientation="vertical"
    >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Domingo"
        android:fontFamily="@font/arialmt"
        android:textSize="14sp"
        android:textColor="@color/branco"
        android:textAlignment="center"
        android:id="@+id/diaSemanaDataPartidaText"
        />
    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_horizontal">

        <caixa.gov.br.loterias.view.custom.ItemEquipeViewResultado_
            android:id="@+id/loteca_time_um"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             />

        <caixa.gov.br.loterias.view.custom.ItemEquipeViewResultado_
            android:id="@+id/loteca_empate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

             />

        <caixa.gov.br.loterias.view.custom.ItemEquipeViewResultado_
            android:id="@+id/loteca_time_dois"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             />
    </LinearLayout>





    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:fontFamily="@font/arialmt"
        android:textSize="14sp"
        android:text="1 de 14"
        android:layout_marginTop="20dp"
        android:id="@+id/paginaResultadoLotecaText"
        />
</LinearLayout>