<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.RepassesSociaisActivity"
    tools:showIn="@layout/activity_repasses_sociais">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/background_dialogtitle_gradient_color">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="40dp"
                        android:text="Em 2017, as loterias já destinaram"
                        android:textAlignment="center"
                        android:textColor="@color/branco"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="15dp"
                        android:text="R$ 129.547,96"
                        android:textAlignment="center"
                        android:textColor="@color/amareloQueimado"
                        android:textSize="19.8sp"
                        android:textStyle="bold"
                        android:id="@+id/valorRepassesSociais"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="18dp"
                        android:text="para melhorar o país."
                        android:textAlignment="center"
                        android:textColor="@color/branco"
                        android:textSize="14.2sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="40dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/repassequadro1"
                                android:layout_weight="0.5">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Para cada \nR$1,00\napostados nas\nloterias federais"
                                    android:textAlignment="center"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:textColor="@color/branco"
                                    android:id="@+id/textViewRepasseQuadro1"
                                    android:textSize="16sp"
                                    />
                            </RelativeLayout>
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/repassequadro2"
                                android:layout_weight="0.5">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="R$0,48*\nsão destinados\na programas sociais"
                                    android:textAlignment="center"
                                    android:layout_centerHorizontal="true"
                                    android:layout_centerVertical="true"
                                    android:textColor="@color/branco"
                                    android:id="@+id/textViewRepasseQuadro2"
                                    android:textSize="16sp"
                                    />

                            </RelativeLayout>
                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>

            </RelativeLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/branco">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:background="@color/linhaDivisa"
                        android:layout_marginTop="130dp">

                        <TextView
                            android:layout_width="230dp"
                            android:layout_height="wrap_content"
                            android:text="*o valor inclui a parcela correspondente
ao imposto de renda sobre os prêmios."
                            android:textAlignment="center"
                            android:textColor="@color/textColorToolbar"
                            android:gravity="center"
                            android:layout_alignParentBottom="true"
                            android:textSize="12.4sp"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="14dp"
                            android:textStyle="bold"
                            />
                    </RelativeLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-143dp">
                        <Button
                            android:layout_width="184dp"
                            android:layout_height="84dp"
                            android:text="Aposte\ne ajude ainda mais"
                            android:layout_centerHorizontal="true"
                            android:background="@color/cinza"
                            android:textColor="@color/branco"
                            android:id="@+id/ButtonAposteSociais"
                            android:textAllCaps="false"/>
                    </RelativeLayout>


                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</android.support.constraint.ConstraintLayout>
