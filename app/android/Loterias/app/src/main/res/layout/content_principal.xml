<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.PrincipalActivity"
    tools:showIn="@layout/app_bar_principal"
    android:background="@drawable/background_gradient_color">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="552dp"
            >

            <com.yarolegovich.discretescrollview.DiscreteScrollView
                android:id="@+id/home_carousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dsv_orientation="horizontal"
                />

            <Button
                android:id="@+id/buttonHomeBet"
                android:layout_width="184dp"
                android:layout_height="84dp"
                android:background="@color/verdesenaclaro"
                android:text="Aposte\npor R$0,00"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="16sp"
                android:layout_marginTop="433dp"
                android:layout_centerHorizontal="true"/>

            <TextView
                android:id="@+id/textViewHomeMinimumPurchaseValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/buttonHomeBet"
                android:layout_centerHorizontal="true"
                android:text="valor mínimo da compra: R$0,00"
                android:textColor="@color/azulescuro"
                android:textSize="10sp"
                android:layout_marginBottom="-15dp"/>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="70dp"
                android:layout_marginTop="465dp"
                android:layout_marginLeft="12dp">

                <Button
                    android:id="@+id/textViewHomeButtonAllBets"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/icon_apostas" />

                <TextView
                    android:id="@+id/textViewHomeCountConfirmedBets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="43dp"
                    android:textColor="@color/branco"
                    android:text="0"
                    android:textSize="12sp"
                    android:background="@drawable/rounded_textview"
                    android:gravity="center"
                    android:layout_marginTop="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Apostas\nconfirmadas"
                    android:textAlignment="center"
                    android:textColor="@color/azulescuro"
                    android:textSize="12sp" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="70dp"
                android:layout_marginTop="465dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="12dp">

                <TextView
                    android:id="@+id/textViewHomeCountBetsCart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/branco"
                    android:text="0"
                    android:textSize="12sp"
                    android:background="@drawable/rounded_textview"
                    android:gravity="center"
                    android:layout_marginTop="14dp"
                    />

                <Button
                    android:id="@+id/homeButtonCart"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/icon_carrinho" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:text="Carrinho\nde apostas"
                    android:textAlignment="center"
                    android:textColor="@color/azulescuro"
                    android:textSize="12sp" />
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>

</RelativeLayout>
