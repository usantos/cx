<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.ListaComprasActivity"
    tools:showIn="@layout/activity_lista_compras"
    >

        <android.support.v4.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/scrollViewContentViewCompras"
            >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acompanhe todas as compras que você já realizou em nosso aplicativo."
            android:textColor="@color/colorAccent"
            android:textSize="14.2sp"
            android:fontFamily="@font/futura_std_bold"
            android:layout_marginHorizontal="17dp"
            android:layout_marginTop="40dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="17dp"
                    android:layout_marginTop="24dp"
                    android:id="@+id/areaSelecaoMesLinearLayout"
                    android:orientation="vertical"
                    >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selecione o mês"
                            />
                        <Spinner
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/SelecaoMesSpinner"/>



                </LinearLayout>

        <!--<ExpandableListView-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="match_parent"-->
