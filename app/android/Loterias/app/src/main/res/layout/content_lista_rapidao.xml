<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.ListaRapidaoActivity"
    tools:showIn="@layout/activity_lista_rapidao">

    <ScrollView
        android:id="@+id/carrinhoRapidaoScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/carrinhoRapidaoMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            android:minHeight="@dimen/activity_vertical_margin"
            android:focusableInTouchMode="true">

            <TextView
                android:id="@+id/infoPacoteRapidao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:layout_marginRight="17dp"
                android:layout_marginTop="20dp"
                android:gravity="start"
                android:text="O seu pacote de apostas prontas para serem adquiridas em um toque"
                android:textAlignment="textStart"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tituloConfirmaApostasRapidao"
                style="@style/editTextArialMTTheme"/>

            <TextView
                android:id="@+id/tituloConfirmaApostasRapidao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="90dp"
                android:layout_marginLeft="17dp"
                android:layout_marginRight="90dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="40dp"
                android:textSize="14.2sp"
                android:gravity="start"
                android:text="@string/titulo_lista_rapidao"
                android:textAlignment="textStart"
                android:textColor="@color/colorAccent"
                android:textStyle="bold"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <RelativeLayout
                android:id="@+id/relativeLayoutRapidao"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="0dp"
                android:layout_marginRight="0dp"
                android:layout_marginTop="0dp"
                android:background="@color/colorAccent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/apostasListaRecycleViewRapidao">

                <TextView
                    android:id="@+id/textoTotalRapidao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="9dp"
                    android:layout_marginRight="9dp"
                    android:layout_toLeftOf="@+id/valorTotalCarrinhoRapidao"
                    android:layout_toStartOf="@+id/valorTotalCarrinhoRapidao"
                    android:text="@string/total"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="@style/editTextArialMTTheme"/>

                <TextView
                    android:id="@+id/valorTotalCarrinhoRapidao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="36dp"
                    android:layout_marginRight="36dp"
                    android:text="R$ 0,00"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="@style/editTextArialMTTheme"/>

                <!--<TextView-->
                    <!--android:id="@+id/textoLimparCarrinhoRapidao"-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:layout_centerVertical="true"-->
                    <!--android:layout_marginLeft="6dp"-->
                    <!--android:layout_marginStart="6dp"-->
                    <!--android:layout_toEndOf="@+id/imagemLixeiraCarrinhoRapidao"-->
                    <!--android:layout_toRightOf="@+id/imagemLixeiraCarrinhoRapidao"-->
                    <!--android:text="@string/limparCarrinho"-->
                    <!--android:textColor="@color/amareloQueimado"-->
                    <!--android:textSize="14sp"-->
                    <!--android:textStyle="bold" />-->

                <!--<ImageView-->
                    <!--android:id="@+id/imagemLixeiraCarrinhoRapidao"-->
                    <!--android:layout_width="20dp"-->
                    <!--android:layout_height="20dp"-->
                    <!--android:layout_centerVertical="true"-->
                    <!--android:layout_marginLeft="14dp"-->
                    <!--android:layout_marginStart="14dp"-->
                    <!--app:srcCompat="@drawable/close" />-->
            </RelativeLayout>

            <Button
                android:id="@+id/botaoFazerNovaApostaRapidao"
                android:layout_width="183dp"
                android:layout_height="56dp"
                android:layout_marginTop="23dp"
                android:background="@drawable/button_white_with_green_border"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="@string/fazerNovaAposta"
                android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                android:textColor="@color/verdeazul"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/relativeLayoutRapidao" />

            <Button
                android:id="@+id/botaoAvancarPagamentoRapidao"
                android:layout_width="184dp"
                android:layout_height="84dp"
                android:background="@color/verdeazul"
                android:text="@string/avancarFormaPagamento"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                android:textColor="@color/branco"
                android:textSize="17sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/botaoFazerNovaApostaRapidao"
                android:layout_marginLeft="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginRight="0dp"
                app:layout_constraintRight_toRightOf="parent" />

            <android.support.constraint.ConstraintLayout
                android:id="@+id/viewTabBarRapidao"
                android:layout_width="0dp"
                android:layout_height="99dp"
                android:layout_marginTop="42dp"
                android:background="@color/azulclaro"
                android:orientation="horizontal"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/botaoAvancarPagamentoRapidao">

                <ImageView
                    android:id="@+id/imageViewPaginacaoRapidao"
                    android:layout_width="184dp"
                    android:layout_height="12dp"
                    android:layout_marginBottom="20dp"
                    android:contentDescription="@string/imagemCarrinho"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:srcCompat="@drawable/paginacao1" />

            </android.support.constraint.ConstraintLayout>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/apostasListaRecycleViewRapidao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/infoPacoteRapidao"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="20dp"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginRight="0dp"
                app:layout_constraintRight_toRightOf="parent"
                />

        </android.support.constraint.ConstraintLayout>

    </ScrollView>



</android.support.constraint.ConstraintLayout>
