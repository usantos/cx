<ScrollView
    android:id="@+id/formaPagamentoScrollView"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:orientation="vertical">

    <android.support.constraint.ConstraintLayout
        android:id="@+id/formaPagamentoMainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco"
        android:minHeight="@dimen/activity_vertical_margin"
        tools:context="caixa.gov.br.loterias.view.FormaPagamentoActivity"
        android:focusableInTouchMode="true">

        <TextView
            android:id="@+id/textoInfoSelecioneFormaPagamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="19dp"
            android:text="@string/infoFormaPagamento"
            android:textColor="@color/cinza"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textoFormaPagamentoTitulo"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/textoFormaPagamentoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="40dp"
            android:text="@string/tituloFormaPagamento"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <RelativeLayout
                android:id="@+id/relativeLayout"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginBottom="26dp"
                android:background="@color/colorAccent"
                app:layout_constraintBottom_toTopOf="@+id/botaoAdicionarFormaPagamento"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/formasPagamentoRecyclerView">

                <TextView
                    android:id="@+id/textoTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="9dp"
                    android:layout_marginRight="9dp"
                    android:layout_toLeftOf="@+id/valorTotalCarrinho"
                    android:layout_toStartOf="@+id/valorTotalCarrinho"
                    android:text="@string/total"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/valorTotalCarrinho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="36dp"
                    android:layout_marginRight="36dp"
                    android:text="R$ 00,00"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

        <Button
            android:id="@+id/botaoAdicionarFormaPagamento"
            android:layout_width="184dp"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/button_white_with_green_border"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/adicionarFormaPagamento"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/verdeazul"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/botaoAvancarPagamento"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <Button
            android:id="@+id/botaoAvancarPagamento"
            android:layout_width="184dp"
            android:layout_height="84dp"
            android:layout_marginBottom="51dp"
            android:layout_marginEnd="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="8dp"
            android:background="@color/verdeazul"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/apostarAutorizarCobranca"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/branco"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="@+id/viewTabBar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

            <android.support.constraint.ConstraintLayout
                android:id="@+id/viewTabBar"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:background="@color/azulclaro"
                android:orientation="horizontal"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/imageViewPaginacao"
                    android:layout_width="184dp"
                    android:layout_height="12dp"
                    android:layout_marginBottom="20dp"
                    android:contentDescription="@string/imagemCarrinho"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:srcCompat="@drawable/paginacao2" />

            </android.support.constraint.ConstraintLayout>

        <android.support.v7.widget.RecyclerView
            android:id="@+id/formasPagamentoRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textoInfoSelecioneFormaPagamento"
 />



    </android.support.constraint.ConstraintLayout>
</ScrollView>
