<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.NumerosRapidaoActivity"
    tools:showIn="@layout/activity_numeros_rapidao">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="135dp"
            android:id="@+id/scrollNumerosRapidao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Números obrigatórios"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textAlignment="center"
                    android:layout_marginTop="40dp"
                    android:textColor="@color/verdeagua"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    >
                    <TextView
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:text="Selecione os números que deverão aparecer em suas apostas."
                        android:textSize="14sp"
                        android:textColor="@color/cinza"
                        android:layout_centerHorizontal="true"
                        android:textAlignment="center"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">
                    <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
                        android:id="@+id/gridviewNumerosRapidaoSelecao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:columnWidth="56dp"
                        android:numColumns="auto_fit"
                        android:verticalSpacing="17dp"
                        android:stretchMode="spacingWidthUniform"
                        android:layout_marginTop="19dp"
                        android:layout_marginBottom="30dp"
                        android:isScrollContainer="false"
                        android:layout_marginHorizontal="8dp"
                        />


                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                android:id="@+id/layoutLimparSelecaoApostaRapidaSelecao"
                android:layout_centerHorizontal="true"
                android:visibility="gone">
                <Button
                    android:layout_width="184dp"
                    android:layout_height="56dp"
                    android:text="Limpar seleção"
                    android:textColor="@color/cinza"
                    android:textSize="14.2sp"
                    android:id="@+id/botaoLimparSelecaoApostaRapidaSelecao"
                    android:background="@drawable/custom_border_cinza"
                    />
            </RelativeLayout>
            <Button
                android:layout_width="184dp"
                android:layout_height="84dp"
                android:background="@color/verdeazul"
                android:textColor="@color/branco"
                android:textSize="17.7sp"
                android:textStyle="bold"
                android:text="Salvar"
                android:layout_centerHorizontal="true"
                android:id="@+id/salvarNumerosApostaRapidaoSelecao"
                android:layout_below="@+id/layoutLimparSelecaoApostaRapidaSelecao"
                android:layout_marginTop="14dp"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:background="@color/linhaDivisa"
                android:layout_marginTop="-44dp"
                android:layout_below="@+id/salvarNumerosApostaRapidaoSelecao"
                >

            </View>

        </RelativeLayout>
    </RelativeLayout>

</android.support.constraint.ConstraintLayout>
