<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/activity_vertical_margin">

        <TextView
            android:id="@+id/infoValorMinimo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="99dp"
            android:layout_marginLeft="17dp"
            android:layout_marginRight="99dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:text="Lembre-se que o valor mínimo do total de compras nesse aplicativo é R$24,00"
            android:textAlignment="textStart"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tituloConfirmaApostas" />

        <TextView
            android:id="@+id/tituloConfirmaApostas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="90dp"
            android:layout_marginLeft="17dp"
            android:layout_marginRight="90dp"
            android:layout_marginStart="17dp"
            android:layout_marginTop="20dp"
            android:gravity="start"
            android:text="Confirme suas apostas e pressione AVANÇAR para continuar."
            android:textAlignment="textStart"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/apostasListaRecycleView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/botaoFazerNovaAposta"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/infoValorMinimo">
        </android.support.v7.widget.RecyclerView>

        <!--<ListView-->
        <!--android:id="@+id/apostasListView"-->
        <!--android:layout_width="0dp"-->
        <!--android:layout_height="0dp"-->
        <!--android:layout_marginTop="10dp"-->
        <!--app:layout_constraintHorizontal_bias="0.0"-->
        <!--app:layout_constraintLeft_toLeftOf="parent"-->
        <!--app:layout_constraintRight_toRightOf="parent"-->
        <!--app:layout_constraintTop_toBottomOf="@+id/infoValorMinimo"-->
        <!--android:layout_marginBottom="8dp"-->
        <!--app:layout_constraintBottom_toTopOf="@+id/botaoFazerNovaAposta" />-->

        <Button
            android:id="@+id/botaoFazerNovaAposta"
            android:layout_width="184dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_white_with_border"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Fazer nova aposta"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/verdeazul"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/botaoAvancarPagamento"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <Button
            android:id="@+id/botaoAvancarPagamento"
            android:layout_width="184dp"
            android:layout_height="84dp"
            android:layout_marginBottom="51dp"
            android:layout_marginEnd="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="8dp"
            android:background="@color/verdeazul"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="Avançar para a forma de pagamento"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/branco"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/viewTabBar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />

        <android.support.constraint.ConstraintLayout
            android:id="@+id/viewTabBar"
            android:layout_width="0dp"
            android:layout_height="94dp"
            android:background="@color/azulclaro"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <ImageView
                android:id="@+id/imageViewPaginacao"
                android:layout_width="184dp"
                android:layout_height="12dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@string/imagemCarrinho"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:srcCompat="@drawable/paginacao1" />

        </android.support.constraint.ConstraintLayout>
    </android.support.constraint.ConstraintLayout>

</ScrollView>

