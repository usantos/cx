<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="300dp"
    android:orientation="vertical"
    android:layout_gravity="center_horizontal"
    android:id="@+id/scrollMegaResultado"
    >
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent"
       android:orientation="vertical">
         <TextView
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="Nº 2584 | 17/07/2016"
             android:id="@+id/numeroeDataConcursoResultadoMegaSena"
             android:layout_gravity="center_horizontal"
             android:textColor="@color/branco"
             android:textSize="14.2sp"
             android:layout_marginTop="15dp"
             android:fontFamily="@font/arialmt"/>
       <android.support.v7.widget.RecyclerView
           android:id="@+id/recyclerNumerosResultado"
           android:layout_width="168dp"
           android:layout_height="100dp"
           android:layout_marginTop="19dp"
           android:layout_gravity="center_horizontal"
           />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/megasenamedio"
            android:layout_marginTop="10dp"
            ></View>
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Premiados"
           android:textColor="@color/branco"
           android:textSize="15.8sp"
           android:fontFamily="@font/futura_std_bold"
           android:layout_marginTop="20dp"
           android:layout_marginLeft="16dp"/>
       
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Sena"
           android:textSize="14.2sp"
           android:textColor="@color/branco"
           android:fontFamily="@font/arialmt"
           android:textStyle="bold"
           android:layout_marginLeft="16dp"
           android:layout_marginTop="18dp"
           />
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="1 ganhador"
           android:textColor="@color/branco"
           android:fontFamily="@font/arialmt"
           android:textSize="14.2sp"
           android:layout_marginLeft="16dp"
           />

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Quina"
           android:textSize="14.2sp"
           android:textColor="@color/branco"
           android:fontFamily="@font/arialmt"
           android:textStyle="bold"
           android:layout_marginLeft="16dp"
           android:layout_marginTop="18dp"
           />
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="1 ganhador"
           android:textColor="@color/branco"
           android:fontFamily="@font/arialmt"
           android:textSize="14.2sp"
           android:layout_marginLeft="16dp"
           />


       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Quadra"
           android:textSize="14.2sp"
           android:textColor="@color/branco"
           android:fontFamily="@font/arialmt"
           android:textStyle="bold"
           android:layout_marginLeft="16dp"
           android:layout_marginTop="18dp"
           />
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="1 ganhador"
           android:textColor="@color/branco"
           android:fontFamily="@font/arialmt"
           android:textSize="14.2sp"
           android:layout_marginLeft="16dp"
           />
       
       <Button
           android:layout_width="246dp"
           android:layout_height="56dp"
           android:text="Veja mais detalhes"
           android:background="@drawable/button_border"
           android:layout_gravity="center_horizontal"
           android:textColor="@color/branco"
           android:layout_marginVertical="20dp"/>

   </LinearLayout>

</ScrollView>