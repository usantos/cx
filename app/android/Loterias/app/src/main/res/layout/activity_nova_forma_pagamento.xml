<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:orientation="vertical">

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco"
        tools:context="caixa.gov.br.loterias.ui.NovaFormaPagamentoActivity">

        <TextView
            android:id="@+id/textoInfoSelecioneFormaPagamento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="19dp"
            android:text="@string/novaFormaPagamentoNenhumCartaoCadastrado"
            android:textColor="@color/cinza"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textoFormaPagamentoTitulo"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/textoFormaPagamentoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="40dp"
            android:text="@string/novaFormaPagamentoTitulo"
            android:textColor="@color/colorAccent"
            android:textStyle="bold"
            android:textSize="14.2sp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />


        <android.support.v7.widget.RecyclerView
            android:id="@+id/novaFormaPagamentoRecyclerView"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@color/cinzaclaro"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@+id/textoInfoSelecioneFormaPagamento" />

        <RelativeLayout
            android:id="@+id/containerNumeroCartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="15dp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/novaFormaPagamentoRecyclerView"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextNumeroCartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true">

                <com.github.pinball83.maskededittext.MaskedEditText
                    android:id="@+id/editTextNumeroCartaoContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="number"
                    android:hint="Numero cartão"
                    android:textSize="16sp"
                    android:textColor="@color/cinza"
                    app:mask="**** **** **** ****"
                    app:notMaskedSymbol="*"
                    android:textColorHint="@color/azulFormNovoTipoPagamento"
                    />
            </android.support.design.widget.TextInputLayout>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/containerNomeClienteCartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="15dp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextNomeClienteCartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true">

                <EditText
                    android:id="@+id/editTextNomeClienteCartaoContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome igual ao do cartão"
                    android:inputType="textPersonName"
                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                    android:textSize="16sp"
                    android:textColorHint="@color/azulFormNovoTipoPagamento"
                    />
            </android.support.design.widget.TextInputLayout>


        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/containerCodigoSeguranca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="15dp"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/containerNomeClienteCartao"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <android.support.design.widget.TextInputLayout
                android:id="@+id/editTextCodigoSeguranca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true">

                <EditText
                    android:id="@+id/editTextCodigoSegurancaContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Código de segurança"
                    android:layout_marginRight="40dp"
                    android:inputType="number"
                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                    android:textSize="16sp"
                    android:maxLength="3"
                    android:textColorHint="@color/azulFormNovoTipoPagamento"
                    />
            </android.support.design.widget.TextInputLayout>

            <ImageView
                android:id="@+id/imageViewCVV"
                android:layout_width="37dp"
                android:layout_height="26dp"
                app:srcCompat="@drawable/cartao_cvc"
                android:layout_centerInParent="true"

                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/containerValidadeCartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/containerCodigoSeguranca"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            android:baselineAligned="false">

            <RelativeLayout
                android:id="@+id/containerMesValidadeCartao"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/editTextMesValidadeCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toLeftOf="@+id/imageMesValidadeCartaoOpenCombo"
                    android:layout_toStartOf="@+id/imageMesValidadeCartaoOpenCombo">

                    <EditText
                        android:id="@+id/editTextMesValidadeCartaooContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mês de validade"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                        android:textSize="16sp"
                        android:textColorHint="@color/azulFormNovoTipoPagamento"
                        />
                </android.support.design.widget.TextInputLayout>

                <ImageView
                    android:id="@+id/imageMesValidadeCartaoOpenCombo"
                    android:layout_width="12dp"
                    android:layout_height="10dp"
                    android:background="@drawable/combo"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/container2NomeClienteCartao"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/editT2extNomeClienteCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_toLeftOf="@+id/imageNome2ClienteCartaoCorrect"
                    android:layout_toStartOf="@+id/imageNome2ClienteCartaoCorrect">

                    <EditText
                        android:id="@+id/editText2NomeClienteCartaoContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Ano de validade"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                        android:textSize="16sp"
                        android:textColorHint="@color/azulFormNovoTipoPagamento"
                        />
                </android.support.design.widget.TextInputLayout>

                <ImageView
                    android:id="@+id/imageNome2ClienteCartaoCorrect"
                    android:layout_width="12dp"
                    android:layout_height="10dp"
                    android:background="@drawable/combo"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerComboSalvar"
            android:layout_width="0dp"
            android:layout_height="80dp"
            app:layout_constraintTop_toBottomOf="@+id/containerValidadeCartao"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@color/cinzaclaro">

            <CheckBox
                android:id="@+id/checkBoxSalvarCartao"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="30dp"
                android:checked="false"
                android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                android:background="@drawable/check_box_selected"
                android:button="@color/transparente50"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="30dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="Salvar este cartão para futuras apostas"/>
            </LinearLayout>
        </LinearLayout>


        <RelativeLayout
            android:id="@+id/relativeLayoutValorTotal"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginBottom="26dp"
            android:background="@color/colorAccent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerComboSalvar">

            <TextView
                android:id="@+id/textoTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="9dp"
                android:layout_marginRight="9dp"
                android:layout_toLeftOf="@+id/valorTotalCarrinho"
                android:layout_toStartOf="@+id/valorTotalCarrinho"
                android:text="@string/total"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valorTotalCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="36dp"
                android:layout_marginRight="36dp"
                android:text="R$ 00,00"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>


        <Button
            android:id="@+id/botaoAvancarPagamento"
            android:layout_width="184dp"
            android:layout_height="84dp"
            android:layout_marginBottom="51dp"
            android:layout_marginEnd="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="40dp"
            android:background="@color/verdeazul"
            android:text="@string/apostarAutorizarCobranca"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/branco"
            android:textSize="17sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/relativeLayoutValorTotal" />

        <android.support.constraint.ConstraintLayout
            android:id="@+id/viewTabBar"
            android:layout_width="0dp"
            android:layout_height="94dp"
            android:background="@color/azulclaro"
            android:orientation="horizontal"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/botaoAvancarPagamento"
            android:layout_marginTop="42dp">

            <ImageView
                android:id="@+id/imageViewPaginacao"
                android:layout_width="184dp"
                android:layout_height="12dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@string/imagemCarrinho"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:srcCompat="@drawable/paginacao2" />

        </android.support.constraint.ConstraintLayout>

    </android.support.constraint.ConstraintLayout>
</ScrollView>