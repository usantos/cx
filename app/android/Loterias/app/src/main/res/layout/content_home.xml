<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.ui.HomeActivity"
    tools:showIn="@layout/app_bar_home">
    <ScrollView
        android:layout_width="368dp"
        android:layout_height="439dp"
        tools:layout_editor_absoluteY="8dp"
        tools:layout_editor_absoluteX="8dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/cinza2"
            tools:layout_editor_absoluteY="0dp"
            tools:layout_editor_absoluteX="8dp">
            <LinearLayout
                android:id="@+id/RelativeLayoutTopResultados"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="59dp"
                android:layout_marginRight="59dp"
                android:background="@color/verdesenaescuro"
                android:orientation="horizontal"
                android:gravity="center"
                >
                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="12dp"
                    android:src="@drawable/seta_esquerda"
                    />
                <Button
                    android:layout_marginLeft="61dp"
                    android:layout_marginRight="61dp"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:textAllCaps="false"
                    android:text="Resultados"
                    android:background="@null"
                    android:textColor="@color/branco"
                    android:gravity="center"/>
                <ImageView
                    android:src="@drawable/seta_direita"
                    android:layout_width="8dp"
                    android:layout_height="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/RelativeLayoutTopModalidades"
                android:layout_width="match_parent"
                android:layout_height="71dp"
                android:layout_marginLeft="42dp"
                android:layout_marginRight="42dp"
                android:background="@color/verdesenaclaro"
                android:orientation="horizontal"
                android:gravity="left">
                <ImageView
                    android:layout_width="85dp"
                    android:layout_height="match_parent"
                    android:background="@color/verdesenatrevo"
                    android:src="@drawable/trevo"
                    android:scaleType="center"
                    android:id="@+id/imageViewBannerTipoAposta"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="mega-sena"
                    android:textSize="21.7sp"
                    android:textColor="@color/branco"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    />
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/RelativeLayoutContentCard"
                android:layout_width="match_parent"
                android:layout_height="356dp"
                android:layout_marginLeft="42dp"
                android:layout_marginRight="42dp"
                android:background="@color/branco"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="61dp"
                    android:textAlignment="center"
                    android:text="ACUMULOU!"
                    android:textSize="25sp"
                    android:textColor="@color/cinzaescuro"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="100dp"
                    android:textAlignment="center"
                    android:text="R$ 132.000.000,00"
                    android:textSize="25sp"
                    android:textColor="@color/verdesenavalor"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="132dp"
                    android:textAlignment="center"
                    android:text="Prêmio estimado do concurso 1843"
                    android:textSize="14sp"
                    android:textColor="@color/cinzaescuro"
                    />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="191dp"
                    android:layout_marginLeft="26dp"
                    android:layout_marginRight="26dp"
                    android:background="@color/cinza2"
                    />
                <LinearLayout
                    android:id="@+id/linearLayoutSorteio"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="232dp"
                    android:layout_marginLeft="29dp"
                    android:layout_marginRight="29dp"
                    android:background="@color/branco"
                    android:orientation="horizontal"
                    android:gravity="left">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@color/branco"
                        android:src="@drawable/icon_data_megasena"
                        android:id="@+id/imageCalendar"
                        android:layout_gravity="center"
                        />
                    <RelativeLayout
                        android:id="@+id/RelativeLayoutContentSorteio"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginLeft="20dp"
                        android:background="@color/branco">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Sorteio"
                            android:textSize="13sp"
                            android:textColor="@color/cinzaescuro"
                            />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Sábado, 18 de julho"
                            android:textSize="13sp"
                            android:textColor="@color/cinzaescuro"
                            android:textStyle="bold"
                            android:gravity="bottom"
                            />
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/linearLayoutAposta"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="277dp"
                    android:layout_marginLeft="29dp"
                    android:layout_marginRight="29dp"
                    android:background="@color/branco"
                    android:orientation="horizontal"
                    android:gravity="left">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@color/branco"
                        android:src="@drawable/icon_horario_megasena"
                        android:id="@+id/imageRelogio"
                        android:layout_gravity="center"
                        />
                    <RelativeLayout
                        android:id="@+id/RelativeLayoutContentAposta"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginLeft="20dp"
                        android:background="@color/branco">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Apostas se encerram em"
                            android:textSize="13sp"
                            android:textColor="@color/cinzaescuro"
                            />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="2 dias e 20 horas"
                            android:textSize="13sp"
                            android:textColor="@color/cinzaescuro"
                            android:textStyle="bold"
                            android:gravity="bottom"
                            />
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
</android.support.constraint.ConstraintLayout>
