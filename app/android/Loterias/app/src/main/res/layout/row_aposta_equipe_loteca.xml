<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_row_aposta_partida_loteca"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/image_aposta_partida_loteca"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="27dp"
        android:background="@drawable/select_unselect_circle_loteca" />

    <TextView
        android:id="@+id/text_aposta_partida_loteca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="33dp"
        android:textSize="14.2sp"
        android:textColor="@color/cinza"/>

</LinearLayout>