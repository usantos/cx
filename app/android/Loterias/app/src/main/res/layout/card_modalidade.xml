<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_item"
    android:layout_width="280dp"
    android:layout_height="450dp"
    android:layout_gravity="center"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/linear_layout"
        android:layout_width="280dp"
        android:layout_height="450dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/relativeLayoutTopResultados"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="@color/megasenaescuro"
            android:orientation="horizontal"
            android:gravity="center"
            >
            <ImageView
                android:layout_width="8dp"
                android:layout_height="12dp"
                android:src="@drawable/seta_esquerda"
                />
            <Button
                android:layout_marginLeft="40dp"
                android:layout_marginRight="40dp"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:textAllCaps="false"
                android:text="Resultados"
                android:background="@null"
                android:textColor="@color/branco"
                android:gravity="center"/>
            <ImageView
                android:src="@drawable/seta_direita"
                android:layout_width="8dp"
                android:layout_height="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/relativeLayoutTopModalidades"
            android:layout_width="match_parent"
            android:layout_height="71dp"
            android:background="@color/verdesenaclaro"
            android:orientation="horizontal"
            android:gravity="left">
            <ImageView
                android:layout_width="85dp"
                android:layout_height="match_parent"
                android:background="@drawable/background_trapeze"
                android:src="@drawable/trevo"
                android:scaleType="center"
                android:id="@+id/imageViewBannerTipoAposta"
                />
            <TextView
                android:id="@+id/textViewCardTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="mega-sena"
                android:textSize="21.7sp"
                android:textColor="@color/branco"
                android:textStyle="bold"
                android:gravity="center_vertical"
                />
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/relativeLayoutContentCard"
            android:layout_width="match_parent"
            android:layout_height="700dp"
            android:background="@color/branco"
            >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="61dp"
                android:textAlignment="center"
                android:text="ACUMULOU!"
                android:textSize="25sp"
                android:textColor="@color/cinzaescuro"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/textVieCardAcumulatedValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:textAlignment="center"
                android:text="R$ 0,00"
                android:textSize="25sp"
                android:textColor="@color/megasenaclaro"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/textVieCardEstimatedPrize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="132dp"
                android:textAlignment="center"
                android:text="Prêmio estimado do concurso 0"
                android:textSize="14sp"
                android:textColor="@color/cinzaescuro"
                />
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="191dp"
                android:layout_marginLeft="26dp"
                android:layout_marginRight="26dp"
                android:background="@color/cinza2"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="232dp"
                android:layout_marginLeft="29dp"
                android:layout_marginRight="29dp"
                android:background="@color/branco"
                android:orientation="horizontal"
                android:gravity="left">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@color/branco"
                    android:src="@drawable/icon_data_megasena"
                    android:id="@+id/imageCalendar"
                    android:layout_gravity="center"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginLeft="20dp"
                    android:background="@color/branco">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Sorteio"
                        android:textSize="13sp"
                        android:textColor="@color/cinzaescuro"
                        />
                    <TextView
                        android:id="@+id/textVieCardDrawDate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Sábado, 18 de julho"
                        android:textSize="13sp"
                        android:textColor="@color/cinzaescuro"
                        android:textStyle="bold"
                        android:gravity="bottom"
                        />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="277dp"
                android:layout_marginLeft="29dp"
                android:layout_marginRight="29dp"
                android:background="@color/branco"
                android:orientation="horizontal"
                android:gravity="left">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@color/branco"
                    android:src="@drawable/icon_horario_megasena"
                    android:id="@+id/imageWatch"
                    android:layout_gravity="center"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginLeft="20dp"
                    android:background="@color/branco">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Apostas se encerram em"
                        android:textSize="13sp"
                        android:textColor="@color/cinzaescuro"
                        />
                    <TextView
                        android:id="@+id/textVieCardClosingOfBets"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="0 dias e 0 horas"
                        android:textSize="13sp"
                        android:textColor="@color/cinzaescuro"
                        android:textStyle="bold"
                        android:gravity="bottom"
                        />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</android.support.v7.widget.CardView>