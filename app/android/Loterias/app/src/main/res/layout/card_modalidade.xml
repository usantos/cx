<?xml version="1.0" encoding="utf-8"?>
<android.support.v7.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_item"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/relativeLayoutTopResultados"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="@color/megasenaescuro"
            android:orientation="horizontal"
            android:gravity="center"
            >
            <ImageView
                android:layout_width="8dp"
                android:layout_height="12dp"
                android:src="@drawable/seta_esquerda"
                />
            <Button
                android:layout_marginLeft="40dp"
                android:layout_marginRight="40dp"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:textAllCaps="false"
                android:text="Resultados"
                android:background="@null"
                android:textColor="@color/branco"
                android:gravity="center"
                style="@style/editTextArialMTTheme"/>
            <ImageView
                android:src="@drawable/seta_direita"
                android:layout_width="8dp"
                android:layout_height="12dp"/>
        </LinearLayout>
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/linear_layout"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/branco">
            <LinearLayout
                android:id="@+id/relativeLayoutTopModalidades"
                android:layout_width="match_parent"
                android:layout_height="71dp"
                android:background="@color/megasenaclaro"
                android:orientation="horizontal"
                android:gravity="left">
                <RelativeLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_trapeze_megasena"
                    android:id="@+id/RelativeLayoutTrevo"
                    >
                    <ImageView
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:layout_marginLeft="23dp"
                        android:layout_marginTop="24dp"
                        android:src="@drawable/trevo"
                        android:scaleType="fitCenter"
                        android:id="@+id/trevoImagem"
                        />
                </RelativeLayout>
                <TextView
                    android:id="@+id/textViewCardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="mega-sena"
                    android:layout_marginLeft="0dp"
                    android:textSize="21.7sp"
                    android:textColor="@color/branco"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    />
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/LinearLayoutContentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/branco"
                    android:orientation="vertical"

                    >
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textAlignment="center"
                        android:text="ACUMULOU!"
                        android:textSize="25sp"
                        android:textColor="@color/cinzaescuro"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:id="@+id/textVieCardAcumulatedValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAlignment="center"
                        android:text="R$ 0,00"
                        android:textSize="25sp"
                        android:textColor="@color/megasenaclaro"
                        android:textStyle="bold"
                        />

                    <TextView
                        android:id="@+id/textPremioEstimadoConcurso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textAlignment="center"
                        android:text="Prêmio estimado do concurso "
                        android:textSize="14sp"
                        android:textColor="@color/cinzaescuro"
                        style="@style/editTextArialMTTheme"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentBottom="true"
                    android:gravity="bottom"
                    android:layout_marginBottom="40dp"
                    >
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginLeft="26dp"
                        android:layout_marginRight="26dp"
                        android:background="@color/cinza2"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginLeft="29dp"
                        android:layout_marginRight="29dp"
                        android:background="@color/branco"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp"
                        >
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@color/branco"
                            android:src="@drawable/icon_data_megasena"
                            android:id="@+id/imageCalendar"
                            android:layout_gravity="center"
                            />
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginLeft="20dp"
                            android:background="@color/branco">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="Sorteio"
                                android:textSize="13sp"
                                android:textColor="@color/cinzaescuro"
                                />
                            <TextView
                                android:id="@+id/textVieCardDrawDate"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="Sábado, 18 de julho"
                                android:textSize="13sp"
                                android:textColor="@color/cinzaescuro"
                                android:textStyle="bold"
                                android:gravity="bottom"
                                style="@style/editTextArialMTTheme"
                                />
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_marginLeft="29dp"
                        android:layout_marginRight="29dp"
                        android:layout_marginBottom="0dp"
                        android:background="@color/branco"
                        android:layout_marginTop="5dp"
                        >
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="@color/branco"
                            android:src="@drawable/icon_horario_megasena"
                            android:id="@+id/imageWatch"
                            android:layout_gravity="center"
                            />
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginLeft="20dp"
                            android:background="@color/branco">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="Apostas se encerram em"
                                android:textSize="13sp"
                                android:textColor="@color/cinzaescuro"
                                style="@style/editTextArialMTTheme"
                                />
                            <TextView
                                android:id="@+id/textVieCardClosingOfBets"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="0 dias e 0 horas"
                                android:textSize="13sp"
                                android:textColor="@color/cinzaescuro"
                                android:textStyle="bold"
                                android:gravity="bottom"
                                style="@style/editTextArialMTTheme"
                                />
                        </RelativeLayout>
                    </LinearLayout>


                </LinearLayout>

            </RelativeLayout>


        </LinearLayout>

    </LinearLayout>

</android.support.v7.widget.CardView>