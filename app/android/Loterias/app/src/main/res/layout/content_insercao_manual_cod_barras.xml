<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.InsercaoManualCodBarrasActivity"
    tools:showIn="@layout/activity_insercao_manual_cod_barras"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Por favor, informe o número do seu bilhete."
        android:textColor="@color/colorAccent"
        android:fontFamily="@font/futura_std_bold"
        android:textSize="14.2sp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"/>


    <android.support.design.widget.TextInputLayout
        android:id="@+id/input_layout_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"
        android:textColorHint="@color/verdeazul">
        <com.github.pinball83.maskededittext.MaskedEditText
            android:id="@+id/editTextNumeroBilhete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número do bilhete"
            android:textSize="14sp"
            android:fontFamily="@font/arialmt"
            android:textColorHint="@color/verdeazul"
            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890-"

            android:ems="10"
            app:mask="****-****************-**"
            app:notMaskedSymbol="*"
            />

    </android.support.design.widget.TextInputLayout>
    <Button
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="20dp"
        android:text="Continuar"
        android:textAllCaps="false"
        android:layout_marginTop="49dp"
        android:fontFamily="@font/futura_std_bold"
        android:textSize="16sp"
        android:id="@+id/buttonContinuarInsercaoManualBilhetes"
        android:enabled="false"
        android:textColor="@color/cinzaDisable"
        android:background="@color/cinzaclaro"
        />

</LinearLayout>
