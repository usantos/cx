<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="wrap_content"
    >
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/HorizontalScrollViewFavoritasItem"
        android:scrollbars="none"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="350dp"
            android:layout_height="match_parent"
            android:id="@+id/RelativeLayoutFavoritasAdapter"
            >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@color/cinza"
            android:id="@+id/RelativeLayoutContentAlterarFavoritas"
            android:layout_alignParentLeft="true"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dê um novo nome para sua aposta"
                android:textColor="@color/verdeazul"
                android:fontFamily="@font/arialmt"
                android:textSize="12sp"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="17dp"
                />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginRight="122dp"
                android:layout_alignParentLeft="true"
                android:layout_marginTop="37dp"
                android:layout_marginLeft="16dp"
                android:textColor="@color/branco"
                android:backgroundTint="@color/edittextlinecinza"
                android:id="@+id/EditTextNomeDaAposta"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:enabled="false"
                />

            <Button
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/seta_verde"
                android:layout_alignParentRight="true"
                android:layout_marginRight="86dp"
                android:layout_marginTop="50dp"
                android:id="@+id/buttonSalvarNomeAposta"
                android:enabled="false"
                />

        </RelativeLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@color/branco"
                android:id="@+id/RelativeLayoutContentFavoritas"
                android:layout_alignParentLeft="true"

                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/LinearLayoutContentApostaFavorita"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14.2sp"
                            android:textColor="@color/verdeazul"
                            android:id="@+id/tituloApostaFavorita"
                            android:layout_marginLeft="16dp"
                            android:fontFamily="@font/arialmt"
                            android:textStyle="bold"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" | agora vai"
                            android:textSize="14.2sp"
                            android:textColor="@color/cinza"
                            android:id="@+id/tituloNomeApostaFavorita"
                            android:fontFamily="@font/arialmt"
                            android:textStyle="bold"
                            />
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/numerosApostaFavorita"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="123dp"
                            android:text="01 - 02 - 03 - 04 - 05 - 06 - 10 - 11 - 12 - 20 - 33 - 100"
                            android:textColor="@color/azulescuroapostafavorita"
                            android:textSize="14.2sp"
                            android:textStyle="bold"

                            />
                        <LinearLayout
                            android:layout_width="123dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_alignParentRight="true">

                            <Button
                                android:id="@+id/editarButtonFavoritos"
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_marginHorizontal="10dp"
                                android:background="@drawable/iconfavedit" />
                            <Button
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:background="@drawable/icon_reload"
                                android:layout_marginHorizontal="10dp"
                                />

                            <Button
                                android:id="@+id/exluirButtonFavoritos"
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_marginHorizontal="10dp"
                                android:background="@drawable/close" />
                        </LinearLayout>
                    </RelativeLayout>



                </LinearLayout>

            </RelativeLayout>



        </RelativeLayout>
        </LinearLayout>
    </HorizontalScrollView>
</RelativeLayout>

