<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.TermosUsoActivity"
    tools:showIn="@layout/activity_termos_uso">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:textAlignment="center">

            <Button
                android:id="@+id/buttonTermos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.33"
                android:background="@color/verdeazul"
                android:drawableBottom="@drawable/tab_seta"
                android:text="Termos de uso"
                android:textAlignment="center"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/buttonPolitica"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.33"
                android:background="@color/cinzaclaro"
                android:text="Política\nde privacidade"
                android:textAlignment="center"
                android:textColor="@color/verdeazul"
                android:textSize="12sp"
                android:visibility="invisible"
                android:textStyle="bold"

                />

            <Button
                android:id="@+id/buttonDuvidas"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.33"
                android:background="@color/cinzaclaro"
                android:text="Dúvidas"
                android:textAlignment="center"
                android:textColor="@color/verdeazul"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="invisible" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="30dp"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="40dp">

            <WebView xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/webViewConteudo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </ScrollView>


    </LinearLayout>


</android.support.constraint.ConstraintLayout>
