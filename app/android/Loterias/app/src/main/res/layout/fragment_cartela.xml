<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartelaFragmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:orientation="vertical">

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cartelaFragmentMainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco">

        <RelativeLayout
            android:id="@+id/layoutSalvarApostaLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@color/cinza"
            android:clickable="true"
            app:layout_constraintBottom_toTopOf="@+id/botaoLimparAposta"
            app:layout_constraintLeft_toRightOf="@+id/viewTabBar"
            app:layout_constraintRight_toLeftOf="@+id/viewTabBar">

            <RelativeLayout
                android:id="@+id/salvarApostaLayout"
                android:layout_width="184dp"
                android:layout_height="140dp">

                <RelativeLayout
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:layout_alignLeft="@+id/textoDeNomeInfo"
                    android:layout_alignStart="@+id/textoDeNomeInfo"
                    android:layout_below="@+id/textoDeNomeInfo"
                    android:layout_marginTop="10dp">

                    <ImageButton
                        android:id="@+id/btnSalvarAposta"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerInParent="true"

                        android:layout_marginLeft="7dp"
                        android:layout_marginStart="7dp"
                        android:layout_toEndOf="@+id/editNomeAposta"
                        android:layout_toRightOf="@+id/editNomeAposta"
                        android:background="@drawable/seta_verde" />

                    <EditText
                        android:id="@+id/editNomeAposta"
                        android:layout_width="125dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:backgroundTint="@color/branco"
                        android:inputType="textNoSuggestions"
                        android:paddingBottom="7dp"
                        android:paddingLeft="0dp"
                        android:paddingTop="0dp"
                        android:text=""
                        android:textColor="@color/branco"
                        android:textCursorDrawable="@null"
                        android:textSize="16sp" />
                </RelativeLayout>


                <TextView
                    android:id="@+id/textoDeNomeInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignLeft="@+id/iconStarSalvar"
                    android:layout_alignStart="@+id/iconStarSalvar"
                    android:layout_below="@+id/textoSalveEstaAposta"
                    android:layout_marginTop="29dp"
                    android:text="@string/textoDeNome"
                    android:textColor="@color/verdeazul"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textoSalveEstaAposta"
                    android:layout_width="match_parent"
                    android:layout_height="21dp"
                    android:layout_alignBottom="@+id/iconStarSalvar"
                    android:layout_marginLeft="5dp"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/iconStarSalvar"
                    android:layout_toRightOf="@+id/iconStarSalvar"
                    android:gravity="center_vertical"
                    android:padding="0dp"
                    android:text="@string/tituloSalvarAposta"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/iconStarSalvar"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginLeft="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    app:srcCompat="@drawable/icon_favoritar" />
            </RelativeLayout>
        </RelativeLayout>

        <Button
            android:id="@+id/botaoLimparAposta"
            android:layout_width="184dp"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/button_white_with_border"

            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/limparAposta"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            app:layout_constraintBottom_toTopOf="@+id/botaoAdicionarCompletarCartela"
            app:layout_constraintLeft_toRightOf="@+id/viewTabBar"
            app:layout_constraintRight_toLeftOf="@+id/viewTabBar" />

        <Button
            android:id="@+id/botaoAdicionarCompletarCartela"
            android:layout_width="154dp"
            android:layout_height="84dp"
            android:layout_marginBottom="51dp"
            android:background="@color/cinzaescuro"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/adicionarAoCarrinho"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/viewTabBar"
            app:layout_constraintRight_toLeftOf="@+id/viewTabBar" />

        <android.support.constraint.ConstraintLayout
            android:id="@+id/viewTabBar"
            android:layout_width="0dp"
            android:layout_height="94dp"
            android:background="@color/azulclaro"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="13dp"
                android:layout_marginEnd="8dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="8dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/imageViewPaginacao"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0">

                <TextView
                    android:id="@+id/valorApostaCartela"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="center"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textInfoValorAposta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:text="@string/valorDessaAposta"
                    android:textAlignment="center"
                    android:textColor="@color/azulescuro"
                    android:textSize="12sp"
                    style="@style/ArialMT"
                    />
            </RelativeLayout>

            <ImageView
                android:id="@+id/imageViewPaginacao"
                android:layout_width="150dp"
                android:layout_height="12dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="@string/imagemCarrinho"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:srcCompat="@drawable/paginacao1" />

            <RelativeLayout
                android:id="@+id/carrinhoApostas"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="13dp"
                android:layout_marginEnd="10dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/imageViewPaginacao"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <Button
                    android:id="@+id/botaoCarrinho"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/icon_carrinho" />

                <RelativeLayout
                    android:layout_width="76dp"
                    android:layout_height="40dp"
                    android:layout_centerHorizontal="true">

                    <TextView
                        android:id="@+id/textViewCarrinhoCartelaCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:background="@drawable/rounded_textview"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/branco"
                        android:textSize="12sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/textInfoCarrinho"
                    style="@style/ArialMT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:text="@string/carrinhoDeApostas"
                    android:textAlignment="center"
                    android:textColor="@color/azulescuro"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/titleInformeBold"
                    style="@style/ArialMT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginBottom="444dp"
                    android:layout_marginEnd="271dp"
                    android:layout_marginRight="271dp"
                    android:text="@string/label_informe"
                    android:textColor="@color/verdeazul"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </android.support.constraint.ConstraintLayout>

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/layoutSalvarApostaLayout"
            app:layout_constraintHorizontal_bias="0.0">


            <LinearLayout
                android:id="@+id/layoutTitleLoteca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/titleContinue"
                    style="@style/ArialMT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/label_resultado_das_partidas."
                    android:textColor="@color/verdeazul"
                    android:textSize="14sp" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/opcaoOutrosNumerosLayout"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/cinza" >

                <android.support.v7.widget.AppCompatCheckBox
                    android:id="@+id/selcioneOutrosNumeros"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/check_box_selected"
                    android:button="@color/verdeagua" />

                <TextView
                    style="@style/ArialMT"
                    android:id="@+id/infoSelecioneOutrosNumeros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginTop="15dp"
                    android:layout_toRightOf="@+id/selcioneOutrosNumeros"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    tools:ignore="NotSibling" />

            </RelativeLayout>

            <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
                android:id="@+id/listaDezenas"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginHorizontal="10dp"
                android:columnWidth="50dp"
                android:gravity="center"
                android:horizontalSpacing="16dp"
                android:numColumns="auto_fit"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp"
                android:paddingBottom="40dp"
                android:paddingTop="40dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"/>


            <RelativeLayout
                android:id="@+id/infoEscolhaPaginacaoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintLeft_toLeftOf="parent">

                <TextView
                    style="@style/ArialMT"
                    android:id="@+id/infoEscolha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:textColor="@color/megasenamedio"
                    android:textSize="14sp" />

                <TextView
                    style="@style/ArialMT"
                    android:id="@+id/infoPaginacao"
                    android:layout_alignParentRight="true"
                    android:layout_alignRight="@id/infoEscolha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="45dp"
                    android:textColor="@color/megasenamedio"
                    android:textSize="14sp" />


            </RelativeLayout>

            <LinearLayout
                android:id="@+id/selecioneTimeCoracao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="28dp">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:text="@string/label_nome_do_seu_time"
                    android:textColor="@color/azulFormNovoTipoPagamento"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/informe_nome_time"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:textColor="@color/cinza"
                    android:textSize="16sp" />

                <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
                    android:id="@+id/gridTimes"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center"
                    android:numColumns="3"
                    android:paddingBottom="55dp"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="16dp"
                    app:layout_goneMarginBottom="10dp" />

            </LinearLayout>

            <caixa.gov.br.loterias.view.custom.ExpandableHeightRecyclerView
                android:id="@+id/recyclerViewPartida"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:clickable="false"
                android:nestedScrollingEnabled="false"
                android:paddingTop="60dp" />

        </android.support.constraint.ConstraintLayout>


    </android.support.constraint.ConstraintLayout>
</ScrollView>