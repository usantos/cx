<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent" >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/gradiente_titulo_caixa"
        android:id="@+id/relativeLayoutTopo">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titulo"
            android:textSize="16sp"
            android:id="@+id/tituloDialogCustom"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="18dp"
            android:textColor="@color/branco"
            />
    </RelativeLayout>

    <ListView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/listaItensDialog"
        android:layout_below="@+id/relativeLayoutTopo"
        android:choiceMode="singleChoice"
        android:listSelector="@color/cinzaclaro"
        >

    </ListView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cinza2"
        android:layout_below="@+id/listaItensDialog"
        android:id="@+id/linhaDivisaoBotoes">
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:layout_below="@+id/linhaDivisaoBotoes"
        >
        <Button
            android:id="@+id/dialogButtonCancelar"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:text=" Cancelar "
            android:textColor="@color/cinzaescuro"
            android:textSize="15sp"
            android:background="@color/branco"
            android:layout_weight="0.5"
            android:textStyle="bold"

            />
        <Button
            android:id="@+id/dialogButtonOK"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:text=" Ok "
            android:textColor="@color/verdeazul"
            android:textSize="15sp"
            android:background="@color/branco"
            android:layout_weight="0.5"
            android:textStyle="bold"
            />
    </LinearLayout>
</RelativeLayout>