<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/cinzaclaro</item>
        <item name="colorPrimaryDark">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:fontFamily">@font/font_family_futura</item>
        <item name="buttonStyle">@style/ButtonNotShadow</item>
        <item name="android:windowBackground">@color/branco</item>
    </style>

    <style name="AppTheme.BrancoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/branco</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:colorControlActivated">@color/verdeazul</item>
        <item name="android:colorControlNormal">@color/cinzaseekbar</item>
    </style>

    <style name="AppTheme.DegradeActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/verdeagua</item>
        <item name="colorPrimaryDark">@color/branco</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:colorControlActivated">@color/verdeazul</item>
        <item name="android:colorControlNormal">@color/cinzaseekbar</item>
    </style>

    <style name="MainWhiteToolbar" parent="AppTheme">
        <item name="android:textColorSecondary">@color/textColorToolbar</item>
        <item name="android:background">@color/branco</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="FullscreenTheme" parent="AppTheme">
        <item name="android:actionBarStyle">@style/FullscreenActionBarStyle</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="metaButtonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <style name="FullscreenActionBarStyle" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/background_splash_screen</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppFullScreenTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="DialogFullScreenTheme" parent="@style/ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="ArialMT" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/arialmt</item>
    </style>

    <style name="FuturaStdBold" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/futura_std_bold</item>
    </style>

    <style name="editTextRegisterTheme" parent="ArialMT">
        <item name="android:textColor">@color/cinza</item>
        <item name="android:textColorHint">@color/colorAccent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="editTextArialMTTheme" parent="ArialMT">
        <item name="android:textColor">@color/cinza</item>
    </style>

    <style name="ButtonNotShadow" parent="Base.Widget.AppCompat.Button">
        <item name="android:outlineProvider">none</item>
    </style>

    <style name="ButtonNotShadowColored" parent="Widget.AppCompat.Button.Colored">
        <item name="android:outlineProvider">none</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@color/transparente</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AppTheme.Modalidade">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textColorSecondary">@color/branco_transparente</item>
    </style>

    <style name="AppTheme.Modalidade.Quina">
        <item name="colorPrimaryDark">@color/quinaescuro</item>
        <item name="colorPrimary">@color/quinaclaro</item>
        <item name="android:windowBackground">@color/quinaescuro</item>
    </style>
    <style name="AppTheme.Modalidade.Loteca">
        <item name="colorPrimaryDark">@color/lotecaescuro</item>
        <item name="colorPrimary">@color/lotecaclaro</item>
        <item name="android:windowBackground">@color/lotecaescuro</item>
    </style>
    <style name="AppTheme.Modalidade.MegaSena">
        <item name="colorPrimaryDark">@color/megasenaescuro</item>
        <item name="colorPrimary">@color/megasenaclaro</item>
        <item name="android:windowBackground">@color/megasenaescuro</item>
    </style>
    <style name="AppTheme.Modalidade.DuplaSena">
        <item name="colorPrimaryDark">@color/duplasenaescuro</item>
        <item name="colorPrimary">@color/duplasenaclaro</item>
        <item name="android:windowBackground">@color/duplasenaescuro</item>
    </style>
    <style name="AppTheme.Modalidade.Lotofacil">
        <item name="colorPrimaryDark">@color/lotofacilescuro</item>
        <item name="colorPrimary">@color/lotofacilclaro</item>
        <item name="android:windowBackground">@color/lotofacilescuro</item>
    </style>
    <style name="AppTheme.Modalidade.Lotomania">
        <item name="colorPrimaryDark">@color/lotomaniaescuro</item>
        <item name="colorPrimary">@color/lotomaniaclaro</item>
        <item name="android:windowBackground">@color/lotomaniaescuro</item>
    </style>
    <style name="AppTheme.Modalidade.Timemania">
        <item name="colorPrimaryDark">@color/timemaniaescuro</item>
        <item name="colorPrimary">@color/timemaniaclaro</item>
        <item name="android:windowBackground">@color/timemaniaescuro</item>
        <item name="android:textColor">@color/megasenamedio</item>
        <item name="android:textColorSecondary">@color/megasenamedio_transparente</item>
        <item name="android:theme">@style/TimeManiaToolbar</item>
    </style>
    <style name="AppTheme.Modalidade.LotoGol">
        <item name="colorPrimaryDark">@color/lotogolescuro</item>
        <item name="colorPrimary">@color/lotogolclaro</item>
        <item name="android:windowBackground">@color/lotogolescuro</item>
    </style>
    <style name="AppTheme.Modalidade.Federal">
        <item name="colorPrimaryDark">@color/federalescuro</item>
        <item name="colorPrimary">@color/federalclaro</item>
        <item name="android:windowBackground">@color/federalescuro</item>
    </style>

    <style name="TimeManiaToolbar" parent="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/megasenamedio</item>
        <item name="colorControlNormal">@color/megasenamedio</item>
        <item name="android:textColorSecondary">@color/megasenamedio</item>
        <item name="actionMenuTextColor">@color/megasenamedio</item>
    </style>

</resources>
