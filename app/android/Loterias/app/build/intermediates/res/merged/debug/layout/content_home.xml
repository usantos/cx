<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.ui.HomeActivity"
    tools:showIn="@layout/app_bar_home">
    <ScrollView
        android:layout_width="368dp"
        android:layout_height="439dp"
        tools:layout_editor_absoluteY="8dp"
        tools:layout_editor_absoluteX="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/RelativeLayoutTopResultados"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="59dp"
                android:layout_marginRight="59dp"
                android:background="@color/verdesena"
                android:orientation="horizontal"
                >
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_marginLeft="17dp"
                    android:layout_marginTop="0dp"
                    android:src="@drawable/seta_esquerda"
                    android:layout_gravity="left"
                    />
                <ImageView
                    android:src="@drawable/seta_direita"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_marginRight="17dp"
                    android:layout_marginTop="0dp"
                    android:layout_gravity="right"/>
                <Button
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="0dp"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:textAllCaps="false"
                android:text="Resultados"
                android:background="@null"
                android:textColor="@color/branco"
                android:gravity="center"/>


            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="42dp"
                android:layout_marginRight="42dp"
                android:background="@color/verdesena"
                android:src="@drawable/cartao_american"
                android:id="@+id/imageViewBannerTipoAposta"
                />
            <RelativeLayout
                android:id="@+id/RelativeLayoutContentAposta"
                android:layout_width="match_parent"
                android:layout_height="356dp"
                android:layout_marginLeft="42dp"
                android:layout_marginRight="42dp"
                android:background="@color/cinza2"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="61dp"
                    android:textAlignment="center"
                    android:text="ACUMULOU!"
                    android:textSize="25sp"
                    android:textColor="@color/cinzaescuro"
                    android:textStyle="bold"
                    />

            </RelativeLayout>

        </LinearLayout>
    </ScrollView>


</android.support.constraint.ConstraintLayout>
