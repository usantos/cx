<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>

            <item>
                android:left="2dp"
                android:right="2dp"
                android:top="2dp"
                android:bottom="2dp">
                <shape android:shape="oval">
                    <size
                        android:width="24dp"
                        android:height="24dp"/>

                    <solid android:color="@color/branco"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/cinza110"/>
                </shape>
            </item>

            <item
                android:gravity="center"
                android:drawable="@drawable/ic_surpresinha"/>
        </layer-list>

    </item>

    <item>
        <layer-list>

            <item>
                android:left="2dp"
                android:right="2dp"
                android:top="2dp"
                android:bottom="2dp">
                <shape android:shape="oval">
                    <size
                        android:width="24dp"
                        android:height="24dp"/>

                    <solid android:color="@color/cinza110"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/cinza110"/>
                </shape>
            </item>

            <item
                android:gravity="center"
                android:drawable="@drawable/ic_surpresinha"/>
        </layer-list>

    </item>

</selector>