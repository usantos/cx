<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >

    <!-- Colored rectangle-->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="72dp"
                android:height="56dp" />
            <solid android:color="@color/quinamedio" />
        </shape>
    </item>

    <!-- This rectangle for the right side -->
    <!-- Their color should be the same as layout's background -->
    <item
        android:right="-250dp"
        android:left="81dp"
        android:top="-113dp"
        android:bottom="-48dp">
        <rotate
            android:fromDegrees="20">
            <shape android:shape="rectangle">
                <solid android:color="@color/quina_claro_mkp" />
            </shape>
        </rotate>
    </item>

</layer-list>