<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Configuração da janela criada pelo Android antes do primeiro quadro do Compose.
      Este arquivo não contém Views ou layouts; SplashScreen é exigido pela plataforma.
    -->
    <style name="Theme.Loterias" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Loterias.Starting" parent="Theme.SplashScreen">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="windowSplashScreenBackground">#005CA9</item>
        <!-- O Android 12+ controla esta breve janela inicial. Mantém apenas o fundo
             correspondente para a máscara do ícone adaptativo não recortar a marca. -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Loterias</item>
    </style>
</resources>
