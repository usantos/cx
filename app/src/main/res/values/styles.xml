<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/cinzaclaro</item>
        <item name="colorPrimaryDark">@color/colorAccent</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:fontFamily">@font/font_family_futura</item>
        <item name="buttonStyle">@style/ButtonNotShadow</item>
        <item name="android:windowBackground">@color/branco</item>
        <item name="android:actionButtonStyle">@style/ActionButtonStyleLoterias</item>
        <item name="actionButtonStyle">@style/ActionButtonStyleLoterias</item>
        <item name="android:homeAsUpIndicator">@drawable/seta_esquerda</item>
    </style>
    <style name="DadosPessoaisLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/caixa_std_bold</item>
        <item name="android:textColor">@color/cinza_texto</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DadosPessoaisInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="boxBackgroundMode">outline</item>
        <item name="boxBackgroundColor">@color/branco</item>
        <item name="boxStrokeColor">@color/cinza_borda</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>

        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>

        <item name="hintEnabled">false</item>
    </style>

    <style name="Widget.App.SegmentedButton"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>

        <item name="strokeColor">@color/cinza_borda</item>
        <item name="strokeWidth">1dp</item>

        <item name="cornerRadius">28dp</item>

        <item name="backgroundTint">@android:color/white</item>

        <item name="rippleColor">@android:color/transparent</item>

    </style>

    <style name="DadosPessoaisEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:fontFamily">@font/caixa_std_regular</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/cinza_texto</item>
        <item name="android:textColorHint">@color/cinza_hint</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DadosPessoaisSegmentedButton">
        <item name="android:fontFamily">@font/caixa_std_regular</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="pesqpush">
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">#4E596B</item>
        <item name="android:fontFamily">Future LT</item>
    </style>
    <style name="Theme.SimulaMaterial"
        parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="colorPrimary">@color/blue_caixa</item>
        <item name="colorPrimaryVariant">@color/azulclaro</item>
        <item name="colorSecondary">@color/blue_caixa</item>

    </style>

    <style name="AppTheme.BrancoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/branco</item>
        <item name="colorAccent">@color/colorAccent</item>
