<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.RapidaoApostaFavoritasSelecaoActivity"
    tools:showIn="@layout/activity_rapidao_aposta_favorita_selecao">


    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/title_apostas_favoritas"
        android:textAlignment="center"
        android:textColor="@color/verdeagua"
        android:textSize="18sp"
        android:fontFamily="@font/caixa_std_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView6"
        style="@style/editTextCaixaStdTheme"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/title_orientacaoRapidao"
        android:textAlignment="center"
        android:textColor="@color/cinza"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleApostasFavoritasRapidao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:paddingBottom="50dp"
        app:layout_constraintBottom_toTopOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />

    <View
        android:id="@+id/view"
        android:layout_width="wrap_content"
        android:layout_height="107dp"
        android:background="@color/linhaDivisa"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/salvarNumerosApostaRapidaoSelecao"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_below="@+id/layoutLimparSelecaoApostaRapidaSelecao"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="70dp"
        android:background="@color/verdeazul"
        android:text="@string/title_salvar"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="17.7sp"
        android:fontFamily="@font/caixa_std_bold"
        app:layout_constraintBottom_toBottomOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view" />

    <ProgressBar
        android:id="@+id/favoritas_loading_more_rapidao"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:padding="5dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/salvarNumerosApostaRapidaoSelecao"
        app:layout_constraintEnd_toEndOf="@+id/recycleApostasFavoritasRapidao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/recycleApostasFavoritasRapidao" />
</androidx.constraintlayout.widget.ConstraintLayout>