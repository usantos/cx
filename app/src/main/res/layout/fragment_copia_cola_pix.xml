<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.fragment.MeioPagamentoFragment">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/pix_copia_cola"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/azul_alterar"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <EditText
        android:id="@+id/numero_copiar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:hint="  12345678910111213141516"
        android:maxLines="1"
        android:inputType="text"
        android:scrollHorizontally="true"
        android:ellipsize="end"
        android:background="@drawable/shape_input_pix_copia_cola"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:paddingStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/titulo"
        app:layout_constraintStart_toStartOf="@+id/titulo"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_copiar_colar"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:background="@drawable/shape_button_copia"
        app:layout_constraintTop_toTopOf="@+id/numero_copiar"
        app:layout_constraintBottom_toBottomOf="@+id/numero_copiar"
        app:layout_constraintEnd_toEndOf="@+id/numero_copiar"
        />

    <TextView
        android:id="@+id/txt_alerta_codigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/pix_codigo_pago_unica_vez"
        android:textSize="14sp"
        android:textColor="@color/azul_alterar"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/numero_copiar"
        app:layout_constraintTop_toBottomOf="@+id/numero_copiar"/>

    <TextView
        android:id="@+id/txt_voce_tem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pix_voce_tem"
        android:textSize="14sp"
        android:textColor="@color/azul_alterar"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txt_alerta_codigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txt_voce_tem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/img_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_timer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/txt_contador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pix_contador"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/azul_alterar"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_timer"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/txt_para_efetuar_pagamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pix_para_efetuar_pagamento"
        android:textSize="14sp"
        android:textColor="@color/azul_alterar"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/timer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>