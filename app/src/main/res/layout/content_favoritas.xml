<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.FavoritasActivity"
    tools:showIn="@layout/activity_favoritas">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scrollViewContentViewFavoritas"
        android:layout_marginBottom="0dp"
        >
    <LinearLayout
        android:layout_marginTop="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/subTituloFavoritas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/arialmt"
            android:text="@string/nesta_rea_est_o_todas_as_suas_apostas_da_sorte_s_escolher_e_apostar_boa_sorte"
            android:textColor="@color/cinza"
            android:textSize="14.2sp" />

        <TextView
            android:id="@+id/tituloFavoritas"
            android:layout_width="362dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/futura_std_bold"
            android:text="@string/numeros_da_sorte_no_mesmo_lugar"
            android:textColor="@color/colorAccent"
            android:textSize="14.2sp"
            android:visibility="invisible" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerFavoritas"
            android:layout_width="match_parent"
            android:layout_height="564dp"
            android:layout_marginVertical="0dp"
            android:layout_marginTop="1dp"
            android:descendantFocusability="afterDescendants"
            android:nestedScrollingEnabled="false" />

        <ProgressBar
            android:id="@+id/favoritas_loading_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:visibility="gone"
            />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
