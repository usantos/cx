<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostar.interno.controllers.FavoritasActivity"
    tools:showIn="@layout/activity_favoritas">
    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/scrollViewContentViewFavoritas"
        android:layout_marginBottom="0dp"
        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/tituloFavoritas"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginLeft="17dp"
                android:text="@string/os_seus_n_meros_da_sorte_no_mesmo_lugar"
                android:textSize="14.2sp"
                android:fontFamily="@font/futura_std_bold"
                android:textColor="@color/colorAccent"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/subTituloFavoritas"
                android:text="@string/nesta_rea_est_o_todas_as_suas_apostas_da_sorte_s_escolher_e_apostar_boa_sorte"
                android:textSize="14.2sp"
                android:fontFamily="@font/arialmt"
                android:textColor="@color/cinza"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="17dp"
                />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/recyclerFavoritas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="19dp"
            android:nestedScrollingEnabled="false"
            android:descendantFocusability="afterDescendants"
            />

        <ProgressBar
            android:id="@+id/favoritas_loading_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:padding="5dp"
            android:visibility="gone"
            />
    </LinearLayout>
    </android.support.v4.widget.NestedScrollView>
</android.support.constraint.ConstraintLayout>
