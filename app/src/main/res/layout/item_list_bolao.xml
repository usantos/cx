<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    android:paddingTop="16dp">

    <ImageView
        android:id="@+id/seta_bolao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_seta_baixo_resultado"
        android:backgroundTint="@color/cinza110"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/linha_divisao"/>

    <br.gov.caixa.loterias.apostas.view.custom.BotaoFavoritar
        android:id="@+id/btn_favoritar_mkp"
        android:layout_width="24dp"
        android:layout_height="21dp"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/loterica_bolao"
        app:layout_constraintEnd_toStartOf="@+id/loterica_bolao"
        app:layout_constraintBottom_toBottomOf="@+id/cidade_bolao"
        />

    <TextView
        android:id="@+id/modalidade_bolao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="mega-sena"
        android:textSize="16sp"
        android:fontFamily="@font/futura_std_bold"
        android:textColor="@color/mega_verde_claro_mkp"
        android:visibility="gone"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <TextView
        android:id="@+id/valor_estimado_premio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 0,00"
        android:textColor="@color/cinza110"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toBottomOf="@+id/modalidade_bolao"
        app:layout_constraintStart_toStartOf="@+id/modalidade_bolao"
        />

    <TextView
        android:id="@+id/loterica_bolao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mina de Ouro"
        android:textSize="16sp"
        android:fontFamily="@font/caixa_std_semi_bold"
        android:textColor="@color/cinza130"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_favoritar_mkp"
        />

    <TextView
        android:id="@+id/cidade_bolao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brasília - DF"
        android:textSize="16sp"
        android:textColor="@color/cinza110"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toBottomOf="@+id/loterica_bolao"
        app:layout_constraintStart_toStartOf="@+id/loterica_bolao"
        />

    <TextView
        android:id="@+id/valor_cota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valor da Cota"
        android:layout_marginEnd="8dp"
        android:textColor="@color/cinza110"
        android:textSize="16sp"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/seta_bolao"
        />

    <TextView
        android:id="@+id/valor_bolao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_bold"
        android:textColor="@color/cinza130"
        android:textSize="16sp"
        android:text="R$ 000,00"
        app:layout_constraintTop_toBottomOf="@id/valor_cota"
        app:layout_constraintEnd_toEndOf="@id/valor_cota"
        />

    <View
        android:id="@+id/linha_divisao"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/linhaDivisa"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/valor_bolao"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_ver_mais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/linha_divisao">

        <TextView
            android:id="@+id/concurso_bolao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:fontFamily="@font/caixa_std_semi_bold"
            android:text="Concurso "
            android:visibility="visible"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/descricao_qtd_dezenas_it"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="05 apostas de 20 dezenas"
            android:textColor="@color/cinza90"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/concurso_bolao" />

        <Button
            android:id="@+id/detalhes"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Detalhes"
            android:textAllCaps="false"
            android:textColor="@color/mega_verde_claro_mkp"
            android:background="@drawable/btn_rounded_green_outlined"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/descricao_qtd_dezenas_it"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:id="@+id/descricao_qtd_cotas_disponiveis_it"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="25 cotas disponíveis de 100"
            android:textColor="@color/cinza90"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/detalhes" />

        <TextView
            android:id="@+id/label_quantidade_cotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="Quantidades de Cotas"
            android:textSize="18sp"
            android:textColor="@color/cinza90"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintTop_toBottomOf="@+id/descricao_qtd_cotas_disponiveis_it"
            app:layout_constraintStart_toStartOf="@+id/container_quantidade_cotas"
            app:layout_constraintEnd_toEndOf="@+id/container_quantidade_cotas"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_quantidade_cotas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/label_quantidade_cotas"
            app:layout_constraintEnd_toStartOf="@id/adicionar_carrinho">

            <Button
                android:id="@+id/diminui_cota"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="0dp"
                android:layout_marginRight="0dp"
                android:background="@drawable/ic_botao_surpresinha"
                android:text="@string/menos"
                android:textColor="@color/branco"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/quantidade_cotas"
                app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/quantidade_cotas"
            android:layout_width="58dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/_1"
                android:textSize="18sp"
            android:textAlignment="center"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="@color/cinza110"
            app:layout_constraintStart_toEndOf="@+id/diminui_cota"
            app:layout_constraintEnd_toStartOf="@+id/aumenta_cota"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/linha_numero"
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:background="@color/mega_verde_escuro_mkp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintStart_toEndOf="@id/diminui_cota"
            app:layout_constraintEnd_toStartOf="@id/aumenta_cota"
            app:layout_constraintBottom_toBottomOf="@id/quantidade_cotas"/>

        <Button
            android:id="@+id/aumenta_cota"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="0dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/ic_botao_surpresinha"
            android:text="@string/mais"
            android:textColor="@color/branco"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/quantidade_cotas"
            app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <Button
            android:id="@+id/adicionar_carrinho"
            android:layout_width="177dp"
            android:layout_height="32dp"
            android:text="Adicionar ao Carrinho"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_regular"
            android:textAllCaps="false"
            android:background="@drawable/btn_rounded_blue"
            app:layout_constraintStart_toEndOf="@+id/container_quantidade_cotas"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/container_quantidade_cotas"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>