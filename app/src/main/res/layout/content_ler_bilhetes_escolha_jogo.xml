<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.LerBilhetesEscolhaJogoActivity"
    tools:showIn="@layout/activity_ler_bilhetes_escolha_jogo">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="135dp"
            android:id="@+id/scrollViewSelecaoModalidadesRapidao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/conferir_aposta"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textSize="18sp"
                    android:textAlignment="center"
                    android:layout_marginTop="40dp"
                    android:textColor="@color/verdeagua"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    >
                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:text="@string/selecione_a_aposta_realizada"
                        android:textSize="14sp"
                        android:textColor="@color/cinza"
                        android:layout_centerHorizontal="true"
                        android:textAlignment="center"
                        style="@style/editTextCaixaStdTheme"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">
                    <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                        android:id="@+id/gridviewTiposApostasConferirAposta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:columnWidth="156dp"
                        android:numColumns="2"
                        android:verticalSpacing="17dp"
                        android:horizontalSpacing="0dp"
                        android:stretchMode="spacingWidthUniform"
                        android:layout_marginTop="19dp"
                        android:isScrollContainer="false"
                        />


                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:orientation="vertical"
            android:layout_alignParentBottom="true">
            <Button
                android:layout_width="184dp"
                android:layout_height="84dp"
                android:background="@color/cinzaclaro"
                android:textColor="@color/branco"
                android:textSize="17.7sp"
                android:fontFamily="@font/caixa_std_bold"
                android:text="@string/salvar"
                android:layout_centerHorizontal="true"
                android:id="@+id/selecionarModalidadesConferirApostaButton"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:background="@color/linhaDivisa"
                android:layout_marginTop="44dp"
                >

            </View>

        </RelativeLayout>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
