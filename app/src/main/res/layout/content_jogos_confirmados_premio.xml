<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.JogosConfirmadosPremioActivity"
    tools:showIn="@layout/activity_jogos_confirmados_premio"
    android:background="@color/branco">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/cinza">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loterica"
                android:textColor="@color/branco"
                android:fontFamily="@font/futura_std_bold"
                android:textSize="16sp"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="21dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/custom_border_circle_linha_divisa"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="40dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="54dp">
                <TextView
                    android:layout_width="146dp"
                    android:layout_height="wrap_content"
                    tools:text="@string/lorem_ipsum"
                    android:textSize="15.9sp"
                    android:fontFamily="@font/arialmt"
                    android:textStyle="bold"
                    android:textColor="@color/cinza"/>
                <TextView
                    android:layout_width="146dp"
                    android:layout_height="wrap_content"
                    tools:text="@string/lorem_ipsum"
                    android:textSize="14.1sp"
                    android:fontFamily="@font/arialmt"
                    android:textColor="@color/cinza"/>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:gravity="center"
            android:id="@+id/lltQrCode"
            android:orientation="vertical"
            android:layout_marginTop="17dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:id="@+id/imagemQrCode"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/custom_border_circle_linha_divisa"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="40dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="54dp">
                <TextView
                    android:layout_width="146dp"
                    android:layout_height="wrap_content"
                    tools:text="@string/lorem_ipsum"
                    android:textSize="15.9sp"
                    android:fontFamily="@font/arialmt"
                    android:textStyle="bold"
                    android:textColor="@color/cinza"/>
                <TextView
                    android:layout_width="146dp"
                    android:layout_height="wrap_content"
                    tools:text="@string/lorem_ipsum"
                    android:textSize="14.1sp"
                    android:fontFamily="@font/arialmt"
                    android:textColor="@color/cinza"/>

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:orientation="horizontal"
            android:layout_marginLeft="68dp"
            android:layout_marginTop="21dp">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/verdeazul"
                android:layout_gravity="center_vertical"
                ></View>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/lorem_ipsum"
                android:textColor="@color/cinza"
                android:textSize="14.1sp"
                android:fontFamily="@font/arialmt"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:orientation="horizontal"
            android:layout_marginLeft="68dp"
            android:layout_marginTop="21dp">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/verdeazul"
                android:layout_gravity="center_vertical"
                ></View>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/lorem_ipsum"
                android:textColor="@color/cinza"
                android:textSize="14.1sp"
                android:fontFamily="@font/arialmt"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:orientation="horizontal"
            android:layout_marginLeft="68dp"
            android:layout_marginTop="21dp">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/verdeazul"
                android:layout_gravity="center_vertical"
                ></View>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/lorem_ipsum"
                android:textColor="@color/cinza"
                android:textSize="14.1sp"
                android:fontFamily="@font/arialmt"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/linhaDivisa"
            android:layout_marginHorizontal="1dp"
            android:layout_marginTop="40dp"
            ></View>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="40dp">
            <ImageView
                android:layout_width="21dp"
                android:layout_height="26dp"
                android:src="@drawable/local_azul"
                android:layout_marginLeft="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/o_ponto_de_atendimento_nmais_pr_ximo_de_voc"
                android:lines="2"
                android:textSize="14.2sp"
                android:fontFamily="@font/futura_std_bold"
                android:textColor="@color/verdeazul"
                android:layout_marginLeft="19dp"
                />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/loterica_placeholder"
            android:textColor="@color/cinza"
            android:textSize="14.2sp"
            android:fontFamily="@font/futura_std_bold"
            android:layout_marginLeft="56dp"
            android:layout_marginTop="26dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="3"
            tools:text="@string/placeholder_endereco"
            android:textColor="@color/cinza"
            android:textSize="14.2sp"
            android:fontFamily="@font/arialmt"
            android:layout_marginLeft="56dp"
            android:layout_marginBottom="26dp"
            />
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
