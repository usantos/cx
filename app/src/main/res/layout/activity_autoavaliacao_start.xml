<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="br.gov.caixa.loterias.apostas.controllers.AutoavaliacaoStartActivity"
    android:background="@drawable/background_gradient_verde">

    <ImageView
        android:id="@+id/imgTrevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_loterias_caixa"
        android:layout_marginTop="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageView
        android:id="@+id/imgVolantes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_volantes"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgTrevo"
        />

    <TextView
        android:id="@+id/tvAutoIniciar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/autoavaliacao_apostador_bold"
        android:textSize="18dp"
        android:textColor="@color/branco"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btnAutoavaliacaoStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/btnAutoavaliacaoStart"
        android:layout_width="280dp"
        android:layout_height="wrap_content"

        android:background="@drawable/button_rouded_border_white"
        android:text="@string/btn_autoavaliacao_start"
        android:textSize="18sp"
        android:textColor="@color/branco"
        android:textAllCaps="false"

        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>