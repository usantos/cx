<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="br.gov.caixa.loterias.apostas.controllers.AutoavaliacaoStartActivity"
    android:background="@drawable/background_gradient_verde">

    <ImageView
        android:id="@+id/imgTrevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_loterias_caixa"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <ImageView
        android:id="@+id/imgVolantes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_volantes"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgTrevo"
        />

    <TextView
        android:id="@+id/tvAutoIniciar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/autoavaliacao_bem_vindo"
        android:textSize="18dp"
        android:textColor="@color/branco"
        android:textStyle="bold"
        android:textAlignment="center"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@+id/imgVolantes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/tvAutoTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/autoavaliacao_texto"
        android:textSize="15dp"
        android:textColor="@color/branco"
        android:textStyle="normal"
        android:textAlignment="center"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginTop="30dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toBottomOf="@+id/tvAutoIniciar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/btnAutoavaliacaoStart"
        android:layout_width="0dp"
        android:layout_height="50dp"

        android:background="@drawable/button_rouded_border_white"
        android:text="@string/btn_autoavaliacao_start"
        android:textSize="18sp"
        android:textColor="@color/branco"
        android:textAllCaps="false"
        android:fontFamily="@font/caixa_std_bold"


        android:layout_marginBottom="65dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnAutoFecharStart"
        android:layout_width="0dp"
        android:layout_height="50dp"

        android:background="@drawable/button_rouded_border_white"
        android:text="@string/fechar"
        android:textSize="18sp"
        android:textColor="@color/branco"
        android:fontFamily="@font/caixa_std_bold"
        android:textAllCaps="false"
        android:visibility="gone"

        android:layout_marginBottom="8dp"
        android:layout_marginStart="55dp"
        android:layout_marginEnd="55dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>