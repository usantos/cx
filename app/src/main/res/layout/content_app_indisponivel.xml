<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.AppIndisponivelActivity"
    tools:showIn="@layout/activity_app_indisponivel">


    <ImageView
        android:id="@+id/ic_download"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="18dp"
        android:src="@drawable/ic_indisponivel"
        app:layout_constraintBottom_toTopOf="@+id/guidelineDezoitoAnos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/viewTracoDezoito"
        android:layout_width="142dp"
        android:layout_height="1dp"
        android:background="@color/linhaDivisa"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineDezoitoAnos"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginStart="16dp"
        android:background="@color/amarelo"
        android:fontFamily="@font/futura_std_bold"
        android:text="@string/title_tente_novamente"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/tenteNovamenteButton"/>

    <TextView
        android:id="@+id/tv_mensagem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/futura_std_book"
        android:lines="4"
        android:text="@string/label_app_indisponivel"
        android:textAlignment="center"
        android:textColor="@color/verdeazul"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guidelineDezoitoAnos" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineDezoitoAnos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5"
        />

    <TextView
        android:id="@+id/txtVersao"
        android:layout_width="100dp"
        android:layout_height="17dp"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="196dp"
        android:layout_marginStart="170dp"
        android:fontFamily="@font/font_family_futura"
        android:text="@string/placeholder_versao"
        android:textAlignment="center"
        android:textColor="#58B7A6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/spin_ambiente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/caixa_std_regular"
        android:backgroundTint="@color/colorAccent"
        android:dropDownWidth="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtVersao"
        />

</androidx.constraintlayout.widget.ConstraintLayout>