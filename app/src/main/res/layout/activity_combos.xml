<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context="br.gov.caixa.loterias.apostas.controllers.CombosActivity"
        android:background="@drawable/background_gradient_verde"
        android:fitsSystemWindows="true">

    <include layout="@layout/app_bar_degrade"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_lista_combos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:background="@drawable/background_gradient_cinza_combos">
    <TextView
            android:id="@+id/txt_combos_orientacoes_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_lista_combos_top"
            android:fontFamily="@font/caixa_std_regular"
            android:textSize="13sp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:lineSpacingExtra="1.2sp"
            android:textColor="@color/cinza_combos"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

        <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_marginTop="7dp"
                app:layout_constraintTop_toBottomOf="@id/txt_combos_orientacoes_top"
                app:layout_constraintBottom_toTopOf="@id/id_fg_somador_carrinho"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcv_lista_combos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="25dp"
                    android:paddingEnd="25dp"
                    android:paddingBottom="10dp"/>
        </androidx.core.widget.NestedScrollView>

        <RelativeLayout
                android:id="@+id/id_fg_somador_carrinho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>