<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="br.gov.caixa.loterias.apostas.controllers.MensagensPushActivity"
    tools:showIn="@layout/content_lista_msgpush"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:clickable="true"
    android:background="@color/branco_transparente"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_cabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_cabec_push_branco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icon_ImageView"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_logo_money"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titulo_msgpush"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:text="Usuario from"
            android:textColor="@color/cinzaescuro"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/data_texto"
            app:layout_constraintStart_toEndOf="@+id/icon_ImageView"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="mensagem preview"
            android:textColor="@color/cinzaescuro"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/data_texto"
            app:layout_constraintStart_toEndOf="@id/icon_ImageView"
            app:layout_constraintTop_toBottomOf="@id/titulo_msgpush" />

        <TextView
            android:id="@+id/data_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="01/01/2023"
            android:textColor="@color/cinzaescuro"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/expandedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@drawable/tab_selector_push"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/container_cabecalho">

            <Button
                android:id="@+id/buttonCompart"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/ic_compartilhar"
                android:drawablePadding="8dp"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/buttonMsgExpandida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="100dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:fontFamily="@font/futura_std_bold"
                android:padding="8dp"
                android:text="botaoMsg"
                android:textAllCaps="false"
                android:textSize="11dp"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mensagem_texto" />

        <TextView
            android:id="@+id/mensagem_texto"
            android:layout_width="298dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="20dp"
            android:fontFamily="@font/futura_std_bold"
            android:padding="12dp"
            android:textAllCaps="false"
            android:textColor="@color/cinzaescuro"
            android:textSize="12dp"
            app:layout_constraintEnd_toStartOf="@+id/buttonCompart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
            />

        </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>