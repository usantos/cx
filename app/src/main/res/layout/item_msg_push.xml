<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal"
    android:stretchColumns="*"
    android:showDividers="middle"
    android:divider="@color/mpsdk_warm_grey">

    >
    <TableRow
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <ImageView
            android:id="@+id/icon_ImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_logo_money" />
        <TextView
            android:id="@+id/titulo_msgpush"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/MessageTitleStyle"
            />
        <TextView
            android:id="@+id/mensagem_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/MessageContentStyle"
            />
        <TextView
            android:id="@+id/data_texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/MessageDateStyle"
            />
    </TableRow>
</TableLayout>