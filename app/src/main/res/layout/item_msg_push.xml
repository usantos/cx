<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context="br.gov.caixa.loterias.apostas.controllers.MensagensPushActivity"
    tools:showIn="@layout/content_lista_msgpush">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackground"
        >
        <ImageView
            android:id="@+id/icon_ImageView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:src="@drawable/ic_logo_money"
            />
        <TextView
            android:id="@+id/titulo_msgpush"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/icon_ImageView"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/icon_ImageView"
            android:textColor="@color/cinzaescuro"
            android:text="Usuario from"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/text_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/titulo_msgpush"
            android:layout_alignStart="@id/titulo_msgpush"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="@color/cinzaescuro"
            android:text="mensagem preview"
            android:layout_marginEnd="24dp"
            android:textSize="16sp"/>

        <LinearLayout
            android:id="@+id/expandedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/titulo_msgpush"
            android:layout_alignStart="@id/titulo_msgpush"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="61dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:padding="1dp">

            <TextView
                android:id="@+id/mensagem_texto"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@id/titulo_msgpush"
                android:layout_alignStart="@id/titulo_msgpush"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:textColor="@color/cinzaescuro"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/data_texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:textColor="@color/cinzaescuro"
            android:textSize="14sp"
            android:text="01-jan"/>
    </RelativeLayout>

</androidx.cardview.widget.CardView>