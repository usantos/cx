<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".view.fragment.TutorialSuperSete1Fragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginRight="40dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingBottom="150dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_bem_vindo"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_height="wrap_content"
                tools:text="@string/bem_vindo_super_sete"
                android:fontFamily="@font/caixa_std_regular"/>

            <TextView
                android:id="@+id/tv_jogo_simples"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:fontFamily="@font/caixa_std_regular"
                tools:text="@string/jogo_simples"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/v_divisor_esq"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/cinza_divisoria"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tv_como_apostar"
                    android:layout_marginRight="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_como_apostar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/como_apostar"
                    android:textColor="@color/cinza_divisoria"
                    android:fontFamily="@font/caixa_std_regular"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/v_divisor_dir"
                    app:layout_constraintStart_toEndOf="@+id/v_divisor_esq"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/v_divisor_dir"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginLeft="5dp"
                    android:background="@color/cinza_divisoria"
                    app:layout_constraintStart_toEndOf="@id/tv_como_apostar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/iv_gif"
                android:layout_marginTop="20dp"
                android:layout_width="match_parent"
                android:background="@color/branco"
                android:adjustViewBounds="true"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>