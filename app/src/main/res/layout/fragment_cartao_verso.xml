<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="0dp"
    app:layout_constraintTop_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    >

    <LinearLayout
        android:id="@+id/containerCartao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/frontCard"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_margin="32dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="6dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/fundoCartaoCredito" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="190dp"
                    android:background="@drawable/background_semi_circulo" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintCartao"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    >

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgBandeiraVerso"
                        android:layout_width="80dp"
                        android:layout_height="65dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                    <View
                        android:id="@+id/tarjaPreta"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/black"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <View
                        android:id="@+id/tarjaAmarela"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@color/tarjaAmarela"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="95dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imgLupa"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/lupa"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintEnd_toEndOf="@+id/containerCartao"
        app:layout_constraintBottom_toBottomOf="@+id/containerCartao"
        />

    <TextView
        android:id="@+id/textoCVV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:text="@string/xxx"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@+id/imgLupa"
        app:layout_constraintBottom_toBottomOf="@id/imgLupa"
        app:layout_constraintEnd_toEndOf="@id/imgLupa"
        app:layout_constraintStart_toStartOf="@id/imgLupa"
        />

</androidx.constraintlayout.widget.ConstraintLayout>