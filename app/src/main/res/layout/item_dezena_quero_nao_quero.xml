<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_excluir_num_quero_nao_quero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

       <TextView
            android:id="@+id/txt_item_numero"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:text="1"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_margin="8dp"
            android:fontFamily="@font/caixa_std_bold"
            android:textColor="@color/branco"
            android:background="@drawable/ic_item_dezena_selecionado"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_fechar_qnq"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/ic_btn_fechar_qnq"
            android:layout_marginStart="-9dp"
            android:layout_marginTop="-4dp"
            app:layout_constraintTop_toTopOf="@id/txt_item_numero"
            app:layout_constraintStart_toEndOf="@id/txt_item_numero"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>