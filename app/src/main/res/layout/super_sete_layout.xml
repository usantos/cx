        android:textColor="@color/super_sete_letra_mkp"
        app:layout_constraintStart_toEndOf="@+id/tv_col_2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_col_4"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_text_view_colunas"
        android:backgroundTint="@color/super_sete_claro_mkp"
        android:fontFamily="@font/futura_std_bold"
        android:gravity="center"
        android:text="4"
        android:textColor="@color/super_sete_letra_mkp"
        app:layout_constraintStart_toEndOf="@+id/tv_col_3"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_col_5"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_text_view_colunas"
        android:backgroundTint="@color/super_sete_claro_mkp"
        android:fontFamily="@font/futura_std_bold"
        android:gravity="center"
        android:text="5"
        android:textColor="@color/super_sete_letra_mkp"
        app:layout_constraintStart_toEndOf="@+id/tv_col_4"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_col_6"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_text_view_colunas"
        android:backgroundTint="@color/super_sete_claro_mkp"
        android:fontFamily="@font/futura_std_bold"
        android:gravity="center"
        android:text="6"
        android:textColor="@color/super_sete_letra_mkp"
        app:layout_constraintStart_toEndOf="@+id/tv_col_5"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_col_7"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_text_view_colunas"
        android:backgroundTint="@color/super_sete_claro_mkp"
        android:fontFamily="@font/futura_std_bold"
        android:gravity="center"
        android:text="7"
        android:textColor="@color/super_sete_letra_mkp"
        app:layout_constraintStart_toEndOf="@+id/tv_col_6"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_super_sete_primeiro"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:paddingTop="5dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintEnd_toEndOf="@+id/tv_col_1"
        app:layout_constraintStart_toStartOf="@+id/tv_col_1"
        app:layout_constraintTop_toBottomOf="@+id/tv_col_1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_super_sete_segundo"
        android:layout_width="30dp"
