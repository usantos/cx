<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_col_1"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_text_view_colunas"
        android:backgroundTint="@color/super_sete_claro_mkp"
        android:fontFamily="@font/futura_std_bold"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/super_sete_letra_mkp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_col_2"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_margin="8dp"
        android:background="@drawable/rounded_text_view_colunas"
        android:backgroundTint="@color/super_sete_claro_mkp"
        android:fontFamily="@font/futura_std_bold"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/super_sete_letra_mkp"
        app:layout_constraintStart_toEndOf="@+id/tv_col_1"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_col_3"
        android:layout_width="25dp"
