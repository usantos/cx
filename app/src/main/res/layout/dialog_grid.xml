<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_roudend_branco"
    android:orientation="vertical"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">


    <LinearLayout
        android:id="@+id/dialog_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded_top_azul"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/selecione_modalidade_desejada"
            android:fontFamily="@font/caixa_std_semi_bold"
            android:textSize="16sp"
            android:focusable="true"
            android:contentDescription="@string/selecione_modalidade_desejada"
            android:textColor="@color/branco"
            android:gravity="start" />

        <Button
            android:id="@+id/dialog_close"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/ic_x"
            android:padding="4dp"
            android:layout_gravity="end" />
    </LinearLayout>


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

<!--        <GridLayout-->
<!--            android:id="@+id/grid_options"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:columnCount="2"-->
<!--            android:alignmentMode="alignMargins"-->
<!--            android:padding="8dp"-->
<!--            android:useDefaultMargins="true" />-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ehgv_grid_modalidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_margin="10dp"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:gravity="center"
            android:horizontalSpacing="10dp"
            android:isScrollContainer="false"
            android:numColumns="2"
            android:verticalSpacing="17dp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="16dp">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="@android:color/holo_blue_dark"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/btn_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtrar"
            android:textColor="@android:color/holo_blue_dark"
            android:textStyle="bold"
            android:padding="8dp"
            android:layout_marginStart="16dp" />
    </LinearLayout>
</LinearLayout>