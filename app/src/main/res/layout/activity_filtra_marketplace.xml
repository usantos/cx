<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/carrinhoScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="blocksDescendants">

    <include layout="@layout/app_bar_degrade_pesquisa" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />

    <ScrollView
        android:id="@+id/scroll_filtra_market"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/id_fg_somador_carrinho"
        app:layout_constraintTop_toTopOf="@id/gl_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/text_quantidade_cotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginStart="10dp"
                android:text="@string/quantidade_cotas"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14.2sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/text_quantidade_dezenas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="10dp"
                android:text="@string/quantidade_dezenas"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="14.2sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/text_quantidade_cotas"
                app:layout_constraintStart_toStartOf="parent"
                />

            <View
                android:id="@+id/view_div_qtd_dezena"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="40dp"
                android:background="@color/bolao_linha"
                app:layout_constraintTop_toBottomOf="@+id/text_quantidade_dezenas" />

            <TextView
                android:id="@+id/accordion_quero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginStart="10dp"
                android:text="@string/numeros_quero"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/black"
                android:textSize="14.2sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/view_div_qtd_dezena"
                app:layout_constraintStart_toStartOf="parent"
                 />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_accordion_quero"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/ic_accordion_plus"
                android:layout_marginEnd="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/accordion_quero"
                />

            <LinearLayout
                android:id="@+id/accordionContentQuero"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/accordion_quero"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Conteudo Acordeon -->
                <TextView
                    android:id="@+id/text_teste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="start"
                    android:paddingLeft="20dp"
                    android:text="teste xxxxx"
                    android:textAlignment="textStart"
                    android:textColor="@color/black"
                    android:textSize="14.2sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/accordionContentQuero" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/accordion_quero"
                tools:layout_editor_absoluteX="0dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_limpar_filtros"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_white_with_rouded_black_border"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/limpar_filtros"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/btn_avancar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_avancar"
        android:layout_width="184dp"
        android:layout_height="40dp"
        android:layout_below="@id/btn_limpar_filtros"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="51dp"
        android:background="@drawable/button_orange_rounded"
        android:text="@string/aplicar"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/id_fg_somador_carrinho"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>