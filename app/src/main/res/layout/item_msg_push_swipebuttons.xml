<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeLayoutButtonPush"
    android:padding="5dp"
     android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">
    <LinearLayout
        android:background="#2E2565"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:gravity="center">
        <ImageButton
            android:id="@+id/btn_msg_lidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_carta_msglidas"
            android:background="#2E2565"
            />
    </LinearLayout>
    <LinearLayout
        android:background="#900000"
        android:layout_width="60dp"
        android:gravity="center"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btn_msg_eliminar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:src="@drawable/ic_lixeira_push"
            android:background="#900000"
            />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/surface_push"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/pesquisa_msgpush"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/container_cabecalho"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/pesquisa_msgpush"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_ImageView"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@color/pesquisa_msgpush"
                android:src="@drawable/ic_logo_money" />

            <LinearLayout
                android:layout_width="247dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titulo_msgpush"
                    android:layout_width="230dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@color/pesquisa_msgpush"
                    android:gravity="left"
                    android:text="Titulo msg"
                    android:textColor="@color/cinzaescuro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_preview"
                    android:layout_width="256dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:background="@color/pesquisa_msgpush"
                    android:ellipsize="marquee"
                    android:gravity="left"
                    android:singleLine="true"
                    android:text="mensagem preview"
                    android:textColor="@color/cinzaescuro"
                    android:textSize="16sp" />
            </LinearLayout>


            <TextView
                android:id="@+id/data_texto"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:background="@color/pesquisa_msgpush"
                android:ellipsize="marquee"
                android:gravity="right"
                android:text="01/01/2023"
                android:textColor="@color/cinzaescuro"
                android:textSize="14sp"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expandedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:background="@drawable/ic_cabec_push_branco"
            android:padding="0dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
            <TextView
                android:id="@+id/mensagem_texto"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/futura_std_bold"
                android:padding="8dp"
                android:textAllCaps="false"
                android:textColor="@color/cinzaescuro"
                android:textSize="12dp" />
            />
            <Button
                android:id="@+id/buttonCompart"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginLeft="80dp"
                android:background="@drawable/ic_compartilhar"
                android:padding="8dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center" >

            <Button
                android:id="@+id/buttonMsgExpandida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/futura_std_bold"
                android:padding="8dp"
                android:text="botaoMsg"
                android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.daimajia.swipe.SwipeLayout>
