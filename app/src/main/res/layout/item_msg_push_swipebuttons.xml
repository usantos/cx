<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="0dp"
    >

    <LinearLayout
        android:id="@+id/swipeLayoutButtonPush"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="1"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="#2E2565"
            >

            <ImageButton
                android:id="@+id/btn_msg_lidas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2E2565"
                android:gravity="center"
                android:src="@drawable/ic_carta_msglidas" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="#900000">

            <ImageButton
                android:id="@+id/btn_msg_eliminar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#900000"
                android:gravity="center"
                android:src="@drawable/ic_lixeira_push" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/surface_push"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pesquisa_msgpush"
        android:orientation="vertical"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/container_cabecalho"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/pesquisa_msgpush"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_ImageView"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@color/pesquisa_msgpush"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:src="@drawable/ic_logo_money" />

            <LinearLayout
                android:layout_width="207dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titulo_msgpush"
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@color/pesquisa_msgpush"
                    android:gravity="left"
                    android:paddingStart="8dp"
                    android:text="Titulo msg"
                    android:textColor="@color/cinzaescuro"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_preview"
                    android:layout_width="256dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@color/pesquisa_msgpush"
                    android:ellipsize="marquee"
                    android:paddingStart="8dp"
                    android:singleLine="true"
                    android:text="mensagem preview"
                    android:textColor="@color/cinzaescuro"
                    android:textSize="16sp" />
            </LinearLayout>


            <TextView
                android:id="@+id/data_texto"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:background="@color/pesquisa_msgpush"
                android:ellipsize="marquee"
                android:gravity="center"
                android:text="01/01/2023"
                android:textColor="@color/cinzaescuro"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expandedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:background="@drawable/ic_cabec_push_branco"
            android:orientation="vertical"

            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mensagem_texto"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:fontFamily="@font/futura_std_bold"
                    android:padding="12dp"
                    android:textAllCaps="false"
                    android:textColor="@color/cinzaescuro"
                    android:textSize="12dp" />
                <Button
                    android:id="@+id/buttonCompart"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:paddingLeft="10dp"
                    android:background="@drawable/ic_compartilhar"
                    android:padding="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonMsgExpandida"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/futura_std_bold"
                    android:padding="8dp"
                    android:text="botaoMsg"
                    android:textAllCaps="false"
                    android:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.daimajia.swipe.SwipeLayout>
