<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:background="@color/loteca_escuro_mkp"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_premio_pago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="15dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/v_separador_esq"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginRight="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_premio_pago_tit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_premio_pago_tit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tit_premio_pago"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/v_separador_dir"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_premio_pago_tit"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/apostaConfirmadaLotecaLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="15dp"
        android:orientation="horizontal"
        android:weightSum="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_premio_pago">

        <LinearLayout

            android:id="@+id/colunaConcursoLinearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_concurso"
                android:textSize="14sp"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_bold" />

            <TextView
                android:id="@+id/concursoCabecalhoTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_concurso"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/colunaSuaApostaLinearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:orientation="horizontal"
                android:weightSum="1">

                <TextView
                    android:id="@+id/tv_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/label_data_aposta"
                    android:textSize="12sp"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_bold"/>

                <TextView
                    android:id="@+id/dataHoraTextView"
                    android:layout_width="wrap_content"
                    android:maxWidth="300dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_titulo"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_data_aposta"
                    android:textSize="12sp"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_regular"/>

                <View
                    android:id="@+id/divider"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/dataHoraTextView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_titulo" />

                <TextView
                    android:id="@+id/statusApostaTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/label_coluna"
                    android:textAlignment="textStart"
                    android:textSize="12sp"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_bold"/>

                <TextView
                    android:id="@+id/tv_val_premio_tit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/val_premio"
                    app:layout_constraintTop_toBottomOf="@+id/statusApostaTextView"
                    app:layout_constraintStart_toStartOf="@+id/divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    android:textSize="12sp"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_regular"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_val_premio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/tv_val_premio_tit"
                    app:layout_constraintStart_toStartOf="@+id/divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    android:textSize="12sp"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_bold"
                    android:visibility="gone"
                    tools:text="@string/r_0_00" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clResgatePremio"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="25dp"
                android:padding="8dp"
                android:layout_below="@id/cl_data"
                android:background="@drawable/rounded_text_view_colunas"
                android:backgroundTint="#FFA829"
                android:layout_alignStart="@id/quantidadeApostadasTxt"
                android:weightSum="1"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivResgatePremio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_icone_resgate"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resgatar prêmio"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_regular"
                    android:layout_marginStart="16sp"
                    app:layout_constraintStart_toEndOf="@+id/ivResgatePremio"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_sua_aposta"
                android:textSize="12sp"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_bold"/>

            <LinearLayout
                android:id="@+id/cabecalhoLotecaLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_coluna"
                    android:textSize="12sp"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_bold"/>

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="21dp"
                    android:text="@string/label_time"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:fontFamily="@font/caixa_std_bold"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/concursoRodapeLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_concurso_abreviado_espaco"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:fontFamily="@font/caixa_std_regular"/>

                <TextView
                    android:id="@+id/concursoRodaPeTextView"
                    style="@style/ArialMT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_concurso_abreviado_espaco"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:fontFamily="@font/caixa_std_bold"/>
            </LinearLayout>

            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightRecyclerView
                android:id="@+id/listaPartidasApostadasExpandebleRecyclerView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:layout_marginEnd="15dp"
                android:clickable="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>