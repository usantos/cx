<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context="caixa.gov.br.loterias.view.fragment.Introducao2Fragment">

<!-- TODO: Update blank fragment layout -->

<ImageView
    android:id="@+id/imageViewLogoLoterias"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_marginTop="18dp"
    android:layout_gravity="center_horizontal"
    app:srcCompat="@drawable/logo"
    android:layout_alignParentTop="true"
    android:layout_centerHorizontal="true" />

<ImageView
    android:id="@+id/imageViewTelefone"
    android:layout_width="161dp"
    android:layout_height="70dp"
    app:srcCompat="@drawable/ilustra_funcionalidades"
    android:layout_marginTop="45dp"
    android:layout_below="@+id/imageViewLogoLoterias"
    android:layout_centerHorizontal="true" />

    <TextView
        android:id="@+id/textView1Fragment2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/imageViewTelefone"
        android:layout_marginTop="19dp"
        android:text="Novas funcionalidades "
        android:textColor="@color/branco"
        android:textSize="18sp" />


    <TextView
        android:id="@+id/textView3"
        android:layout_width="172dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Suas apostas ainda mais fáceis e muito mais rápidas."
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:layout_below="@+id/textView1Fragment2"
        android:layout_centerHorizontal="true" />
</RelativeLayout>
