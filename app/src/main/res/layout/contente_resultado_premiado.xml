<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topoModalidadeResultadoLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/megasenaclaro"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fundoBackgroundTrapezeResultadoLinearLayout"
            android:layout_width="90dp"
            android:layout_height="56dp">

            <ImageView
                android:layout_width="22sp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:src="@drawable/trevo" />
        </LinearLayout>


        <TextView
            android:id="@+id/tituloModalidadeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/futura_std_bold"
            android:textColor="@color/branco"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/topo2ModalidadeResultadoLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="111dp"
        android:background="@color/megasenaescuro"
        android:orientation="vertical">

        <TextView
            style="@style/ArialMT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="35dp"
            android:text="@string/label_pode_comemorar"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/label_voce_foi_premiado"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="20.1sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dadosModalidadeLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:background="@color/cinza"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="40dp"
                    android:text="@string/label_abertura_aposta"
                    android:textAlignment="textStart"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aberturaApostaResultadoTextView"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAlignment="textStart"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp"
                    tools:text="nº 1456" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="40dp"
                    android:text="@string/label_encerramento"
                    android:textAlignment="textEnd"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/encerramentoResultadoTextView"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="09/12"
                    android:textAlignment="textEnd"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp" />


            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_proximo_sorteio"
                    android:textAlignment="textStart"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/proximoSorteioTextView"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:textAlignment="textStart"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_limite_diario"
                    android:textAlignment="textEnd"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/limiteDiarioResultadoTextView"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    tools:text="11/04 | 15h50"
                    android:textAlignment="textEnd"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/premioGanhoLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/drawer_linha_divisao_bg"
        android:orientation="vertical">

        <TextView
            style="@style/ArialMT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/label_premio"
            android:textAlignment="center"
            android:textColor="@color/cinza"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/premioResultadoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textAlignment="center"
            android:textColor="@color/verdeazul"
            android:textSize="20.1sp"
            android:textStyle="bold"
            tools:text="R$ 999.999.999,99" />

        <LinearLayout
            android:id="@+id/listaFaixaPremiacaoLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            android:layout_marginStart="19dp"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cabecalhoListaFaixaPremiacaoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="1">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_weight="0.24"
                    android:text="@string/label_concurso"
                    android:textColor="@color/verdeazul"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.27"
                    android:text="@string/label_faixa_premiacao"
                    android:textColor="@color/verdeazul"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_weight="0.24"
                    android:text="@string/label_sorteio_case"
                    android:textColor="@color/verdeazul"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_weight="0.25"
                    android:text="@string/label_premiacao"
                    android:textColor="@color/verdeazul"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightRecyclerView
                android:id="@+id/listaFaixaPremiacaoExpandableHeightRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:clickable="false"
                android:nestedScrollingEnabled="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="29dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
