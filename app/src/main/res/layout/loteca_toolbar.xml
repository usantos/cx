<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lotecaToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cinza_corner"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/txtSuasApostas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/caixa_std_semi_bold"
        android:text="@string/label_suas_apostas"
        android:textColor="@color/cinza110"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <LinearLayout
        android:id="@+id/containerComoJogar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txtComoJogar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="Como jogar"
            android:textColor="@color/cinza110"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/imgInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_info"
            app:tint="@color/cinza110" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerQuantidades"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="4"
        android:clickable="false"
        android:focusable="true"
        android:padding="0dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        app:layout_constraintStart_toStartOf="@+id/txtSuasApostas"
        app:layout_constraintEnd_toEndOf="@+id/containerComoJogar"
        app:layout_constraintTop_toBottomOf="@+id/txtSuasApostas"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txtPartidas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="Partidas: 0 |"
            android:textColor="@color/cinza110"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtSimples"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="Simples: 0 |"
            android:textColor="@color/cinza110"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtDuplas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="Duplas: 0 |"
            android:textColor="@color/cinza110"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtTriplas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="Triplas: 0 "
            android:textColor="@color/cinza110"
            android:textSize="16sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>