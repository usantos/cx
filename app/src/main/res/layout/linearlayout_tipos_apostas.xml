<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    >
    <LinearLayout
        android:layout_width="156dp"
        android:layout_height="56dp"
        android:background="@color/verdesenatrevo"
        android:orientation="horizontal"
        android:id="@+id/LinearLayoutContentTiposAposta">
        <ImageView
            android:id="@+id/imageviewTrevoTipoAposta"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/trevo_duplasena"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="14dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="lotofácil"
            android:textSize="15sp"
            android:layout_marginLeft="12dp"
            android:layout_gravity="center"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:id="@+id/tituloTipoApostaTextView"
            android:textAlignment="center"/>

    </LinearLayout>

</LinearLayout>