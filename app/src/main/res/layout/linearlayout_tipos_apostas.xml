<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/LinearLayoutContentTiposAposta"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/verdesenatrevo"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageviewTrevoTipoAposta"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:src="@drawable/trevo_duplasena" />

        <TextView
            android:id="@+id/tituloTipoApostaTextView"
            style="@style/FuturaStdBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="11dp"
            android:textColor="@color/branco"
            android:textAlignment="center"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="dia de sorte" />

    </LinearLayout>

</LinearLayout>