<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.DadosPessoaisActivity"
    tools:showIn="@layout/activity_dados_pessoais"
    android:orientation="vertical"
    >
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="106dp"
        android:layout_marginHorizontal="10dp"
        android:id="@+id/scrollViewDadosPessoais">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editTextCpf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/textViewTituloCadastrar3"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="40dp" >

                <com.github.pinball83.maskededittext.MaskedEditText
                    android:id="@+id/editTextCpfContent"
                    android:ems="10"
                    android:hint="@string/title_cpf"
                    style="@style/editTextRegisterThemeCaixa"
                    android:inputType="number"
                    app:mask="***.***.***-**"
                    app:notMaskedSymbol="*"
                    android:enabled="false"
                    android:alpha="0.3"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editTextNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextCpf"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextNomeContent"
                    android:ems="10"
                    android:hint="@string/label_nome"
                    style="@style/editTextRegisterThemeCaixa"
                    android:inputType="textPersonName"
                    android:enabled="false"
                    android:alpha="0.3"/>
            </com.google.android.material.textfield.TextInputLayout>


            <br.gov.caixa.loterias.apostas.utils.segmentedbutton.SegmentedButtonGroup
                android:id="@+id/segmentedButtonSexo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_below="@id/editTextNome"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp"
                android:elevation="2dp"
                app:sb_textStyle="bold"
                app:sbg_animateSelector="fastOutSlowIn"
                app:sbg_animateSelectorDuration="1000"
                app:sbg_backgroundColor="@color/cinzaclaro"
                app:sbg_position="0"
                app:sbg_ripple="true"
                app:sbg_selectorColor="@color/verdeazul">

                <br.gov.caixa.loterias.apostas.utils.segmentedbutton.SegmentedButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    app:sb_text="Masculino"
                    app:sb_textColor="@color/verdeazul"
                    android:textAlignment="center"
                    app:sb_textColor_onSelection="@color/branco"
                    app:sb_textStyle="bold"
                    app:sb_textGravity="center"
                    android:layout_gravity="center_vertical"
                    tools:ignore="RtlCompat" />

                <br.gov.caixa.loterias.apostas.utils.segmentedbutton.SegmentedButton
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:textSize="16sp"
                    app:sb_text="Feminino"
                    app:sb_textColor="@color/verdeazul"
                    app:sb_textColor_onSelection="@color/branco"
                    app:sb_textStyle="bold" />

            </br.gov.caixa.loterias.apostas.utils.segmentedbutton.SegmentedButtonGroup>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editTextCEP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/segmentedButtonSexo"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <com.github.pinball83.maskededittext.MaskedEditText
                    android:id="@+id/editTextCepContent"
                    style="@style/editTextRegisterThemeCaixa"
                    android:ems="10"
                    android:hint="@string/label_cep"
                    android:inputType="number"
                    app:mask="*****-***"
                    app:notMaskedSymbol="*" />
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editTextUF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextCEP"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextUFContent"
                    android:drawableRight="@drawable/combo"
                    style="@style/editTextRegisterThemeCaixa"
                    android:ems="10"
                    android:focusableInTouchMode="false"
                    android:hint="@string/title_uf"
                    android:inputType="textPersonName"/>
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editTextMunicipio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextUF"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp">

                <EditText
                    android:id="@+id/editTextMunicipioContent"
                    android:drawableRight="@drawable/combo"
                    style="@style/editTextRegisterThemeCaixa"
                    android:ems="10"
                    android:focusableInTouchMode="false"
                    android:hint="@string/label_municipio"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/editTextMunicipio"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp">

                <EditText
                    android:id="@+id/editTextEmailContent"
                    style="@style/editTextRegisterThemeCaixa"
                    android:ems="10"
                    android:hint="@string/label_email"
                    android:inputType="textEmailAddress"
                    android:enabled="false"
                    android:alpha="0.3"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/seekbar_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/seekbar_titulo"
                android:layout_below="@id/editTextEmailContent"
                android:textSize="15.7sp"
                android:fontFamily="@font/caixa_std_bold"
                />

            <TextView
                android:id="@+id/seekbar_valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/seekbar_titulo"
                android:layout_marginLeft="120dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="15.7sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="fill_parent"
                android:layout_height="29dp"
                android:layout_below="@id/seekbar_valor"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />
            <TableLayout
                android:id="@+id/tableLayout1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TableRow
                    android:id="@+id/tablerow1"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/seekbar_valor_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/seekBar"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/seekbar_val_min"
                        android:fontFamily="@font/caixa_std_regular"
                        android:textSize="15.7sp" />

                    <TextView
                        android:id="@+id/seekbar_valor_max"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/seekBar"
                        android:layout_marginLeft="120dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/seekbar_val_max"
                        android:fontFamily="@font/caixa_std_regular"
                        android:textSize="15.7sp" />
                </TableRow>
            </TableLayout>
            <Button
                android:id="@+id/updateDadosPessoaisLimiteButton"
                android:layout_below="@id/seekBar"
                android:layout_width="184dp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="98dp"
                android:layout_height="84dp"
                android:layout_centerHorizontal="true"
                android:background="@color/verdeazul"
                android:text="@string/dados_limite_compra"
                android:fontFamily="@font/caixa_std_regular"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="15.7sp"
                android:layout_marginBottom="30dp"/>

        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="106dp"
        android:id="@+id/atualizarRelativeLayout"
        app:layout_constraintTop_toBottomOf="@+id/scrollViewDadosPessoais"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_alignParentBottom="true"
            android:background="@color/cinzamercadopago">

        </View>

        <Button
            android:id="@+id/updateDadosPesoaisButton"
            android:layout_width="184dp"
            android:layout_height="84dp"
            android:layout_marginLeft="108dp"
            android:background="@color/verdeazul"
            android:fontFamily="@font/caixa_std_bold"
            android:text="@string/atualizar"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="17.7sp" />
    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
