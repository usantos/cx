<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/id_numero_jogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Jogo 1"
        android:layout_margin="16dp"
        android:fontFamily="@font/caixa_std_bold"
        android:textColor="@color/mega_verde_escuro_mkp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/id_lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/item_dezena_detalhe"
        tools:spanCount="6"
        app:layout_constraintTop_toBottomOf="@id/id_numero_jogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/mes_sorte_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:visibility="gone"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/id_lista"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/mes_sorte_valor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/mes_sorte_label"
        app:layout_constraintStart_toEndOf="@id/mes_sorte_label"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/id_trevos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/mes_sorte_valor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>