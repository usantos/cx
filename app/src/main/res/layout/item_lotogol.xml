<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/item_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/time"
        android:layout_centerHorizontal="true"/>

    <TextView
        android:id="@+id/item_title"
        style="@style/editTextArialMTTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/item_image"
        android:textAlignment="center"
        android:textSize="14.2sp"
        tools:text="Time/Pais"
        android:layout_centerHorizontal="true"/>

    <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
        android:id="@+id/gridViewPlacarTresColunas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/item_title"
        android:layout_marginTop="19dp"
        android:isScrollContainer="false"
        android:numColumns="3"
        android:verticalSpacing="5dp" />

    <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
        android:id="@+id/gridViewPlacarDuasColunas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/gridViewPlacarTresColunas"
        android:layout_marginTop="5dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:isScrollContainer="false"
        android:numColumns="2"
        android:verticalSpacing="5dp" />


</RelativeLayout>