<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shakeTutorialRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/shake_tutorial_background" android:paddingTop="12dp">
    <TextView android:id="@+id/shakeTutorialTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingHorizontal="32dp" android:minHeight="64dp"
        android:fontFamily="@font/caixa_std_regular" android:textSize="20sp" android:textColor="@color/cinza110"
        android:accessibilityHeading="true" />
    <FrameLayout android:id="@+id/shakeTutorialNavigation" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/shakeTutorialImage" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginHorizontal="48dp" android:layout_marginVertical="8dp" android:scaleType="fitCenter" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/shakeTutorialPrevious"
            android:layout_width="48dp" android:layout_height="64dp" android:layout_gravity="start|center_vertical"
            android:paddingHorizontal="20dp" android:paddingVertical="25dp" android:scaleType="fitCenter"
            android:src="@drawable/shake_tutorial_chevron_left" android:background="@drawable/shake_tutorial_arrow"
            android:backgroundTint="@null" android:elevation="2dp"
            android:contentDescription="@string/shake_tutorial_anterior" />
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/shakeTutorialNext"
            android:layout_width="48dp" android:layout_height="64dp" android:layout_gravity="end|center_vertical"
            android:paddingHorizontal="20dp" android:paddingVertical="25dp" android:scaleType="fitCenter"
            android:src="@drawable/shake_tutorial_chevron_right" android:background="@drawable/shake_tutorial_arrow"
            android:backgroundTint="@null" android:elevation="2dp"
            android:contentDescription="@string/shake_tutorial_proximo" />
    </FrameLayout>
    <LinearLayout android:id="@+id/shakeTutorialDots" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center" />
    <Button android:id="@+id/shakeTutorialSkip" style="?android:attr/buttonBarButtonStyle"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="12dp"
        android:fontFamily="@font/caixa_std_semi_bold" android:textSize="16sp" android:textColor="@color/cinza110" android:textAllCaps="false" />
</LinearLayout>
