<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparente"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.fragment.JogoResponsavelCardsFragment">

    <com.yarolegovich.discretescrollview.DiscreteScrollView
        android:id="@+id/sv_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="5dp"
        android:clipToPadding="false"
        app:dsv_orientation="horizontal" />

    <me.relex.circleindicator.CircleIndicator2
        android:id="@+id/ci_jr"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:ci_drawable="@drawable/jr_circle_selected"
        app:ci_drawable_unselected="@drawable/jr_circle_unselected"
        app:layout_constraintTop_toBottomOf="@id/sv_cards" />

</androidx.constraintlayout.widget.ConstraintLayout>