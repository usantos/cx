<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostar.view.JogosConfirmadosPremioMercadoPagoActivity"
    tools:showIn="@layout/activity_jogos_confirmados_premio_mercado_pago"
    >
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <ImageView
            android:layout_width="177dp"
            android:layout_height="46dp"
            android:src="@drawable/mercadopago"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"/>
            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="vertical"
            android:background="@color/azulfavoritas"
            android:layout_marginTop="40dp"
                android:id="@+id/contentTopoConfirmarLinearLayout"
                android:visibility="visible"
                >
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prêmio"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:fontFamily="@font/arialmt"
                android:textAlignment="center"
                android:layout_marginTop="20dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="R$ 00,00"
                android:id="@+id/valorPremioTextView"
                android:textAlignment="center"
                android:layout_marginTop="5dp"
                android:textColor="@color/branco"
                android:fontFamily="@font/futura_std_bold"
                android:textSize="21sp"
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:background="@color/verdemusgo"
                android:layout_marginTop="40dp"
                android:id="@+id/contentTopoConfirmadoLinearLayout"
                android:visibility="gone"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excelente"
                    android:textColor="@color/branco"
                    android:textSize="20sp"
                    android:fontFamily="@font/futura_std_bold"
                    android:textAlignment="center"
                    android:layout_marginTop="29dp"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="252dp"
                android:orientation="vertical"
                android:id="@+id/contentConfirmarLinearLayout"
                android:visibility="visible">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Para receber seu prêmio,\npor favor confirme seu email:"
                        android:textSize="14.2dp"
                        android:textColor="@color/cinza"
                        android:fontFamily="@font/arialmt"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="40dp"/>
                <android.support.design.widget.TextInputLayout
                    android:id="@+id/ayout_emailPremioMercadoPagoEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="40dp">

                    <EditText
                        android:id="@+id/emailPremioMercadoPagoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="E-mail"
                        android:textSize="16sp"
                        android:textColorHint="@color/azulFormNovoTipoPagamento"
                        android:textColor="@color/cinza"
                        />

                </android.support.design.widget.TextInputLayout>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="252dp"
                android:orientation="vertical"
                android:id="@+id/contentConfirmadoLinearLayout"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Em breve seu prêmio estará disponível em sua conta no mercado pago"
                    android:textAlignment="center"
                    android:textSize="14dp"
                    android:textColor="@color/cinza"
                    android:fontFamily="@font/arialmt"
                    android:layout_marginLeft="16dp"
                    android:id="@+id/textoTituloPremioConfirmado"
                    android:layout_marginTop="40dp"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="10dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:textSize="14dp"
                    android:textColor="@color/cinza"
                    android:fontFamily="@font/arialmt"
                    android:layout_marginHorizontal="10dp"
                    android:text="Um email foi enviado para dmalva@monumenta.com.br com todas as informações e passo-a-passo para o recebimento de seu prêmio"
                    android:layout_marginTop="19dp"
                    android:id="@+id/textoPremioConfirmado"
                    />



            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="106dp">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@color/cinzamercadopago"
                    android:layout_alignParentBottom="true">

                </View>
                <Button
                    android:layout_width="184dp"
                    android:layout_height="84dp"
                    android:textAllCaps="false"
                    android:text="Resgatar"
                    android:background="@color/verdeazul"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/futura_std_bold"
                    android:textSize="17.7sp"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/resgatarPremioButton"
                    android:visibility="visible"/>
                <Button
                    android:layout_width="184dp"
                    android:layout_height="84dp"
                    android:textAllCaps="false"
                    android:text="Voltar"
                    android:background="@color/verdeazul"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/futura_std_bold"
                    android:textSize="17.7sp"
                    android:layout_centerHorizontal="true"
                    android:id="@+id/voltarPremioButton"
                    android:visibility="gone"/>
            </RelativeLayout>
            
        </LinearLayout>

    </ScrollView>

</android.support.constraint.ConstraintLayout>
