<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostar.interno.controllers.JogosConfirmadosPremioMercadoPagoActivity"
    tools:showIn="@layout/activity_jogos_confirmados_premio_mercado_pago">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <ImageView
                android:layout_width="177dp"
                android:layout_height="46dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:src="@drawable/mercadopago" />

            <LinearLayout
                android:id="@+id/contentTopoConfirmarLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="40dp"
                android:background="@color/azulfavoritas"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/arialmt"
                    android:text="@string/label_premio"
                    android:textAlignment="center"
                    android:textColor="@color/cinza"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/valorPremioTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/futura_std_bold"
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="21sp"
                    tools:text="R$ 00,00" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentTopoConfirmadoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="40dp"
                android:background="@color/verdemusgo"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="29dp"
                    android:fontFamily="@font/futura_std_bold"
                    android:text="@string/excelente"
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentConfirmarLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="252dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="40dp"
                    android:fontFamily="@font/arialmt"
                    android:text="@string/confirmar_email"
                    android:textColor="@color/cinza"
                    android:textSize="14.2dp" />

                <android.support.design.widget.TextInputLayout
                    android:id="@+id/ayout_emailPremioMercadoPagoEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="40dp">

                    <EditText
                        android:id="@+id/emailPremioMercadoPagoEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="E-mail"
                        android:textColor="@color/cinza"
                        android:textColorHint="@color/azulFormNovoTipoPagamento"
                        android:textSize="16sp" />

                </android.support.design.widget.TextInputLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentConfirmadoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="252dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textoTituloPremioConfirmado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="40dp"
                    android:fontFamily="@font/arialmt"
                    android:text="@string/premio_disponivel"
                    android:textAlignment="center"
                    android:textColor="@color/cinza"
                    android:textSize="14dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoPremioConfirmado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="19dp"
                    android:fontFamily="@font/arialmt"
                    android:textAlignment="center"
                    android:textColor="@color/cinza"
                    android:textSize="14dp"
                    tools:text="Um email foi enviado para dmalva@monumenta.com.br com todas as informações e passo-a-passo para o recebimento de seu prêmio" />

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="106dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_alignParentBottom="true"
                    android:background="@color/cinzamercadopago">

                </View>

                <Button
                    android:id="@+id/resgatarPremioButton"
                    android:layout_width="184dp"
                    android:layout_height="84dp"
                    android:layout_centerHorizontal="true"
                    android:background="@color/verdeazul"
                    android:fontFamily="@font/futura_std_bold"
                    android:text="@string/resgatar"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="17.7sp"
                    android:visibility="visible" />

                <Button
                    android:id="@+id/voltarPremioButton"
                    android:layout_width="184dp"
                    android:layout_height="84dp"
                    android:layout_centerHorizontal="true"
                    android:background="@color/verdeazul"
                    android:fontFamily="@font/futura_std_bold"
                    android:text="@string/title_voltar"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="17.7sp"
                    android:visibility="gone" />
            </RelativeLayout>

        </LinearLayout>

    </ScrollView>

</android.support.constraint.ConstraintLayout>
