 <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.gov.caixa.loterias.apostar.interno.view.fragment.Introducao1Fragment">

    <!-- TODO: Update blank fragment layout -->

    <ImageView
        android:id="@+id/imageViewLogoLoterias"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="18dp"
        android:layout_gravity="center_horizontal"
        app:srcCompat="@drawable/logo"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true" />

    <ImageView
        android:id="@+id/imageViewTelefone"
        android:layout_width="161dp"
        android:layout_height="70dp"
        app:srcCompat="@drawable/ilustra_mobile"
        android:layout_marginTop="45dp"
        android:layout_below="@+id/imageViewLogoLoterias"
        android:layout_centerHorizontal="true" />

     <TextView
         android:id="@+id/textView1Fragment1"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:layout_gravity="center_horizontal"
         android:layout_marginTop="19dp"
         android:text="Uma nova experiência"
         android:textColor="@color/branco"
         android:textSize="18sp"
         android:layout_below="@+id/imageViewTelefone"
         android:layout_centerHorizontal="true" />

    <TextView
        android:id="@+id/textView2Fragment1"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textView1Fragment1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="Todas as apostas na palma da sua mão, o dia inteiro, todos os dias. :)"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="@color/branco"/>

     <Button
         android:id="@+id/buttonPularIntroducao"
         style="@style/Widget.AppCompat.Button"
         android:layout_width="130dp"
         android:layout_height="wrap_content"
         android:layout_alignParentBottom="true"
         android:layout_alignParentEnd="true"
         android:layout_alignParentRight="true"
         android:background="@android:color/transparent"
         android:text="Pular introdução"
         android:textAllCaps="false"
         android:textColor="@color/branco"
         android:fontFamily="@font/arialmt"
         android:textSize="12sp"/>
 </RelativeLayout>
