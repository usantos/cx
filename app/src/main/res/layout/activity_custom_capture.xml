<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:zxing_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:orientation="vertical"
    tools:context="caixa.gov.br.loterias.view.CustomCaptureActivity">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/decoratedBarcodeView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        zxing_view:zxing_scanner_layout="@layout/custom_barcode_scanner"
        app:zxing_preview_scaling_strategy="centerCrop"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutCabecalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="68dp"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logoLoteriasCinza"
                    android:layout_width="22dp"
                    android:layout_height="23dp"
                    android:src="@drawable/logo_cinza" />

                <TextView
                    android:id="@+id/textResultado"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:text="@string/title_activity_resultado_ler_bilhetes"
                    android:textColor="@color/branco"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutFechar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageFechar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/btn_fechar" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/labelPosicione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="68dp"
            android:layout_marginTop="19dp"
            android:text="@string/label_posicione_ler_bilhetes"
            android:textColor="@color/branco"
            android:textSize="14.2sp" />
    </LinearLayout>

    <Button
        android:id="@+id/buttomDigitarAposta"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="68dp"
        android:layout_centerInParent="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="26dp"
        android:textSize="14.2sp"
        android:textAllCaps="false"
        android:background="@drawable/button_border_amarelo_queimado"
        android:textColor="@color/amareloQueimado" />
</RelativeLayout>
