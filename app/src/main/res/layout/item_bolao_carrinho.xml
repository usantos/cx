<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:fontFamily="@font/caixa_std_bold"
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#7B1FA2"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@id/btnExcluir"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="lotofácil da independência" />

    <ImageView
        android:src="@drawable/trash"
        android:id="@+id/btnExcluir"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintTop_toTopOf="@id/tvTitulo"
        app:layout_constraintBottom_toBottomOf="@id/tvTitulo"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:textColor="@color/greyText"
        android:fontFamily="@font/caixa_std_regular"
        android:id="@+id/tvDescricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        tools:text="Reservada - cota nº 24 de 100"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvConcurso"/>

    <TextView
        android:textColor="@color/greyText"
        android:fontFamily="@font/caixa_std_regular"
        android:id="@+id/tvConcurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Conc. 3780"
        app:layout_constraintBaseline_toBaselineOf="@id/tvDescricao"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:textColor="@color/greyText"
        android:fontFamily="@font/caixa_std_regular"
        android:id="@+id/tvValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/tvConcurso"
        app:layout_constraintTop_toBottomOf="@id/tvDescricao"
        tools:text="R$ 53,50" />

    <LinearLayout
        android:id="@+id/layoutExpira"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvValor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:textColor="@color/colorAccent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="Expira em"/>

        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/schedule"/>

        <TextView
            android:textColor="@color/colorAccent"
            android:id="@+id/tvTempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/caixa_std_bold"
            tools:text="04:58"/>
    </LinearLayout>

    <TextView
        android:layout_marginEnd="5dp"
        android:id="@+id/btnMaisDetalhes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="mais detalhes"
        android:textColor="@color/colorAccent"
        android:fontFamily="@font/caixa_std_bold"
        app:layout_constraintBottom_toBottomOf="@id/layoutExpira"
        app:layout_constraintEnd_toStartOf="@id/ic_arrow" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ic_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/chevron_right"
        android:tint="@color/colorAccent"
        app:layout_constraintBottom_toBottomOf="@+id/btnMaisDetalhes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnMaisDetalhes" />

    <View
        app:layout_constraintTop_toBottomOf="@id/btnMaisDetalhes"
        android:id="@+id/tracoViewDivisoriaResultado"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="13dp"
        android:background="@color/linhaDivisa" />

</androidx.constraintlayout.widget.ConstraintLayout>