<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    tools:context="br.gov.caixa.loterias.apostas.controllers.NovaFormaPagamentoActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/viewTabBar"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="250dp">

            <LinearLayout
                android:id="@+id/containerValidadeCartao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:baselineAligned="false"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerCodigoSeguranca">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/containerMesValidadeCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="1"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/editTextMesValidadeCartao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        app:layout_constraintTop_toTopOf="parent">

                        <EditText
                            android:id="@+id/editTextMesValidadeCartaooContent"
                            style="@style/editTextRegisterTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:hint="@string/title_mesDeValidade"
                            android:inputType="number"
                            android:maxLength="2"
                            android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                            android:textColorHint="@color/azulFormNovoTipoPagamento"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <Spinner
                        android:id="@+id/spin_meses"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/colorAccent"
                        android:dropDownWidth="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <RelativeLayout
                    android:id="@+id/containerAnoValidadeCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="1"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/editTextAnoValidadeCartao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true">

                        <EditText
                            android:id="@+id/editTextAnoValidadeCartaooContent"
                            style="@style/editTextRegisterTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/title_anoValidade"
                            android:inputType="number"
                            android:maxLength="4"
                            android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                            android:textColorHint="@color/azulFormNovoTipoPagamento"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </RelativeLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/containerNomeClienteCartao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/editTextNomeClienteCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true">

                    <EditText
                        android:id="@+id/editTextNomeClienteCartaoContent"
                        style="@style/editTextRegisterTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/title_nomeIgualAoCartao"
                        android:inputType="textPersonName"
                        android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                        android:textColorHint="@color/azulFormNovoTipoPagamento"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>


            </RelativeLayout>


            <!--<androidx.recyclerview.widget.RecyclerView-->
            <!--android:id="@+id/novaFormaPagamentoRecyclerView"-->
            <!--android:layout_width="0dp"-->
            <!--android:layout_height="56dp"-->
            <!--android:background="@color/cinzaclaro"-->
            <!--app:layout_constraintHorizontal_bias="1.0"-->
            <!--app:layout_constraintLeft_toLeftOf="parent"-->
            <!--app:layout_constraintRight_toRightOf="parent"-->
            <!--android:layout_marginTop="40dp"-->
            <!--app:layout_constraintTop_toBottomOf="@+id/textoInfoSelecioneFormaPagamento" />-->

            <RelativeLayout
                android:id="@+id/containerCodigoSeguranca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerNomeClienteCartao">

                <ImageView
                    android:id="@+id/imageViewCVV"
                    android:layout_width="37dp"
                    android:layout_height="26dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentRight="true"

                    android:layout_centerInParent="true"
                    app:srcCompat="@drawable/cartao_cvc" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/editTextCodigoSeguranca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true">

                    <EditText
                        android:id="@+id/editTextCodigoSegurancaContent"
                        style="@style/editTextRegisterTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="40dp"
                        android:hint="@string/title_cvv"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                        android:textColorHint="@color/azulFormNovoTipoPagamento"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/containerNumeroCartao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textoInfoSelecioneFormaPagamento">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/editTextNumeroCartao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true">

                    <EditText
                        android:id="@+id/editTextNumeroCartaoContent"
                        style="@style/editTextRegisterTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:hint="@string/title_numCartao"
                        android:inputType="number"
                        android:textColor="@color/cinza"
                        android:textColorHint="@color/azulFormNovoTipoPagamento"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </RelativeLayout>


            <TextView
                android:id="@+id/textoInfoSelecioneFormaPagamento"
                style="@style/editTextArialMTTheme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="19dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/novaFormaPagamentoNenhumCartaoCadastrado"
                android:textColor="@color/cinza"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textoFormaPagamentoTitulo" />


            <TextView
                android:id="@+id/textoFormaPagamentoTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/novaFormaPagamentoTitulo"
                android:textColor="@color/colorAccent"
                android:textSize="14.2sp"
                android:textStyle="bold"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewTabBar"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_marginTop="42dp"
        android:background="@color/azulclaro"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1.0"/>
    <Button
        android:id="@+id/botaoAvancarPagamento"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginBottom="84dp"
        android:background="@color/verdeazul"
        android:text="@string/apostarAutorizarCobranca"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/viewTabBar" />

    <LinearLayout
        android:id="@+id/containerComboSalvar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@color/cinzaclaro"
        app:layout_constraintBottom_toTopOf="@+id/relativeLayoutValorTotal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <CheckBox
            android:id="@+id/checkBoxSalvarCartao"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/check_box_selected"
            android:button="@color/transparente50"
            android:checked="false"
            android:textColor="@color/pretoLinhaFormNovoTipoPagamento" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="30dp"
            android:orientation="vertical">

            <TextView
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_salvarCartao"
                android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>


    <RelativeLayout
        android:id="@+id/relativeLayoutValorTotal"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="5dp"
        android:background="@color/colorAccent"
        app:layout_constraintBottom_toTopOf="@id/botaoAvancarPagamento"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/textoTotal"
            style="@style/editTextArialMTTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="9dp"
            android:layout_marginRight="9dp"
            android:layout_toStartOf="@+id/valorTotalCarrinho"
            android:layout_toLeftOf="@+id/valorTotalCarrinho"
            android:text="@string/total"
            android:textColor="@color/branco"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/valorTotalCarrinho"
            style="@style/editTextArialMTTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="36dp"
            android:layout_marginRight="36dp"
            android:textColor="@color/branco"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="R$ 00,00" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/id_fg_somador_carrinho"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>