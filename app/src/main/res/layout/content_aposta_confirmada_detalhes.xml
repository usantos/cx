<?xml version="1.0" encoding="utf-8"?>
<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary" />


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/linearLayoutBottom"
            >

            <View
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_gravity="bottom"
                android:layout_marginTop="115dp"
                android:background="@color/cinzaApostaConfirmada" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/informacaoApostaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:id="@+id/validadePremioImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/activity_horizontal_margin"
                        android:layout_marginTop="24dp"
                        android:alpha="0.6"
                        android:src="@drawable/ic_validade" />

                    <TextView
                        android:id="@+id/validadePremioLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignStart="@+id/validadePremioText"
                        android:layout_alignTop="@+id/validadePremioImage"
                        android:fontFamily="@font/arialmt"
                        android:text="@string/label_validade_premio"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/validadePremioText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/validadePremioLabel"
                        android:layout_marginStart="20dp"
                        android:layout_toEndOf="@+id/validadePremioImage"
                        android:fontFamily="@font/arialmt"
                        android:text="@string/label_noventa_dias"
                        android:textSize="14sp" />

                    <View
                        android:id="@+id/linhaSeparadora"
                        android:layout_width="wrap_content"
                        android:layout_height="1dp"
                        android:layout_below="@+id/validadePremioImage"
                        android:layout_marginStart="@dimen/activity_horizontal_margin"
                        android:layout_marginTop="37dp"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:background="?android:textColor" />

                    <RelativeLayout
                        android:id="@+id/comprovanteLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/linhaSeparadora"
                        android:visibility="visible">

                        <ImageView
                            android:id="@+id/comprovanteImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/activity_horizontal_margin"
                            android:layout_marginTop="30dp"
                            android:alpha="0.6"
                            android:src="@drawable/ic_codigo" />

                        <TextView
                            android:id="@+id/comprovanteText"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignTop="@+id/comprovanteImage"
                            android:layout_alignBottom="@+id/comprovanteImage"
                            android:layout_marginStart="20dp"
                            android:layout_toEndOf="@+id/comprovanteImage"
                            android:fontFamily="@font/arialmt"
                            android:gravity="center_vertical"
                            android:textSize="10sp"
                            tools:text="62915279BA15976C9D3AE723D22222222222" />

                        <ImageView
                            android:id="@+id/comprovanteImpressaoImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignBottom="@+id/comprovanteImage"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="@dimen/activity_horizontal_margin"
                            android:layout_marginEnd="15dp"
                            android:alpha="0.4"
                            android:src="@drawable/ic_icon_imprime_branco" />
                    </RelativeLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/activity_horizontal_margin"
                    android:paddingEnd="@dimen/activity_horizontal_margin"
                    android:paddingBottom="@dimen/activity_vertical_margin">


                    <RelativeLayout
                        android:id="@+id/editarApostaBtn"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginEnd="10dp">

                        <ImageView
                            android:id="@+id/editarImg"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_centerHorizontal="true"
                            android:adjustViewBounds="true"
                            android:src="@drawable/icon_editar_aposta" />

                        <TextView
                            android:id="@+id/editarTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/editarImg"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="@string/label_editar_aposta"
                            android:textColor="@color/textColorToolbar"
                            android:textSize="12sp" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <RelativeLayout
                            android:id="@+id/favoritadoLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignBottom="@+id/favoriteBtn"
                            android:background="@color/verdeazul"
                            android:gravity="center"
                            android:paddingTop="@dimen/activity_vertical_margin"
                            android:paddingBottom="@dimen/activity_vertical_margin"
                            android:visibility="invisible">

                            <ImageView
                                android:id="@+id/favoritadoImg"
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:layout_marginEnd="10dp"
                                android:src="@drawable/icon_favoritado" />

                            <TextView
                                android:id="@+id/labelApostaSalvaTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignBottom="@+id/favoritadoImg"
                                android:layout_toEndOf="@id/favoritadoImg"
                                android:text="@string/label_aposta_salva_carinha"
                                android:textColor="@color/branco"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/favoriteBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentTop="true"
                            android:background="@color/cinza"
                            android:drawableStart="@drawable/icon_favoritar"
                            android:drawablePadding="10dp"
                            android:gravity="center"
                            android:minHeight="56dp"
                            android:padding="15dp"
                            android:visibility="visible">

                            <RelativeLayout
                                android:id="@+id/layoutTextoSalveAposta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:visibility="visible">

                                <ImageView
                                    android:id="@+id/favoritarImg"
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:layout_marginEnd="10dp"
                                    android:src="@drawable/icon_favoritar" />

                                <TextView
                                    android:id="@+id/labelSalveApostaTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/favoritarImg"
                                    android:text="@string/label_salve_aposta"
                                    android:textColor="@color/branco"
                                    android:textSize="14sp" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:id="@+id/layoutnomeApostaLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/layoutTextoSalveAposta"
                                android:layout_marginTop="20dp"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/labelDeNomeTxt"
                                    style="@style/ArialMT"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/label_de_nome"
                                    android:textColor="@color/verdeazul"
                                    android:textSize="12sp" />

                                <EditText
                                    android:id="@+id/nomeApostaEditTxt"
                                    style="@style/ArialMT"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@+id/labelDeNomeTxt"
                                    android:layout_alignStart="@+id/labelDeNomeTxt"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginEnd="@dimen/activity_vertical_margin"
                                    android:backgroundTint="@color/branco"
                                    android:textColor="@color/branco"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:id="@+id/salvarApostaImg"
                                    android:layout_width="@dimen/image_size_small"
                                    android:layout_height="@dimen/image_size_small"
                                    android:layout_alignTop="@+id/nomeApostaEditTxt"
                                    android:layout_alignBottom="@+id/nomeApostaEditTxt"
                                    android:layout_alignParentEnd="true"
                                    android:src="@drawable/seta_verde" />
                            </RelativeLayout>

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/adicionarCarrinhoBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/favoriteBtn"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="40dp"
                            android:background="@color/cinza"
                            android:gravity="center"
                            android:minHeight="84dp"
                            android:padding="15dp">

                            <TextView
                                android:id="@+id/adicionarTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:text="@string/label_adicionar"
                                android:textColor="@color/branco"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/adicionarTxt"
                                android:layout_centerHorizontal="true"
                                android:gravity="center"
                                android:text="@string/label_adicionar_carrinho_apostas"
                                android:textColor="@color/branco"
                                android:textSize="14sp" />

                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/carrinhoApostasBtn"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="10dp">

                        <ImageView
                            android:id="@+id/carrinhoImg"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_centerHorizontal="true"
                            android:src="@drawable/icon_carrinho" />

                        <TextView
                            android:id="@+id/carrinhoTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/carrinhoImg"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="5dp"
                            android:gravity="center"
                            android:text="@string/label_carrinho_apostas"
                            android:textColor="@color/textColorToolbar"
                            android:textSize="12sp" />

                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</android.support.v4.widget.NestedScrollView>