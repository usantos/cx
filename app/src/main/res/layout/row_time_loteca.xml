<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_time_loteca"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="17dp"
    android:gravity="center"
    android:orientation="vertical">

    <br.gov.caixa.loterias.apostar.view.custom.ItemEquipeView_
        android:id="@+id/loteca_time_um"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:outlineProvider="none" />

    <br.gov.caixa.loterias.apostar.view.custom.ItemEquipeView_
        android:id="@+id/loteca_empate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="109dp"
        android:layout_alignTop="@+id/loteca_time_um"
        android:layout_alignBottom="@+id/loteca_time_um"
        android:outlineProvider="none" />

    <br.gov.caixa.loterias.apostar.view.custom.ItemEquipeView_
        android:id="@+id/loteca_time_dois"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginStart="218dp"
        android:layout_alignTop="@+id/loteca_time_um"
        android:layout_alignBottom="@+id/loteca_time_um"
        android:outlineProvider="none" />
</RelativeLayout>