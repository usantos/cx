<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/simulaToolbar"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="#EEEEEE"
    android:paddingHorizontal="16dp">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchSurpresinha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:showText="false"
        android:text=""
        android:thumb="@drawable/surpresinha_thumb"
        android:track="@drawable/surpresinha_track"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/caixa_std_regular"
        android:text="Surpresinha"
        android:textColor="@color/cinza110"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@id/switchSurpresinha"
        app:layout_constraintTop_toTopOf="@id/switchSurpresinha"
        app:layout_constraintBottom_toBottomOf="@id/switchSurpresinha" />

    <TextView
        android:id="@+id/txtComoJogar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/caixa_std_regular"
        android:text="Como jogar"
        android:textColor="@color/cinza110"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/imgInfo"
        app:layout_constraintTop_toTopOf="@id/txtTitulo"
        app:layout_constraintBottom_toBottomOf="@id/txtTitulo" />

    <ImageView
        android:id="@+id/imgInfo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_info"
        app:tint="@color/cinza110"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtComoJogar"
        app:layout_constraintBottom_toBottomOf="@id/txtComoJogar" />

</androidx.constraintlayout.widget.ConstraintLayout>