<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/branco">

    <RelativeLayout
        android:id="@+id/relativeLayoutTopo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/gradiente_titulo_caixa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tituloDialogCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="18dp"
            android:text="@string/titulo"
            android:textColor="@color/branco"
            android:textSize="15.8sp"
            android:fontFamily="@font/caixa_std_bold" />

    </RelativeLayout>

    <TextView
        android:id="@+id/subtituloDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/valores_para_apostas_com_2_trevos"
        android:layout_margin="16dp"
        android:fontFamily="@font/caixa_std_regular"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/relativeLayoutTopo"
        app:layout_constraintStart_toStartOf="parent"/>

    <ListView
        android:id="@+id/listaItensDialog"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:choiceMode="singleChoice"
        android:listSelector="@color/cinzaclaro"
        app:layout_constraintTop_toBottomOf="@id/subtituloDialog"
        app:layout_constraintStart_toStartOf="parent"
        />

    <RelativeLayout
        android:id="@+id/linhaDivisaoBotoes"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/listaItensDialog"
        android:background="@color/cinza2"
        app:layout_constraintTop_toBottomOf="@id/listaItensDialog"/>

    <Button
        android:id="@+id/dialogButtonCancelar"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:background="@color/branco"
        android:text="@string/cancelar"
        android:textAllCaps="false"
        android:textColor="@color/cinzaescuro"
        android:textSize="15.8sp"
        android:fontFamily="@font/caixa_std_bold"
        android:gravity="center_vertical"
        android:paddingLeft="15dp"
        app:layout_constraintTop_toBottomOf="@id/linhaDivisaoBotoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dialogButtonOK"/>

    <Button
        android:id="@+id/dialogButtonOK"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:background="@color/branco"
        android:text="@string/ok"
        android:textColor="@color/verdeazul"
        android:textSize="15.8sp"
        android:fontFamily="@font/caixa_std_bold"
        android:gravity="center_vertical|right"
        android:paddingRight="24dp"
        app:layout_constraintTop_toBottomOf="@id/linhaDivisaoBotoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dialogButtonCancelar"/>

</androidx.constraintlayout.widget.ConstraintLayout>