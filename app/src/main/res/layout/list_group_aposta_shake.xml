<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shakeMenuRow" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="55dp" android:gravity="center_vertical" android:paddingHorizontal="4dp">
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_celular"
        android:tint="@color/blue_caixa" android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:fontFamily="@font/caixa_std_semi_bold" android:text="@string/aposta_shake" android:textColor="@color/cinza110" android:textSize="14sp" />
    <ImageView android:id="@+id/shakeMenuInfo" android:layout_width="40dp" android:layout_height="48dp"
        android:src="@drawable/ic_info" android:padding="12dp" android:contentDescription="@string/shake_menu_info"
        android:clickable="true" android:focusable="true" />
    <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchApostaShake"
        android:layout_width="48dp" android:layout_height="48dp" android:checked="false"
        android:padding="0dp" android:gravity="center_vertical"
        android:thumb="@drawable/shake_switch_thumb"
        app:track="@drawable/shake_switch_track" app:thumbTint="@null" app:trackTint="@null"
        app:switchMinWidth="48dp" app:splitTrack="false" app:showText="false" app:useMaterialThemeColors="false"
        android:contentDescription="@string/aposta_shake" />
</LinearLayout>
