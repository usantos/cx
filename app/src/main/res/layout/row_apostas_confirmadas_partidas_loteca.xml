<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_row_apostas_partidas_loteca_list_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_linha_divisao_branco_vermelho_top"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:paddingTop="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageApostaPartidaLotecaUm"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="19dp"
            android:background="@drawable/select_unselect_circle_branco" />

        <TextView
            android:id="@+id/textApostaPartidaLotecaUm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="33dp"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageApostaPartidaLotecaEmpate"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="19dp"
            android:background="@drawable/select_unselect_circle_branco" />

        <TextView
            android:id="@+id/textApostaPartidaLotecaEmpate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="33dp"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageApostaPartidaLotecaDois"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="19dp"
            android:background="@drawable/select_unselect_circle_branco" />

        <TextView
            android:id="@+id/textApostaPartidaLotecaDois"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="33dp"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            android:textSize="12sp" />

    </LinearLayout>


</LinearLayout>