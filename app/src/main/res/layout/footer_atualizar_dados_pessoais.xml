<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/footerDadosPessoais"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    tools:context="br.gov.caixa.loterias.apostas.controllers.DadosPessoaisActivity"
    tools:showIn="@layout/activity_dados_pessoais"
    android:orientation="vertical">

    <View
        android:id="@+id/view_bottom"
        android:layout_width="wrap_content"
        android:layout_height="70dp"
        android:background="@color/cinzamercadopago"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/updateDadosPesoaisButton"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:background="@color/verdeazul"
        android:fontFamily="@font/caixa_std_bold"
        android:text="@string/atualizar"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="17.7sp"
        app:layout_constraintTop_toTopOf="@id/view_bottom"
        app:layout_constraintBottom_toTopOf="@id/view_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
