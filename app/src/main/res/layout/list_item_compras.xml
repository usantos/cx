<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topListItemComprasLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verdesenaclaro"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingVertical="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TipoPremioListaComprasTextView"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:fontFamily="@font/arialmt"
                android:text="Mega-sena"
                android:textColor="@color/branco"
                android:textSize="14.2sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/seusNumerosItemListaComprasTextView"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:fontFamily="@font/arialmt"
                android:text="Seus números"
                android:textColor="@color/branco"
                android:textSize="12.1sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="0.3"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dataConcursoListaComprasTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arialmt"
                    android:text="25/08/2016"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp" />

                <TextView
                    android:id="@+id/concursoListaComprasTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arialmt"
                    tools:text="Conc. 2587"
                    android:textColor="@color/branco"
                    android:textSize="14.2sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/itemComprasContentModalideLinearLayout"
                android:layout_width="0dip"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                android:orientation="vertical">
                <!--<TextView-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:textColor="@color/branco"-->
                <!--android:fontFamily="@font/arialmt"-->
                <!--android:textSize="14.2sp"-->
                <!--android:id="@+id/SeusNumerosListaComprasTextView"-->
                <!--android:text="01 - 02 - 03 - 04 - 05 - 06"/>-->

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomListItemComprasLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@color/verdesenatrevo"
        android:orientation="horizontal"
        android:paddingHorizontal="13dp">

        <TextView
            android:id="@+id/statusResultadoApostaListaComprasTextView"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/arialmt"
            android:text="Confirmada"
            android:textColor="@color/branco"
            android:textSize="14.2sp"

            />

        <Button
            android:id="@+id/VejaOsResultadosListaComprasButton"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/arialmt"
            android:text="Veja os resultados"
            android:textColor="@color/branco"
            android:textSize="14.2sp"
            android:textStyle="bold"
            android:visibility="invisible"/>
    </LinearLayout>
</LinearLayout>