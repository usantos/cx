<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <TextView
        android:id="@+id/label_jogo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Jogo 01"
        android:fontFamily="@font/caixa_std_regular"
        android:textSize="18sp"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <RadioButton
        android:id="@+id/check_equipe_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:checked="true"
        android:clickable="false"
        android:focusable="false"
        android:text=""
        android:buttonTint="@android:color/black"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/label_jogo"
        app:layout_constraintStart_toStartOf="parent"/>

    <RadioButton
        android:id="@+id/check_empate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:checked="false"
        android:clickable="false"
        android:focusable="false"
        android:text=""
        android:buttonTint="@android:color/black"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/check_equipe_1"
        app:layout_constraintStart_toStartOf="parent"/>

    <RadioButton
        android:id="@+id/check_equipe_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:checked="false"
        android:clickable="false"
        android:focusable="false"
        android:text=""
        android:buttonTint="@android:color/black"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/check_empate"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/nome_equipe_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="EQUIPE1/UF"
        android:fontFamily="@font/caixa_std_regular"
        android:textSize="16sp"
        android:layout_marginStart="0dp"
        app:layout_constraintTop_toTopOf="@id/check_equipe_1"
        app:layout_constraintBottom_toBottomOf="@id/check_equipe_1"
        app:layout_constraintStart_toEndOf="@id/check_equipe_1"/>

    <TextView
        android:id="@+id/nome_empate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="EMPATE"
        android:fontFamily="@font/caixa_std_regular"
        android:textSize="16sp"
        android:layout_marginStart="0dp"
        app:layout_constraintTop_toTopOf="@id/check_empate"
        app:layout_constraintBottom_toBottomOf="@id/check_empate"
        app:layout_constraintStart_toEndOf="@id/check_empate"/>

    <TextView
        android:id="@+id/nome_equipe_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="EQUIPE2/UF"
        android:fontFamily="@font/caixa_std_regular"
        android:textSize="16sp"
        android:layout_marginStart="0dp"
        app:layout_constraintTop_toTopOf="@id/check_equipe_2"
        app:layout_constraintBottom_toBottomOf="@id/check_equipe_2"
        app:layout_constraintStart_toEndOf="@id/check_equipe_2"/>

    <View
        android:id="@+id/v_linha_divisoria_loteca"
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/nome_equipe_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>