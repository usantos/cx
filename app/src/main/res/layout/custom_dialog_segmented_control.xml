<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_modal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/branco">

    <View
        android:id="@+id/vw_topo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/gradiente_titulo_caixa"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="17dp"
        android:textColor="@color/branco"
        android:textSize="15.8sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/vw_topo"
        app:layout_constraintTop_toTopOf="@+id/vw_topo"
        tools:text="Titulo" />

    <info.hoang8f.android.segmented.SegmentedGroup
        xmlns:segmentedgroup="http://schemas.android.com/apk/res-auto"
        android:id="@+id/sg_opcoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        segmentedgroup:sc_border_width="2dp"
        segmentedgroup:sc_corner_radius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vw_topo">

        <RadioButton
            android:id="@+id/rb_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="One"
            android:textColor="@color/branco"
            style="@style/RadioButton" />

        <RadioButton
            android:id="@+id/rb_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Two"
            style="@style/RadioButton" />

        <RadioButton
            android:id="@+id/rb_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="tree"
            style="@style/RadioButton" />

    </info.hoang8f.android.segmented.SegmentedGroup>

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cl_divisao"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/et_carrinho"
        android:background="@color/cinza2"
        app:layout_constraintTop_toBottomOf="@id/sg_opcoes" />

    <Button
        android:id="@+id/btn_cancelar"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:background="@color/branco"
        android:gravity="center"
        android:text="@string/cancelar"
        android:textAllCaps="false"
        android:textColor="@color/cinzaescuro"
        android:textSize="15.8sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_divisao" />

    <Button
        android:id="@+id/btn_ok"
        android:layout_width="100dp"
        android:layout_height="55dp"
        android:background="@color/branco"
        android:gravity="center"
        android:text="@string/title_salvar"
        android:textAllCaps="false"
        android:textColor="@color/verdeazul"
        android:textSize="15.8sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_divisao" />

</android.support.constraint.ConstraintLayout>