<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_resultado_concurso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Resultado do Concurso 1234"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tv_label_situacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/label_situacao"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_resultado_concurso"/>

        <TextView
            android:id="@+id/tv_situacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Não premiada"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toEndOf="@+id/tv_label_situacao"
            app:layout_constraintTop_toTopOf="@+id/tv_label_situacao"/>

        <ImageView
            android:id="@+id/iv_expand_collapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/combo2"
            app:tint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <View
            android:id="@+id/v_linha_accordion1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_situacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- LOTOFACIL e outras -->
        <TextView
            android:id="@+id/tv_label_numeros_sorteados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Números sorteados"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_super7_sorteados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            tools:itemCount="1"/>

        <TextView
            android:id="@+id/tv_label_numeros_primeiro_sorteio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1º Sorteio"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="0dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_numbers_sorteados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:itemCount="3"/>

        <!-- DUPKASENA -->
        <TextView
            android:id="@+id/tv_label_numeros_segundo_sorteio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2º Sorteio"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_numbers_sorteados2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            tools:itemCount="3"/>

        <!-- TIMEMANIA MESSORTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_label_time_mes_sorteado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time sorteado"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_regular" />

            <TextView
                android:id="@+id/tv_time_mes_sorteado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORINTHIAS/SP"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- LOTOFACIL e outras -->
        <TextView
            android:id="@+id/tv_label_seus_numeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seus números"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_super7_seus_numeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            tools:itemCount="1"/>

        <TextView
            android:id="@+id/tv_label_seus_numeros_primeiro_sorteio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1º Sorteio"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="0dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_seus_numeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:itemCount="3"/>

        <!-- DUPKASENA -->
        <TextView
            android:id="@+id/tv_label_seus_numeros_segundo_sorteio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2º Sorteio"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_seus_numeros2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            tools:itemCount="3"/>

        <!-- TIMEMANIA MESSORTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_label_seu_time_mes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time do Coração:"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_regular" />

            <TextView
                android:id="@+id/tv_seu_time_mes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLAMENGO/RJ"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/caixa_std_bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_premio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_label_premio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_premio_dois_pontos"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_regular" />

            <TextView
                android:id="@+id/tv_premio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 14,00"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/caixa_std_bold"
                android:layout_marginStart="4dp"/>
        </LinearLayout>


        <View
            android:id="@+id/v_linha_accordion2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/black"
            android:layout_marginTop="14dp" />

    </LinearLayout>
</LinearLayout>
