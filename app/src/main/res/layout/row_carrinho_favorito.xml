<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tols="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="20dp">

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cl_card_carrinho_favorito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_card"
        android:backgroundTint="@color/verde_card"
        android:minHeight="70dp"
        tols:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_nome_carrinho"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:autoSizeMaxTextSize="14dp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:lines="1"
            android:text="Carrinho Favorito"
            android:textColor="@color/branco"
            android:textSize="14dp"
            tols:layout_constraintBottom_toBottomOf="@id/gl_fim_card"
            tols:layout_constraintStart_toStartOf="parent"
            tols:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_valor_total_carrinho"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:autoSizeMaxTextSize="14dp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:lines="1"
            android:text="R$ 30,00"
            android:visibility="invisible"
            android:textColor="@color/branco"
            android:textSize="14dp"
            tols:layout_constraintBottom_toBottomOf="@id/gl_fim_card"
            tols:layout_constraintStart_toEndOf="@id/tv_nome_carrinho"
            tols:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/ib_excluir_carrinho"
            android:layout_width="40dp"
            android:layout_height="70dp"
            android:background="@color/transparente"
            android:src="@drawable/ic_x"
            android:padding="10dp"
            android:scaleType="fitCenter"
            tols:layout_constraintBottom_toBottomOf="@id/gl_fim_card"
            tols:layout_constraintEnd_toStartOf="@id/ib_lupa_detalhes"
            tols:layout_constraintStart_toEndOf="@id/tv_valor_total_carrinho"
            tols:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/ib_lupa_detalhes"
            android:layout_width="40dp"
            android:layout_height="70dp"
            android:background="@color/transparente"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:src="@drawable/ic_lupa_carrinho_fav"
            tols:layout_constraintBottom_toBottomOf="@id/gl_fim_card"
            tols:layout_constraintEnd_toStartOf="@id/ib_transformar_carrinho"
            tols:layout_constraintStart_toEndOf="@id/ib_excluir_carrinho"
            tols:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/ib_transformar_carrinho"
            android:layout_width="40dp"
            android:layout_height="70dp"
            android:background="@color/transparente"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/icon_carrinho"
            android:tint="@color/branco"
            tols:layout_constraintBottom_toBottomOf="@id/gl_fim_card"
            tols:layout_constraintEnd_toEndOf="parent"
            tols:layout_constraintTop_toTopOf="parent" />

        <android.support.constraint.Guideline
            android:id="@+id/gl_fim_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            tols:layout_constraintGuide_begin="70dp" />

        <LinearLayout
            android:id="@+id/ll_apostas_carrinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="10dp"
            android:visibility="gone"
            tols:layout_constraintTop_toBottomOf="@id/tv_nome_carrinho"/>

    </android.support.constraint.ConstraintLayout>

</android.support.constraint.ConstraintLayout>