<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostar.interno.view.RapidaoConfigActivity"
    tools:showIn="@layout/activity_rapidao_config"
    >

    <ScrollView
        android:id="@+id/scrollViewRapidaoConfig"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="91dp"
                android:background="@color/cinza"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tituloPrecoMinimo"
                        style="@style/editTextArialMTTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prêmio mínimo"
                        android:textColor="@color/branco"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <com.blackcat.currencyedittext.CurrencyEditText
                        android:id="@+id/tituloValorPremiumMinimum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_gravity="end"
                        android:layout_marginRight="5dp"
                        android:layout_toStartOf="@+id/limparPremioMinimoAposta"
                        android:layout_toLeftOf="@+id/limparPremioMinimoAposta"
                        android:background="@null"
                        android:text="R$ 00,00"
                        android:textColor="@color/verdeazul"
                        android:textSize="15.8sp" />

                    <Button
                        android:id="@+id/limparPremioMinimoAposta"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/close" />
                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seekBarPremiumMimimun"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:backgroundTint="@color/verdeazul"
                    android:thumb="@drawable/custom_thumb" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tituloValorMinimoPremiumMiminum"
                        style="@style/editTextArialMTTheme"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_zero"
                        android:textColor="@color/branco"
                        android:textSize="14.2sp" />

                    <TextView
                        android:id="@+id/tituloValorMaximoPremiumMiminum"
                        style="@style/editTextArialMTTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="5dp"
                        android:text="100 milhões"
                        android:textColor="@color/branco"
                        android:textSize="14.2sp" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="111dp"
                android:background="@color/linhaDivisa"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/editTextArialMTTheme"
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:text="Valor mínimo da aposta"
                        android:textColor="@color/cinza"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <com.blackcat.currencyedittext.CurrencyEditText
                        android:id="@+id/tituloValorValorMinimoAposta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_gravity="end"
                        android:layout_marginRight="5dp"
                        android:layout_toStartOf="@+id/limparValorMinimoAposta"
                        android:layout_toLeftOf="@+id/limparValorMinimoAposta"
                        android:background="@null"
                        android:inputType="number"
                        android:text="R$ 00,00"
                        android:textColor="@color/verdeazul"
                        android:textSize="15.8sp" />

                    <Button
                        android:id="@+id/limparValorMinimoAposta"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/close" />
                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seekBarValorMinimoAposta"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:backgroundTint="@color/verdeazul"
                    android:thumb="@drawable/custom_thumb" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tituloValorMinimoApostaValorMinimo"
                        style="@style/editTextArialMTTheme"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="1 real"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="14.2sp" />

                    <TextView
                        android:id="@+id/tituloValorMinimoApostaValorMaximo"
                        style="@style/editTextArialMTTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="5dp"
                        android:text="100 reais"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="14.2sp" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="111dp"
                android:background="@color/cinzaclaro"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/editTextArialMTTheme"
                        android:layout_width="155dp"
                        android:layout_height="wrap_content"
                        android:text="Valor máximo da aposta"
                        android:textColor="@color/cinza"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <com.blackcat.currencyedittext.CurrencyEditText
                        android:id="@+id/tituloValorValorMaximoAposta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_gravity="end"
                        android:layout_marginRight="5dp"
                        android:layout_toStartOf="@+id/limparValorMaximoAposta"
                        android:layout_toLeftOf="@+id/limparValorMaximoAposta"
                        android:background="@null"
                        android:inputType="number"
                        android:text="R$ 00,00"
                        android:textColor="@color/verdeazul"
                        android:textSize="15.8sp" />

                    <Button
                        android:id="@+id/limparValorMaximoAposta"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/close" />
                </RelativeLayout>

                <SeekBar
                    android:id="@+id/seekBarValorMaximoAposta"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:backgroundTint="@color/verdeazul"
                    android:thumb="@drawable/custom_thumb" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tituloValorMaximoApostaValorMinimo"
                        style="@style/editTextArialMTTheme"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="1 real"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="14.2sp" />

                    <TextView
                        android:id="@+id/tituloValorMaximoApostaValorMaximo"
                        style="@style/editTextArialMTTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="5dp"
                        android:text="100 reais"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="14.2sp" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                android:orientation="vertical"
                android:paddingVertical="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:text="Quais modalidades você quer no rapidão?"
                    android:textColor="@color/azulFormNovoTipoPagamento"
                    android:textSize="14.2sp"
                    android:textStyle="bold" />

                <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                    android:id="@+id/gridviewTiposApostasRapidao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="19dp"
                    android:layout_marginEnd="10dp"
                    android:focusable="false"
                    android:gravity="center"
                    android:horizontalSpacing="10dp"
                    android:isScrollContainer="false"
                    android:numColumns="2"
                    android:verticalSpacing="17dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cinzaclaro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Números obrigatórios"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAddRemoverNumsObrigatorios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_white_with_green_border"
                        android:text="Adicionar \nou remover"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/verdeagua" />

                </LinearLayout>

                <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                    android:id="@+id/gridviewNumerosObrigatoriosRapidao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="19dp"
                    android:columnWidth="56dp"
                    android:focusable="false"
                    android:gravity="center"
                    android:isScrollContainer="false"
                    android:numColumns="auto_fit"
                    android:stretchMode="spacingWidthUniform"
                    android:verticalSpacing="17dp"

                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/cinzaclaro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Números proibidos"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAddRemoverNumsProibidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_white_with_red_border"
                        android:text="Adicionar \nou remover"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/vermelhoBilhetes" />

                </LinearLayout>

                <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                    android:id="@+id/gridviewNumerosProibidosRapidao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="19dp"
                    android:columnWidth="56dp"
                    android:focusable="false"
                    android:gravity="center"
                    android:isScrollContainer="false"
                    android:numColumns="auto_fit"
                    android:stretchMode="spacingWidthUniform"
                    android:verticalSpacing="17dp"

                    />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                android:orientation="vertical"
                android:paddingTop="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Apostas favoritas"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAddRemoverApostasFav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_white_with_green_border"
                        android:text="Adicionar \nou remover"
                        android:textAlignment="center"
                        android:textAllCaps="false"
                        android:textColor="@color/verdeagua" />

                </LinearLayout>

                <android.support.v7.widget.RecyclerView
                    android:id="@+id/gridViewApostaFavorita"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="19dp"
                    android:layout_marginBottom="50dp"
                    android:paddingBottom="100dp"
                    android:focusable="false"
                    android:horizontalSpacing="0dp"
                    android:verticalSpacing="0dp"
                    />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="@color/linhaDivisa"
        app:layout_constraintBottom_toBottomOf="@+id/scrollViewRapidaoConfig"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </View>

    <Button
        android:id="@+id/salvarApostaRapidao"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="40dp"
        android:background="@color/verdeazul"
        android:text="Salvar"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="17.7sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/view2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</android.support.constraint.ConstraintLayout>
