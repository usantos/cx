<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="blocksDescendants">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Números obrigatórios"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textAlignment="center"
                android:layout_marginTop="40dp"
                android:textColor="@color/verdeagua"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/tv_titulo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecione os números que deverão aparecer em suas apostas."
                android:textSize="14sp"
                android:padding="20dp"
                android:textColor="@color/cinza"
                android:layout_centerHorizontal="true"
                android:textAlignment="center"
                android:id="@+id/tv_descricao"
                app:layout_constraintTop_toBottomOf="@id/tv_titulo"
                style="@style/editTextArialMTTheme"/>

            <Button
                android:layout_width="184dp"
                android:layout_height="56dp"
                android:text="Limpar seleção"
                android:textAllCaps="false"
                android:textColor="@color/cinza"
                android:textSize="14.2sp"
                app:layout_constraintTop_toBottomOf="@id/tv_descricao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:id="@+id/btn_limpar_selecao"
                android:background="@drawable/custom_border_cinza" />

            <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                android:id="@+id/ehgv_grid_numeros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:columnWidth="56dp"
                android:nestedScrollingEnabled="false"
                android:numColumns="auto_fit"
                android:verticalSpacing="17dp"
                android:stretchMode="spacingWidthUniform"
                android:layout_marginTop="19dp"
                android:layout_marginBottom="100dp"
                android:isScrollContainer="false"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintTop_toBottomOf="@id/btn_limpar_selecao"/>
        </android.support.constraint.ConstraintLayout>

</ScrollView>
