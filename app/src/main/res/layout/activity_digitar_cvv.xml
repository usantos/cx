<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundoFormaPagamento"
    tools:context=".view.activity.DigitarCvvActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include layout="@layout/app_bar_degrade_pesquisa" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_toolbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="?attr/actionBarSize" />

        <TextView
            android:id="@+id/textoInsiraCodSeg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/insiraCodigoSeguranca"
            android:textColor="@color/azul_alterar"
            android:textSize="12sp"
            android:fontFamily="@font/caixa_std_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gl_toolbar" />

        <TextView
            android:id="@+id/textoMensagemVerso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/normalmenteNoVerso"
            android:textColor="@color/cinzaescuro"
            android:textSize="13sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/textoInsiraCodSeg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <FrameLayout
            android:id="@+id/fragmentCartaoVerso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textoMensagemVerso">

            <TextView
                android:id="@+id/textoCartaoFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cartaoFinal"
                android:textColor="@color/cinzaescuro"
                android:textSize="13sp"
                android:fontFamily="@font/caixa_std_regular"
                android:layout_gravity="right"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <FrameLayout
                android:id="@+id/containerCartaoVerso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/linearCvv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fragmentCartaoVerso"
            >

            <EditText
                android:id="@+id/cvv_digit1"
                android:layout_width="40dp"
                android:layout_height="60dp"
                android:textSize="40sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/numeroDigitacaoCVV"
                android:maxLength="1"
                android:inputType="number"
                android:background="@drawable/background_border_verde"
                android:gravity="center"/>

            <EditText
                android:id="@+id/cvv_digit2"
                android:layout_width="40dp"
                android:layout_height="60dp"
                android:textSize="40sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/numeroDigitacaoCVV"
                android:maxLength="1"
                android:inputType="number"
                android:background="@drawable/background_border_verde"
                android:gravity="center"
                android:layout_marginStart="15dp"
                />

            <EditText
                android:id="@+id/cvv_digit3"
                android:layout_width="40dp"
                android:layout_height="60dp"
                android:textSize="40sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/numeroDigitacaoCVV"
                android:background="@drawable/background_border_verde"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:layout_marginStart="15dp"
                />

            <EditText
                android:id="@+id/cvv_digit4"
                android:layout_width="40dp"
                android:layout_height="60dp"
                android:textSize="40sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/numeroDigitacaoCVV"
                android:background="@drawable/background_border_verde"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:layout_marginStart="15dp"
                android:visibility="gone"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/textoCodSeguranca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/digiteSeuCvv"
            android:textColor="@color/cinzaescuro"
            android:textSize="13sp"
            android:fontFamily="@font/caixa_std_regular"
            android:gravity="center"
            android:layout_marginTop="1dp"
            app:layout_constraintTop_toBottomOf="@+id/linearCvv"
            app:layout_constraintStart_toStartOf="parent"
            />

        <Button
            android:id="@+id/btnConfirmarCvv"
            android:layout_width="170dp"
            android:layout_height="50dp"
            android:background="@drawable/button_rounded_verdeazul"
            android:text="@string/confirmarCvv"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/branco"
            android:textSize="17sp"
            android:fontFamily="@font/caixa_std_bold"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@+id/textoCodSeguranca"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>