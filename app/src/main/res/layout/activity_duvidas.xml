<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.gov.caixa.loterias.apostas.controllers.DuvidasActivity"
    android:fitsSystemWindows="true"
    >

    <include layout="@layout/app_bar_custom"/>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/branco"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layoutDuvidas2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/duvidasScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightRecyclerView
                        android:id="@+id/recyclerViewDuvidas2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="22dp"
                        android:clickable="false"
                        android:layout_gravity="center_horizontal"/>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
