<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorAccent"
    tools:context="br.gov.caixa.loterias.apostar.interno.view.fragment.LoginFragment">

    <!-- TODO: Update blank fragment layout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="93dp"
            android:layout_height="95dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="53dp"
            android:src="@drawable/logo" />

        <Button
            android:id="@+id/buttonAposteAgora"
            android:layout_width="290dp"
            android:layout_height="56dp"
            android:layout_below="@+id/imageView2"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:layout_weight="1"
            android:background="@drawable/button_border"
            android:text="@string/label_aposte_agora"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="142dp"
            android:layout_height="11dp"
            android:layout_below="@+id/buttonAposteAgora"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:src="@drawable/shape_4" />

        <Button
            android:id="@+id/buttonFacaLogin"
            android:layout_width="290dp"
            android:layout_height="56dp"
            android:layout_alignLeft="@+id/buttonAposteAgora"
            android:layout_alignStart="@+id/buttonAposteAgora"
            android:layout_below="@+id/imageView3"
            android:layout_marginTop="30dp"
            android:background="@color/laranjacaixa"
            android:text="@string/label_faca_login_cadastre"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:textStyle="bold"
            android:outlineProvider="none"/>

        <TextView
            android:id="@+id/textView2"
            android:layout_width="181dp"
            android:layout_height="33dp"
            android:layout_below="@+id/buttonFacaLogin"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:text="Você utilizará o sistema único de cadastro da caixa"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="14sp" />


    </RelativeLayout>


</FrameLayout>
