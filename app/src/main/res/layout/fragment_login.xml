<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorAccent"
    tools:context="br.gov.caixa.loterias.apostas.view.fragment.LoginFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="93dp"
            android:layout_height="95dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="53dp"
            android:background="@drawable/logo" />

        <Button
            android:id="@+id/buttonAposteAgora"
            android:layout_width="290dp"
            android:layout_height="56dp"
            android:layout_below="@+id/imageView2"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:layout_weight="1"
            android:background="@drawable/button_border"
            android:text="@string/label_experimente"
            android:fontFamily="@font/caixa_std_bold"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="142dp"
            android:layout_height="11dp"
            android:layout_below="@+id/buttonAposteAgora"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:src="@drawable/shape_4" />

        <Button
            android:id="@+id/buttonFacaLogin"
            android:layout_width="290dp"
            android:layout_height="56dp"
            android:layout_below="@+id/imageView3"
            android:layout_alignStart="@+id/buttonAposteAgora"
            android:layout_alignLeft="@+id/buttonAposteAgora"
            android:layout_marginTop="30dp"
            android:background="@color/laranjacaixa"
            android:outlineProvider="none"
            android:text="@string/label_faca_login_cadastre"
            android:textAllCaps="false"
            android:fontFamily="@font/caixa_std_bold"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewSSO"
            android:layout_width="181dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/buttonFacaLogin"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:text="@string/voc_utilizar_o_sistema_nico_de_cadastro_da_caixa"
            android:fontFamily="@font/caixa_std_regular"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="14sp"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/textViewTrocar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/buttonFacaLogin"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="35dp"
            android:text="@string/trocar_de_usuario"
            android:fontFamily="@font/caixa_std_regular"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="15sp"
            android:background="@drawable/drawer_underline"
            android:onClick="onClick"
            android:clickable="true"
            android:visibility="visible"/>

        <LinearLayout
            android:id="@+id/biometriaLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@+id/textViewSSO"
            android:layout_marginTop="35dp"
            android:layout_centerHorizontal="true"
            android:visibility="visible"
            >

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/digital2" />

            <ImageView
                android:id="@+id/imageViewPipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/pipe"
                android:layout_below="@+id/digital2"
                android:layout_marginLeft="7dp"
                android:layout_marginRight="9dp"
                />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/iface" />

            <TextView
                android:id="@+id/textViewBiometria"
                android:layout_width="207dp"
                android:layout_height="wrap_content"
                android:text="@string/leitor_digital"
                android:fontFamily="@font/caixa_std_regular"
                android:textAlignment="center"
                android:textColor="@color/branco"
                android:textSize="18dp" />

            <Switch
                android:id="@+id/biometriaSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:theme="@style/SwitchTheme"
            tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>

        <TextView
            android:id="@+id/textVersao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="26dp"
            android:clickable="true"
            android:text="@string/placeholder_versao"
            android:fontFamily="@font/caixa_std_regular"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="12sp" />

    </RelativeLayout>
    
</FrameLayout>
