<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorAccent"
    tools:context="br.gov.caixa.loterias.apostas.view.fragment.LoginFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="93dp"
            android:layout_height="95dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="146dp"
            android:contentDescription="@string/logoLoteriasCaixa"
            android:importantForAccessibility="yes"
            android:focusable="true"
            android:background="@drawable/logo" />

        <Button
            android:id="@+id/buttonAposteAgora"
            android:layout_width="338dp"
            android:layout_height="44dp"
            android:layout_below="@+id/imageView2"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="57dp"
            android:layout_weight="1"
            android:background="@drawable/button_border_new"
            android:fontFamily="@font/caixa_std_semi_bold"
            android:text="@string/label_experimente"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:textStyle="bold" />


        <LinearLayout
            android:id="@+id/imageView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/buttonAposteAgora"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:background="@color/branco" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/caixa_std_bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="OU"
                android:textColor="@color/branco"
                android:textStyle="bold" />

            <View
                android:layout_width="150dp"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:background="@color/branco" />
        </LinearLayout>


        <Button
            android:id="@+id/buttonFacaLogin"
            android:layout_width="338dp"
            android:layout_height="44dp"
            android:layout_below="@+id/imageView3"
            android:layout_alignStart="@+id/buttonAposteAgora"
            android:layout_alignLeft="@+id/buttonAposteAgora"
            android:layout_marginTop="42dp"
            android:background="@drawable/button_border_laranja"
            android:fontFamily="@font/caixa_std_semi_bold"
            android:outlineProvider="none"
            android:text="@string/label_faca_login_cadastre"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/biometriaLinearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/buttonFacaLogin"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="135dp"
            android:layout_marginBottom="148dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="9dp"
                android:src="@drawable/digital2" />

        <LinearLayout
            android:id="@+id/rowBiometria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:labelFor="@id/biometriaSwitch"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/textViewBiometria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="9dp"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/leitor_digital"
                android:textAlignment="center"
                android:textColor="@color/branco"
                android:textSize="20dp" />

            <Switch
                android:id="@+id/biometriaSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:importantForAccessibility="no"
                android:theme="@style/SwitchTheme"
                tools:ignore="UseSwitchCompatOrMaterialXml" />
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textVersao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="26dp"
            android:clickable="true"
            android:fontFamily="@font/caixa_std_regular"
            android:text="@string/placeholder_versao"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spin_ambiente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="26dp"
            android:backgroundTint="@color/branco"
            android:dropDownWidth="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:visibility="gone" />

    </RelativeLayout>

</FrameLayout>
