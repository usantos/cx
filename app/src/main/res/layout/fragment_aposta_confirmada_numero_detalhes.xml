<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/concursoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arialmt"
            android:text="@string/concurso"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/concursoTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/concursoLabel"
            android:fontFamily="@font/arialmt"
            android:textSize="12sp"
            tools:text="1234" />

        <TextView
            android:id="@+id/quantidadeApostadasTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_toEndOf="@id/concursoLabel"
            android:fontFamily="@font/arialmt"
            android:textSize="12sp"
            tools:text="4 apostas" />

        <TextView
            android:id="@+id/dataAposta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/quantidadeApostadasTxt"
            android:layout_below="@id/quantidadeApostadasTxt"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:fontFamily="@font/arialmt"
            android:text="@string/data_da_aposta"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dataApostaTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/dataAposta"
            android:layout_below="@id/dataAposta"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="25/08/2016" />

        <TextView
            android:id="@+id/resultTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/dataAposta"
            android:layout_toEndOf="@id/divider"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Aguardando" />

        <TextView
            android:id="@+id/apostaTrocaTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/dividerHorizontal"
            android:layout_below="@+id/concursoTxt"
            android:fontFamily="@font/arialmt"
            android:gravity="bottom"
            android:text="@string/label_aposta_troca"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/timeCoracaoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/quantidadeApostadasTxt"
            android:layout_below="@+id/dataApostaTxt"
            android:layout_marginTop="39dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/labelTimeCoracaoTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arialmt"
                android:text="@string/label_time_coracao"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeCoracaoTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/labelTimeCoracaoTxt"
                android:fontFamily="@font/arialmt"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="@string/label_time_coracao" />
        </RelativeLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/dataApostaTxt"
            android:layout_alignTop="@id/dataAposta"
            android:layout_marginBottom="0dp"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/dataApostaTxt"
            android:background="?android:textColor" />

        <View
            android:id="@+id/dividerHorizontal"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_alignStart="@id/quantidadeApostadasTxt"
            android:layout_below="@id/timeCoracaoLayout"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:background="?android:textColor" />

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/activity_vertical_margin">

        <TextView
            android:id="@+id/modalidadeTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arialmt"
            android:text="@string/label_teimosinha"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/seusNumerosTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_toEndOf="@id/modalidadeTxt"
            android:fontFamily="@font/arialmt"
            android:text="@string/seus_numeros"
            android:textSize="12sp" />

        <android.support.v7.widget.RecyclerView
            android:id="@+id/dezenasRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/seusNumerosTxt"
            android:layout_below="@id/seusNumerosTxt"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/conferirResultadoButton"
            style="@style/ButtonNotShadowColored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/seusNumerosTxt"
            android:layout_below="@id/dezenasRecyclerView"
            android:layout_marginTop="@dimen/activity_vertical_margin"
            android:background="@drawable/background_border_color"
            android:text="@string/conferir_resultados"
            android:visibility="gone" />

    </RelativeLayout>


</LinearLayout>