<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/item_resultado_content_view">
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recyclerNumerosResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_gravity="center_horizontal"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="33dp">
        <ImageView
            android:layout_width="41dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_timecoracao"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time do coração"
                android:textColor="@color/branco"
                android:textSize="14.2sp"
                android:fontFamily="@font/futura_std_book"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flamengo"
                android:textColor="@color/branco"
                android:textSize="14.2sp"
                android:fontFamily="@font/futura_std_bold"
                android:id="@+id/textTimeCoracao"
                />
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/megasenamedio"
        android:layout_marginTop="19dp"
        android:id="@+id/tracoViewDivisoriaResultado"
        ></View>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Premiados"
        android:textColor="@color/branco"
        android:textSize="15.8sp"
        android:fontFamily="@font/futura_std_bold"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="16dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/linearlayoutPremiadosListaText"
        android:orientation="vertical">

    </LinearLayout>

    <Button
        android:layout_width="246dp"
        android:layout_height="56dp"
        android:text="Veja mais detalhes"
        android:background="@drawable/button_border"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/branco"
        android:layout_marginVertical="20dp"
        android:id="@+id/vejaDetalhesButton"
        android:textAllCaps="false"/>
    </LinearLayout>

    <caixa.gov.br.loterias.view.custom.PartidaViewDetalhesResultado_
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:id="@+id/partidaViewDetalhesResultadoView"
        />

</RelativeLayout>