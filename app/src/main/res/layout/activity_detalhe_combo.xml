<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.gov.caixa.loterias.apostas.controllers.DetalheComboActivity"
    android:background="@color/bolao_gray_stroke"
    android:fitsSystemWindows="true">

    <include layout="@layout/app_bar_degrade"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:background="@color/background_detalhe_combo">

        <ScrollView
            android:id="@+id/scrollViewDetalheCombo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerDetalheCombo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtNomeDetalheCombo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/trevo_fundo_claro_detalhe_combo"
                    android:drawablePadding="8dp"
                    android:fontFamily="@font/caixa_std_semi_bold"
                    android:textColor="@color/azul_detalhe_combo"
                    android:importantForAccessibility="yes"
                    android:focusable="true"
                    android:textSize="16sp"
                    tools:text="Fezinha do Mês"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txtHeaderDetalheCombo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/caixa_std_regular"
                    android:textSize="13sp"
                    android:textColor="@color/cinza_combos"
                    android:importantForAccessibility="yes"
                    android:focusable="true"
                    android:text="@string/texto_header_detalhe_combo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/txtNomeDetalheCombo"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcvDetalheCombo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtHeaderDetalheCombo"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutCheckBoxBotoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginEnd="17dp"
                    android:layout_marginBottom="36dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rcvDetalheCombo">

                    <TextView
                        android:id="@+id/txtVerOuNaoNumerosEscolhidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:textSize="12sp"
                        android:text="@string/texto_ver_ou_nao_numeros_escolhidos_detalhe_combo"
                        android:textColor="@color/black"
                        android:importantForAccessibility="yes"
                        android:focusable="true"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <CheckBox
                        android:id="@+id/checkBoxNumerosEscolhidos"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="1dp"
                        android:textColor="@color/black"
                        android:importantForAccessibility="yes"
                        android:focusable="true"
                        android:text="@string/ver_numeros_escolhidos_antes_de_pagar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/txtVerOuNaoNumerosEscolhidos"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        app:layout_constraintTop_toBottomOf="@id/checkBoxNumerosEscolhidos"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@color/branco"
            app:layout_constraintBottom_toTopOf="@id/id_fg_somador_carrinho">

            <TextView
                android:id="@+id/txtValorCombo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="R$ 350,00"
                android:fontFamily="@font/caixa_std_extra_bold"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textAlignment="center"
                android:importantForAccessibility="yes"
                android:focusable="true"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/txtQtdApostas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/bolao_black_loterias"
                android:textSize="16sp"
                android:textAlignment="center"
                android:text="@string/quantidade_de_apostas"
                android:importantForAccessibility="yes"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtValorCombo"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutQtdApostas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtQtdApostas">

                <ImageButton
                    android:id="@+id/btnDecrementarApostas"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/remover_apostas"
                    android:src="@drawable/botao_menos_detalhe_combo"
                    android:importantForAccessibility="yes"
                    android:focusable="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/txtQtdDeApostas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textColor="@color/blue_caixa"
                    android:textSize="17sp"
                    android:textAlignment="center"
                    android:importantForAccessibility="yes"
                    android:focusable="true"
                    android:drawableBottom="@drawable/linha_inferior_qtd_apostas_detalhe_combo"
                    app:layout_constraintStart_toEndOf="@id/btnDecrementarApostas"
                    app:layout_constraintEnd_toStartOf="@id/btnIncrementarApostas"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    tools:text="1" />

                <ImageButton
                    android:id="@+id/btnIncrementarApostas"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/adicionar_apostas"
                    android:src="@drawable/botao_mais_detalhe_combo"
                    android:importantForAccessibility="yes"
                    android:focusable="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnAdicionarAoCarrinho"
                android:layout_width="201dp"
                android:layout_height="59dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_rounded_detalhe_combo"
                tools:text="@string/adicionarAoCarrinho"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                android:textColor="@color/branco"
                android:importantForAccessibility="yes"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@string/adicionar_ao_carrinho_de_compras"
                android:backgroundTint="@color/blue_caixa"
                app:layout_constraintTop_toBottomOf="@+id/layoutQtdApostas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <RelativeLayout
            android:id="@+id/id_fg_somador_carrinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>