<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:id="@+id/LinearLayoutContentApostaFavorita">
        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/checkboxApostaFavorita"
            android:buttonTint="@color/verdeazul"
            android:layout_marginLeft="10dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mega-Sena"
            android:textSize="14.2sp"
            android:textColor="@color/verdeazul"
            android:id="@+id/tituloApostaFavorira"
            android:layout_marginLeft="16dp"
            />

        <TextView
            android:id="@+id/numerosApostaFavorita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="01 - 02 - 03 - 04 - 05 - 06 - 10 - 11 - 12 - 20 - 33 - 100"
            android:textColor="@color/azulescuroapostafavorita"
            android:textSize="14.2sp"
            android:textStyle="bold"
            android:layout_marginRight="10dp"

            />

    </LinearLayout>
</LinearLayout>