<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_conteudo"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <FrameLayout
                android:id="@+id/linearLayoutBottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/fragmentContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/informacaoApostaLayout"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/informacaoApostaLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/validadePremioImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/activity_horizontal_margin"
                    android:layout_marginTop="24dp"
                    android:src="@drawable/ic_validade"
                    app:tint="@color/branco"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/validadePremioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_regular"
                    android:text="@string/label_validade_premio"
                    android:textSize="14sp"
                    android:textColor="@color/branco"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/validadePremioImage"
                    app:layout_constraintStart_toEndOf="@id/validadePremioImage"
                    />

                <TextView
                    android:id="@+id/validadePremioText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/validadePremioLabel"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/caixa_std_regular"
                    android:textColor="@color/branco"
                    android:text="@string/label_noventa_dias"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@id/validadePremioLabel"
                    app:layout_constraintStart_toEndOf="@id/validadePremioImage"
                    />

                <View
                    android:id="@+id/linhaSeparadora"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/branco"
                    android:alpha="0.8"
                    android:layout_marginEnd="@dimen/activity_horizontal_margin"
                    android:layout_marginStart="@dimen/activity_horizontal_margin"
                    app:layout_constraintTop_toBottomOf="@id/validadePremioText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/comprovanteLayout"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:backgroundTint="#FFA829"
                    android:padding="8dp"
                    app:layout_constraintTop_toBottomOf="@id/linhaSeparadora"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    >

                    <ImageView
                        android:id="@+id/id_image_download"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:src="@drawable/ic_download_comprovante"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/id_txt_gerar_comprovante"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/id_txt_gerar_comprovante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="34dp"
                        android:text="@string/gerar_comprovante"
                        android:textColor="@color/branco"
                        android:fontFamily="@font/caixa_std_regular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/id_view_divisao"
                    android:layout_width="wrap_content"
                    android:layout_height="150dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/comprovanteLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_bottom"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/cinzaApostaConfirmada" >

        <RelativeLayout
            android:id="@+id/editarApostaBtn"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp">

            <ImageView
                android:id="@+id/editarImg"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerHorizontal="true"
                android:adjustViewBounds="true"
                android:src="@drawable/icon_editar_aposta" />

            <TextView
                android:id="@+id/editarTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/editarImg"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/label_editar_aposta"
                android:textColor="@color/textColorToolbar"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="12sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/carrinhoApostasBtn"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/carrinhoImg"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/icon_carrinho" />

            <TextView
                android:id="@+id/carrinhoTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/carrinhoImg"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/label_carrinho_apostas"
                android:textColor="@color/textColorToolbar"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="12sp" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_adic_fav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="70dp"
            android:layout_marginRight="70dp"
            android:layout_weight="1">

            <RelativeLayout
                android:id="@+id/favoritadoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/favoriteBtn"
                android:background="@color/verdeazul"
                android:gravity="center"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/favoritadoImg"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/icon_favoritado_novo" />

                <TextView
                    android:id="@+id/labelApostaSalvaTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/favoritadoImg"
                    android:layout_toEndOf="@id/favoritadoImg"
                    android:text="@string/label_aposta_salva_carinha"
                    android:fontFamily="@font/caixa_std_regular"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/favoriteBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@color/cinza"
                android:drawableStart="@drawable/icon_favoritar_novo"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:minHeight="56dp"
                android:padding="15dp"
                android:visibility="visible">

                <RelativeLayout
                    android:id="@+id/layoutTextoSalveAposta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/favoritarImg"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/icon_favoritar_novo" />

                    <TextView
                        android:id="@+id/labelSalveApostaTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/favoritarImg"
                        android:text="@string/label_salve_aposta"
                        android:textColor="@color/branco"
                        android:fontFamily="@font/caixa_std_regular"
                        android:textSize="14sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/layoutnomeApostaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/layoutTextoSalveAposta"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/labelDeNomeTxt"
                        style="@style/CaixaStdRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_de_nome"
                        android:textColor="@color/verdeazul"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/nomeApostaEditTxt"
                        style="@style/CaixaStdRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/labelDeNomeTxt"
                        android:layout_alignStart="@+id/labelDeNomeTxt"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/activity_vertical_margin"
                        android:backgroundTint="@color/branco"
                        android:textColor="@color/branco"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/salvarApostaImg"
                        android:layout_width="@dimen/image_size_small"
                        android:layout_height="@dimen/image_size_small"
                        android:layout_alignTop="@+id/nomeApostaEditTxt"
                        android:layout_alignBottom="@+id/nomeApostaEditTxt"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/seta_verde" />
                </RelativeLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/adicionarCarrinhoBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/favoriteBtn"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="40dp"
                android:background="@color/cinza"
                android:gravity="center"
                android:minHeight="84dp"
                android:padding="15dp">

                <TextView
                    android:id="@+id/adicionarTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="@string/label_adicionar"
                    android:textColor="@color/branco"
                    android:textSize="18sp"
                    android:fontFamily="@font/caixa_std_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/adicionarTxt"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:text="@string/label_adicionar_carrinho_apostas"
                    android:textColor="@color/branco"
                    android:textSize="14sp"
                    android:fontFamily="@font/caixa_std_regular"/>

            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>