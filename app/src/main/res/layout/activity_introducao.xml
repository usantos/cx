<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splashscreen_triangulo_new"
    android:fitsSystemWindows="true">

    <!-- ViewPager ocupa toda a tela -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:paddingTop="20dp">

        <Button
            android:id="@+id/buttonPularIntroducao"
            android:layout_width="140dp"
            android:layout_height="44dp"
            android:text="@string/pular_introdu_o"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:background="@android:color/transparent"
            android:fontFamily="@font/caixa_std_semi_bold"
            android:textSize="16sp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="10dp" />

        <me.relex.circleindicator.CircleIndicator3
            android:id="@+id/indicator_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignTop="@id/buttonPularIntroducao"
            android:layout_alignBottom="@id/buttonPularIntroducao"
            android:visibility="visible" />
    </RelativeLayout>

</RelativeLayout>
