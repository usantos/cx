<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">
    
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="147dp"
            android:layout_height="102dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutImgTarjaTrevo"
                android:layout_width="39dp"
                android:layout_height="33dp"
                android:elevation="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            <ImageView
                    android:id="@+id/imgTarjaTrevo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/tarja_trevo_padrao_lista_combos"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                    android:id="@+id/img_trevo_lista_combo"
                    android:layout_width="22dp"
                    android:layout_height="21dp"
                    android:background="@drawable/trevo_lista_combo"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_card_combo"
                android:layout_width="147dp"
                android:layout_height="96dp"
                android:background="@drawable/card_lista_combos"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/card_de_combo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                    android:id="@+id/img_background_combo"
                    android:layout_width="59dp"
                    android:layout_height="61dp"
                    android:src="@drawable/trevo_background_lista_combo"
                    android:layout_marginStart="1dp"
                    android:layout_marginTop="-2.5dp"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutImgTarjaTrevo">

            <TextView
                    android:id="@+id/txtNomeCombo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_semi_bold"
                    android:textSize="14sp"
                    android:textColor="@color/azul_combo"
                    tools:text="lotomania + espelho"
                    android:textAlignment="center"
                    android:layout_marginTop="13dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                    android:id="@+id/txtValorCombo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="R$ 10,00"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textFontWeight="700"
                    android:textAlignment="center"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    app:layout_constraintTop_toBottomOf="@id/txtNomeCombo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBaseline_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
            
            
        </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>