<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_partida_lotogol"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:gravity="center"
    android:layout_marginTop="28dp"
    android:orientation="horizontal">

    <caixa.gov.br.loterias.view.custom.ItemEquipeViewLotogol_
        android:id="@+id/lotogol_time_um"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>

    <ImageView
        android:id="@+id/lotogol_versus"
        android:layout_width="0dp"
        android:layout_height="17dp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="21dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/time_versus_azul"
        android:layout_weight="0.1"/>

    <caixa.gov.br.loterias.view.custom.ItemEquipeViewLotogol_
        android:id="@+id/lotogol_time_dois"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>