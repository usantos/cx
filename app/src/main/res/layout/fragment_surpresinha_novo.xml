<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/branco">

        <TextView
            android:id="@+id/surpresinhaInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="16sp"
            android:text="@string/surpresinhaInfo"
            android:textAlignment="center"
            android:textColor="@color/cinza110"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/numeroNovoConst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/escolhaItemLayout"
            tools:visibility="visible">


            <TextView
                android:id="@+id/numerosInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/escolha_a_quantidade_de_n_meros"
                android:textAlignment="center"
                android:textColor="@color/cinza110"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <LinearLayout
                android:id="@+id/numberNumeros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/numerosInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/qtdNumerosSelecionadasNovo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center|bottom"
                    android:layout_marginHorizontal="6dp"
                    android:textSize="18sp"
                    android:text="6"
                    android:textColor="@color/cinza110"
                    android:fontFamily="@font/caixa_std_regular"/>

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/cinza110"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNumerosMenos"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="0dp"
                android:backgroundTint="@color/cinza110"
                android:text="@string/menos"
                android:gravity="center"
                android:textSize="12dp"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_bold"
                app:cornerRadius="4dp"
                app:layout_constraintRight_toLeftOf="@+id/numberNumeros"
                app:layout_constraintTop_toTopOf="@+id/numberNumeros"
                app:layout_constraintBottom_toBottomOf="@id/numberNumeros"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNumerosMais"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="20dp"
                android:text="@string/mais"
                android:textSize="12dp"
                android:gravity="center"
                android:textColor="@color/branco"
                app:cornerRadius="4dp"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintLeft_toRightOf="@+id/numberNumeros"
                app:layout_constraintTop_toTopOf="@+id/numberNumeros"
                app:layout_constraintBottom_toBottomOf="@id/numberNumeros"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
            android:id="@+id/listaDezenasSurpresinha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/drawer_linha_divisao_cinza_claro_top_bottom"
            android:columnWidth="40dp"
            android:gravity="center"
            android:horizontalSpacing="8dp"
            android:numColumns="auto_fit"
            android:paddingBottom="20dp"
            android:paddingTop="20dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="9dp"
            app:layout_constraintTop_toBottomOf="@+id/surpresinhaInfo" />


        <LinearLayout
            android:id="@+id/escolhaItemLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/listaDezenasSurpresinha"
            android:visibility="gone"
            android:orientation="vertical"
            tools:visibility="visible">

            <TextView
                android:id="@+id/TimeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="45dp"
                android:layout_marginEnd="45dp"
                android:text="@string/surpresinhaTime"
                android:textAlignment="center"
                android:textColor="@color/cinza110"
                android:textSize="16sp"
                android:fontFamily="@font/caixa_std_regular"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/escolherOutroItemBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:textAllCaps="false"
                app:strokeWidth="1dp"
                app:cornerRadius="4dp"
                android:backgroundTint="@color/button_rodape"
                app:strokeColor="@color/text_rodape"
                android:textColor="@color/text_rodape"
                android:text="@string/label_escolher_time"
                android:fontFamily="@font/caixa_std_regular"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:textSize="13sp"
                android:enabled="true"
                android:layout_gravity="center_horizontal"/>

            <View
                android:id="@+id/divisaoLinhaDois"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/escolherOutroItemBtn"
                android:layout_marginStart="17dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="21dp"
                android:background="@color/cinzaclaro" />
        </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/maisMilionaria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/numeroNovoConst"
            tools:visibility="visible">


            <TextView
                android:id="@+id/trevosInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/trevosInfo"
                android:textAlignment="center"
                android:textColor="@color/cinza110"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <LinearLayout
                android:id="@+id/numberTrevos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/trevosInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/qtdSurpresinhasSelecionadasTrevos"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center|bottom"
                    android:textSize="18sp"
                    android:text="2"
                    android:layout_marginHorizontal="6dp"
                    android:textColor="@color/cinza110"
                    android:fontFamily="@font/caixa_std_regular"/>

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/cinza110"/>

            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenosTrevos"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="0dp"
                android:backgroundTint="@color/cinza110"
                android:text="@string/menos"
                android:gravity="center"
                android:textSize="12dp"
                android:textColor="@color/branco"
                app:cornerRadius="4dp"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintRight_toLeftOf="@+id/numberTrevos"
                app:layout_constraintTop_toTopOf="@+id/numberTrevos"
                app:layout_constraintBottom_toBottomOf="@id/numberTrevos"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMaisTrevos"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="20dp"
                android:text="@string/mais"
                android:textSize="12dp"
                android:gravity="center"
                app:cornerRadius="4dp"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintLeft_toRightOf="@+id/numberTrevos"
                app:layout_constraintTop_toTopOf="@+id/numberTrevos"
                app:layout_constraintBottom_toBottomOf="@id/numberTrevos"/>




        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/surpresinhaQtdInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="45dp"
            android:layout_marginLeft="45dp"
            android:layout_marginRight="45dp"
            android:layout_marginStart="45dp"
            android:layout_marginTop="20dp"
            android:text="@string/surpresinhaInfoNova"
            android:textAlignment="center"
            android:textColor="@color/cinza110"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/escolhaItemLayout" />

        <LinearLayout
            android:id="@+id/numberSurpresinhas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/surpresinhaQtdInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/qtdSurpresinhasSelecionadas"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center|bottom"
                android:text="1"
                android:textSize="18sp"
                android:layout_marginHorizontal="6dp"
                android:textColor="@color/cinza110"
                android:fontFamily="@font/caixa_std_regular"/>

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="@color/cinza110"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMenosSurpresinha"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="0dp"
            android:layout_marginTop="20dp"
            app:cornerRadius="4dp"
            android:backgroundTint="@color/cinza110"
            android:text="@string/menos"
            android:gravity="center"
            android:textSize="12dp"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintRight_toLeftOf="@+id/numberSurpresinhas"
            app:layout_constraintBottom_toBottomOf="@id/numberSurpresinhas"
            app:layout_constraintTop_toTopOf="@+id/numberSurpresinhas" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMaisSurpresinha"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="20dp"
            app:cornerRadius="4dp"
            android:text="@string/mais"
            android:textSize="12dp"
            android:gravity="center"
            android:backgroundTint="@color/cinza110"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintLeft_toRightOf="@+id/numberSurpresinhas"
            app:layout_constraintBottom_toBottomOf="@id/numberSurpresinhas"
            app:layout_constraintTop_toTopOf="@+id/numberSurpresinhas" />

        <LinearLayout
            android:id="@+id/layoutEspelhoSurpresinha"
            android:layout_width="183dp"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:background="@color/cinza"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnMaisSurpresinha">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/selcioneEspelhoSurpresinha"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="17dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/check_box_selected"
                android:button="@color/transparente50"
                android:clickable="false" />

            <TextView
                android:id="@+id/textoEspelhoSurpresinha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:layout_marginStart="17dp"
                android:layout_marginTop="20dp"
                android:clickable="false"
                android:text="@string/label_aposta_espelho"
                android:textColor="@color/branco"
                android:textSize="14.2sp"
                android:fontFamily="@font/caixa_std_bold"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>