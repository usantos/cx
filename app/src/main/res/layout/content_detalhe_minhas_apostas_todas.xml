<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom">

        <!-- ÚNICO FILHO do ScrollView -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:importantForAccessibility="no"
            android:id="@+id/cl_scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Bloco 1: cabeçalho -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:importantForAccessibility="no"
                android:id="@+id/rl_header_bloco"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="@dimen/activity_vertical_margin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    app:layout_constraintWidth_min="250dp"
                    android:id="@+id/cl_concursos"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    app:layout_constraintBottom_toBottomOf="@id/concursoTxt"
                    app:layout_constraintEnd_toEndOf="@+id/quantidadeApostadasTxt"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:importantForAccessibility="no"
                    android:id="@+id/concursoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_bold"
                    android:text="@string/concursos"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/concursoTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_regular"
                    android:importantForAccessibility="no"
                    android:text="@string/contest_example"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:visibility="invisible"
                    app:layout_constraintStart_toStartOf="@id/concursoLabel"
                    app:layout_constraintTop_toBottomOf="@id/concursoLabel" />

                <TextView
                    android:id="@+id/quantidadeApostadasTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/caixa_std_regular"
                    android:importantForAccessibility="no"
                    android:text="@string/contest_bet"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:visibility="invisible"
                    app:layout_constraintStart_toEndOf="@+id/concursoTxt"
                    app:layout_constraintTop_toTopOf="@+id/concursoTxt" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_data"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/concursoTxt">

                    <TextView
                        android:focusable="true"
                        android:importantForAccessibility="yes"
                        android:id="@+id/cl_accessibility_left"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/divider"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:focusable="true"
                        android:importantForAccessibility="yes"
                        android:id="@+id/cl_accessibility_right"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintStart_toStartOf="@id/divider"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:id="@+id/dataAposta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_bold"
                        android:text="@string/label_dt_aposta"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        />

                    <TextView
                        android:importantForAccessibility="no"
                        android:id="@+id/dataApostaTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/contest_timestamp_example"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:visibility="visible"
                        app:layout_constraintStart_toStartOf="@id/dataAposta"
                        app:layout_constraintTop_toBottomOf="@id/dataAposta" />

                    <TextView
                        android:importantForAccessibility="no"
                        android:id="@+id/horaApostaTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/contest_timestamp_example_hour"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:visibility="visible"
                        app:layout_constraintStart_toStartOf="@id/dataAposta"
                        app:layout_constraintTop_toBottomOf="@id/dataApostaTxt" />

                    <View
                        android:id="@+id/divider"
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:background="@color/black"
                        android:layout_marginStart="20dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/dataApostaTxt" />

                    <TextView
                        android:id="@+id/statusApostaTextView"
                        android:layout_width="0dp"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:fontFamily="@font/caixa_std_bold"
                        android:importantForAccessibility="no"
                        android:text="@string/contest_example_waiting"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/divider"
                        app:layout_constraintTop_toTopOf="@+id/dataAposta" />

                    <TextView
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:id="@+id/tvStatusCentralizado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/label_concurso_nao_apurado"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:layout_marginStart="20dp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="@id/divider"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/tv_val_premio_tit"
                        android:layout_width="0dp"
                        android:ellipsize="end"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:importantForAccessibility="no"
                        android:text="@string/val_premio"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/statusApostaTextView"
                        app:layout_constraintTop_toBottomOf="@+id/statusApostaTextView" />

                    <TextView
                        android:id="@+id/tv_val_premio"
                        android:ellipsize="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_bold"
                        android:importantForAccessibility="no"
                        android:text="@string/r_0_00"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/statusApostaTextView"
                        app:layout_constraintTop_toBottomOf="@+id/tv_val_premio_tit" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:contentDescription="@string/button_get_reward"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:clickable="true"
                    android:id="@+id/clResgatePremio"
                    android:layout_width="246dp"
                    android:layout_height="44dp"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:backgroundTint="@color/black"
                    android:layout_marginTop="22dp"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@id/cl_data"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:importantForAccessibility="no"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:id="@+id/ivResgatePremio"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_resgatar_premio" />

                        <TextView
                            android:importantForAccessibility="no"
                            android:id="@+id/ResgatarPremioTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/caixa_std_bold"
                            android:textColor="@color/branco"
                            android:text="@string/resgatar_premio_mp"
                            android:textSize="16sp"
                            android:layout_marginStart="10dp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clInformacoesBolao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="22dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/clResgatePremio"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:clickable="true"
                        android:focusable="true"
                        android:id="@+id/rv_fields_bolao"
                        android:layout_width="0dp"
                        tools:itemCount="5"
                        tools:listitem="@layout/layout_rv_bolao"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bloco 2: tipo de aposta -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rl_tipo_aposta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rl_header_bloco">

                <br.gov.caixa.loterias.apostas.view.fragment.TipoApostaLinhaView
                    android:id="@+id/tipo_aposta_linha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bloco 3: Centro Apenas LOTECA Top -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_loteca_top"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rl_tipo_aposta">

                <TextView
                    android:id="@+id/tv_label_minhas_apostas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_regular"
                    android:text="@string/minhasApostas"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:layout_marginStart="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <LinearLayout
                    android:id="@+id/ll_legenda_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:contentDescription="@string/acessibilidade_legenda_botao"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_label_legenda"
                    android:importantForAccessibility="no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_regular"
                    android:text="@string/label_legenda"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginEnd="2dp"
                    app:layout_constraintEnd_toStartOf="@+id/iv_lupa_legenda"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/iv_lupa_legenda"
                    android:importantForAccessibility="no"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:fontFamily="@font/caixa_std_regular"
                    android:src="@drawable/lupa_legenda"
                    app:tint="@color/black"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                </LinearLayout>

                <View
                    android:id="@+id/v_linha_loteca"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_label_minhas_apostas"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bloco 3: Centro Recycle -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_centro_detalhe_minhas_apostas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@+id/cl_loteca_top"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"                 />

            <!-- Bloco 3: Centro Apenas LOTECA Bottom -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_loteca_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rv_centro_detalhe_minhas_apostas">

                <View
                    android:id="@+id/v_linha_loteca2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:layout_marginTop="0dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_loteca_acertos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="0dp"
                    app:layout_constraintStart_toStartOf="@+id/v_linha_loteca2"
                    app:layout_constraintTop_toTopOf="@+id/v_linha_loteca2">

                    <TextView
                        android:id="@+id/tv_label_loteca_acertos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/label_acertos_dois_pontos"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

                    <TextView
                        android:id="@+id/tv_loteca_acertos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_bold"
                        android:text="13 palpites"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:importantForAccessibility="no"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="4dp"
                        app:layout_constraintStart_toEndOf="@+id/tv_label_loteca_acertos"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_label_loteca_acertos" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_loteca_premio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/cl_loteca_acertos"
                    app:layout_constraintTop_toBottomOf="@+id/cl_loteca_acertos">

                    <TextView
                        android:id="@+id/tv_label_loteca_premio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/label_premio_dois_pontos"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_loteca_premio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_bold"
                        android:text="R$ 3,50"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        app:layout_constraintStart_toEndOf="@+id/tv_label_loteca_premio"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_label_loteca_premio" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/v_linha_loteca3"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/cl_loteca_premio"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Bloco 4: Rodape -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/informacaoApostaLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cl_loteca_bottom">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:contentDescription="@string/contest_reward_valid_time"
                    android:id="@+id/validadePremio"
                    android:importantForAccessibility="yes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintRight_toRightOf="parent">

                    <ImageView
                        android:importantForAccessibility="no"
                        android:id="@+id/validadePremioImage"
                        android:layout_width="25dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="21dp"
                        android:src="@drawable/ic_validade"
                        app:tint="@color/black"
                        android:visibility="visible"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:importantForAccessibility="no"
                        android:id="@+id/validadePremioLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/label_validade_premio"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="-6dp"
                        android:visibility="visible"
                        app:layout_constraintTop_toTopOf="@id/validadePremioImage"
                        app:layout_constraintStart_toEndOf="@id/validadePremioImage" />

                    <TextView
                        android:importantForAccessibility="no"
                        android:id="@+id/validadePremioText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/validadePremioLabel"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/label_noventa_dias"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:layout_marginStart="8dp"
                        android:visibility="visible"
                        app:layout_constraintStart_toEndOf="@id/validadePremioImage"
                        app:layout_constraintTop_toBottomOf="@id/validadePremioLabel" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <!-- Card 1: Resgatar prêmio -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:contentDescription="@string/button_get_reward"
                    android:importantForAccessibility="yes"
                    android:clickable="true"
                    android:focusable="true"
                    android:id="@+id/clResgatePremio2"
                    android:layout_width="246dp"
                    android:layout_height="44dp"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:backgroundTint="@color/black"
                    android:layout_marginTop="12dp"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@+id/validadePremio"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:id="@+id/ivResgatePremio2"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_resgatar_premio"/>
                        <TextView
                            android:importantForAccessibility="no"
                            android:id="@+id/ResgatarPremioTxt2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/caixa_std_bold"
                            android:textColor="@color/branco"
                            android:text="@string/resgatar_premio_mp"
                            android:textSize="16sp"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Card 2: Gerar comprovante -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/comprovanteLayout"
                    android:importantForAccessibility="yes"
                    android:contentDescription="@string/button_generate_receipt"
                    android:layout_width="246dp"
                    android:layout_height="44dp"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:backgroundTint="@color/black"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@+id/clResgatePremio2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:importantForAccessibility="no"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:id="@+id/ivImageDownload"
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/ic_download_comprovante"
                            />

                        <TextView
                            android:importantForAccessibility="no"
                            android:id="@+id/gerarConprovanteTxt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/caixa_std_bold"
                            android:textColor="@color/branco"
                            android:text="@string/gr_comprovante"
                            android:textSize="16sp"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    app:layout_constraintTop_toBottomOf="@+id/comprovanteLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_bottom"
        android:layout_width="match_parent"
        android:layout_height="111dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/branco" >

        <RelativeLayout
            android:id="@+id/editarApostaBtn"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp">

            <ImageView
                android:id="@+id/editarImg"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerHorizontal="true"
                android:adjustViewBounds="true"
                android:src="@drawable/icon_editar_aposta"
                app:tint="@color/cinza90"/>

            <TextView
                android:id="@+id/editarTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/editarImg"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/label_editar_aposta"
                android:textColor="@color/bolao_azul_filtro"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="18sp" />
        </RelativeLayout>

        <RelativeLayout
            android:contentDescription="@string/label_carrinho_apostas_limpo"
            android:id="@+id/carrinhoApostasBtn"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginEnd="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:importantForAccessibility="no"
                android:id="@+id/carrinhoImg"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_carrinho2"
                app:tint="@color/cinza90"/>

            <TextView
                android:importantForAccessibility="no"
                android:id="@+id/carrinhoTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/carrinhoImg"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="@string/label_carrinho_apostas"
                android:textColor="@color/bolao_azul_filtro"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="18sp" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/ll_adic_fav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center"
        android:paddingStart="@dimen/activity_horizontal_margin"
        android:paddingEnd="@dimen/activity_horizontal_margin"
        android:paddingBottom="@dimen/activity_vertical_margin">

        <RelativeLayout
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="70dp"
            android:layout_marginRight="70dp"
            android:layout_weight="1">

            <RelativeLayout
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/favoritadoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/favoriteBtn"
                android:background="@color/verdeazul"
                android:gravity="center"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/favoritadoImg"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/icon_favoritado_novo" />

                <TextView
                    android:id="@+id/labelApostaSalvaTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@+id/favoritadoImg"
                    android:layout_toEndOf="@id/favoritadoImg"
                    android:text="@string/label_aposta_salva_carinha"
                    android:fontFamily="@font/caixa_std_regular"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/favoriteBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/rounded_text_view_colunas"
                android:backgroundTint="@color/cinza110"
                android:drawableStart="@drawable/icon_favoritar_novo"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:minHeight="61dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp"
                android:clickable="true">

                <RelativeLayout
                    android:id="@+id/layoutTextoSalveAposta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true" >

                    <ImageView
                        android:id="@+id/favoritarImg"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_favoritar2" />

                    <TextView
                        android:id="@+id/labelSalveApostaTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/favoritarImg"
                        android:text="@string/label_salve_aposta"
                        android:textColor="@color/branco"
                        android:fontFamily="@font/caixa_std_regular"
                        android:textSize="18sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/layoutnomeApostaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/layoutTextoSalveAposta"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/labelDeNomeTxt"
                        style="@style/CaixaStdRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_de_nome"
                        android:textColor="@color/verdeazul"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/nomeApostaEditTxt"
                        style="@style/CaixaStdRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/labelDeNomeTxt"
                        android:layout_alignStart="@+id/labelDeNomeTxt"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/activity_vertical_margin"
                        android:backgroundTint="@color/branco"
                        android:textColor="@color/branco"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/salvarApostaImg"
                        android:layout_width="@dimen/image_size_small"
                        android:layout_height="@dimen/image_size_small"
                        android:layout_alignTop="@+id/nomeApostaEditTxt"
                        android:layout_alignBottom="@+id/nomeApostaEditTxt"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/seta_verde" />
                </RelativeLayout>

            </RelativeLayout>

            <RelativeLayout
                android:clickable="true"
                android:focusable="true"
                android:id="@+id/adicionarCarrinhoBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_text_view_colunas"
                android:backgroundTint="@color/cinza110"
                android:layout_below="@id/favoriteBtn"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="50dp"
                android:gravity="center"
                android:minHeight="77dp"
                android:paddingVertical="10dp"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/adicionarTxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="@string/label_adicionar"
                    android:textColor="@color/branco"
                    android:textSize="16sp"
                    android:fontFamily="@font/caixa_std_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/adicionarTxt"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:text="@string/label_adicionar_carrinho_apostas"
                    android:textColor="@color/branco"
                    android:textSize="18sp"
                    android:fontFamily="@font/caixa_std_regular"/>

            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
