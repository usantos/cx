<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/id_tag_bolao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_tag_bolao_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_premio_pago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="15dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/v_separador_esq"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginRight="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_premio_pago_tit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_premio_pago_tit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tit_premio_pago"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/v_separador_dir"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_premio_pago_tit"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/cl_premio_pago"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <TextView
            android:id="@+id/concursoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arialmt"
            android:text="@string/concurso"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/concursoTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/concursoLabel"
            android:fontFamily="@font/arialmt"
            android:textSize="12sp"
            tools:text="1234"
            android:textColor="@color/branco"
            app:layout_constraintTop_toBottomOf="@id/concursoLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/cotaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arialmt"
            android:layout_below="@id/concursoTxt"
            android:text="Cota"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/branco"
            app:layout_constraintTop_toBottomOf="@id/concursoTxt"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/cotaTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/cotaLabel"
            android:fontFamily="@font/arialmt"
            android:textSize="12sp"
            tools:text="1/25"
            android:textColor="@color/branco"
            app:layout_constraintTop_toBottomOf="@id/cotaLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/cotaLabel"
            app:layout_constraintTop_toBottomOf="@id/concursoTxt"
            >

            <TextView
                android:id="@+id/dataAposta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/divider"
                android:text="@string/label_data_aposta"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/branco"/>

            <TextView
                android:id="@+id/dataApostaTxt"
                android:layout_width="wrap_content"
                android:maxWidth="300dp"
                app:layout_constraintTop_toBottomOf="@+id/dataAposta"
                app:layout_constraintStart_toStartOf="@id/dataAposta"
                android:layout_height="wrap_content"
                android:text="@string/label_data_aposta"
                android:textColor="@color/branco"
                android:textSize="12sp" />

            <View
                android:id="@+id/divider"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/cl_data"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@color/branco" />

            <TextView
                android:id="@+id/statusApostaTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/divider"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="Aguardando"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultTxt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="@+id/divider"
                app:layout_constraintEnd_toEndOf="parent"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Aguardando" />

            <TextView
                android:id="@+id/tv_val_premio_tit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/val_premio"
                app:layout_constraintTop_toBottomOf="@+id/resultTxt"
                app:layout_constraintStart_toStartOf="@+id/divider"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="10dp"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_val_premio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_val_premio_tit"
                app:layout_constraintStart_toStartOf="@+id/divider"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="10dp"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="@string/r_0_00" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clResgatePremio"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:layout_below="@id/cl_data"
            android:background="@drawable/rounded_text_view_colunas"
            android:backgroundTint="#FFA829"
            app:layout_constraintTop_toBottomOf="@id/cl_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <ImageView
                android:id="@+id/ivResgatePremio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_icone_resgate"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resgatar prêmio"
                android:textColor="@color/branco"
                android:layout_marginStart="16sp"
                app:layout_constraintStart_toEndOf="@+id/ivResgatePremio"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/id_seus_numeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/numeros_sorteados"
            android:textStyle="bold"
            android:textColor="@color/branco"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toBottomOf="@id/clResgatePremio"
            app:layout_constraintStart_toStartOf="@id/cl_data"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/id_lista_sorteados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/id_seus_numeros"
            app:layout_constraintStart_toStartOf="@id/id_seus_numeros"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/id_lista_jogos"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@id/id_lista_sorteados"
            app:layout_constraintTop_toBottomOf="@id/id_lista_sorteados"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>