<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_premio_pago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="15dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/v_separador_esq"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginRight="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_premio_pago_tit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_premio_pago_tit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tit_premio_pago"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/v_separador_dir"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_premio_pago_tit"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

<!--    <ImageView-->
<!--        android:id="@+id/id_tag_bolao"-->
<!--        android:layout_width="60dp"-->
<!--        android:layout_height="60dp"-->
<!--        android:src="@drawable/ic_tag_bolao_outline"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"/>-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_cabecalho_concurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:paddingBottom="32dp"
        app:layout_constraintTop_toBottomOf="@id/cl_premio_pago"
        app:layout_constraintEnd_toStartOf="@id/cl_data"
        app:layout_constraintStart_toStartOf="parent"
        >

        <TextView
            android:id="@+id/concursoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_bold"
            android:text="@string/concurso"
            android:textSize="14sp"
            android:textColor="@color/branco"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/concursoTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/concursoLabel"
            android:fontFamily="@font/caixa_std_regular"
            android:textSize="12sp"
            tools:text="1234"
            android:textColor="@color/branco"
            app:layout_constraintTop_toBottomOf="@id/concursoLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/cotaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_bold"
            android:layout_below="@id/concursoTxt"
            android:text="Cota"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/branco"
            app:layout_constraintTop_toBottomOf="@id/concursoTxt"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/cotaTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/cotaLabel"
            android:fontFamily="@font/caixa_std_regular"
            android:textSize="12sp"
            tools:text="1/25"
            android:textColor="@color/branco"
            app:layout_constraintTop_toBottomOf="@id/cotaLabel"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toEndOf="@id/id_cabecalho_concurso"
        app:layout_constraintTop_toTopOf="@id/id_cabecalho_concurso"
        app:layout_constraintBottom_toBottomOf="@id/id_cabecalho_concurso"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <TextView
            android:id="@+id/dataAposta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/divider"
            android:text="@string/label_data_aposta"
            android:fontFamily="@font/caixa_std_bold"
            android:textSize="12sp"
            android:textColor="@color/branco"/>

        <TextView
            android:id="@+id/dataApostaTxt"
            android:layout_width="wrap_content"
            android:maxWidth="300dp"
            app:layout_constraintTop_toBottomOf="@+id/dataAposta"
            app:layout_constraintStart_toStartOf="@id/dataAposta"
            android:layout_height="wrap_content"
            android:text="@string/label_data_aposta"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            android:textSize="12sp" />

        <View
            android:id="@+id/divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/cl_data"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@color/branco" />

        <TextView
            android:id="@+id/statusApostaTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Aguardando"
            android:textColor="@color/branco"
            android:textSize="12sp"
            android:fontFamily="@font/caixa_std_bold" />

        <TextView
            android:id="@+id/resultTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            android:textColor="@color/branco"
            android:textSize="12sp"
            android:fontFamily="@font/caixa_std_bold"
            tools:text="Aguardando" />

        <TextView
            android:id="@+id/tv_val_premio_tit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/val_premio"
            app:layout_constraintTop_toBottomOf="@+id/resultTxt"
            app:layout_constraintStart_toStartOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            android:textColor="@color/branco"
            android:textSize="12sp"
            android:fontFamily="@font/caixa_std_regular"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_val_premio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_val_premio_tit"
            app:layout_constraintStart_toStartOf="@+id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="10dp"
            android:textColor="@color/branco"
            android:textSize="12sp"
            android:fontFamily="@font/caixa_std_bold"
            android:visibility="gone"
            tools:text="@string/r_0_00" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clResgatePremio"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:layout_below="@id/cl_data"
        android:background="@drawable/rounded_text_view_colunas"
        android:backgroundTint="#FFA829"
        app:layout_constraintTop_toBottomOf="@id/cl_data"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/ivResgatePremio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_icone_resgate"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resgatar prêmio"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginStart="16sp"
            app:layout_constraintStart_toEndOf="@+id/ivResgatePremio"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/v_div_top_numeros_sorteados"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/branco"
        app:layout_constraintTop_toBottomOf="@id/clResgatePremio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_corpo_aposta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/v_div_top_numeros_sorteados"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container_sorteados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >

            <TextView
                android:id="@+id/id_seus_numeros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/numeros_sorteados"
                android:fontFamily="@font/caixa_std_bold"
                android:textColor="@color/branco"
                android:layout_marginTop="16dp"
                android:paddingBottom="4dp"
                android:lineSpacingExtra="2dp"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/id_lista_sorteados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/id_seus_numeros"
                app:layout_constraintStart_toStartOf="parent"/>

            <RelativeLayout
                android:id="@+id/rl_container_result_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                app:layout_constraintTop_toBottomOf="@id/id_lista_sorteados"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="visible" />

            <TextView
                android:id="@+id/mes_time_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Mês de sorte:"
                android:fontFamily="@font/caixa_std_regular"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toBottomOf="@id/rl_container_result_1"/>

            <TextView
                android:id="@+id/mes_time_valor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                tools:text="Março"
                android:importantForAccessibility="no"
                android:fontFamily="@font/caixa_std_regular"
                android:visibility="gone"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="0dp"
                android:padding="4dp"
                app:layout_constraintTop_toBottomOf="@id/mes_time_label"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/id_trevos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/mes_time_label"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/id_seus_numeros2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/segundo_sorteiro"
                android:fontFamily="@font/caixa_std_bold"
                android:textColor="@color/branco"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/rl_container_result_1"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/id_lista_sorteados2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/id_seus_numeros2"
                app:layout_constraintStart_toStartOf="parent"/>

            <RelativeLayout
                android:id="@+id/rl_container_result_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                app:layout_constraintTop_toBottomOf="@id/id_seus_numeros2"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>


<!--        <TextView-->
<!--            android:id="@+id/id_dupla_sena1"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="@string/seus_jogos"-->
<!--            android:fontFamily="@font/caixa_std_bold"-->
<!--            android:textColor="@color/branco"-->
<!--            android:visibility="gone"-->
<!--            android:layout_marginTop="16dp"-->
<!--            android:layout_marginStart="12dp"-->
<!--            app:layout_constraintTop_toBottomOf="@id/rl_container_result_2"-->
<!--            app:layout_constraintStart_toStartOf="parent"/>-->
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/id_lista_sorteados_s7"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:visibility="gone"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintTop_toBottomOf="@id/id_corpo_aposta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/v_div_bot_numeros_sorteados"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/branco"
        app:layout_constraintTop_toBottomOf="@id/id_lista_sorteados_s7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <br.gov.caixa.loterias.apostas.view.fragment.TipoApostaLinhaView
        android:id="@+id/tipo_aposta_linha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_div_bot_numeros_sorteados"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible"
        />

    <TextView
        android:id="@+id/id_dupla_sena1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seus_jogos"
        android:fontFamily="@font/caixa_std_bold"
        android:textColor="@color/branco"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/tipo_aposta_linha"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/id_lista_jogos_s7"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:visibility="gone"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintTop_toBottomOf="@id/id_dupla_sena1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_corpo_aposta_cont"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/id_lista_jogos_s7"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/id_lista_jogos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/id_dupla_sena2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/seus_jogos"
            android:fontFamily="@font/caixa_std_bold"
            android:textColor="@color/branco"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toBottomOf="@id/id_lista_jogos"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/id_lista_jogos2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/id_dupla_sena2"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:id="@+id/id_view_base"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/id_lista_jogos2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>