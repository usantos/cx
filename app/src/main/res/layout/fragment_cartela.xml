<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCartelaFragmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/cartelaFragmentScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:orientation="vertical">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/cartelaFragmentMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco">

            <android.support.constraint.ConstraintLayout
                android:id="@+id/cltGeral"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/layotLabelEscolhaNumeros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="19dp"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/infoEscolhaPaginacaoLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layout_constraintLeft_toLeftOf="parent">

                        <TextView
                            android:id="@+id/infoEscolha"
                            style="@style/ArialMT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_marginLeft="45dp"
                            android:layout_marginTop="41dp"
                            android:textColor="@color/megasenamedio"
                            android:textSize="14sp"
                            tools:text="@string/dia_sorte_escolha_dia"/>

                        <TextView
                            android:id="@+id/infoPaginacao"
                            style="@style/ArialMT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentTop="true"
                            android:layout_alignRight="@id/infoEscolha"
                            android:layout_marginRight="45dp"
                            android:layout_marginTop="41dp"
                            android:textColor="@color/megasenamedio"
                            android:textSize="14sp"
                            tools:text="@string/paginacao_um_de_dois"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/ttvLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/ttvEscolha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_marginTop="41dp"
                            tools:text="@string/dia_sorte_escolha_dia" />

                        <TextView
                            android:id="@+id/ttvPagina"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_alignBottom="@+id/ttvEscolha"
                            android:layout_alignTop="@+id/ttvEscolha"
                            android:layout_toStartOf="@+id/ttvPaginaQuantidade"
                            android:text="@string/label_numerico_um" />

                        <TextView
                            android:id="@+id/ttvPaginaQuantidade"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_alignBottom="@+id/ttvEscolha"
                            android:layout_alignParentEnd="true"
                            android:layout_alignTop="@+id/ttvEscolha"
                            android:layout_marginEnd="24dp"
                            android:layout_marginTop="0dp"
                            tools:text=" | 2" />
                    </RelativeLayout>
                </LinearLayout>


                <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
                    android:id="@+id/listaDezenas"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="10dp"
                    android:columnWidth="50dp"
                    android:gravity="center"
                    android:horizontalSpacing="16dp"
                    android:numColumns="auto_fit"
                    android:paddingBottom="119dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="40dp"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/layotLabelEscolhaNumeros" />
            </android.support.constraint.ConstraintLayout>

            <LinearLayout
                android:id="@+id/selecioneTimeCoracao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="81dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:text="@string/label_nome_do_seu_time"
                    android:textColor="@color/azulFormNovoTipoPagamento"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/informe_nome_time"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                    android:textSize="16sp" />

                <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
                    android:id="@+id/gridTimes"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center"
                    android:nestedScrollingEnabled="false"
                    android:numColumns="3"
                    android:paddingBottom="119dp"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="16dp"
                    app:layout_goneMarginBottom="10dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRecyclerViewPartida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/selecioneTimeCoracao">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layoutTitleLoteca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:orientation="horizontal"
                        android:paddingTop="20dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/titleInformeBold"
                            style="@style/ArialMT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_informe"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/titleContinue"
                            style="@style/ArialMT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:layout_marginStart="6dp"
                            android:text="@string/label_resultado_das_partidas."
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <caixa.gov.br.loterias.view.custom.ExpandableHeightRecyclerView
                        android:id="@+id/recyclerViewPartida"
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:clickable="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        android:paddingBottom="119dp" />
                </LinearLayout>
            </LinearLayout>
        </android.support.constraint.ConstraintLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/opcaoOutrosNumerosLayout"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/cinza"
        android:clickable="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <android.support.v7.widget.AppCompatCheckBox
            android:id="@+id/selcioneOutrosNumeros"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/check_box_selected"
            android:button="@color/verdeagua"
            android:clickable="false" />

        <TextView
            android:id="@+id/infoSelecioneOutrosNumeros"
            style="@style/ArialMT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginTop="15dp"
            android:layout_toRightOf="@+id/selcioneOutrosNumeros"
            android:textColor="@color/branco"
            android:textSize="14sp" />
    </RelativeLayout>
</RelativeLayout>