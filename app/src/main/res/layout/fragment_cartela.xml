<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCartelaFragmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_colunas_super_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cinza"
        android:visibility="gone">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/cl_super_sete_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolBar">

            <TextView
                android:id="@+id/tv_colunas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/superseteclaro"
                android:fontFamily="@font/futura_std_bold"
                android:padding="10dp"
                android:text="Colunas"
                android:textAlignment="center"
                android:textColor="@color/branco"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/ll_numeros_colunas_super_sete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@color/branco"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tv_colunas">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:fontFamily="@font/futura_std_bold"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/branco" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:fontFamily="@font/futura_std_bold"
                    android:gravity="center"

                    android:text="2"
                    android:textColor="@color/branco" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:fontFamily="@font/futura_std_bold"

                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/branco" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:fontFamily="@font/futura_std_bold"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/branco" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:fontFamily="@font/futura_std_bold"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/branco" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:fontFamily="@font/futura_std_bold"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="@color/branco" />

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_text_view_colunas"
                    android:fontFamily="@font/futura_std_bold"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="@color/branco" />
            </LinearLayout>
        </android.support.constraint.ConstraintLayout>


    </RelativeLayout>

    <ScrollView
        android:id="@+id/cartelaFragmentScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_colunas_super_7"
        android:fillViewport="false"
        android:orientation="vertical">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/cartelaFragmentMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco">

            <android.support.constraint.ConstraintLayout
                android:id="@+id/cltGeral"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/layotLabelEscolhaNumeros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent">

                    <RelativeLayout
                        android:id="@+id/ttvLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/ttvEscolha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_marginTop="41dp"
                            tools:text="@string/dia_sorte_escolha_dia" />

                        <TextView
                            android:id="@+id/ttvPagina"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_alignTop="@+id/ttvEscolha"
                            android:layout_alignBottom="@+id/ttvEscolha"
                            android:layout_toStartOf="@+id/ttvPaginaQuantidade"
                            android:text="@string/label_numerico_um" />

                        <TextView
                            android:id="@+id/ttvPaginaQuantidade"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_alignTop="@+id/ttvEscolha"
                            android:layout_alignBottom="@+id/ttvEscolha"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="0dp"
                            android:layout_marginEnd="24dp"
                            tools:text=" | 2" />
                    </RelativeLayout>
                </LinearLayout>


                <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                    android:id="@+id/listaDezenas"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="10dp"
                    android:columnWidth="50dp"
                    android:gravity="center"
                    android:horizontalSpacing="16dp"
                    android:numColumns="auto_fit"
                    android:paddingLeft="10dp"
                    android:paddingTop="40dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="119dp"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="10dp"
                    app:layout_constraintTop_toBottomOf="@+id/layotLabelEscolhaNumeros" />

                <ScrollView
                    android:id="@+id/sv_super_sete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/layotLabelEscolhaNumeros">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="600dp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:layout_marginTop="50dp"
                        android:layout_marginRight="5dp"
                        android:layout_marginBottom="100dp"
                        android:orientation="horizontal">

                        <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                            android:id="@+id/ehgv_super_sete_primeiro"
                            android:layout_width="wrap_content"
                            android:layout_height="500dp"
                            android:layout_weight="1"
                            android:alpha="0.5"
                            android:layout_margin="3dp"
                            android:background="@color/supersete_claro_transparente"
                            android:columnWidth="50dp"
                            android:gravity="center"
                            android:isScrollContainer="false"
                            android:numColumns="1"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="10dp" />

                        <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                            android:id="@+id/ehgv_super_sete_segundo"
                            android:layout_width="wrap_content"
                            android:layout_height="500dp"
                            android:layout_weight="1"
                            android:alpha="0.5"
                            android:layout_margin="3dp"
                            android:background="@color/supersete_claro_transparente"
                            android:columnWidth="50dp"
                            android:gravity="center"
                            android:isScrollContainer="false"
                            android:numColumns="1"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="10dp" />

                        <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                            android:id="@+id/ehgv_super_sete_terceiro"
                            android:layout_width="wrap_content"
                            android:layout_height="500dp"
                            android:layout_weight="1"
                            android:alpha="0.5"
                            android:layout_margin="3dp"
                            android:background="@color/supersete_claro_transparente"
                            android:columnWidth="50dp"
                            android:gravity="center"
                            android:isScrollContainer="false"
                            android:numColumns="1"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="10dp" />

                        <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                            android:id="@+id/ehgv_super_sete_quarto"
                            android:layout_width="wrap_content"
                            android:layout_height="500dp"
                            android:layout_weight="1"
                            android:alpha="0.5"
                            android:layout_margin="3dp"
                            android:background="@color/supersete_claro_transparente"
                            android:columnWidth="50dp"
                            android:gravity="center"
                            android:isScrollContainer="false"
                            android:numColumns="1"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="10dp" />

                        <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                            android:id="@+id/ehgv_super_sete_quinto"
                            android:layout_width="wrap_content"
                            android:layout_height="500dp"
                            android:layout_weight="1"
                            android:alpha="0.5"
                            android:layout_margin="3dp"
                            android:background="@color/supersete_claro_transparente"
                            android:columnWidth="50dp"
                            android:gravity="center"
                            android:isScrollContainer="false"
                            android:numColumns="1"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="10dp" />

                        <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                            android:id="@+id/ehgv_super_sete_sexto"
                            android:layout_width="wrap_content"
                            android:layout_height="500dp"
                            android:layout_weight="1"
                            android:alpha="0.5"
                            android:layout_margin="3dp"
                            android:background="@color/supersete_claro_transparente"
                            android:columnWidth="50dp"
                            android:gravity="center"
                            android:isScrollContainer="false"
                            android:numColumns="1"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="10dp" />

                        <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                            android:id="@+id/ehgv_super_sete_setimo"
                            android:layout_width="wrap_content"
                            android:layout_height="500dp"
                            android:layout_weight="1"
                            android:alpha="0.5"
                            android:layout_margin="3dp"
                            android:background="@color/supersete_claro_transparente"
                            android:columnWidth="50dp"
                            android:gravity="center"
                            android:isScrollContainer="false"
                            android:numColumns="1"
                            android:scrollbars="none"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="10dp" />
                    </LinearLayout>
                </ScrollView>
            </android.support.constraint.ConstraintLayout>

            <LinearLayout
                android:id="@+id/selecioneTimeCoracao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="81dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible">

                <TextView
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:text="@string/label_nome_do_seu_time"
                    android:textColor="@color/azulFormNovoTipoPagamento"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/informe_nome_time"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="45dp"
                    android:layout_marginRight="45dp"
                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                    android:textSize="16sp" />

                <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightGridView
                    android:id="@+id/gridTimes"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="10dp"
                    android:gravity="center"
                    android:nestedScrollingEnabled="false"
                    android:numColumns="3"
                    android:paddingBottom="119dp"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="16dp"
                    app:layout_goneMarginBottom="10dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutRecyclerViewPartida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/selecioneTimeCoracao">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/layoutTitleLoteca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:focusableInTouchMode="true"
                        android:orientation="horizontal"
                        android:paddingTop="20dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/titleInformeBold"
                            style="@style/ArialMT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_informe"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/titleContinue"
                            style="@style/ArialMT"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="20dp"
                            android:text="@string/label_resultado_das_partidas"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <br.gov.caixa.loterias.apostar.interno.view.custom.ExpandableHeightRecyclerView
                        android:id="@+id/recyclerViewPartida"
                        android:layout_width="wrap_content"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:clickable="false"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        android:paddingBottom="119dp" />
                </LinearLayout>
            </LinearLayout>
        </android.support.constraint.ConstraintLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/opcaoOutrosNumerosLayout"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="@color/cinza"
        android:clickable="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <android.support.v7.widget.AppCompatCheckBox
            android:id="@+id/selcioneOutrosNumeros"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/check_box_selected"
            android:button="@color/verdeagua"
            android:clickable="false" />

        <TextView
            android:id="@+id/infoSelecioneOutrosNumeros"
            style="@style/ArialMT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="16dp"
            android:layout_toRightOf="@+id/selcioneOutrosNumeros"
            android:textColor="@color/branco"
            android:textSize="14sp" />
    </RelativeLayout>
</RelativeLayout>