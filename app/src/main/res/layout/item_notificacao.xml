<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/badgeNaoLida"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:background="@drawable/badge_nao_lida"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTituloNotificacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cinza130"
                android:fontFamily="@font/caixa_std_semi_bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/textMensagemNotificacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/cinza110"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="14sp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnExcluirNotificacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/excluir_notificacao"
            android:src="@drawable/lixeira_notificacao"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/linhaDivisa"/>

</LinearLayout>
