<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="@drawable/ic_background_somador_carrinho"
    tools:context=".view.fragment.SomadorCarrinhoFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:text="@string/valor_atual_do_carrinho"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:fontFamily="@font/font_family_futura"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guideline2"
        app:layout_constraintStart_toEndOf="@+id/tv_valor_total"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_valor_total"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:text="R$ 00,00"
        android:textColor="@color/branco"
        android:textSize="16sp"
        android:textStyle="bold"
        android:lineSpacingExtra="1sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_carrinho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_somador_carrinho"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp"/>

    <ImageView
        android:id="@+id/circulo_quantidade"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/ic_shape_oval"
        android:backgroundTint="#FDAB01"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_carrinho"
        app:layout_constraintStart_toEndOf="@+id/iv_carrinho"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/tv_quantidade_apostas"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:text="0"
        android:textSize="7sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_family_futura"
        android:lineHeight="10dp"
        app:layout_constraintTop_toTopOf="@id/circulo_quantidade"
        app:layout_constraintStart_toStartOf="@id/circulo_quantidade"
        app:layout_constraintBottom_toBottomOf="@id/circulo_quantidade"
        app:layout_constraintEnd_toEndOf="@id/circulo_quantidade"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.8" />
    app:layout_constraintGuide_percent="0.85" />


</androidx.constraintlayout.widget.ConstraintLayout>