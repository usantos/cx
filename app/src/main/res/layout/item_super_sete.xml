<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:id="@+id/numero_jogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Jogo 1"
        android:layout_margin="16dp"
        android:textColor="@color/super_sete_letra_mkp"
        android:fontFamily="@font/caixa_std_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/colunas_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Colunas"
        android:textColor="@color/super_sete_letra_mkp"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/numero_jogo"
        app:layout_constraintStart_toStartOf="@id/numero_jogo"/>

        <TextView
            android:id="@+id/coluna_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="@color/branco"
            android:background="@color/super_sete_escuro_mkp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/colunas_txt"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/coluna_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="2"
            android:textColor="@color/branco"
            android:background="@color/super_sete_escuro_mkp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/colunas_txt"
            app:layout_constraintStart_toEndOf="@id/coluna_1"/>

        <TextView
            android:id="@+id/coluna_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="@color/branco"
            android:background="@color/super_sete_escuro_mkp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/colunas_txt"
            app:layout_constraintStart_toEndOf="@id/coluna_2"/>

        <TextView
            android:id="@+id/coluna_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="4"
            android:textColor="@color/branco"
            android:background="@color/super_sete_escuro_mkp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/colunas_txt"
            app:layout_constraintStart_toEndOf="@id/coluna_3"/>

        <TextView
            android:id="@+id/coluna_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="5"
            android:textColor="@color/branco"
            android:background="@color/super_sete_escuro_mkp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/colunas_txt"
            app:layout_constraintStart_toEndOf="@id/coluna_4"/>

        <TextView
            android:id="@+id/coluna_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="6"
            android:textColor="@color/branco"
            android:background="@color/super_sete_escuro_mkp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/colunas_txt"
            app:layout_constraintStart_toEndOf="@id/coluna_5"/>

        <TextView
            android:id="@+id/coluna_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="7"
            android:textColor="@color/branco"
            android:background="@color/super_sete_escuro_mkp"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/colunas_txt"
            app:layout_constraintStart_toEndOf="@id/coluna_6"/>

    <TextView
        android:id="@+id/numeros_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Números"
        android:textColor="@color/super_sete_letra_mkp"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/coluna_1"
        app:layout_constraintStart_toStartOf="@id/numero_jogo"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_coluna_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dezena_detalhe"
            app:spanCount="1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toBottomOf="@id/numeros_txt"
            app:layout_constraintStart_toStartOf="@id/coluna_1"
            app:layout_constraintEnd_toEndOf="@id/coluna_1"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_coluna_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dezena_detalhe"
            app:spanCount="1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/numeros_txt"
            app:layout_constraintStart_toStartOf="@id/coluna_2"
            app:layout_constraintEnd_toEndOf="@id/coluna_2"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_coluna_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dezena_detalhe"
            app:spanCount="1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            app:layout_constraintTop_toBottomOf="@id/numeros_txt"
            app:layout_constraintStart_toStartOf="@id/coluna_3"
            app:layout_constraintEnd_toEndOf="@id/coluna_3"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_coluna_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dezena_detalhe"
            app:spanCount="1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            app:layout_constraintTop_toBottomOf="@id/numeros_txt"
            app:layout_constraintStart_toStartOf="@id/coluna_4"
            app:layout_constraintEnd_toEndOf="@id/coluna_4"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_coluna_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dezena_detalhe"
            app:spanCount="1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            app:layout_constraintTop_toBottomOf="@id/numeros_txt"
            app:layout_constraintStart_toStartOf="@id/coluna_5"
            app:layout_constraintEnd_toEndOf="@id/coluna_5"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_coluna_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dezena_detalhe"
            app:spanCount="1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            app:layout_constraintTop_toBottomOf="@id/numeros_txt"
            app:layout_constraintStart_toStartOf="@id/coluna_6"
            app:layout_constraintEnd_toEndOf="@id/coluna_6"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista_coluna_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:listitem="@layout/item_dezena_detalhe"
            app:spanCount="1"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            app:layout_constraintTop_toBottomOf="@id/numeros_txt"
            app:layout_constraintStart_toStartOf="@id/coluna_7"
            app:layout_constraintEnd_toEndOf="@id/coluna_7"/>

</androidx.constraintlayout.widget.ConstraintLayout>