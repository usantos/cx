<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.gov.caixa.loterias.apostas.controllers.ResgatePremioLotericaAgenciaActivity">

    <include layout="@layout/app_bar_degrade_pesquisa" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/gl_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_background_qr"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/azulfavoritas"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_desc_qr_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintTop_toBottomOf="@id/cl_background_qr"
                tools:text="@string/rsgt_lt_msg_qr_valido" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@color/branco"
                android:gravity="center"
                android:textColor="@color/verde_card"
                android:textSize="25sp"
                android:fontFamily="@font/caixa_std_bold"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tv_desc_qr_code"
                tools:text="05:00" />

            <Button
                android:id="@+id/btn_nova_aposta"
                android:layout_width="183dp"
                android:layout_height="56dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp"
                android:background="@drawable/button_white_with_green_border"
                android:text="@string/rsgt_lt_btn_gerar"
                android:textAllCaps="false"
                android:textColor="@color/verdeazul"
                android:textSize="16sp"
                android:fontFamily="@font/caixa_std_bold"
                android:visibility="gone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc_qr_code" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/br_divisao"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tv_timer,btn_nova_aposta" />

            <View
                android:id="@+id/v_divisao"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="@color/cinza2"
                app:layout_constraintTop_toBottomOf="@id/br_divisao" />

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_divisao">

                <ScrollView
                    android:id="@+id/resgatePremioLotericaAgenciaScrool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="30dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/activity_vertical_margin"
                            android:layout_marginTop="39dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/enumeradorUmText"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_linha_divisiva"
                                android:gravity="center"
                                android:text="@string/label_numerico_um"
                                android:textColor="@color/colorAccent"
                                android:textSize="17.5sp"
                                android:fontFamily="@font/caixa_std_bold"/>

                            <TextView
                                android:id="@+id/informacaoTopicoUmText"
                                style="@style/ArialMT"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/text_margin_small"
                                android:layout_marginTop="@dimen/text_margin_20"
                                android:layout_marginEnd="@dimen/activity_horizontal_margin"
                                android:layout_toEndOf="@+id/enumeradorUmText"
                                android:gravity="center_vertical"
                                android:text="@string/label_diriga_unidade_loterica_preferencia"
                                android:textColor="@color/cinza"
                                android:textSize="16sp"
                                android:fontFamily="@font/caixa_std_bold"/>

                        </RelativeLayout>

                        <ImageView
                            android:id="@+id/qrCodeApostaImage"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:layout_marginLeft="58dp"
                            android:visibility="gone" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/activity_vertical_margin"
                            android:layout_marginTop="35dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/enumeradorDoisText"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_linha_divisiva"
                                android:gravity="center"
                                android:text="@string/label_numerico_dois"
                                android:textColor="@color/colorAccent"
                                android:textSize="17.5sp"
                                android:fontFamily="@font/caixa_std_bold"/>

                            <TextView
                                android:id="@+id/informacaoTopicoDoisText"
                                style="@style/ArialMT"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/text_margin_small"
                                android:layout_marginTop="@dimen/text_margin_20"
                                android:layout_marginEnd="@dimen/activity_vertical_margin"
                                android:layout_toEndOf="@+id/enumeradorDoisText"
                                android:gravity="center_vertical"
                                android:text="@string/label_apresente_qr_code_acima"
                                android:textColor="@color/cinza"
                                android:textSize="16sp"
                                android:fontFamily="@font/caixa_std_bold"/>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/activity_vertical_margin"
                            android:layout_marginTop="39dp"
                            android:layout_marginBottom="@dimen/activity_vertical_margin"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/enumeradorTresText"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_linha_divisiva"
                                android:gravity="center"
                                android:text="@string/label_numerico_tres"
                                android:textColor="@color/colorAccent"
                                android:textSize="17.5sp"
                                android:fontFamily="@font/caixa_std_bold"/>

                            <TextView
                                android:id="@+id/tv_topico_3"
                                style="@style/ArialMT"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/text_margin_small"
                                android:layout_marginTop="@dimen/text_margin_20"
                                android:layout_marginEnd="@dimen/activity_vertical_margin"
                                android:layout_toEndOf="@+id/enumeradorTresText"
                                android:gravity="center_vertical"
                                android:textColor="@color/cinza"
                                android:textSize="16sp"
                                android:fontFamily="@font/caixa_std_bold"
                                tools:text="texto 03" />

                        </RelativeLayout>
                    </LinearLayout>

                </ScrollView>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
