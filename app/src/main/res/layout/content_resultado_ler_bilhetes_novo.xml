<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resultadoApostaNovoScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.ResultadoLerBilhetesNovoActivity"
    tools:showIn="@layout/activity_resultado_ler_bilhetes_novo">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentResultadosBilhete"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/nsgTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="NSB DO BILHETE"
            android:textStyle="bold"
            android:textColor="@color/jr_azul_text_title"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nsbValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="3312231123123123132132312132"
            android:textStyle="bold"
            android:textColor="@color/jr_azul_text_title"
            app:layout_constraintTop_toBottomOf="@+id/nsgTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/tableLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="25dp"
            android:padding="5dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/nsbValor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >

                <TextView
                    android:text="Concurso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_weight="0.20"
                    android:gravity="center"
                    android:textColor="@color/black"/>

                <TextView
                    android:text="Situação"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_weight="0.20"
                    android:gravity="center"
                    android:textColor="@color/black"/>


                <TextView
                    android:text="Acertos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_weight="0.20"
                    android:gravity="center"
                    android:textColor="@color/black"/>


                <TextView
                    android:text="Qtde."
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_weight="0.20"
                    android:gravity="center"
                    android:textColor="@color/black"/>


                <TextView
                    android:text="Valor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_weight="0.20"
                    android:gravity="center"
                    android:textColor="@color/black"/>

            </TableRow>

        </TableLayout>

        <TextView
            android:id="@+id/valorTotalPremiacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold"
            android:text="Valor Total da Premiação:"
            android:textColor="@color/jr_azul_text_title"
            android:layout_marginTop="35dp"
            app:layout_constraintTop_toBottomOf="@+id/tableLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />



    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
