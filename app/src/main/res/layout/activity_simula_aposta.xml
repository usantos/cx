<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    tools:context="br.gov.caixa.loterias.apostas.controllers.SimularApostaActivity">

    <FrameLayout
        android:id="@+id/id_fg_barra_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/id_fg_barra_titulo"
        >

        <LinearLayout
            android:id="@+id/toolBarSimularAposta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/azulclaro"
            android:orientation="horizontal"
            android:weightSum="1"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutFragments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/simularTelaAposta"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="17dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/icon_seleciona2" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/surpresinhaTela"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/icon_surpresinha" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/layoutPrognosticoTeimosinha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:gravity="right"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/qtdNumerosButton"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentLeft="true"
                    android:fontFamily="@font/caixa_std_regular"
                    android:gravity="center_vertical"
                    android:paddingLeft="3dp"
                    android:text="@string/um_concurso"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageQtdNumerosButton"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_alignRight="@+id/qtdNumerosButton"
                    android:layout_marginTop="25dp"
                    android:src="@drawable/combo2" />

                <Button
                    android:id="@+id/qtdConcursosButton"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="10dp"
                    android:fontFamily="@font/caixa_std_regular"
                    android:gravity="center_vertical"
                    android:paddingLeft="3dp"
                    android:text="@string/label_sem_teimosinha"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageQtdConcursosButton"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="25dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/combo2" />
            </RelativeLayout>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolBarLoteca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/drawer_linha_divisao_bg"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/labelExplicaSuasApostas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="17dp"
                android:layout_marginEnd="17dp"
                android:paddingTop="5dp"
                android:text="@string/label_suas_apostas_explica"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="12dp"
                android:textColor="@color/cinza"
                app:layout_constraintEnd_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelTituloLoteca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:paddingTop="8dp"
                android:text="@string/label_suas_apostas"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_bold"
                android:textColor="@color/cinza"
                app:layout_constraintStart_toStartOf="@id/labelExplicaSuasApostas"
                app:layout_constraintTop_toBottomOf="@id/labelExplicaSuasApostas" />

            <TextView
                android:id="@+id/labelJogosLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/label_jogos"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/cinza"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="52dp"
                android:paddingTop="8dp"
                android:text="@string/label_dois_pontos"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
                />

            <TextView
                android:id="@+id/labelValueJogosLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="65dp"
                android:paddingTop="6dp"
                android:text="@string/zero"
                android:textColor="@color/loteca_claro_mkp"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />

            <TextView
                android:id="@+id/labelSimplesLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:paddingLeft="95dp"
                android:paddingTop="8dp"
                android:text="@string/label_simples"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/cinza"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
                 />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="147dp"
                android:paddingTop="8dp"
                android:text="@string/label_dois_pontos"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />

            <TextView
                android:id="@+id/labelValueSimplesLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="155dp"
                android:paddingTop="6dp"
                android:text="@string/zero"
                android:textColor="@color/loteca_claro_mkp"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />

            <TextView
                android:id="@+id/labelDuplasLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="180dp"
                android:paddingTop="8dp"
                android:text="@string/label_duplas"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/cinza"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="227dp"
                android:paddingTop="8dp"
                android:text="@string/label_dois_pontos"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />

            <TextView
                android:id="@+id/labelValueDuplasLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="232dp"
                android:paddingTop="6dp"
                android:text="@string/zero"
                android:textColor="@color/loteca_claro_mkp"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
             />

            <TextView
                android:id="@+id/labelTriplasLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="260dp"
                android:paddingTop="8dp"
                android:text="@string/label_triplas"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/cinza"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="305dp"
                android:paddingTop="8dp"
                android:text="@string/label_dois_pontos"
                android:textColor="@color/cinza"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />

            <TextView
                android:id="@+id/labelValueTriplasLoteca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="315dp"
                android:paddingTop="6dp"
                android:text="@string/zero"
                android:textColor="@color/loteca_claro_mkp"
                android:textSize="18sp"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintStart_toStartOf="@id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="@id/labelTituloLoteca" />
            />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/paginacaoView"
        android:layout_height="60dp"
        android:layout_width="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolBar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerSurpresinha"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/id_fg_barra_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/rodape_simula">

        <include
            android:id="@+id/simulaToolbar"
            layout="@layout/simula_toolbar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/simulaToolbar"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuantidadeNumeros"
                android:layout_width="wrap_content"
                android:minWidth="100dp"
                android:layout_height="40dp"
                android:text="6 números"
                android:textAllCaps="false"
                android:padding="4dp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@android:color/white"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_down"
                app:iconGravity="textEnd"
                app:iconTint="@android:color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTeimosinha"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:minWidth="100dp"
                android:text="Teimosinha"
                android:textAllCaps="false"
                android:padding="4dp"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/cinza110"
                app:backgroundTint="@android:color/white"
                app:strokeColor="@color/cinza"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_down"
                app:iconGravity="textEnd"
                app:iconTint="@color/cinza110"/>

        </LinearLayout>

        <TextView
            android:id="@+id/textSelecionados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecione os números:"
            android:textColor="@color/cinza110"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintTop_toBottomOf="@id/layoutFiltros"
            app:layout_constraintStart_toStartOf="parent"/>

        <FrameLayout
            android:id="@+id/fragmentSimularApostas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/textSelecionados"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <RelativeLayout
        android:id="@+id/layoutSalvarApostaLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@color/cinza"
        android:clickable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/botaoLimparAposta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <RelativeLayout
            android:id="@+id/salvarApostaLayout"
            android:layout_width="184dp"
            android:layout_height="140dp"
            android:visibility="gone"
            tools:visibility="gone">

            <RelativeLayout
                android:layout_width="152dp"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/textoDeNomeInfo"
                android:layout_alignStart="@+id/textoDeNomeInfo"
                android:layout_below="@+id/textoDeNomeInfo"
                android:layout_marginTop="10dp">

                <ImageButton
                    android:id="@+id/btnSalvarAposta"
                    android:layout_width="20dp"
                    android:visibility="gone"

                    android:layout_height="20dp"
                    android:layout_centerInParent="true"

                    android:layout_marginLeft="7dp"
                    android:layout_marginStart="7dp"
                    android:layout_toEndOf="@+id/editNomeAposta"
                    android:layout_toRightOf="@+id/editNomeAposta"
                    android:background="@drawable/seta_verde" />

                <EditText
                    android:id="@+id/editNomeAposta"
                    android:layout_width="125dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:backgroundTint="@color/branco"
                    android:visibility="gone"
                    android:inputType="textNoSuggestions"
                    android:paddingBottom="7dp"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:text=""
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_regular"
                    android:textCursorDrawable="@null"
                    android:textSize="16sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/textoDeNomeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/iconStarSalvar"
                android:visibility="gone"
                android:layout_alignStart="@+id/iconStarSalvar"
                android:layout_below="@+id/textoSalveEstaAposta"
                android:layout_marginTop="29dp"
                android:text="@string/label_de_nome"
                android:textColor="@color/verdeazul"
                android:textSize="12sp"
                android:fontFamily="@font/caixa_std_regular"/>

            <TextView
                android:id="@+id/textoSalveEstaAposta"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:layout_alignBottom="@+id/iconStarSalvar"
                android:layout_marginLeft="5dp"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/iconStarSalvar"
                android:layout_toRightOf="@+id/iconStarSalvar"
                android:gravity="center_vertical"
                android:padding="0dp"
                android:visibility="gone"

                android:text="@string/tituloSalvarAposta"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_regular"/>

            <ImageView
                android:id="@+id/iconStarSalvar"
                android:layout_width="21dp"
                android:visibility="gone"

                android:layout_height="21dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                app:srcCompat="@drawable/icon_favoritar" />
        </RelativeLayout>
    </RelativeLayout>

    <Button
        android:id="@+id/botaoLimparAposta"
        android:layout_width="184dp"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_white_with_border"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:visibility="gone"
        android:text="@string/limparAposta"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/cinza"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintBottom_toTopOf="@+id/botaoAdicionarCompletarCartela"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/botaoAdicionarCompletarCartela"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginBottom="51dp"
        android:background="@color/cinzaescuro"
        android:elevation="15dp"
        android:visibility="gone"
        android:text="@string/adicionarAoCarrinho"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintBottom_toTopOf="@id/rodape_simula"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <include
        android:id="@+id/rodape_simula"
        layout="@layout/rodape_simula"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <FrameLayout
        android:id="@+id/id_fg_rodape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
