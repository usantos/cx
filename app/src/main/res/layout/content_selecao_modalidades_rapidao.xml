<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="caixa.gov.br.loterias.view.SelecaoModalidadesRapidaoActivity"
    tools:showIn="@layout/activity_selecao_modalidades_rapidao">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="135dp"
            android:id="@+id/scrollViewSelecaoModalidadesRapidao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modalidades"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textAlignment="center"
                    android:layout_marginTop="40dp"
                    android:textColor="@color/verdeagua"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    >
                    <TextView
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:text="Selecione as opções que você quer contemplar no Rapidão."
                        android:textSize="14sp"
                        android:textColor="@color/cinza"
                        android:layout_centerHorizontal="true"
                        android:textAlignment="center"
                        style="@style/editTextArialMTTheme"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp">
                    <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
                        android:id="@+id/gridviewTiposApostasRapidaoSelecionar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:numColumns="2"
                        android:verticalSpacing="17dp"
                        android:horizontalSpacing="10dp"
                        android:layout_marginTop="19dp"
                        android:isScrollContainer="false"
                        />


                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:orientation="vertical"
            android:layout_alignParentBottom="true">
            <Button
                android:layout_width="184dp"
                android:layout_height="84dp"
                android:background="@color/cinzaclaro"
                android:textColor="@color/branco"
                android:textSize="17.7sp"
                android:textStyle="bold"
                android:text="Salvar"
                android:textAllCaps="false"
                android:layout_centerHorizontal="true"
                android:id="@+id/salvarModalidadesApostaRapidaoSelececao"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:background="@color/linhaDivisa"
                android:layout_marginTop="44dp"
                >

            </View>

        </RelativeLayout>
    </RelativeLayout>
</android.support.constraint.ConstraintLayout>
