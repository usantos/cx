<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/id_modalidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="lotofacil"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/id_concurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Conc. 3226"
        android:textColor="@color/bolao_azul_subtitulo"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/id_valor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="R$ 3,00"
        android:textColor="@color/bolao_azul_subtitulo"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/id_lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/item_dezena_combo_detalhe"
        tools:spanCount="6"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/id_modalidade"
        app:layout_constraintStart_toStartOf="@id/id_modalidade"
        app:layout_constraintEnd_toEndOf="@id/id_valor"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_dia_sorte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/id_lista">

        <ImageView
            android:id="@+id/id_img_calendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/rectangle_6_copy_5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/interrogacoes"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="@color/dia_sorte_claro_mkp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/id_img_calendar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_timemania"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/id_lista">

        <ImageView
            android:id="@+id/id_img_time"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="16dp"
            android:background="@drawable/ic_timecoracao"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/interrogacoes"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="@color/timemania_letra_mkp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/id_img_time"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_mais_milionaria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/id_lista">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/id_lista_trevos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_dezena_combo_detalhe"
            tools:spanCount="6"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>