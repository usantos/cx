<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:mask="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.InsercaoManualCodBarrasActivity"
    tools:showIn="@layout/activity_insercao_manual_cod_barras"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_informeNumBilhete"
        android:textColor="@color/colorAccent"
        android:fontFamily="@font/caixa_std_bold"
        android:textSize="14.2sp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="40dp"
        android:textColorHint="@color/verdeazul">

        <EditText
            android:id="@+id/editTextNumeroBilhete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:inputType="text"
            android:hint="NSB"
            android:ems="25"
            android:fontFamily="@font/caixa_std_regular"
            android:textColorHint="@color/verdeazul"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout_password2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:textColorHint="@color/verdeazul">

        <EditText
            android:id="@+id/editTextLoterico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:inputType="text"
            android:hint="Lotérico"
            android:ems="11"
            android:fontFamily="@font/caixa_std_regular"
            android:textColorHint="@color/verdeazul"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginHorizontal="20dp"
        android:text="@string/title_continuar"
        android:textAllCaps="false"
        android:layout_marginTop="49dp"
        android:fontFamily="@font/caixa_std_bold"
        android:textSize="16sp"
        android:id="@+id/buttonContinuarInsercaoManualBilhetes"
        android:enabled="false"
        android:textColor="@color/cinzaDisable"
        android:background="@color/cinzaclaro"

        />

</LinearLayout>
