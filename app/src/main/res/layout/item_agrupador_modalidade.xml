<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <LinearLayout
        android:id="@+id/linearLayoutTopModalidades"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@color/mega_verde_claro_mkp"
        android:layout_marginTop="15dp"
        android:gravity="left"
        android:orientation="horizontal">

        <RelativeLayout
            android:id="@+id/RelativeLayoutTrevo"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:background="@drawable/background_trapeze_megasena">

            <ImageView
                android:id="@+id/trevoImagem"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/trevo" />
        </RelativeLayout>

        <TextView
            android:id="@+id/textViewCardTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:textColor="@color/branco"
            android:textSize="20sp"
            tools:text="mega sena"
            android:fontFamily="@font/futura_std_bold"/>
    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApostas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />
</LinearLayout>