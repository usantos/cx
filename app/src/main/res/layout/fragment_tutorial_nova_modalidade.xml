<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TutorialMaisMilionariaActivity">

    <Button
        android:id="@+id/tv_fechar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tutorial_fechar"
        android:textColor="@color/cinza_tutorial"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/transparente"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/tv_pular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tutorial_pular"
        android:textColor="@color/cinza_tutorial"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/transparente"
        android:textAllCaps="false" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_tutorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/ci_tutorial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/center_view_pager"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/vp_tutorial"
        app:layout_constraintBottom_toBottomOf="@id/vp_tutorial"/>

    <Button
        android:id="@+id/btn_principal"
        android:layout_width="164dp"
        android:layout_height="wrap_content"
        android:elevation="15dp"
        android:text="@string/vamos_comecar"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:background="@drawable/rounded_card"
        android:backgroundTint="@color/verde_tutorial"
        android:padding="16dp"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/center_view_pager"
        app:layout_constraintBottom_toBottomOf="@id/vp_tutorial"/>

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/checkboxMostrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/check_box_tutorial"
        android:checked="false"
        android:text="  Não exibir novamente"
        android:textColor="@color/branco"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/btn_principal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <me.relex.circleindicator.CircleIndicator
        android:id="@+id/ci_tutorial"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:visibility="visible"
        app:ci_drawable="@drawable/tutorial_circle_selected"
        app:ci_drawable_unselected="@drawable/tutorial_cicrcle_unselected"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>