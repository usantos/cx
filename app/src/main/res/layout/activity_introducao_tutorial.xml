<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/milionaria_escuro_mkp"
    tools:context=".IntroducaoTutorialActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chegou_a_milionaria"
        android:textColor="@color/branco"
        android:fontFamily="@font/futura_std_bold"
        android:textAlignment="center"
        android:textSize="28sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/descricao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/descricao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conheca_mais_milionaria"
        android:textColor="@color/branco"
        android:textAlignment="center"
        android:fontFamily="@font/futura_std_book"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/idCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/idCentro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="1dp"
        android:layout_width="match_parent"/>

    <Button
        android:id="@+id/btnComecar"
        android:layout_width="180dp"
        android:layout_height="84dp"
        android:background="@color/verde_tutorial"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textAlignment="center"
        android:layout_marginBottom="16dp"
        android:textSize="16sp"
        tools:text="@string/comecar_tutorial"
        app:layout_constraintBottom_toTopOf="@+id/checkVerNovamente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/checkVerNovamente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/idCentro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkboxMostrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/check_box_tutorial"
            android:checked="false"
            android:text="  Não mostrar mais esse tutorial"
            android:textColor="@color/branco"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btnPular"
        android:layout_width="180dp"
        android:layout_height="64dp"
        android:background="@color/cinza_tutorial"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:layout_marginBottom="16dp"
        android:textSize="16sp"
        tools:text="@string/pular_tutorial"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>