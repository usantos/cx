<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="4dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/LinearLayoutContentTiposAposta"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@drawable/background_roudend_azul"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageviewTrevoTipoAposta"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:src="@drawable/trevo_duplasena" />

        <TextView
            android:id="@+id/tituloTipoApostaTextView"
            style="@style/FuturaStdBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:textColor="@color/branco"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            tools:text="@string/placeholder_dia_de_sorte" />

    </LinearLayout>

</LinearLayout>