<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/item_resultado_content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.yarolegovich.discretescrollview.DiscreteScrollView
            android:id="@+id/recyclerPartidasLotecas"
            android:layout_width="match_parent"
            android:layout_height="183dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="19dp"
            app:dsv_orientation="horizontal" />

        <View
            android:id="@+id/tracoViewDivisoriaResultado"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/megasenamedio" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/futura_std_bold"
            android:text="@string/label_premiados"
            android:textColor="@color/branco"
            android:textSize="15.8sp" />

        <LinearLayout
            android:id="@+id/linearlayoutPremiadosListaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

        </LinearLayout>

        <Button
            android:id="@+id/vejaDetalhesButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/button_border"
            android:textAllCaps="false"
            android:textColor="@color/branco" />
    </LinearLayout>

    <br.gov.caixa.loterias.apostar.interno.view.custom.PartidaViewDetalhesResultado_
        android:id="@+id/partidaViewDetalhesResultadoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>