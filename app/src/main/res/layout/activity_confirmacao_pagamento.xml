<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/confirmacaoPagamentoMainLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.gov.caixa.loterias.apostas.controllers.ConfirmacaoPagamentoActivity"
    android:background="@drawable/navigation_gradient">

    <ImageButton
        android:id="@+id/botao_termo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="fitXY"
        android:src="@drawable/duvidas_toolbar_icon"
        android:layout_marginTop="12dp"
        android:layout_marginRight="8dp"
        android:background="@color/transparente" />

    <TextView
        android:id="@+id/textInfoApostas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="67dp"
        android:layout_marginStart="57dp"
        android:layout_marginRight="51dp"
        android:layout_marginEnd="41dp"
        android:layout_marginTop="10dp"
        android:text="@string/confirmacaoPagamentoInfoApostas"
        android:textAlignment="center"
        android:textColor="@color/branco"
        app:layout_constraintLeft_toLeftOf="@+id/imageViewSetaParaApostas"
        app:layout_constraintRight_toRightOf="@+id/imageViewSetaParaApostas"
        app:layout_constraintTop_toTopOf="@+id/imageViewSetaParaApostas"
        app:layout_constraintHorizontal_bias="0.0"
        style="@style/editTextArialMTTheme"/>

    <View
        android:id="@+id/v_linha"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:background="@color/verdeazul"
        app:layout_constraintTop_toBottomOf="@id/textTitulo"
        app:layout_constraintBottom_toTopOf="@+id/textInfoApostas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageViewSetaParaApostas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="55dp"
        android:layout_marginBottom="106dp"
        android:rotation="180"
        android:scaleType="fitXY"
        android:scaleY="-1"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitulo"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/rectangle_5_copy" />

    <TextView
        android:id="@+id/textConfirmacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/confirmacao"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textStyle="bold"
        android:textSize="14.2sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="115dp"
        android:layout_marginRight="115dp"
        android:layout_marginTop="100dp"
        android:text="@string/confirmacaopagamentoParabens"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textStyle="bold"
        android:textSize="14.2sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewTabBar"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:background="@color/azulclaro"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <RelativeLayout
            android:id="@+id/carrinhoApostas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="13dp"
            android:visibility="gone"
            android:layout_marginRight="10dp"
            app:layout_constraintRight_toLeftOf="@+id/imageViewPaginacao"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/textViewCarrinhoCartelaCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/botaoCarrinho"
                android:layout_alignEnd="@+id/textInfoCarrinho"
                android:layout_alignRight="@+id/textInfoCarrinho"
                android:background="@drawable/rounded_textview"
                android:layout_marginRight="6dp"
                android:gravity="center"
                tools:text="0"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:outlineProvider="none"
                android:translationZ="3dp"/>

            <Button
                android:id="@+id/botaoCarrinho"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:background="@drawable/icon_apostas"
                android:layout_centerHorizontal="true"/>

            <TextView
                android:id="@+id/textInfoCarrinho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:text="@string/minhasApostas"
                android:textAlignment="center"
                android:textColor="@color/azulescuro"
                android:textSize="12sp"
                style="@style/editTextArialMTTheme"/>


        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <Button
        android:id="@+id/botaoAcompanheSuasCompras"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_border"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        tools:text="@string/label_acompanhe_suas_compras"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@+id/botaoVoltarInicio"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />


    <Button
        android:id="@+id/botaoVoltarInicio"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginBottom="51dp"
        android:layout_marginEnd="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginStart="8dp"
        android:background="@color/verdeazul"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/btn_title_voltarAoInicio"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@+id/viewTabBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
