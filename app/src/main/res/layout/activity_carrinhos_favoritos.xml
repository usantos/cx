<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.CarrinhosFavoritosActivity">

    <TextView
        android:id="@+id/tv_subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:fontFamily="@font/futura_std_bold"
        android:text="@string/carrinho_fav_subtitulo"
        android:textColor="@color/azulescuro"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_descricao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:fontFamily="@font/font_family_futura"
        android:text="@string/carrinho_fav_lbl_desc"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitulo" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/rv_carrinhos_favoritos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="20dp"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_descricao"
        app:layout_constraintBottom_toBottomOf="parent"/>

</android.support.constraint.ConstraintLayout>