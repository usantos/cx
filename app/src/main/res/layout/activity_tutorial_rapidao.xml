<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.TutorialRapidaoActivity">

    <include
        layout="@layout/app_bar_degrade" />

    <android.support.v4.view.ViewPager
        android:id="@+id/vp_rapidao"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize" />

    <me.relex.circleindicator.CircleIndicator
        android:id="@+id/ci_rapidao"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true"
        android:visibility="visible"
        app:ci_drawable="@drawable/custom_circle_selected"
        app:ci_drawable_unselected="@drawable/custom_circle_unselected"
        app:layout_constraintBottom_toBottomOf="parent" />

</android.support.constraint.ConstraintLayout>