<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bolao_gray_stroke"
    tools:context="br.gov.caixa.loterias.apostas.controllers.AutoSuspensaoActivity">

    <include layout="@layout/app_bar_degrade" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardSuspensao"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@+id/gl_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imagemAtencao"
                android:layout_width="72dp"
                android:layout_height="89dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_atencao"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAtencaoAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-35dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/label_atencao"
                android:textSize="18sp"
                android:textColor="@color/blue_caixa"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imagemAtencao"
                />

            <TextView
                android:id="@+id/tvSuspensao1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/tv_autosuspensao_1"
                android:textSize="16sp"
                android:textColor="@color/blue_caixa"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imagemAtencao"
                />

            <TextView
                android:id="@+id/tvSuspensao2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/tv_autosuspensao_2"
                android:textSize="16sp"
                android:textColor="@color/blue_caixa"
                android:textStyle="normal"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintTop_toBottomOf="@+id/tvSuspensao1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/tvSuspensao3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/tv_autosuspensao_3"
                android:textSize="16sp"
                android:textColor="@color/blue_caixa"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintTop_toBottomOf="@+id/tvSuspensao2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/tvSuspensao4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/tv_autosuspensao_4"
                android:textSize="16sp"
                android:textColor="@color/blue_caixa"
                android:fontFamily="@font/caixa_std_regular"
                app:layout_constraintTop_toBottomOf="@+id/tvSuspensao3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/tvPerguntaSuspensao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/tv_suspensao_pergunta"
                android:textSize="14sp"
                android:textColor="@color/blue_caixa"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintTop_toBottomOf="@+id/tvSuspensao4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <RadioGroup
                android:id="@+id/rgSuspensao1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toBottomOf="@+id/tvPerguntaSuspensao"
                app:layout_constraintStart_toStartOf="parent">

                <RadioButton
                    android:id="@+id/rb24h"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_24_horas"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textColor="@color/blue_caixa"/>

                <RadioButton
                    android:id="@+id/rb48h"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_48_horas"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textColor="@color/blue_caixa"/>

                <RadioButton
                    android:id="@+id/rb7d"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_7_dias"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textColor="@color/blue_caixa"/>
            </RadioGroup>

            <RadioGroup
                android:id="@+id/rgSuspensao2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toBottomOf="@+id/rgSuspensao1"
                app:layout_constraintStart_toStartOf="parent">

                <RadioButton
                    android:id="@+id/rb15d"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_15_dias"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textColor="@color/blue_caixa"/>

                <RadioButton
                    android:id="@+id/rb30d"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="@string/tv_30_dias"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textColor="@color/blue_caixa"/>
            </RadioGroup>

            <CheckBox
                android:id="@+id/chkSuspensaoCiente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_estou_ciente"
                android:textColor="@color/blue_caixa"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_bold"
                android:layout_marginTop="16dp"
                android:layout_marginStart="15dp"
                app:layout_constraintTop_toBottomOf="@+id/rgSuspensao2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btnSuspensaoConfimar"
                />


            <Button
                android:id="@+id/btnSuspensaoConfimar"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="@string/confirmar"
                android:textColor="@color/branco"
                android:textAllCaps="false"
                android:fontFamily="@font/caixa_std_bold"
                android:textAlignment="center"
                android:background="@drawable/button_rounded_verdeazul"
                android:visibility="visible"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/chkSuspensaoCiente"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/btnDesistir"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/desistir"
                android:textColor="@color/bolao_slider_trilha_ativa"
                android:textAllCaps="false"
                android:fontFamily="@font/caixa_std_bold"
                android:textAlignment="center"
                android:background="@drawable/background_border_verde"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSuspensao2"
                />

            <Button
                android:id="@+id/btnSuspender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="12dp"
                android:text="@string/suspender_apostas"
                android:textColor="@color/branco"
                android:textAllCaps="false"
                android:fontFamily="@font/caixa_std_bold"
                android:textAlignment="center"
                android:background="@drawable/button_rounded_verdeazul"
                android:visibility="gone"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toBottomOf="@+id/tvSuspensao2"
                app:layout_constraintStart_toEndOf="@+id/btnDesistir"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/btnSuspensaoEntendi"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/title_entendi"
                android:textColor="@color/branco"
                android:textAllCaps="false"
                android:fontFamily="@font/caixa_std_bold"
                android:textAlignment="center"
                android:background="@drawable/button_rounded_verdeazul"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSuspensao2"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>