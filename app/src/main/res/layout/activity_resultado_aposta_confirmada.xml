<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:id="@+id/clTopbarModalidade"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/mega_verde_claro_mkp"
        android:orientation="horizontal">

        <androidx.constraintlayout.widget.ConstraintLayout
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/backgroundTopbar"
            android:layout_width="90dp"
            android:layout_height="56dp">

            <ImageView
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:id="@+id/imgTrevoResultado"
                android:layout_width="22sp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:src="@drawable/trevo" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            app:layout_constraintLeft_toRightOf="@id/backgroundTopbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/tvTituloModalidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/futura_std_bold"
            android:textColor="@color/branco"
            android:textSize="16sp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clFocoConcurso"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintLeft_toLeftOf="@id/tvConcurso"
            app:layout_constraintRight_toRightOf="@id/tvConcurso"
            app:layout_constraintTop_toTopOf="@id/tvConcursos"
            app:layout_constraintBottom_toBottomOf="@id/tvConcurso"/>

        <TextView
            android:textColor="@color/branco"
            android:textSize="14sp"
            android:layout_marginEnd="24dp"
            android:id="@+id/tvConcursos"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvConcurso"
            app:layout_constraintVertical_chainStyle="packed"
            android:text="@string/txt_contest"/>
        <TextView
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:id="@+id/tvConcurso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvConcursos"
            app:layout_constraintRight_toRightOf="@id/tvConcursos"
            tools:text="3490 - 3514"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toBottomOf="@id/clTopbarModalidade"
        android:id="@+id/topoResultadoPremioLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mega_verde_escuro_mkp"
        >

        <TextView
            app:layout_constraintTop_toTopOf="parent"
            android:id="@+id/idPodeComemorar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="15dp"
            android:text="@string/label_pode_comemorar"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="14sp"
            android:fontFamily="@font/caixa_std_regular"/>

        <TextView
            app:layout_constraintTop_toBottomOf="@id/idPodeComemorar"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:id="@+id/valorPremioTituloTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:lineSpacingExtra="10dp"
            android:text="@string/label_voce_foi_premiado"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="20.1sp"
            android:fontFamily="@font/caixa_std_bold" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clMidLayout"
        app:layout_constraintTop_toBottomOf="@id/topoResultadoPremioLinearLayout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_width="match_parent"
        android:background="@color/mega_verde_escuro_mkp"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            tools:listitem="@layout/layout_bet_contest"
            android:layout_margin="16dp"
            android:id="@+id/rvConcursos"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            tools:itemCount="2"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>

        <br.gov.caixa.loterias.apostas.view.fragment.TipoApostaLinhaView
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rvConcursos"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/tipo_aposta_linha_compras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clMidLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/clBottomLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <TextView
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            android:text="@string/txt_choose_your_reward"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:id="@+id/tvEscolhaPremio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.recyclerview.widget.RecyclerView
            tools:listitem="@layout/layout_bet_reward"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintTop_toBottomOf="@id/tvEscolhaPremio"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/rvResgatePremio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
