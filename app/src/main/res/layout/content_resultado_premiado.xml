<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topoModalidadeResultadoLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/megasenaclaro"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/fundoBackgroundTrapezeResultadoLinearLayout"
            android:layout_width="90dp"
            android:layout_height="56dp">

            <ImageView
                android:layout_width="22sp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:src="@drawable/trevo" />
        </LinearLayout>


        <TextView
            android:id="@+id/tituloModalidadeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/futura_std_bold"
            android:textColor="@color/branco"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/topoResultadoPremioLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="111dp"
        android:background="@color/megasenaescuro"
        android:orientation="vertical">

        <TextView
            style="@style/ArialMT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="15dp"
            android:text="@string/label_pode_comemorar"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/valorPremioTituloTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:lineSpacingExtra="10dp"
            android:text="@string/label_voce_foi_premiado"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="20.1sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/premioInfoLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/megasenaescuro"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/premioGanhoLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/listaFaixaPremiacaoLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="19dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="22dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/cabecalhoListaFaixaPremiacaoLinearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="0.24"
                        android:text="@string/label_concurso"
                        android:gravity="center"
                        android:textColor="@color/branco"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.27"
                        android:text="@string/label_faixa_premiacao"
                        android:gravity="center"
                        android:textColor="@color/branco"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="0.24"
                        android:text="@string/label_sorteio_case"
                        android:gravity="center"
                        android:textColor="@color/branco"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_weight="0.25"
                        android:text="@string/label_premiacao"
                        android:gravity="center"
                        android:textColor="@color/branco"
                        android:textSize="14sp" />
                </LinearLayout>

                <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightRecyclerView
                    android:id="@+id/listaFaixaPremiacaoExpandableHeightRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="15dp"
                    android:clickable="false"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dadosModalidadeLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/branco"
        android:orientation="vertical"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clVerDetalheAposta"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:padding="8dp"
            android:background="@drawable/rounded_inline"
            android:layout_alignStart="@id/quantidadeApostadasTxt"
            android:weightSum="1">

            <ImageView
                android:id="@+id/ivDetalheAposta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_lupa_detalhe_aposta"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvDetalheAposta"/>

            <TextView
                android:id="@+id/tvDetalheAposta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ver_detalhe_da_aposta"
                android:textColor="@color/mais_milionaria_escura"
                android:layout_marginStart="16sp"
                app:layout_constraintStart_toEndOf="@+id/ivDetalheAposta"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_concurso_atual"
                android:textColor="@color/cinza"
                android:textSize="14.2sp"
                android:textStyle="bold"></TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="206dp"
                android:layout_height="match_parent"
                android:gravity="top"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView11"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_estimativa_de_premio"
                    android:textAlignment="textStart"
                    android:textColor="@color/cinza"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/valorEstimativaConcursoAtualTextView"
                    style="@style/ArialMT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="5dp"
                    android:textAlignment="textStart"
                    android:textColor="@color/cinza" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:layout_marginRight="16dp"
                    android:layout_weight="0.5"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ArialMT"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/label_encerramento_apostas"
                        android:textAlignment="textStart"
                        android:textColor="@color/cinza"
                        android:textSize="14.2sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/proximoSorteioTextView"
                        style="@style/ArialMT"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="textStart"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/cinza"
                        android:textSize="14.2sp" />

                    <Button
                        android:id="@+id/botaoAposteAgora"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="17dp"
                        android:background="@drawable/button_white_with_border_disabled"
                        android:backgroundTint="#3A485B"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14.2sp"
                        tools:text="@string/label_aposte_agora" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
