<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvModalidade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/caixa_std_bold"
        android:text="mega-sena"
        android:textColor="#009B55"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnExcluir"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnExcluir"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/excluir"
        android:padding="9dp"
        android:src="@drawable/trash"
        app:layout_constraintBottom_toBottomOf="@+id/tvModalidade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvModalidade"
        app:tint="@color/azul_caixa" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineInformacoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.75" />

    <LinearLayout
        android:id="@+id/containerNumeros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintEnd_toStartOf="@id/guidelineInformacoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModalidade">

        <TextView
            android:letterSpacing="0.1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="#46515A"
            android:textSize="14sp"
            tools:text="01 - 02 - 03 - 04 - 05 - 06" />

        <TextView
            android:letterSpacing="0.1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="#46515A"
            android:textSize="14sp"
            tools:text="08 - 09 - 10 - 11 - 12 - 13" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerSuperSete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/guidelineInformacoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModalidade">

        <LinearLayout
            android:id="@+id/containerColunasSuperSete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/containerNumerosSuperSete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvConcurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:gravity="end"
        android:textColor="#46515A"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/containerNumeros"
        tools:text="Conc.3005" />

    <TextView
        android:id="@+id/tvValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/caixa_std_regular"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:gravity="end"
        android:textColor="#46515A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvConcurso"
        tools:text="R$ 6,00" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierAposta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="containerNumeros,containerSuperSete,tvValor" />

    <TextView
        android:id="@+id/tvExtra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:gravity="start"
        android:textColor="@color/greyText"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/guidelineInformacoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierAposta"
        tools:text="time do coração: america/mg"
        tools:visibility="visible" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierAntesIndicadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="barrierAposta,tvExtra"
        />

    <TextView
        android:id="@+id/tvEspelho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_espelho_linha"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="Espelho"
        android:textColor="@color/cinza90"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableTint="@color/cinza90" />

    <TextView
        android:id="@+id/tvSurpresinha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_surpresinha_linha_white"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="Surpresinha"
        android:textColor="@color/cinza90"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableTint="@color/cinza90" />

    <TextView
        android:id="@+id/tvTeimosinha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_teimosinha_white"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="Teimosinha"
        android:textColor="@color/cinza90"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableTint="@color/cinza90" />

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flowIndicadores"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tvEspelho,tvSurpresinha,tvTeimosinha"
        app:flow_firstHorizontalBias="0"
        app:flow_firstHorizontalStyle="packed"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="12dp"
        app:flow_horizontalStyle="packed"
        app:flow_lastHorizontalBias="0"
        app:flow_lastHorizontalStyle="packed"
        app:flow_verticalGap="8dp"
        app:flow_wrapMode="chain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guidelineInformacoes"
        app:layout_constraintBottom_toBottomOf="@id/tvValor" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierConteudo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="barrierAntesIndicadores,flowIndicadores" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#DCE8EC"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierConteudo" />

    <Space
        android:id="@+id/spaceBottom"
        android:layout_width="1dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider" />

</androidx.constraintlayout.widget.ConstraintLayout>