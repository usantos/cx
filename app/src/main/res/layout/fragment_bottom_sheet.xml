<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/design_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_bottom_sheet"
    android:paddingBottom="50dp">

    <View
        android:id="@+id/indicator_top"
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/rounded_card"
        android:backgroundTint="@color/jr_cinza_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/jr_bs_titulo"
        android:textColor="@color/jr_azul_text_title"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/indicator_top" />

    <TextView
        android:id="@+id/tv_descricao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/jr_bs_desc"
        android:textColor="@color/cinza_total"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_titulo" />

    <android.support.v4.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_descricao"
        app:layout_constraintBottom_toBottomOf="parent">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/cl_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:paddingBottom="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_descricao">

            <TextView
                android:id="@+id/tv_caixa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="1dp"
                android:text="@string/jr_bs_caixa_tel"
                android:textSize="14sp"
                android:textColor="@color/jr_cinza_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_caixa_op_7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="1dp"
                android:text="@string/jr_bs_op_7"
                android:textSize="14sp"
                android:textColor="@color/jr_cinza_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_caixa" />

            <TextView
                android:id="@+id/tv_caixa_op_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="1dp"
                android:text="@string/jr_bs_op_3"
                android:textSize="14sp"
                android:textColor="@color/jr_cinza_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_caixa_op_7" />

            <TextView
                android:id="@+id/tv_proamjo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:layout_marginTop="20dp"
                android:text="@string/jr_bs_proamjo"
                android:textColor="@color/jr_cinza_text"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_caixa_op_3" />

            <TextView
                android:id="@+id/tv_proamjo_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="@string/jr_bs_proamjo_end"
                android:textSize="14sp"
                android:textColor="@color/jr_cinza_text_claro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proamjo" />

            <TextView
                android:id="@+id/tv_proamjo_tels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_cinza_text"
                android:text="@string/jr_bs_proamjo_tels"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proamjo_end" />

            <TextView
                android:id="@+id/tv_proamjo_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_email"
                android:text="@string/jr_bs_proamjo_email"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proamjo_tels" />

            <TextView
                android:id="@+id/tv_avb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:layout_marginTop="20dp"
                android:text="@string/jr_bs_avb"
                android:textColor="@color/jr_cinza_text"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proamjo_email" />

            <TextView
                android:id="@+id/tv_avb_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="@string/jr_bs_avb_end"
                android:textSize="14sp"
                android:textColor="@color/jr_cinza_text_claro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_avb" />

            <TextView
                android:id="@+id/tv_avb_tels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_cinza_text"
                android:text="@string/jr_bs_avb_tel"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_avb_end" />

            <TextView
                android:id="@+id/tv_avb_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_email"
                android:text="@string/jr_bs_avb_email"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_avb_tels" />

            <TextView
                android:id="@+id/tv_proad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:layout_marginTop="20dp"
                android:text="@string/jr_bs_proad"
                android:textColor="@color/jr_cinza_text"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_avb_email" />

            <TextView
                android:id="@+id/tv_proad_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="@string/jr_bs_proad_end"
                android:textSize="14sp"
                android:textColor="@color/jr_cinza_text_claro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proad" />

            <TextView
                android:id="@+id/tv_proad_tels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_cinza_text"
                android:text="@string/jr_bs_proad_tels"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proad_end" />

            <TextView
                android:id="@+id/tv_proad_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_email"
                android:text="@string/jr_bs_proad_email"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proad_tels" />

            <TextView
                android:id="@+id/tv_scm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:text="@string/jr_bs_scm"
                android:textColor="@color/jr_cinza_text"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_proad_email" />

            <TextView
                android:id="@+id/tv_scm_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:text="@string/jr_bs_scm_end"
                android:textSize="14sp"
                android:textColor="@color/jr_cinza_text_claro"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_scm" />

            <TextView
                android:id="@+id/tv_scm_tels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_cinza_text"
                android:text="@string/jr_bs_scm_tel"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_scm_end" />

            <TextView
                android:id="@+id/tv_ja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:text="@string/jr_bs_ja"
                android:textColor="@color/jr_cinza_text"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_scm_tels" />

            <TextView
                android:id="@+id/tv_ja_site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_email"
                android:text="@string/jr_bs_ja_site"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_ja" />

            <TextView
                android:id="@+id/tv_vj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:text="@string/jr_bs_vj"
                android:textColor="@color/jr_cinza_text"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_ja_site" />

            <TextView
                android:id="@+id/tv_vj_site"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:textColor="@color/jr_email"
                android:text="@string/jr_bs_vj_site"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_vj" />

        </android.support.constraint.ConstraintLayout>

    </android.support.v4.widget.NestedScrollView>

</android.support.constraint.ConstraintLayout>