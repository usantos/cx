<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".controllers.JogoResponsavelActivity">

    <include layout="@layout/app_bar_degrade" />

    <android.support.constraint.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/gl_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_aprender_regras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="@string/jr_aprender_regras"
                android:textStyle="bold"
                android:textSize="17dp"
                android:lineHeight="23dp"
                android:textColor="@color/branco"
                android:textAlignment="center"
                android:padding="40dp"
                android:background="@drawable/background_gradient_jogo_responsavel"/>
            <RadioGroup
                android:id="@+id/rdogrp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center"
                android:orientation="horizontal" >

                <RadioButton
                    android:id="@+id/rb_conheca"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:background="@drawable/jr_tab_selector"
                    android:text="@string/jr_conheca"
                    android:button="@null"
                    android:textSize="13sp"
                    android:textColor="@color/tab_color_jr"
                    android:checked="true"
                    android:gravity="center" />

                <RadioButton
                    android:id="@+id/rb_principios"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="match_parent"
                    android:text="@string/jr_principios"
                    android:background="@drawable/jr_tab_selector"
                    android:textColor="@color/tab_color_jr"
                    android:button="@null"
                    android:gravity="center" />

                <RadioButton
                    android:id="@+id/rb_apostador"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="13sp"
                    android:layout_height="match_parent"
                    android:text="@string/jr_o_apostador"
                    android:background="@drawable/jr_tab_selector"
                    android:textColor="@color/tab_color_jr"
                    android:button="@null"
                    android:gravity="center" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/iv_duvidas"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_ajuda_jr"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</android.support.constraint.ConstraintLayout>