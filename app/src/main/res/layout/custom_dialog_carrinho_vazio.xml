<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="fill_parent"
    android:background="@color/branco">

    <RelativeLayout
        android:id="@+id/relativeLayoutTopo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/gradiente_titulo_caixa">

        <TextView
            android:id="@+id/tituloDialogCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:layout_marginTop="18dp"
            android:text="@string/label_atencao"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:fontFamily="@font/caixa_std_bold" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/relativeLayoutTopo"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="14dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="@string/mensagem_carrinho_vazio_dialog"
            android:textSize="18sp" />


        <RelativeLayout
            android:id="@+id/linhaDivisaoBotoes"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/listaItensDialog"
            android:background="@color/cinza2"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_below="@+id/linhaDivisaoBotoes"
            android:orientation="horizontal"
            android:paddingBottom="15dp"
            >

            <Button
                android:id="@+id/dialogButtonCarrinhoVazio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:layout_marginTop="5dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:background="@drawable/button_border_vermelho"
                android:text="@string/ok"
                android:textAllCaps="false"
                android:textColor="@color/vermelho_dialog"
                android:textSize="14sp"
                android:fontFamily="@font/caixa_std_bold"
                android:gravity="center"
                />

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
