<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.gov.caixa.loterias.apostas.controllers.MensagensPushActivity"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/activity_notificacao_msg"
   >
    <include layout="@layout/app_bar_degrade_push" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_pesquisa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/pesquisa_msgpush"
        >
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:layout_marginRight="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_push_msg"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/search_edittext_background"
                android:drawableStart="@drawable/ic_pesquisar"
                android:drawableLeft="@drawable/ic_pesquisar"
                android:hint="@string/pesquisa_push"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:padding="10dp"
                android:textAppearance="@style/pesqpush"
                android:visibility="visible"
                app:boxBackgroundMode="none"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_push_apagar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="right"
            android:layout_marginLeft="5dp"
            android:background="@drawable/ic_lixeira"
            android:padding="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp"
            />

        <Button
            android:id="@+id/btn_push_msg"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="5dp"
            android:background="@drawable/ic_carta"
            app:layout_constraintEnd_toStartOf="@+id/btn_push_apagar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp"
            tools:ignore="TouchTargetSizeCheck" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pesquisa_msgpush"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_pesquisa">

        <RadioGroup
            android:id="@+id/rg_push"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" >

            <RadioButton
                android:id="@+id/rb_todas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Todas"
                android:checked="true"
                android:button="@null"
                android:background="@drawable/tab_selector_push"
                />
            <RadioButton
                android:id="@+id/rb_naolidas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Não Lidas"
                android:button="@null"
                android:background="@drawable/tab_selector_push"
                />
        </RadioGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCentralMsg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/item_msg_push"
        android:layout_marginTop="16dp"
        android:background="@color/fundobrancocentralmsg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/container_tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
