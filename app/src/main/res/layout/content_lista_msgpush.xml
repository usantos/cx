<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:paddingTop="40dp"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.MensagensPushActivity"
    tools:showIn="@layout/activity_notificacao_msg">

    <LinearLayout
        android:id="@+id/lnPesqPush"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginRight="60dp"
            android:focusableInTouchMode="true"
            android:drawableStart="@drawable/ic_pesquisar"
            android:drawableLeft="@drawable/ic_pesquisar"
            android:drawablePadding="5dp"
            android:hint="@string/pesquisa_push"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:textSize="14sp"
            android:background="@drawable/rounded_edittext"
            android:padding="10dp"
            android:textAppearance="@style/pesqpush"
            android:visibility="visible"
            app:boxBackgroundMode="none"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp" />

        <ImageButton
            android:id="@+id/btn_push_msg"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_gravity="right"
            android:layout_marginRight="15dp"
            android:background="@color/transparente"
            android:padding="5dp"
            android:paddingRight="5dp"
            android:src="@drawable/ic_carta"
            tools:ignore="TouchTargetSizeCheck">

        </ImageButton>

        <ImageButton
            android:id="@+id/btn_push_apagar"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_marginRight="16dp"
            android:background="@color/transparente"
            android:padding="5dp"
            android:paddingRight="5dp"
            android:src="@drawable/ic_lixeira">

        </ImageButton>
    </LinearLayout>

    <TextView
    android:id="@+id/mensagensVazioTextview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:text="@string/pesquisa_push_vazia"
    android:textSize="18sp"
    android:textColor="@android:color/black"
    android:visibility="gone" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnPesqPush"
        android:layout_marginBottom="16dp"
        app:tabGravity="fill"
        android:actionBarTabTextStyle="@style/My.TabText.Style"
        app:tabIndicatorColor="@color/colorAccent"
        app:tabMode="fixed"
        app:tabTextColor="@color/colorAccent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCentralMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tab_layout"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp" />

</RelativeLayout>
