<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gravity="center"
    android:orientation="horizontal"
    tools:context="br.gov.caixa.loterias.apostar.interno.view.LerBilhetesActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        >

        <com.journeyapps.barcodescanner.DecoratedBarcodeView
            android:id="@+id/DecoratedBarcodeViewBilhetes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:zxing_preview_scaling_strategy="centerCrop"
            app:zxing_use_texture_view="false" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/mascara_loteria" />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"></RelativeLayout>

        <ImageView
            android:id="@+id/iconeTrevoLeitor"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginLeft="68dp"
            android:layout_marginTop="32dp"
            android:elevation="3dp"
            android:src="@drawable/logo_cinza"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100dp"
            android:layout_marginTop="34dp"
            android:fontFamily="@font/futura_std_bold"
            android:text="Resultado"
            android:textColor="@color/branco"
            android:textSize="16sp" />

        <Button
            android:id="@+id/fecharLeitorCodBarras"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"
            android:layout_marginRight="20dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/close_circle_outline" />

        <TextView
            android:id="@+id/TextoLeitorCodBarras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="68dp"
            android:layout_marginRight="68dp"
            android:layout_marginTop="64dp"
            android:fontFamily="@font/arialmt"
            android:text="Posicione a linha abaixo sobre o código de barras e aguarde a focalização da câmera."
            android:textColor="@color/branco"
            android:textSize="14.2sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="23dp"
            android:background="@color/vermelhoBilhetes"></View>

        <Button
            android:id="@+id/buttonDigitarAposta"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="26dp"
            android:layout_marginHorizontal="68dp"
            android:background="@drawable/button_border_amareloqueimado"
            android:text="Digitar sua aposta realizada"
            android:textAllCaps="false"
            android:textColor="@color/amareloQueimado"
            android:textSize="14.2sp"

            />

    </RelativeLayout>
</LinearLayout>