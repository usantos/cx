<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    tools:context="br.gov.caixa.loterias.apostas.controllers.SimularApostaActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/toolBarSimularAposta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/azulclaro"
            android:orientation="horizontal"
            android:weightSum="1"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/layoutFragments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/simularTelaAposta"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="17dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/icon_seleciona2" />

                <Button
                    android:id="@+id/surpresinhaTela"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/icon_surpresinha" />
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/layoutPrognosticoTeimosinha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:gravity="right"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/qtdNumerosButton"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentLeft="true"
                    android:fontFamily="@font/arialmt"
                    android:gravity="center_vertical"
                    android:paddingLeft="3dp"
                    android:text="@string/um_concurso"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageQtdNumerosButton"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_alignRight="@+id/qtdNumerosButton"
                    android:layout_marginTop="25dp"
                    android:src="@drawable/combo2" />

                <Button
                    android:id="@+id/qtdConcursosButton"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="10dp"
                    android:fontFamily="@font/arialmt"
                    android:gravity="center_vertical"
                    android:paddingLeft="3dp"
                    android:text="Teimosinha"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/imageQtdConcursosButton"
                    android:layout_width="12dp"
                    android:layout_height="8dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginTop="25dp"
                    android:layout_marginRight="5dp"
                    android:src="@drawable/combo2" />
            </RelativeLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolBarLoteca"
            android:layout_width="0dp"
            android:layout_height="98dp"
            android:background="@drawable/drawer_linha_divisao_bg"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/labelExplicaSuasApostas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:paddingTop="1dp"
                android:text="@string/label_suas_apostas_explica"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/labelTituloLoteca"
                />

            <TextView
                android:id="@+id/labelTituloLoteca"
                style="@style/editTextArialMTTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="17dp"
                android:paddingTop="1dp"
                android:text="@string/label_suas_apostas_loteca"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/labelExplicaSuasApostas"
                app:layout_constraintTop_toBottomOf="@id/labelExplicaSuasApostas" />

            <TextView
                android:id="@+id/labelSimplesLoteca"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:paddingLeft="17dp"
                android:paddingTop="0dp"
                android:text="@string/label_simples"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/labelTriplasLoteca"
                app:layout_constraintEnd_toBottomOf="id/labelTituloLoteca"
                app:layout_constraintStart_toStartOf="id/labelTituloLoteca"
                app:layout_constraintTop_toBottomOf="id/labelTituloLoteca" />

            <TextView
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="67dp"
                android:paddingTop="59dp"
                android:text="@string/label_dois_pontos"
                android:textColor="@color/verdeazul"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelValueSimplesLoteca"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="74dp"
                android:paddingTop="57dp"
                android:text="@string/zero"
                android:textColor="@color/verdeazul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelDuplasLoteca"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="100dp"
                android:paddingTop="59dp"
                android:text="@string/label_duplas"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="143dp"
                android:paddingTop="59dp"
                android:text="@string/label_dois_pontos"
                android:textColor="@color/verdeazul"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelValueDuplasLoteca"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="152dp"
                android:paddingTop="57dp"
                android:text="@string/zero"
                android:textColor="@color/verdeazul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelTriplasLoteca"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="180dp"
                android:paddingTop="59dp"
                android:text="@string/label_triplas"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="221dp"
                android:paddingTop="59dp"
                android:text="@string/label_dois_pontos"
                android:textColor="@color/verdeazul"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/labelValueTriplasLoteca"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:paddingLeft="229dp"
                android:paddingTop="59dp"
                android:text="@string/zero"
                android:textColor="@color/verdeazul"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/paginacaoView"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/toolBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <FrameLayout
        android:id="@+id/fragmentSimularApostas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/paginacaoView"
        app:layout_constraintVertical_bias="0.292" />

    <RelativeLayout
        android:id="@+id/layoutSalvarApostaLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@color/cinza"
        android:clickable="true"
        app:layout_constraintBottom_toTopOf="@+id/botaoLimparAposta"
        app:layout_constraintLeft_toRightOf="@+id/viewTabBar"
        app:layout_constraintRight_toLeftOf="@+id/viewTabBar"
        tools:visibility="visible">

        <RelativeLayout
            android:id="@+id/salvarApostaLayout"
            android:layout_width="184dp"
            android:layout_height="140dp"
            tools:visibility="visible">

            <RelativeLayout
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/textoDeNomeInfo"
                android:layout_alignStart="@+id/textoDeNomeInfo"
                android:layout_below="@+id/textoDeNomeInfo"
                android:layout_marginTop="10dp">

                <ImageButton
                    android:id="@+id/btnSalvarAposta"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"

                    android:layout_marginLeft="7dp"
                    android:layout_marginStart="7dp"
                    android:layout_toEndOf="@+id/editNomeAposta"
                    android:layout_toRightOf="@+id/editNomeAposta"
                    android:background="@drawable/seta_verde" />

                <EditText
                    android:id="@+id/editNomeAposta"
                    android:layout_width="125dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:backgroundTint="@color/branco"
                    android:inputType="textNoSuggestions"
                    android:paddingBottom="7dp"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:text=""
                    android:textColor="@color/branco"
                    android:textCursorDrawable="@null"
                    android:textSize="16sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/textoDeNomeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignLeft="@+id/iconStarSalvar"
                android:layout_alignStart="@+id/iconStarSalvar"
                android:layout_below="@+id/textoSalveEstaAposta"
                android:layout_marginTop="29dp"
                android:text="@string/label_de_nome"
                android:textColor="@color/verdeazul"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textoSalveEstaAposta"
                android:layout_width="match_parent"
                android:layout_height="21dp"
                android:layout_alignBottom="@+id/iconStarSalvar"
                android:layout_marginLeft="5dp"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/iconStarSalvar"
                android:layout_toRightOf="@+id/iconStarSalvar"
                android:gravity="center_vertical"
                android:padding="0dp"
                android:text="@string/tituloSalvarAposta"
                android:textColor="@color/branco"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iconStarSalvar"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                app:srcCompat="@drawable/icon_favoritar" />
        </RelativeLayout>
    </RelativeLayout>

    <Button
        android:id="@+id/botaoLimparAposta"
        android:layout_width="184dp"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_white_with_border"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/limparAposta"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/cinza"
        app:layout_constraintBottom_toTopOf="@+id/botaoAdicionarCompletarCartela"
        app:layout_constraintLeft_toRightOf="@+id/viewTabBar"
        app:layout_constraintRight_toLeftOf="@+id/viewTabBar" />

    <RelativeLayout
        android:id="@+id/viewTabBar"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:background="@color/azulclaro"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="13dp"
            android:layout_toStartOf="@+id/imageViewPaginacao">

            <TextView
                android:id="@+id/valorApostaCartela"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/textInfoValorAposta"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="10dp"
                android:textAlignment="center"
                android:textStyle="bold"
                tools:text="R$ 4,50" />

            <TextView
                android:id="@+id/textInfoValorAposta"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:text="@string/valorDessaAposta"
                android:textAlignment="center"
                android:textColor="@color/azulescuro"
                android:textSize="12sp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/imageViewPaginacao"
            android:layout_width="184dp"
            android:layout_height="12dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/imagemCarrinho"
            android:visibility="invisible"
            app:srcCompat="@drawable/paginacao1" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/simularApostaLayoutCarrinhoApostas"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="13dp"
            android:layout_toEndOf="@+id/imageViewPaginacao">

            <Button
                android:id="@+id/botaoCarrinho"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/icon_carrinho"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:clickable="false" />

            <ImageView
                android:id="@+id/circuloQuantidade"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/ic_shape_oval"
                android:backgroundTint="#FDAB01"
                android:layout_marginTop="6dp"
                android:translationZ="2dp"
                app:layout_constraintEnd_toEndOf="@+id/botaoCarrinho"
                app:layout_constraintStart_toEndOf="@+id/botaoCarrinho"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvQuantidadeApostas"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:translationZ="2dp"
                android:paddingEnd="1dp"
                android:paddingStart="1dp"
                android:text="0"
                android:textSize="7sp"
                android:textStyle="bold"
                android:padding="1dp"
                android:fontFamily="@font/font_family_futura"
                android:lineHeight="10dp"
                app:layout_constraintTop_toTopOf="@id/circuloQuantidade"
                app:layout_constraintStart_toStartOf="@id/circuloQuantidade"
                app:layout_constraintBottom_toBottomOf="@id/circuloQuantidade"
                app:layout_constraintEnd_toEndOf="@id/circuloQuantidade"
                />

            <TextView
                android:id="@+id/textInfoCarrinho"
                style="@style/ArialMT"
                android:translationZ="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:clickable="false"
                android:text="@string/carrinhoDeApostas"
                android:textAlignment="center"
                android:textColor="@color/azulescuro"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/botaoCarrinho"
                android:textSize="12sp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>

    <Button
        android:id="@+id/botaoAdicionarCompletarCartela"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginBottom="51dp"
        android:background="@color/cinzaescuro"
        android:elevation="15dp"
        android:text="@string/adicionarAoCarrinho"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/viewTabBar"
        app:layout_constraintRight_toLeftOf="@+id/viewTabBar" />

    <TextView
        android:id="@+id/tv_valor_atual_carrinho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/valor_atual_do_carrinho"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/botaoAdicionarCompletarCartela"
        app:layout_constraintStart_toStartOf="@+id/botaoAdicionarCompletarCartela"
        app:layout_constraintEnd_toEndOf="@+id/botaoAdicionarCompletarCartela"/>

    <TextView
        android:id="@+id/valorAtualCarrinho"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 00,00"
        android:textStyle="bold"
        android:textColor="#3964A4"
        app:layout_constraintTop_toBottomOf="@+id/tv_valor_atual_carrinho"
        app:layout_constraintStart_toStartOf="@+id/tv_valor_atual_carrinho"
        app:layout_constraintEnd_toEndOf="@+id/tv_valor_atual_carrinho"/>

    <FrameLayout
        android:id="@+id/id_fg_somador_carrinho"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="invisible"/>

</androidx.constraintlayout.widget.ConstraintLayout>
