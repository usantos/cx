<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="br.gov.caixa.loterias.apostar.interno.view.ResgatePremioLotericaAgenciaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:id="@+id/categoriaLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/cinza"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/activity_vertical_margin">

            <TextView
                android:id="@+id/categoriaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/branco"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="tipo de resgate" />
        </RelativeLayout>

        <ScrollView
            android:id="@+id/resgatePremioLotericaAgenciaScrool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/activity_vertical_margin"
                    android:layout_marginTop="39dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/enumeradorUmText"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_linha_divisiva"
                        android:gravity="center"
                        android:text="@string/label_numerico_um"
                        android:textColor="@color/colorAccent"
                        android:textSize="17.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/informacaoTopicoUmText"
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/text_margin_small"
                        android:layout_marginTop="@dimen/text_margin_20"
                        android:layout_marginEnd="@dimen/activity_horizontal_margin"
                        android:layout_toEndOf="@+id/enumeradorUmText"
                        android:gravity="center_vertical"
                        android:textColor="@color/cinza"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="texto 01" />

                </RelativeLayout>

                <ImageView
                    android:id="@+id/qrCodeApostaImage"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginLeft="58dp"
                    android:visibility="gone" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/activity_vertical_margin"
                    android:layout_marginTop="35dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/enumeradorDoisText"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_linha_divisiva"
                        android:gravity="center"
                        android:text="@string/label_numerico_dois"
                        android:textColor="@color/colorAccent"
                        android:textSize="17.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/informacaoTopicoDoisText"
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/text_margin_small"
                        android:layout_marginTop="@dimen/text_margin_20"
                        android:layout_marginEnd="@dimen/activity_vertical_margin"
                        android:layout_toEndOf="@+id/enumeradorDoisText"
                        android:gravity="center_vertical"
                        android:textColor="@color/cinza"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="texto 02" />

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/activity_vertical_margin"
                    android:layout_marginTop="39dp"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/enumeradorTresText"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_linha_divisiva"
                        android:gravity="center"
                        android:text="@string/label_numerico_tres"
                        android:textColor="@color/colorAccent"
                        android:textSize="17.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/informacaoTopicoTresText"
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/text_margin_small"
                        android:layout_marginTop="@dimen/text_margin_20"
                        android:layout_marginEnd="@dimen/activity_vertical_margin"
                        android:layout_toEndOf="@+id/enumeradorTresText"
                        android:gravity="center_vertical"
                        android:textColor="@color/cinza"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="texto 03" />

                </RelativeLayout>
            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</android.support.constraint.ConstraintLayout>
