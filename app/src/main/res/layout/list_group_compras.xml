<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:weightSum="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/situacaoCompraTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:fontFamily="@font/arialmt"
            tools:text="Situação: Em processamento"
            android:maxWidth="150dp"
            android:textColor="@color/cinza"
            android:textSize="14.2sp" />

        <TextView
            android:id="@+id/dataCompraTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            tools:text="TextView" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/ib_favoritar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/ic_estrela"
        android:backgroundTint="@color/transparente"
        android:tint="@color/azulescuro"
        android:layout_marginRight="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/valorCompra"/>

    <TextView
        android:id="@+id/valorCompra"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/arialmt"
        android:gravity="end"
        android:text="@string/r_4_50"
        android:textColor="@color/cinza"
        android:textSize="14.2sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/setaComprasGroup"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/setaComprasGroup"
        android:layout_width="11dp"
        android:layout_height="20dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/seta_direita_cinza"
        android:padding="7dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

