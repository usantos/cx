<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:importantForAccessibility="no"
tools:context="br.gov.caixa.loterias.apostas.view.fragment.Introducao3Fragment">

<!-- TODO: Update blank fragment layout -->

<ImageView
    android:id="@+id/imageViewLogoLoterias"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_marginTop="29dp"
    android:layout_gravity="center_horizontal"
    app:srcCompat="@drawable/logo"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:importantForAccessibility="yes"
    android:contentDescription="@string/logoLoteriasCaixa"
    android:layout_alignParentTop="true"
    android:layout_centerHorizontal="true" />

<ImageView
    android:id="@+id/imageViewTelefone"
    android:layout_width="161dp"
    android:layout_height="70dp"
    app:srcCompat="@drawable/ic_manage_search"
    android:layout_marginTop="54dp"
    android:importantForAccessibility="no"
    android:layout_below="@+id/imageViewLogoLoterias"
    android:layout_centerHorizontal="true" />

    <View
        android:id="@+id/divider"
        android:layout_width="125dp"
        android:layout_height="1dp"
        android:minHeight="1dp"
        android:maxHeight="1dp"
        android:importantForAccessibility="no"
        android:layout_below="@id/imageViewTelefone"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@color/branco" />

<TextView
    android:id="@+id/textView1Fragment3"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="18dp"
    android:text="@string/mais_praticidade"
    android:textColor="@color/branco"
    android:textSize="18sp"
    android:layout_below="@id/divider"
 />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/textView1Fragment3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="@string/acompanhe_e_gerencie_todas_as_suas_apostas"
        android:fontFamily="@font/caixa_std_regular"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textSize="20sp" />

</RelativeLayout>
