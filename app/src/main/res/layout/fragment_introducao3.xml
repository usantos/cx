<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context="br.gov.caixa.loterias.apostar.interno.view.fragment.Introducao3Fragment">

<!-- TODO: Update blank fragment layout -->

<ImageView
    android:id="@+id/imageViewLogoLoterias"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_marginTop="18dp"
    android:layout_gravity="center_horizontal"
    app:srcCompat="@drawable/logo"
    android:layout_alignParentTop="true"
    android:layout_centerHorizontal="true" />

<ImageView
    android:id="@+id/imageViewTelefone"
    android:layout_width="161dp"
    android:layout_height="70dp"
    app:srcCompat="@drawable/ilustra_praticidade"
    android:layout_marginTop="45dp"
    android:layout_below="@+id/imageViewLogoLoterias"
    android:layout_centerHorizontal="true" />

<TextView
    android:id="@+id/textView1Fragment3"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="19dp"
    android:text="Mais praticidade"
    android:textColor="@color/branco"
    android:textSize="18sp"
    android:layout_below="@+id/imageViewTelefone"
 />

<TextView
    android:id="@+id/textView3"
    android:layout_width="130dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:text="Acompanhe e gerencie todas as suas apostas."
    android:textAlignment="center"
    android:textColor="@color/branco"
    android:textSize="12sp"
    android:layout_below="@+id/textView1Fragment3"
    android:layout_alignLeft="@+id/imageViewLogoLoterias"
    android:layout_alignStart="@+id/imageViewLogoLoterias" />
</RelativeLayout>
