<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tols="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:minHeight="30dp"
    android:background="@color/transparente">

    <TextView
        android:id="@+id/tv_nome_modalidade"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="14dp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:lines="1"
        android:text="Mega-sena"
        android:textColor="@color/branco"
        android:textSize="14dp"
        tols:layout_constraintBottom_toBottomOf="parent"
        tols:layout_constraintStart_toStartOf="parent"
        tols:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_teimosinha"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@color/transparente"
        android:src="@drawable/ic_teimosinha"
        android:visibility="invisible"
        tols:layout_constraintBottom_toBottomOf="parent"
        tols:layout_constraintEnd_toStartOf="@id/tv_qtd_numeros"
        tols:layout_constraintStart_toEndOf="@id/tv_nome_modalidade"
        tols:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_qtd_numeros"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:autoSizeMaxTextSize="14dp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:lines="1"
        android:text="7 números"
        android:textColor="@color/branco"
        android:textSize="14dp"
        tols:layout_constraintBottom_toBottomOf="parent"
        tols:layout_constraintEnd_toStartOf="@id/tv_valor_total_carrinho"
        tols:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_valor_total_carrinho"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="14dp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:lines="1"
        android:textAlignment="textEnd"
        tools:text="R$ 30,00"
        android:textColor="@color/branco"
        android:textSize="14dp"
        tols:layout_constraintBottom_toBottomOf="parent"
        tols:layout_constraintEnd_toEndOf="parent"
        tols:layout_constraintTop_toTopOf="parent" />

</android.support.constraint.ConstraintLayout>