<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="30dp"
    tools:context=".view.fragment.JogoResponsavelApostadorFragment">

    <ImageView
        android:id="@+id/iv_icone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_jogador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_caracteristicas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_icone"
        android:layout_marginTop="10dp"
        android:textSize="16sp"
        android:text="@string/jr_apostador_caracteristicas"
        android:padding="10dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/jr_azul_text_title" />

    <TextView
        android:id="@+id/tv_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/jr_apostador_1"
        android:layout_marginTop="20dp"
        android:textColor="@color/jr_laranja"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/tv_caracteristicas" />

    <TextView
        android:id="@+id/tv_caracteristica_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/jr_apostador_carac_1"
        android:textSize="15sp"
        android:paddingBottom="20dp"
        android:paddingLeft="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_1"
        app:layout_constraintTop_toTopOf="@+id/tv_1" />

