<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/carrinhoScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:descendantFocusability="blocksDescendants">

    <include layout="@layout/app_bar_degrade_pesquisa_novo" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />

    <ScrollView
        android:id="@+id/sv_carrinho"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/cl_tab_bar"
        app:layout_constraintTop_toTopOf="@id/gl_toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="24dp"
                />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="24dp"
                />

            <TextView
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                android:layout_width="0dp"
                android:id="@+id/tv_confirm_aposta"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="start"
                android:text="@string/confirmarApostas"
                android:textAlignment="textStart"
                android:textColor="@color/colorAccent"
                android:textSize="14.2sp"
                android:fontFamily="@font/caixa_std_bold"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                android:layout_width="0dp"
                android:id="@+id/tv_info_valor_minimo"
                style="@style/editTextCaixaRegularTheme"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="@string/label_lembrar_valor_minimo"
                android:textColor="@color/black"
                android:textAlignment="textStart"
                android:textSize="14.2sp"
                app:layout_constraintTop_toBottomOf="@id/tv_confirm_aposta" />

            <androidx.recyclerview.widget.RecyclerView
                app:layout_constraintStart_toStartOf="@id/guidelineStart"
                app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
                android:layout_width="0dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_info_valor_minimo"
                android:id="@+id/listaCarrinho"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintBottom_toBottomOf="parent"
                 />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_nova_aposta"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="14dp"
        android:background="@drawable/button_white_blue_border_round"
        android:text="@string/continuarApostando"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/colorAccent"
        android:textSize="16sp"
        android:fontFamily="@font/caixa_std_bold"
        app:layout_constraintBottom_toTopOf="@+id/btn_avancar_pagamento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_avancar_pagamento"
        android:layout_width="240dp"
        android:layout_height="70dp"
        android:layout_below="@id/btn_nova_aposta"
        android:layout_marginBottom="51dp"
        android:background="@drawable/btn_rounded_blue"
        android:text="@string/avancarFormaPagamento"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:textSize="16sp"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/id_fg_somador_carrinho"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

