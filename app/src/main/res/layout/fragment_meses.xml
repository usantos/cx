<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCartelaFragmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mesesFragmentScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/mesesTituloLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/escolhaNumerosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="41dp"
                tools:text="@string/dia_sorte_escolha_dia" />

            <TextView
                android:id="@+id/paginaNumeroText"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_alignBottom="@+id/escolhaNumerosText"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@+id/escolhaNumerosText"
                android:layout_marginEnd="50dp"
                android:text="@string/label_numerico_dois" />

            <TextView
                android:id="@+id/paginaQuantidadeText"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_alignBottom="@+id/escolhaNumerosText"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@+id/escolhaNumerosText"
                android:layout_marginEnd="24dp"
                tools:text="| 2" />

            <caixa.gov.br.loterias.view.custom.ExpandableHeightGridView
                android:id="@+id/mesesGridView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/escolhaNumerosText"
                android:layout_marginEnd="40dp"
                android:layout_marginStart="40dp"
                android:layout_marginTop="21dp"
                android:columnWidth="50dp"
                android:gravity="center"
                android:horizontalSpacing="10dp"
                android:verticalSpacing="10dp"
                android:nestedScrollingEnabled="false"
                android:numColumns="2"
                android:paddingBottom="170dp" />
        </RelativeLayout>

    </ScrollView>
</RelativeLayout>