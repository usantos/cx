<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCartelaFragmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mesesFragmentScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/mesesTituloLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/escolhaNumerosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="41dp"
                tools:text="@string/dia_sorte_escolha_dia" />

            <TextView
                android:id="@+id/paginaNumeroText"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_alignBottom="@+id/escolhaNumerosText"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@+id/escolhaNumerosText"
                android:layout_marginEnd="50dp"
                android:layout_marginTop="0dp"
                android:text="@string/label_numerico_dois" />

            <TextView
                android:id="@+id/paginaQuantidadeText"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_alignBottom="@+id/escolhaNumerosText"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@+id/escolhaNumerosText"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="0dp"
                tools:text="| 2" />
        </RelativeLayout>


    </ScrollView>
</RelativeLayout>