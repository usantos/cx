<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/AppTheme.AppBarOverlay"
    android:background="@color/colorAccent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetLeft="0dp"
            app:contentInsetRight="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:contentInsetEndWithActions="0dp"
        app:popupTheme="@style/AppTheme.PopupOverlay">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:layout_gravity="start">

                        <ImageButton
                            android:id="@+id/customButton"
                            android:layout_width="wrap_content"
                            android:contentDescription=""
                            android:focusable="true"
                            android:importantForAccessibility="yes"
                            android:layout_height="wrap_content"
                            android:background="@color/transparente"
                            android:src="@drawable/ic_arrow_back"
                            android:layout_marginEnd="16dp"/>

                        <TextView
                            android:id="@+id/textCustom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/biometria_popup_titulo"
                            android:textColor="@android:color/white"
                            android:layout_weight="1"
                            android:textSize="20sp"
                            android:fontFamily="@font/caixa_std_semi_bold" />

                        <ImageButton
                            android:id="@+id/buttonQuestions"
                            android:layout_width="25dp"
                            android:contentDescription="@string/action_duvidas"
                            android:focusable="true"
                            android:importantForAccessibility="yes"
                            android:layout_height="25dp"
                            android:scaleType="centerInside"
                            android:background="@color/transparente"
                            android:src="@drawable/icon_duvida2"
                            android:layout_marginEnd="20dp"/>


                </LinearLayout>

        </androidx.appcompat.widget.Toolbar>
</com.google.android.material.appbar.AppBarLayout>