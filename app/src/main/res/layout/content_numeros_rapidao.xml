<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="135dp"
            android:id="@+id/scrollNumerosRapidao">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_meros_obrigat_rios"
                    android:fontFamily="@font/caixa_std_bold"
                    android:textSize="18sp"
                    android:textAlignment="center"
                    android:layout_marginTop="40dp"
                    android:textColor="@color/verdeagua"
                    android:id="@+id/titleNumerosRapidao"
                    />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    >
                    <TextView
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:text="@string/selecione_os_n_meros_que_dever_o_aparecer_em_suas_apostas"
                        android:textSize="14sp"
                        android:textColor="@color/cinza"
                        android:layout_centerHorizontal="true"
                        android:textAlignment="center"
                        android:id="@+id/textoSelecaoNumerosRapidao"
                        style="@style/editTextCaixaStdTheme"/>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp">
                    <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                        android:id="@+id/gridviewNumerosRapidaoSelecao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:columnWidth="56dp"
                        android:numColumns="auto_fit"
                        android:verticalSpacing="17dp"
                        android:stretchMode="spacingWidthUniform"
                        android:layout_marginTop="19dp"
                        android:layout_marginBottom="100dp"
                        android:isScrollContainer="false"
                        android:layout_marginHorizontal="8dp"
                        />


                </RelativeLayout>
            </LinearLayout>
        </ScrollView>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                android:id="@+id/layoutLimparSelecaoApostaRapidaSelecao"
                android:layout_centerHorizontal="true"
                android:visibility="visible">
                <Button
                    android:layout_width="184dp"
                    android:layout_height="56dp"
                    android:text="@string/limpar_sele_o"
                    android:fontFamily="@font/caixa_std_regular"
                    android:textAllCaps="false"
                    android:textColor="@color/cinza"
                    android:textSize="14.2sp"
                    android:id="@+id/botaoLimparSelecaoApostaRapidaSelecao"
                    android:background="@drawable/custom_border_cinza"
                    />
            </RelativeLayout>

            <Button
                android:id="@+id/salvarNumerosApostaRapidaoSelecao"
                android:layout_width="184dp"
                android:layout_height="84dp"
                android:layout_below="@+id/layoutLimparSelecaoApostaRapidaSelecao"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="30dp"
                android:background="@color/verdeazul"
                android:text="@string/salvar"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="17.7sp"
                android:fontFamily="@font/caixa_std_bold" />
            <View
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:background="@color/linhaDivisa"
                android:layout_marginTop="-44dp"
                android:layout_below="@+id/salvarNumerosApostaRapidaoSelecao"
                >

            </View>

        </RelativeLayout>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
