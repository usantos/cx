<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/selecioneTimeCoracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <EditText
            android:id="@+id/informe_nome_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:layout_margin="16dp"
            android:maxLines="1"
            android:drawableStart="@drawable/ic_lupa"
            android:drawableTint="@color/cinza110"
            android:drawablePadding="8dp"
            android:background="@drawable/bg_edit_favoritar"
            android:hint="@string/label_nome_do_time"
            android:textColor="@color/cinza110"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_regular"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gridTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp"
            />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>