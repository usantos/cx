<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/titulo_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textoFormaPagamentoTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/como_voc_prefere_pagar"
                    android:textColor="@color/colorAccent"
                    android:textSize="14.2sp"
                    android:fontFamily="@font/caixa_std_bold"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:id="@+id/containerCartaoCredito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/titulo_descricao"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cabecalho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ECFAFF"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/containerCartaoCredito">

                <View
                    android:id="@+id/margem_cabecalho"
                    android:layout_width="5dp"
                    android:layout_height="57dp"
                    android:background="@color/azul_meu_cartao"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_voltar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/ic_chevron_left"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imagemMeioPagamento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_mercadopago"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@+id/iv_voltar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/alterarMeioPagamento"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Alterar"
                    android:textColor="@color/azul_alterar"
                    android:layout_marginEnd="28dp"
                    android:fontFamily="@font/caixa_std_regular"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0.08dp"
                    android:background="@color/black"
                    app:layout_constraintStart_toEndOf="@id/margem_cabecalho"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/background_dados_cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/azul_meu_cartao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cabecalho">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@color/branco"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/textoBandeiras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bandeirasAceitas"
                        android:fontFamily="@font/caixa_std_regular"
                        android:textColor="@color/cinzaescuro"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"
                        android:layout_marginLeft="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgBandeira1"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_bandeira_amex"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="0dp"
                        app:layout_constraintTop_toBottomOf="@+id/textoBandeiras"
                        app:layout_constraintStart_toStartOf="@+id/textoBandeiras"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgBandeira2"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/textoBandeiras"
                        app:layout_constraintStart_toEndOf="@+id/imgBandeira1"
                        android:visibility="gone"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgBandeira3"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/elo_fundo_claro"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/textoBandeiras"
                        app:layout_constraintStart_toEndOf="@+id/imgBandeira2"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgBandeira4"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_hipercard"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/textoBandeiras"
                        app:layout_constraintStart_toEndOf="@+id/imgBandeira3"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgBandeira5"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_master_card"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/textoBandeiras"
                        app:layout_constraintStart_toEndOf="@id/imgBandeira4"
                        />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgBandeira6"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_bandeira_visa"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/textoBandeiras"
                        app:layout_constraintStart_toEndOf="@+id/imgBandeira5"
                        />

                    <RelativeLayout
                        android:id="@+id/containerNumeroCartao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgBandeira3">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/editTextNumeroCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true">

                            <EditText
                                android:id="@+id/editTextNumeroCartaoContent"
                                style="@style/editTextCaixaRegularTheme"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="10"
                                android:hint="@string/title_numCartao"
                                android:inputType="number"
                                android:textColor="@color/cinza"
                                android:textColorHint="@color/azulFormNovoTipoPagamento"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/containerNomeClienteCartao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/editTextNomeClienteCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true">

                            <EditText
                                android:id="@+id/editTextNomeClienteCartaoContent"
                                style="@style/editTextCaixaRegularTheme"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/title_nomeIgualAoCartao"
                                android:inputType="textPersonName"
                                android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                android:textColorHint="@color/azulFormNovoTipoPagamento"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>


                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/containerValidadeCartao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginRight="16dp"
                        android:baselineAligned="false"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerNomeClienteCartao">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/containerMesValidadeCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_marginRight="10dp"
                            android:layout_weight="1"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/editTextMesValidadeCartao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                app:layout_constraintTop_toTopOf="parent">

                                <EditText
                                    android:id="@+id/editTextMesValidadeCartaooContent"
                                    style="@style/editTextCaixaRegularTheme"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:hint="@string/title_mesDeValidade"
                                    android:fontFamily="@font/caixa_std_regular"
                                    android:inputType="number"
                                    android:maxLength="2"
                                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                    android:textColorHint="@color/azulFormNovoTipoPagamento"
                                    android:textSize="16sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <Spinner
                                android:id="@+id/spin_meses"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="@color/colorAccent"
                                android:dropDownWidth="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/containerAnoValidadeCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginLeft="10dp"
                            android:layout_weight="1"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/editTextAnoValidadeCartao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                app:layout_constraintTop_toTopOf="parent">

                                <EditText
                                    android:id="@+id/editTextAnoValidadeCartaooContent"
                                    style="@style/editTextCaixaRegularTheme"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/title_anoValidade"
                                    android:fontFamily="@font/caixa_std_regular"
                                    android:inputType="number"
                                    android:maxLength="4"
                                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                    android:textColorHint="@color/azulFormNovoTipoPagamento"
                                    android:textSize="16sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <Spinner
                                android:id="@+id/spin_anos"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="@color/colorAccent"
                                android:dropDownWidth="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerComboSalvar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerValidadeCartao">

                        <CheckBox
                            android:id="@+id/checkBoxSalvarCartao"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="20dp"
                            android:background="@drawable/check_box_selected"
                            android:button="@color/transparente50"
                            android:checked="false"
                            android:layout_gravity="center"
                            android:textColor="@color/pretoLinhaFormNovoTipoPagamento" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/editTextCaixaRegularTheme"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_salvar_Cartao"
                                android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <Button
                        android:id="@+id/botaoAvancarPagamento"
                        android:layout_width="184dp"
                        android:layout_height="84dp"
                        android:background="@color/cinzaDisable"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="@string/title_continuar"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                        android:textColor="@color/branco"
                        android:textSize="17sp"
                        android:layout_marginBottom="24dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerComboSalvar" />



                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
