<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    tools:context="br.gov.caixa.loterias.apostas.controllers.NovaFormaPagamentoActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/titulo_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textoInfoSelecioneFormaPagamento"
                    style="@style/editTextArialMTTheme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="19dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/selecione_o_meio_de_pagamento_que_ira_processar_a_compra"
                    android:textColor="@color/cinza"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textoFormaPagamentoTitulo" />

                <TextView
                    android:id="@+id/textoFormaPagamentoTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/como_voc_prefere_pagar"
                    android:textColor="@color/colorAccent"
                    android:textSize="14.2sp"
                    android:textStyle="bold"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cabecalho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/titulo_descricao">

                <View
                    android:id="@+id/margem_cabecalho"
                    android:layout_width="5dp"
                    android:layout_height="57dp"
                    android:background="@color/azul_meu_cartao"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_voltar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/ic_chevron_left"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imagemMeioPagamento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/mercadopago"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@+id/iv_voltar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:id="@+id/alterarMeioPagamento"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Alterar"
                    android:textColor="@color/azul_alterar"
                    android:layout_marginEnd="28dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/background_dados_cartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/azul_meu_cartao"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cabecalho">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@color/branco"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <RelativeLayout
                        android:id="@+id/containerNumeroCartao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/editTextNumeroCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true">

                            <EditText
                                android:id="@+id/editTextNumeroCartaoContent"
                                style="@style/editTextRegisterTheme"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ems="10"
                                android:hint="@string/title_numCartao"
                                android:inputType="number"
                                android:textColor="@color/cinza"
                                android:textColorHint="@color/azulFormNovoTipoPagamento"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/containerNomeClienteCartao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/editTextNomeClienteCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true">

                            <EditText
                                android:id="@+id/editTextNomeClienteCartaoContent"
                                style="@style/editTextRegisterTheme"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/title_nomeIgualAoCartao"
                                android:inputType="textPersonName"
                                android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                android:textColorHint="@color/azulFormNovoTipoPagamento"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>


                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/containerCodigoSeguranca"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginRight="16dp"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerNomeClienteCartao">

                        <ImageView
                            android:id="@+id/imageViewCVV"
                            android:layout_width="37dp"
                            android:layout_height="26dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentRight="true"

                            android:layout_centerInParent="true"
                            app:srcCompat="@drawable/cartao_cvc" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/editTextCodigoSeguranca"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true">

                            <EditText
                                android:id="@+id/editTextCodigoSegurancaContent"
                                style="@style/editTextRegisterTheme"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="40dp"
                                android:hint="@string/title_cvv"
                                android:inputType="number"
                                android:maxLength="4"
                                android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                android:textColorHint="@color/azulFormNovoTipoPagamento"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/containerValidadeCartao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginRight="16dp"
                        android:baselineAligned="false"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerCodigoSeguranca">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/containerMesValidadeCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_marginRight="10dp"
                            android:layout_weight="1"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/editTextMesValidadeCartao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                app:layout_constraintTop_toTopOf="parent">

                                <EditText
                                    android:id="@+id/editTextMesValidadeCartaooContent"
                                    style="@style/editTextRegisterTheme"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:hint="@string/title_mesDeValidade"
                                    android:inputType="number"
                                    android:maxLength="2"
                                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                    android:textColorHint="@color/azulFormNovoTipoPagamento"
                                    android:textSize="16sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <Spinner
                                android:id="@+id/spin_meses"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="@color/colorAccent"
                                android:dropDownWidth="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/containerAnoValidadeCartao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginLeft="10dp"
                            android:layout_weight="1"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/containerNumeroCartao">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/editTextAnoValidadeCartao"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentTop="true"
                                app:layout_constraintTop_toTopOf="parent">

                                <EditText
                                    android:id="@+id/editTextAnoValidadeCartaooContent"
                                    style="@style/editTextRegisterTheme"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/title_anoValidade"
                                    android:inputType="number"
                                    android:maxLength="4"
                                    android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                                    android:textColorHint="@color/azulFormNovoTipoPagamento"
                                    android:textSize="16sp" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <Spinner
                                android:id="@+id/spin_anos"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="@color/colorAccent"
                                android:dropDownWidth="wrap_content"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerComboSalvar"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerValidadeCartao">

                        <CheckBox
                            android:id="@+id/checkBoxSalvarCartao"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="20dp"
                            android:background="@drawable/check_box_selected"
                            android:button="@color/transparente50"
                            android:checked="false"
                            android:layout_gravity="center"
                            android:textColor="@color/azul_salvar_cartao" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/editTextArialMTTheme"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_salvar_Cartao"
                                android:textColor="@color/azul_salvar_cartao"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerComboCiente"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerComboSalvar">

                        <CheckBox
                            android:id="@+id/checkBoxCiente"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="20dp"
                            android:background="@drawable/check_box_selected"
                            android:button="@color/transparente50"
                            android:checked="false"
                            android:layout_gravity="center"
                            android:textColor="@color/pretoLinhaFormNovoTipoPagamento" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_gravity="center"
                            android:orientation="vertical">

                            <TextView
                                style="@style/editTextArialMTTheme"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_ciente_cpf_titularidadeo"
                                android:textColor="@color/azul_salvar_cartao"
                                android:textSize="16sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <Button
                        android:id="@+id/botaoAvancarPagamento"
                        android:layout_width="184dp"
                        android:layout_height="84dp"
                        android:background="@color/cinza_salvar_cartao_desabilitado"
                        android:text="_Pagar agora_"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                        android:textColor="@color/branco"
                        android:textSize="17sp"
                        android:layout_marginBottom="24dp"
                        android:layout_marginTop="24dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/containerComboCiente" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>