<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:layout_alignBottom="@+id/relativeLayoutContentFavoritas"
        android:layout_alignParentTop="true"
        android:background="@color/cinza"
        android:orientation="horizontal"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/relativeLayoutContentAlterarFavoritasEditar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="17dp"
                android:fontFamily="@font/arialmt"
                android:text="@string/d_um_novo_nome_para_sua_aposta"
                android:textColor="@color/verdeazul"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editTextNomeDaAposta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="122dp"
                android:layout_marginTop="37dp"
                android:backgroundTint="@color/edittextlinecinza"
                android:enabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/branco" />

            <RelativeLayout
                android:id="@+id/layoutSalvarNomeAposta"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="86dp"
                android:layout_marginTop="50dp"
                android:clickable="true">

                <ImageView
                    android:id="@+id/imagemSalvarNomeAposta"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/seta_verde" />
            </RelativeLayout>


        </RelativeLayout>

        <LinearLayout
            android:id="@+id/linearLayoutLayoutContentAlterarFavoritasSalvo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/verdeazul"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/arialmt"
                    android:text="@string/label_otimo_novo_nome_sua_aposta"
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/nomeApostaSalvoTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/arialmt"
                    android:text="@string/quot_o_pr_mio_meu_quot"
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/relativeLayoutContentFavoritas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:background="@color/branco"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/LinearLayoutContentApostaFavorita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tituloApostaFavorita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:fontFamily="@font/arialmt"
                    android:text=""
                    android:textColor="@color/verdeazul"
                    android:textSize="14.2sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tituloNomeApostaFavorita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arialmt"
                    android:text="@string/agora_vai"
                    android:textColor="@color/cinza"
                    android:textSize="14.2sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/numerosApostaFavorita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="123dp"
                    android:textColor="@color/azulescuroapostafavorita"
                    android:textSize="14.2sp"
                    tools:text="01 - 02 - 03 - 04 - 05 - 06 - 10 - 11 - 12 - 20 - 33 - 100" />

                <LinearLayout
                    android:layout_width="123dp"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/editarRelativeLayoutFavoritos"
                        android:layout_width="41dp"
                        android:layout_height="30dp"
                        android:visibility="invisible"
                        android:clickable="false">

                        <Button
                            android:id="@+id/editarButtonFavoritos"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/iconfavedit"
                            android:clickable="false" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/editarRelativeLayoutAddCarrinho"
                        android:layout_width="41dp"
                        android:layout_height="30dp"
                        android:clickable="true">

                        <Button
                            android:id="@+id/editarButtonAddCarrinho"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/icon_add_carrinho"
                            android:clickable="false" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/exluirRelativeLayoutFavoritos"
                        android:layout_width="41dp"
                        android:layout_height="30dp"
                        android:clickable="true">

                        <Button
                            android:id="@+id/exluirButtonFavoritos"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/close"
                            android:clickable="false" />
                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/maisInformacoesLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/numerosApostaFavorita"
                    android:layout_alignStart="@+id/numerosApostaFavorita"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/labelInformacaoText"
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/azulescuroapostafavorita"
                        android:textSize="14sp"
                        tools:text="Mes de Sorte: " />

                    <TextView
                        android:id="@+id/informacaoText"
                        style="@style/ArialMT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/azulescuroapostafavorita"
                        android:textSize="14sp"
                        tools:text="Fevereiro" />
                </LinearLayout>
            </RelativeLayout>


        </LinearLayout>

    </RelativeLayout>

</com.daimajia.swipe.SwipeLayout>



