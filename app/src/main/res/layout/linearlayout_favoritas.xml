<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutFavoritas"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco">

    <!-- Título -->
    <TextView
        android:id="@+id/tituloNomeApostaFavorita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_semi_bold"
        android:textSize="16sp"
        android:text="@string/agora_vai"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp" />

    <!-- Números da aposta -->
    <TextView
        android:id="@+id/numerosApostaFavorita"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/cinza130"
        android:textSize="16sp"
        android:fontFamily="@font/caixa_std_regular"
        tools:text="01 - 02 - 03 - 04 - 05 - 06 - 10 - 11 - 12 - 20 - 33 - 100"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/tituloNomeApostaFavorita"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/editarRelativeLayout"
        />

    <!-- Botões de ação -->
    <LinearLayout
        android:id="@+id/editarRelativeLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/transparente"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/tituloNomeApostaFavorita"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="14dp">

        <RelativeLayout
            android:id="@+id/editarRelativeLayoutAddCarrinho"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:clickable="true"
            android:layout_marginEnd="8dp">

            <Button
                android:id="@+id/editarButtonAddCarrinho"
                android:layout_width="26dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:background="@drawable/ic_favoritas_carrinho"
                android:clickable="false" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/excluirRelativeLayoutFavoritos"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:clickable="true">

            <Button
                android:id="@+id/excluirButtonFavoritos"
                android:layout_width="17dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:background="@drawable/ic_favoritas_lixeira"
                android:clickable="false" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Informações adicionais -->
    <LinearLayout
        android:id="@+id/infoAdicionais"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/numerosApostaFavorita"
        app:layout_constraintStart_toStartOf="@id/numerosApostaFavorita">

        <LinearLayout
            android:id="@+id/maisInformacoesLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/numerosApostaFavorita"
            app:layout_constraintStart_toStartOf="@id/numerosApostaFavorita">

            <TextView
                android:id="@+id/labelInformacaoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cinza110"
                android:textSize="16sp"
                tools:text="Mes de Sorte: "
                android:fontFamily="@font/caixa_std_regular" />

            <TextView
                android:id="@+id/informacaoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cinza110"
                android:textSize="16sp"
                tools:text="Fevereiro"
                android:fontFamily="@font/caixa_std_regular" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/maisInformacoesMaisMilionaria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/numerosApostaFavorita"
            app:layout_constraintStart_toStartOf="@id/numerosApostaFavorita">

            <TextView
                android:id="@+id/labelInformacaoMaisMilionaria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cinza110"
                android:textSize="16sp"
                android:text="@string/trevos_"
                tools:text="Trevos: "
                android:fontFamily="@font/caixa_std_regular" />

            <TextView
                android:id="@+id/informacaoTextMaisMilionaria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cinza110"
                android:textSize="16sp"
                tools:text=""
                android:fontFamily="@font/caixa_std_regular" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fragment container (inicialmente invisível) -->
    <RelativeLayout
        android:id="@+id/rl_container_fragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/tituloNomeApostaFavorita"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/editarRelativeLayout"
        />

    <View
        android:id="@+id/linhaDivisoriaAposFragment"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/linhaDivisa"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/rl_container_fragment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Linha divisória -->
    <View
        android:id="@+id/linhaDivisoria"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/linhaDivisa"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/infoAdicionais"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>