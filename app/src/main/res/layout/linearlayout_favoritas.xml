<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:layout_alignBottom="@+id/relativeLayoutContentFavoritas"
        android:layout_alignParentTop="true"
        android:background="@color/cinza"
        android:orientation="horizontal"
        android:visibility="visible">

        <RelativeLayout
            android:id="@+id/relativeLayoutContentAlterarFavoritasEditar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="17dp"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/d_um_novo_nome_para_sua_aposta"
                android:textColor="@color/verdeazul"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editTextNomeDaAposta"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentLeft="true"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="122dp"
                android:layout_marginTop="37dp"
                android:backgroundTint="@color/edittextlinecinza"
                android:enabled="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_regular"/>

            <RelativeLayout
                android:id="@+id/layoutSalvarNomeAposta"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentRight="true"
                android:layout_marginRight="86dp"
                android:layout_marginTop="50dp"
                android:clickable="true">

                <ImageView
                    android:id="@+id/imagemSalvarNomeAposta"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/seta_verde" />
            </RelativeLayout>


        </RelativeLayout>

        <LinearLayout
            android:id="@+id/linearLayoutLayoutContentAlterarFavoritasSalvo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/verdeazul"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/caixa_std_regular"
                    android:text="@string/label_otimo_novo_nome_sua_aposta"
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/nomeApostaSalvoTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/caixa_std_bold"
                    android:text="@string/quot_o_pr_mio_meu_quot"
                    android:textAlignment="center"
                    android:textColor="@color/branco"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <RelativeLayout
        android:id="@+id/relativeLayoutContentFavoritas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:background="@color/branco"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/LinearLayoutContentApostaFavorita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingLeft="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">

<!--                <TextView-->
<!--                    android:id="@+id/tituloApostaFavorita"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginLeft="16dp"-->
<!--                    android:fontFamily="@font/futura_std_bold"-->
<!--                    android:text=""-->
<!--                    android:textColor="@color/verdeazul"-->
<!--                    android:textSize="14.2sp" />-->

                <TextView
                    android:id="@+id/tituloNomeApostaFavorita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/caixa_std_semi_bold"
                    android:text="@string/agora_vai"
                    android:textColor="@color/cinza130"
                    android:textSize="16sp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/numerosApostaFavorita"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="100dp"
                    android:textColor="@color/cinza130"
                    android:textSize="16sp"
                    tools:text="01 - 02 - 03 - 04 - 05 - 06 - 10 - 11 - 12 - 20 - 33 - 100"
                    android:fontFamily="@font/caixa_std_regular"/>

                <RelativeLayout
                    android:id="@+id/rl_container_fragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="0dp"
                    android:visibility="gone"
                    android:layout_below="@id/numerosApostaFavorita"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:background="@color/transparente"
                    android:orientation="horizontal">

<!--                    <RelativeLayout-->
<!--                        android:id="@+id/editarRelativeLayoutFavoritos"-->
<!--                        android:layout_width="30dp"-->
<!--                        android:layout_height="30dp"-->
<!--                        android:layout_marginRight="5dp"-->
<!--                        android:visibility="invisible"-->
<!--                        android:clickable="false">-->

<!--                        <Button-->
<!--                            android:id="@+id/editarButtonFavoritos"-->
<!--                            android:layout_width="16dp"-->
<!--                            android:layout_height="15dp"-->
<!--                            android:layout_centerVertical="true"-->
<!--                            android:background="@drawable/iconfavedit"-->
<!--                            android:clickable="false" />-->
<!--                    </RelativeLayout>-->

                    <RelativeLayout
                        android:id="@+id/editarRelativeLayoutAddCarrinho"
                        android:layout_width="30dp"
                        android:layout_marginRight="8dp"
                        android:layout_height="30dp"
                        android:clickable="true">

                        <Button
                            android:id="@+id/editarButtonAddCarrinho"
                            android:layout_width="26dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/ic_favoritas_carrinho"
                            android:clickable="false" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/excluirRelativeLayoutFavoritos"
                        android:layout_width="30dp"
                        android:layout_marginRight="14dp"
                        android:layout_height="30dp"
                        android:clickable="true">

                        <Button
                            android:id="@+id/excluirButtonFavoritos"
                            android:layout_width="17dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/ic_favoritas_lixeira"
                            android:clickable="false" />
                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/maisInformacoesLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/numerosApostaFavorita"
                    android:layout_alignStart="@+id/numerosApostaFavorita"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/labelInformacaoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cinza110"
                        android:textSize="16sp"
                        tools:text="Mes de Sorte: "
                        android:fontFamily="@font/caixa_std_regular"/>

                    <TextView
                        android:id="@+id/informacaoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cinza110"
                        android:textSize="16sp"
                        tools:text="Fevereiro"
                        android:fontFamily="@font/caixa_std_regular"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/maisInformacoesMaisMilionaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/numerosApostaFavorita"
                    android:layout_alignStart="@+id/numerosApostaFavorita"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/labelInformacaoMaisMilionaria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cinza110"
                        android:textSize="16sp"
                        android:text="@string/trevos_"
                        tools:text="Trevos: "
                        android:fontFamily="@font/caixa_std_regular"/>

                    <TextView
                        android:id="@+id/informacaoTextMaisMilionaria"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cinza110"
                        android:textSize="16sp"
                        tools:text=""
                        android:fontFamily="@font/caixa_std_regular"/>

                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

        <View
            android:id="@+id/linhaDivisoria"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/linhaDivisa"
            android:layout_marginTop="5dp"
            android:layout_below="@id/LinearLayoutContentApostaFavorita"/>

    </RelativeLayout>

</com.daimajia.swipe.SwipeLayout>



