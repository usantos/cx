<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:id="@+id/layout_fragmento"
    android:background="@color/mega_verde_claro_mkp">

    <ImageView
        android:id="@+id/back_money"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:background="@drawable/ic_trapezio_mkp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/trevoImagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:layout_centerInParent="true"
        android:src="@drawable/ic_money_bolao"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/back_money"
        app:layout_constraintBottom_toBottomOf="@id/back_money"
        app:layout_constraintStart_toStartOf="@id/back_money"
        app:layout_constraintEnd_toEndOf="@id/back_money"/>

    <TextView
        android:id="@+id/label_sorteio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:text="@string/label_sorteio_case"
        android:textColor="@color/branco"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/id_sorteio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="03/12"
        android:textSize="12sp"
        android:textColor="@color/branco"
        android:fontFamily="@font/caixa_std_bold"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/label_sorteio"
        app:layout_constraintStart_toStartOf="@id/label_sorteio"/>

    <TextView
        android:id="@+id/label_concurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:text="@string/label_concurso"
        android:textColor="@color/branco"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/label_sorteio"/>

    <TextView
        android:id="@+id/id_concurso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="1891"
        android:textColor="@color/branco"
        android:fontFamily="@font/caixa_std_bold"
        android:textSize="12sp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/label_concurso"
        app:layout_constraintStart_toStartOf="@id/label_concurso"/>

    <TextView
        android:id="@+id/id_modalidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Modalidade"
        android:textColor="@color/branco"
        android:fontFamily="@font/futura_std_bold"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/back_money"
        app:layout_constraintEnd_toStartOf="@id/label_concurso"/>

</androidx.constraintlayout.widget.ConstraintLayout>