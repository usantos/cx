<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background">

    <ScrollView
        android:id="@+id/sv_carrinho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:fontFamily="@font/caixa_std_bold"
                android:lineSpacingExtra="5dp"
                android:textSize="16sp"
                android:text="@string/selecione_as_op_es_e_clique_em_adicionar"
                android:textAlignment="center"
                android:id="@+id/selecioneText"
                android:textColor="@color/blue_caixa" />

            <Button
                android:id="@+id/selecioneConcursoButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_rounded_border_grey"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/tipo_de_concurso"
                android:textAllCaps="false"
                android:textColor="@color/greyText"
                android:textSize="16sp" />

            <NumberPicker
                android:id="@+id/picker_tipo_concurso"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:descendantFocusability="blocksDescendants" />

            <Button
                android:id="@+id/selecioneQntTeimosinhaButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_rounded_border_grey"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/quantidade_teimosinhas"
                android:contentDescription="@string/quantidade_teimosinhas"
                android:textAllCaps="false"
                android:textColor="@color/greyText"
                android:textSize="16sp"
                android:visibility="gone" />

            <NumberPicker
                android:id="@+id/picker_qnt_teimosinhas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:descendantFocusability="blocksDescendants" />

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/checkbox_aposta_espelho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:button="@drawable/check_box_selected"
        android:checked="false"
        android:text="@string/label_modal_checkbox_aposta_espelho"
        android:layout_margin="8dp"
        android:paddingStart="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/sv_carrinho"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/cancelarModalFavoritosAddCarrinhoButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@drawable/button_border_new_blue"
        android:fontFamily="@font/caixa_std_bold"
        android:text="@string/cancelar"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/checkbox_aposta_espelho"
        app:layout_constraintEnd_toStartOf="@id/adicionarCarrinhoFavoritosButton"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@+id/adicionarCarrinhoFavoritosButton"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_weight="0.5"
        android:background="@color/cinzaDisable"
        android:fontFamily="@font/caixa_std_bold"
        android:text="@string/adicionar_ao_carrinho"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:enabled="false"
        app:layout_constraintTop_toTopOf="@id/cancelarModalFavoritosAddCarrinhoButton"
        app:layout_constraintStart_toEndOf="@id/cancelarModalFavoritosAddCarrinhoButton"
        app:layout_constraintBottom_toBottomOf="@id/cancelarModalFavoritosAddCarrinhoButton"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
