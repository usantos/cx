<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco">

    <ScrollView
        android:id="@+id/sv_carrinho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/futura_std_bold"
                android:lineSpacingExtra="5dp"
                android:text="Selecione as opções e clique em adicionar"
                android:textAlignment="center"
                android:textColor="@color/verdeazul" />

            <Button
                android:id="@+id/selecioneConcursoButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_border_azul"
                android:fontFamily="@font/futura_std_bold"
                android:text="Selecione o tipo de concurso"
                android:textAllCaps="false"
                android:textColor="@color/textColorToolbar"
                android:textSize="14dp" />

            <NumberPicker
                android:id="@+id/picker_tipo_concurso"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:descendantFocusability="blocksDescendants" />


            <Button
                android:id="@+id/selecioneQntTeimosinhaButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_border_azul"
                android:fontFamily="@font/futura_std_bold"
                android:text="Selecione a qtd. de teimosinhas"
                android:textAllCaps="false"
                android:textColor="@color/textColorToolbar"
                android:textSize="14dp"
                android:visibility="gone" />

            <NumberPicker
                android:id="@+id/picker_qnt_teimosinhas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignBottom="@id/sv_carrinho"
        android:layout_marginHorizontal="20dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/sv_carrinho"
        tools:layout_editor_absoluteX="20dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="0.5">

            <Button
                android:id="@+id/cancelarModalFavoritosAddCarrinhoButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="5dp"
                android:background="@color/verdeazul"
                android:fontFamily="@font/futura_std_bold"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/branco" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="0.5">

            <Button
                android:id="@+id/adicionarCarrinhoFavoritosButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="5dp"
                android:background="@color/verdeazul"
                android:fontFamily="@font/futura_std_bold"
                android:text="Adicionar no carrinho"
                android:textAllCaps="false"
                android:textColor="@color/branco" />
        </FrameLayout>
    </LinearLayout>

</android.support.constraint.ConstraintLayout>