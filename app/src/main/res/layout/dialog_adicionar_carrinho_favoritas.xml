<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/branco">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="100dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecione as opções e clique em adicionar"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/verdeazul"
                android:fontFamily="@font/futura_std_bold"
                android:layout_marginTop="30dp"
                android:layout_marginHorizontal="5dp"
                android:textAlignment="center"
                android:lineSpacingExtra="5dp"
                />

            <Button
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Selecione o tipo de concurso"
                android:textAllCaps="false"
                android:background="@drawable/button_border_azul"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/textColorToolbar"
                android:textSize="14dp"
                android:fontFamily="@font/futura_std_bold"
                android:id="@+id/selecioneConcursoButton"/>

            <NumberPicker
                android:id="@+id/picker_tipo_concurso"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:descendantFocusability="blocksDescendants"/>


            <Button
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Selecione a qtd. de teimosinhas"
                android:textAllCaps="false"
                android:background="@drawable/button_border_azul"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/textColorToolbar"
                android:textSize="14dp"
                android:fontFamily="@font/futura_std_bold"
                android:id="@+id/selecioneQntTeimosinhaButton"
                android:visibility="gone"/>

            <NumberPicker
                android:id="@+id/picker_qnt_teimosinhas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:descendantFocusability="blocksDescendants"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_alignParentBottom="true"
        >
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="0.5">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:background="@color/verdeazul"
                android:id="@+id/cancelarModalFavoritosAddCarrinhoButton"
                android:layout_marginHorizontal="5dp"
                android:fontFamily="@font/futura_std_bold"
                />

        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="0.5">
            <Button
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Adicionar no carrinho"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:background="@color/verdeazul"
                android:id="@+id/adicionarCarrinhoFavoritosButton"
                android:layout_marginHorizontal="5dp"
                android:fontFamily="@font/futura_std_bold"
                />
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>