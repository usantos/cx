<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.activity.ConfirmaDadosPixActivity">

    <include layout="@layout/app_bar_degrade_pesquisa" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_pix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_pix_145"
        android:layout_margin="32dp"
        app:layout_constraintTop_toBottomOf="@id/gl_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_valor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradiente_titulo_caixa"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_pix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/premio_valor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confira os dados antes\nde concluir o resgate"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/branco"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/label_nome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/view_valor"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/label_cpf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPF:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/label_nome"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/label_instituicao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Instituição:"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/label_cpf"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txt_nome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Alexandre Santos"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/label_nome"
        app:layout_constraintStart_toEndOf="@id/label_instituicao"/>

    <TextView
        android:id="@+id/txt_cpf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="***.352.456-***"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/label_cpf"
        app:layout_constraintStart_toEndOf="@id/label_instituicao"/>

    <TextView
        android:id="@+id/txt_intituicao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Caixa Econômica Federal"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/label_instituicao"
        app:layout_constraintStart_toEndOf="@id/label_instituicao"/>

    <Button
        android:id="@+id/btn_confimar"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginBottom="20dp"
        android:background="@color/verdeazul"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="Concluir resgate"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_trocar_chave"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Button
        android:id="@+id/btn_trocar_chave"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:text="Trocar Tipo de Chave"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/verdeazul"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/button_border_verde"
        android:layout_marginBottom="51dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>