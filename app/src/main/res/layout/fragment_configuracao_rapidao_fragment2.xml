<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.ConfiguracaoRapidaoFragment2">

    <TextView
        android:id="@+id/tv_pm_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conf_rapd_premio_minimo"
        android:layout_marginTop="20dp"
        android:textColor="@color/verde_card"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_pm_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingLeft="25dp"
        android:paddingRight="50dp"
        android:gravity="center"
        android:textSize="15sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pm_titulo" />

    <View
        android:id="@+id/v_div_1"
        android:layout_width="150dp"
        android:layout_height="1dp"
        android:background="@color/cinzaclaro"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pm_desc" />

    <NumberPicker
        android:id="@+id/np_premio_minimo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:theme="@style/AppTheme.Picker"
        android:descendantFocusability="blocksDescendants"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_div_1"/>

    <View
        android:id="@+id/v_div_2"
        android:layout_width="150dp"
        android:layout_height="1dp"
        android:background="@color/cinzaclaro"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/np_premio_minimo" />

    <TextView
        android:id="@+id/tv_nossas_sugestoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/conf_rapd_nossas_sugestoes"
        android:layout_marginTop="20dp"
        android:paddingLeft="25dp"
        android:paddingRight="50dp"
        android:gravity="center"
        android:textSize="15sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_div_2" />

    <android.support.v7.widget.RecyclerView
        android:id="@+id/rv_sugestoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_nossas_sugestoes" />

</android.support.constraint.ConstraintLayout>