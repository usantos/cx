<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/branco">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTitulo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/gradiente_titulo_caixa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tituloDialogCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:text="@string/label_atencao"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <Button
            android:id="@+id/closePopup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="x"
            android:gravity="right|center"
            android:background="@android:color/transparent"
            android:paddingEnd="16dp"
            android:fontFamily="@font/caixa_std_regular"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/descricaoDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Descricao"
        android:textSize="18sp"
        android:layout_gravity="center"
        android:padding="14dp"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toBottomOf="@+id/layoutTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <View
        android:id="@+id/linhaDivisaoBotoes"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cinza2"
        app:layout_constraintTop_toBottomOf="@id/descricaoDialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/dialogButton1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/verdeazul"
        android:text="1"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:fontFamily="@font/caixa_std_bold"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/linhaDivisaoBotoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dialogButton2"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <Button
        android:id="@+id/dialogButton2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/verdeazul"
        android:text="2"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:fontFamily="@font/caixa_std_bold"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/linhaDivisaoBotoes"
        app:layout_constraintStart_toEndOf="@id/dialogButton1"
        app:layout_constraintEnd_toStartOf="@id/dialogButton3"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@+id/dialogButton3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/verdeazul"
        android:text="3"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:fontFamily="@font/caixa_std_bold"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/linhaDivisaoBotoes"
        app:layout_constraintStart_toEndOf="@id/dialogButton2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
