    <TextView
        android:id="@+id/textObservacaoConfirmacao"
        style="@style/editTextArialMTTheme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="46dp"
        android:layout_marginLeft="46dp"
        android:layout_marginRight="46dp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="11dp"
        android:text="@string/infoValorMinimoCarrinho"
        android:textAlignment="center"
        android:textColor="@color/branco"
        app:layout_constraintLeft_toLeftOf="@+id/imageSetaApontandoCarrinho"
        app:layout_constraintRight_toRightOf="@+id/imageSetaApontandoCarrinho"
        app:layout_constraintTop_toTopOf="@+id/imageSetaApontandoCarrinho" />

    <TextView
        android:id="@+id/textTituloTela"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:layout_marginEnd="105dp"
        android:layout_marginLeft="105dp"
        android:layout_marginRight="105dp"
        android:layout_marginStart="105dp"
        android:text="@string/tituloApostaFeita"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textSize="14.2sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/imageSetaApontandoCarrinho"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

