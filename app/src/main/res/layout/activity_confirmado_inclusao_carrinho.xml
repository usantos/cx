    <ImageView
        android:id="@+id/imageSetaApontandoCarrinho"
        android:layout_width="0dp"
        android:layout_height="309dp"
        android:layout_marginBottom="7dp"
        android:layout_marginEnd="42dp"
        android:layout_marginLeft="53dp"
        android:layout_marginRight="42dp"
        android:layout_marginStart="53dp"
        app:layout_constraintBottom_toTopOf="@+id/viewTabBar"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/rectangle_5_copy" />

    <RelativeLayout
        android:id="@+id/viewTabBar"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:background="@color/azulclaro"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="13dp"
            android:layout_toStartOf="@+id/imageViewPaginacao">

            <TextView
                android:id="@+id/valorApostaConfirmacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/textInfoValorAposta"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="10dp"
                android:textAlignment="center"
                android:textStyle="bold"
                tools:text="R$ 4,50" />

            <TextView
                android:id="@+id/textInfoValorAposta"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:text="@string/valorDessaAposta"
                android:textAlignment="center"
                android:textColor="@color/azulescuro"
                android:textSize="12sp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/imageViewPaginacao"
            android:layout_width="184dp"
            android:layout_height="12dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="19dp"
            android:contentDescription="@string/imagemCarrinho"
            app:srcCompat="@drawable/paginacao1" />

        <RelativeLayout
            android:id="@+id/confirmarInclusaoApostaLayoutCarrinhoApostas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="13dp"
            android:layout_marginTop="8dp"
            android:layout_toEndOf="@+id/imageViewPaginacao"
            android:clickable="true">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">

                <Button
                    android:id="@+id/botaoCarrinho"
                    android:layout_width="34dp"
                    android:layout_height="40dp"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/icon_carrinho"
                    android:clickable="false" />

                <TextView
                    android:id="@+id/textViewCarrinhoCartelaCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/rounded_textview"
                    android:clickable="false"
                    android:gravity="center"
                    android:outlineProvider="none"
                    android:text="0"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:translationZ="2dp"
                    android:layout_marginEnd="25dp"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/textInfoCarrinho"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:clickable="false"
                android:text="@string/carrinhoDeApostas"
                android:textAlignment="center"
                android:textColor="@color/azulescuro"
                android:textSize="12sp" />
        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/botaoLinearLayoutVoltarPrincipal"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginBottom="51dp"
        android:background="@color/cinza"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text=""
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/viewTabBar"
        app:layout_constraintRight_toLeftOf="@+id/viewTabBar">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:fontFamily="@font/futura_std_bold"
            android:text="Voltar"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="17.7sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/futura_std_book"
            android:text="ao início"
            android:textAlignment="center"
            android:textColor="@color/branco"
            android:textSize="14.2sp" />
    </LinearLayout>

</android.support.constraint.ConstraintLayout>
