<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:background="@color/cinzaCx"
    android:minHeight="40dp">

    <ImageView
        android:id="@+id/iconCef"
        android:layout_width="30dp"
        android:layout_height="22dp"
        android:layout_marginStart="20dp"
        android:layout_marginVertical="10dp"
        android:src="@drawable/ic_logo_nova"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="invisible"
        />


    <TextView
        android:id="@+id/nav_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/caixa_std_bold"
        android:text="@string/cef_id_tit"
        android:textAppearance="@style/cef_titulo"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/iconCef"
        app:layout_constraintEnd_toStartOf="@id/imagemMaisOpcoes"
        app:layout_constraintStart_toEndOf="@id/iconCef"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imagemMaisOpcoes"
        android:layout_width="10dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_seta"
        android:visibility="visible"
        android:layout_marginEnd="18dp"
        android:importantForAccessibility="no"
        android:layout_marginVertical="10dp"
        app:layout_constraintStart_toEndOf="@+id/nav_user"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>


    <TextView
        android:id="@+id/nav_user_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/caixa_std_regular"
        android:maxLines="5"
        android:paddingTop="5dp"
        android:paddingBottom="6dp"
        android:importantForAccessibility="yes"
        android:text="@string/cef_id1"
        android:textColor="@color/cinzaIdcaixa"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/nav_user"
        app:layout_constraintTop_toBottomOf="@id/nav_user" />


</androidx.constraintlayout.widget.ConstraintLayout>

