<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_partida_lotogol"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="28dp"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/diaSemanaDataPartidaText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/caixa_std_regular"
        android:textAlignment="center"
        android:layout_marginTop="2dp"
        android:textColor="@color/branco"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal">

        <br.gov.caixa.loterias.apostas.view.custom.ItemEquipeViewLotogolResultado
            android:id="@+id/lotogol_time_um"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/lotogol_versus"
            android:layout_width="18dp"
            android:layout_height="17dp"
            android:layout_gravity="top"
            android:layout_marginEnd="21dp"
            android:layout_marginStart="25dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/time_versus_white" />

        <br.gov.caixa.loterias.apostas.view.custom.ItemEquipeViewLotogolResultado
            android:id="@+id/lotogol_time_dois"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/paginaResultadoLotogolText"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/caixa_std_regular"
        android:textAlignment="center"
        android:textColor="@color/branco"
        android:textSize="14sp"
        tools:text="1 de 14" />

</LinearLayout>