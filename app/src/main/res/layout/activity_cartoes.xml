<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <include layout="@layout/app_bar_degrade_pesquisa" />

    <android.support.constraint.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />

    <android.support.v4.widget.NestedScrollView
        android:id="@+id/nsv_conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/cl_tab"
        app:layout_constraintTop_toBottomOf="@id/gl_toolbar">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/cl_principal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/branco"
            android:focusableInTouchMode="true"
            android:minHeight="@dimen/activity_vertical_margin">

            <TextView
                android:id="@+id/tv_subtitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/cartoes_subt"
                android:textColor="@color/colorAccent"
                android:textSize="14.2sp"
                android:textStyle="bold"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cl_principal" />

            <TextView
                android:id="@+id/tv_descricao"
                style="@style/editTextArialMTTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="19dp"
                android:layout_marginEnd="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/cartoes_desc"
                android:textColor="@color/cinza"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitulo" />

            <android.support.v7.widget.RecyclerView
                android:id="@+id/rv_cartoes"
                style="@style/editTextArialMTTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="300dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_descricao" />

        </android.support.constraint.ConstraintLayout>
    </android.support.v4.widget.NestedScrollView>


    <Button
        android:id="@+id/btn_adicionar_cartao"
        android:layout_width="184dp"
        android:layout_height="56dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_white_with_green_border"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/adicionarFormaPagamento"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/verdeazul"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_avancar_pagamento"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <Button
        android:id="@+id/btn_avancar_pagamento"
        android:layout_width="184dp"
        android:layout_height="84dp"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="51dp"
        android:background="@color/verdeazul"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="@string/apostarAutorizarCobranca"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/branco"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_tab"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cl_tab"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:background="@color/azulclaro"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/cl_total"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:layout_marginRight="10dp"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_valor_total_carrinho"
                style="@style/FuturaStdBold"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:textAlignment="center"
                android:textColor="@color/cinza_total"
                android:textSize="16sp"
                app:autoSizeMaxTextSize="16dp"
                app:autoSizeMinTextSize="8sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform"
                app:layout_constraintBottom_toTopOf="@id/tv_total"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="R$100,00" />

            <TextView
                android:id="@+id/tv_total"
                style="@style/ArialMT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/transparente"
                android:text="@string/total"
                android:textAlignment="center"
                android:textAllCaps="false"
                android:textColor="@color/azulescuro"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_valor_total_carrinho" />
        </android.support.constraint.ConstraintLayout>
    </android.support.constraint.ConstraintLayout>

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cl_ir_rapidao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cl_tab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/gl_toolbar">

        <TextView
            android:id="@+id/tv_ir_rapidao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/futura_std_book"
            android:padding="30dp"
            android:textAlignment="center"
            android:textColor="@color/colorAccent"
            android:textSize="14.2sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/cartoes_ir_rapidao" />

        <Button
            android:id="@+id/btn_ir_rapidao"
            android:layout_width="184dp"
            android:layout_height="56dp"
            android:background="@drawable/button_white_with_green_border"
            android:fontFamily="@font/futura_std_bold"
            android:text="@string/so_bora"
            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
            android:textColor="@color/verdeazul"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_ir_rapidao" />


    </android.support.constraint.ConstraintLayout>
</android.support.constraint.ConstraintLayout>
