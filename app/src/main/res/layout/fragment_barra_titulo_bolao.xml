<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:id="@+id/layout_fragmento_mkp"
    android:background="@color/mega_verde_claro_mkp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_modalidade_mkp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:id="@+id/layout_trevo_mkp"
            android:layout_width="85dp"
            android:layout_height="55dp"
            android:layout_marginLeft="-0dp"
            android:background="@drawable/mega_sena_trapezio"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/trevo_mkp"
                android:layout_width="27dp"
                android:layout_height="28dp"
                android:layout_marginStart="20dp"
                android:layout_centerVertical="true"
                android:src="@drawable/trevo" />
        </RelativeLayout>

        <TextView
            android:id="@+id/modalidade_mkp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="@font/futura_std_bold"
            android:textColor="@color/branco"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/group_concurso_mkp"
            app:layout_constraintStart_toEndOf="@+id/layout_trevo_mkp"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Modalidade" />

        <LinearLayout
            android:id="@+id/group_concurso_mkp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/modalidade_mkp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/label_concurso_mkp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/label_concurso"
                android:textSize="14sp"
                android:textColor="@color/branco"
                app:layout_constraintBottom_toTopOf="@+id/numero_concurso_mkp"
                app:layout_constraintEnd_toStartOf="@id/label_sorteio_mkp"
                app:layout_constraintStart_toEndOf="@+id/id_modalidade"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/numero_concurso_mkp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/caixa_std_semi_bold"
                android:textColor="@color/branco"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/label_concurso_mkp"
                app:layout_constraintTop_toBottomOf="@id/label_concurso_mkp"
                tools:text="1891" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/group_sorteio_mkp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/group_concurso_mkp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/label_sorteio_mkp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/label_sorteio_case"
                android:textSize="14sp"
                android:textColor="@color/branco"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/group_concurso_mkp"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/data_sorteio_mkp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/caixa_std_semi_bold"
                android:textColor="@color/branco"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/label_sorteio_mkp"
                app:layout_constraintTop_toBottomOf="@id/label_sorteio_mkp"
                tools:text="03/12" />
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_premio_estimado_mkp"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container_modalidade_mkp"
        android:background="@color/mega_verde_escuro_mkp"
        >

        <LinearLayout
            android:id="@+id/group_premio_mkp"
            android:layout_width="wrap_content"
            android:importantForAccessibility="yes"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center">

            <TextView
                android:id="@+id/valor_premio_mkp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0.000"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_bold"
                android:textSize="28sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/valor_premio_mkp_por_extenso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(R$ 0 Mil)"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_bold"
                android:textSize="22sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:id="@+id/label_premio_mkp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prêmio Estimado"
                android:textColor="@color/branco"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="16sp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>