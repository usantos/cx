<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    tools:context=".view.fragment.NumerosFragment">

    <TextView
        android:id="@+id/lista_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arialmt"
        android:gravity="center"
        android:text="@string/seus_numeros"
        android:textSize="12sp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ehgv_numeros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/lista_titulo"
        android:layout_alignStart="@id/lista_titulo"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:columnWidth="50dp"
        android:gravity="center"
        android:isScrollContainer="false"
        android:numColumns="6"
        android:scrollbars="none"
        android:stretchMode="columnWidth"
        android:verticalSpacing="5dp"
        app:layout_constrainedHeight="true" />

</RelativeLayout>