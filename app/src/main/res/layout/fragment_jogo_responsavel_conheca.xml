<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="50dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".view.fragment.JogoResponsavelConhecaFragment">

    <android.support.constraint.ConstraintLayout
        android:id="@+id/cl_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="30dp">

        <ImageView
            android:id="@+id/iv_icone_topo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_conheca"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_jogo_responsavel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_icone_topo"
            android:layout_marginTop="10dp"
            android:textSize="16sp"
            android:text="@string/jr_conheca_o_jogo"
            android:padding="10dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/jr_azul_text_title" />

        <TextView
            android:id="@+id/tv_acoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/jr_conheca_acoes"
            android:textSize="15sp"
            android:textAlignment="center"
            android:layout_marginTop="10dp"
            android:paddingBottom="20dp"
            android:paddingLeft="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_jogo_responsavel" />

        <ImageView
            android:id="@+id/iv_seta_1"
            android:layout_width="13dp"
            android:layout_height="13dp"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_arrow_blue_right"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_acoes" />

        <TextView
            android:id="@+id/tv_acao_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/jr_conheca_acao_1"
            android:textSize="14sp"
            android:textColor="#6A7476"
            android:paddingBottom="20dp"
            android:paddingLeft="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_seta_1"
            app:layout_constraintTop_toTopOf="@+id/iv_seta_1" />

        <ImageView
            android:id="@+id/iv_seta_2"
            android:layout_width="13dp"
            android:layout_height="13dp"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_arrow_blue_right"
            app:layout_constraintTop_toBottomOf="@+id/tv_acao_1" />

        <TextView
            android:id="@+id/tv_acao_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/jr_conheca_acao_2"
            android:textSize="14sp"
            android:paddingBottom="20dp"
            android:paddingLeft="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_seta_2"
            app:layout_constraintTop_toTopOf="@+id/iv_seta_2" />

    </android.support.constraint.ConstraintLayout>

    <TextView
        android:id="@+id/tv_alem_disso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/jr_conheca_alem_disso"
        android:textSize="15sp"
        android:textColor="@color/jr_cinza_text"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:textAlignment="center"
        android:background="@color/jr_cinza_bg"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_margin" />

    <View
        android:id="@+id/v_cinza"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/jr_cinza_bg"
        app:layout_constraintTop_toBottomOf="@id/tv_alem_disso" />

    <FrameLayout
        android:id="@+id/v_container_fragment_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/transparente"
        app:layout_constraintTop_toBottomOf="@+id/tv_alem_disso" />

    <TextView
        android:id="@+id/tv_ober_mais_informacoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/jr_conheca_label_saiba_mais"
        android:textSize="15sp"
        android:padding="15dp"
        android:textAlignment="center"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_container_fragment_cards" />

    <Button
        android:id="@+id/btn_saiba_mais"
        android:layout_width="184dp"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/buttom_border_saiba_mais"
        android:text="@string/jr_conheca_btn_saiba_mais"
        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
        android:textColor="@color/jr_radio_text_selected"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_ober_mais_informacoes" />

</android.support.constraint.ConstraintLayout>