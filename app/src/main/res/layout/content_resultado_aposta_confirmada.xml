<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultadoApostaScrollView"
    android:layout_width="match_parent"
    android:fillViewport="true"
    android:layout_height="match_parent"
    android:background="@color/branco"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <br.gov.caixa.loterias.apostas.view.custom.ContentResultadoPremiado
            android:id="@+id/contentResultadoPremiado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="listaOpcaoResgate" />

        </br.gov.caixa.loterias.apostas.view.custom.ContentResultadoPremiado>

        <TextView
            android:id="@+id/textoComoRetirarPremio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/label_veja_retirar_premio"
            android:textColor="@color/verdeazul"
            android:textSize="14.2sp"
            android:fontFamily="@font/caixa_std_bold"
            app:layout_constraintTop_toBottomOf="@id/contentResultadoPremiado"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaOpcaoResgate"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/textoComoRetirarPremio"
            app:layout_constraintStart_toStartOf="@id/textoComoRetirarPremio"
            app:layout_constraintEnd_toEndOf="@id/textoComoRetirarPremio"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintAvisoResgate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/btn_round_outlined"
            android:backgroundTint="@color/pesquisa_msgpush"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/listaOpcaoResgate"
            app:layout_constraintEnd_toEndOf="@id/listaOpcaoResgate"
            app:layout_constraintTop_toBottomOf="@id/listaOpcaoResgate">

            <ImageView
                android:id="@+id/id_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_money_premio"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Resgate permitido somente na agência devido à incidência de IR sobre o valor total do prêmio."
                android:textColor="@color/bolao_barra_titulo"
                android:fontFamily="@font/caixa_std_regular"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/id_money"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
