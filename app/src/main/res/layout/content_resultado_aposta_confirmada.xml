<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultadoApostaScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <br.gov.caixa.loterias.apostar.interno.view.custom.ContentResultadoPremiado_
            android:id="@+id/contenteResultadoPremiado"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <RelativeLayout
            android:id="@+id/layoutText"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textoComoRetirarPremio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/label_veja_retirar_premio"
                android:textColor="@color/verdeazul"
                android:textSize="14.2sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textoComoRetirarPremio"
                android:layout_marginBottom="38dp"
                android:layout_marginEnd="@dimen/activity_vertical_margin"
                android:layout_marginStart="@dimen/activity_vertical_margin"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:background="@drawable/custom_border_cinza_escuro"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/lotericaLayout"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/lotericaText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/label_loterica"
                        android:textColor="@color/cinza"
                        android:textSize="14.2sp" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/agenciaCaixaLayout"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="0dp"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/linhaSeparadoraUm"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/cinza" />

                    <TextView
                        android:id="@+id/agenciaCaixaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBottom="@+id/linhaSeparadoraUm"
                        android:layout_alignTop="@+id/linhaSeparadoraUm"
                        android:gravity="center"
                        android:paddingEnd="@dimen/text_margin_small"
                        android:paddingStart="@dimen/text_margin_small"
                        android:text="@string/label_agencia_caixa"
                        android:textColor="@color/cinza"
                        android:textSize="14.2sp" />


                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/mercadoPagoLayout"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/linhaSeparadoraDois"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/cinza" />

                    <TextView
                        android:id="@+id/mercadoPagoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignBottom="@+id/linhaSeparadoraDois"
                        android:layout_alignTop="@+id/linhaSeparadoraDois"
                        android:gravity="center"
                        android:paddingEnd="@dimen/text_margin_small"
                        android:paddingStart="@dimen/text_margin_small"
                        android:text="@string/label_mercado_pago"
                        android:textColor="@color/cinza"
                        android:textSize="14.2sp" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</ScrollView>
