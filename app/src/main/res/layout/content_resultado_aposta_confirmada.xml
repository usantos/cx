<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultadoApostaScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <br.gov.caixa.loterias.apostas.view.custom.ContentResultadoPremiado
            android:id="@+id/contentResultadoPremiado"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <RelativeLayout
            android:id="@+id/layoutText"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textoComoRetirarPremio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/label_veja_retirar_premio"
                android:textColor="@color/verdeazul"
                android:textSize="14.2sp"
                android:fontFamily="@font/caixa_std_bold" />

            <LinearLayout
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textoComoRetirarPremio"
                android:layout_marginBottom="38dp"
                android:layout_marginEnd="@dimen/activity_vertical_margin"
                android:layout_marginStart="@dimen/activity_vertical_margin"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_centerInParent="true"
                android:baselineAligned="true"
                android:orientation="vertical"
                >

                <RelativeLayout
                    android:id="@+id/pixLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="0dp"
                    android:visibility="gone">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayoutPix"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/verdeazul">

                        <ImageView
                            android:id="@+id/pixIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/icone_do_pix"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/pixText"
                            app:layout_constraintHorizontal_chainStyle="packed" />

                        <TextView
                            android:id="@+id/pixText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_pix"
                            android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                            android:fontFamily="@font/caixa_std_bold"
                            android:textColor="@color/branco"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/pixIcon"
                            app:layout_constraintEnd_toEndOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/mercadoPagoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mercadoPagoText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="10dp"
                        android:background="@color/verdeazul"
                        android:text="@string/label_mercado_pago"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                        android:fontFamily="@font/caixa_std_bold"
                        android:textColor="@color/branco"
                        android:textSize="14sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/agenciaCaixaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/agenciaCaixaText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="10dp"
                        android:background="@color/verdeazul"
                        android:text="@string/label_agencia_maiuscula"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                        android:fontFamily="@font/caixa_std_bold"
                        android:textColor="@color/branco"
                        android:textSize="14sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/lotericaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/lotericaText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="10dp"
                        android:background="@color/verdeazul"
                        android:text="@string/label_loterica"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.AppCompat.Light.Widget.PopupMenu.Large"
                        android:fontFamily="@font/caixa_std_bold"
                        android:textColor="@color/branco"
                        android:textSize="14sp" />
                </RelativeLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintAvisoResgate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/btn_round_outlined"
                    android:backgroundTint="@color/pesquisa_msgpush"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/id_money"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_money_premio"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Resgate permitido somente na agência devido à incidência de IR sobre o valor total do prêmio."
                        android:textColor="@color/bolao_barra_titulo"
                        android:fontFamily="@font/caixa_std_regular"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/id_money"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

</ScrollView>
