<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <TextView
        android:textColor="@color/black"
        android:fontFamily="@font/caixa_std_bold"
        android:layout_marginVertical="12dp"
        android:layout_marginStart="12dp"
        android:id="@+id/title"
        android:text="Jogo 01"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ImageView
        android:id="@+id/check_equipe_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:background="@drawable/ic_radio_checked"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/check_empate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:background="@drawable/ic_radio_unchecked"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/check_equipe_1"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/check_equipe_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:background="@drawable/ic_radio_unchecked"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/check_empate"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/nome_equipe_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Binternacional/RS (MAS)"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/check_equipe_1"
        app:layout_constraintBottom_toBottomOf="@id/check_equipe_1"
        app:layout_constraintStart_toEndOf="@id/check_equipe_1"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/nome_empate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/txt_empate"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/check_empate"
        app:layout_constraintBottom_toBottomOf="@id/check_empate"
        app:layout_constraintStart_toEndOf="@id/check_empate"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/nome_equipe_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Gremio/RS (MAS)"
        android:fontFamily="@font/caixa_std_regular"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/check_equipe_2"
        app:layout_constraintBottom_toBottomOf="@id/check_equipe_2"
        app:layout_constraintStart_toEndOf="@id/check_equipe_2"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/id_linha_divisoria"
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="@color/cinza2"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/nome_equipe_2"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>