<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient_cinza"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_principal">

    <LinearLayout
        android:id="@+id/atalhoRapidoLoterias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <RelativeLayout
            android:id="@+id/relativeLayoutContentRapidao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.0">

            <RelativeLayout
                android:layout_width="294dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="199dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tituloRapidao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/label_rapidao"
                            android:textColor="@color/laranjacaixa"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@+id/tituloRapidao"
                            android:gravity="end"
                            android:text="@string/label_faca_apostas_apenas_um_clique"
                            android:textColor="@color/cinza"
                            android:textSize="13sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="95dp"
                        android:layout_height="60dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/icon_rapidao" />
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/relativeLayoutContentLerBilhetes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.0"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="294dp"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="199dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tituloLerBilhetes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:textColor="@color/vermelhoBilhetes"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/tituloLerBilhetes"
                            android:layout_alignParentEnd="true"
                            android:gravity="end"
                            android:text="@string/label_apostou_loterica_confira_resultados"
                            android:textColor="@color/cinza"
                            android:textSize="13sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="95dp"
                        android:layout_height="60dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/icon_bilhetes" />
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlJogoResponsavel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.0">

            <RelativeLayout
                android:layout_width="294dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="199dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_titulo_jr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/jr_titulo_maiusculo"
                            android:textColor="@color/jr_radio_text_selected"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@+id/tv_titulo_jr"
                            android:gravity="right"
                            android:text="@string/jr_desc_menu_trevo"
                            android:textColor="@color/cinza"
                            android:textSize="13sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="95dp"
                        android:layout_height="60dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_jr_menu_trevo" />
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/relativeLayoutContentFavoritas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:alpha="0.0">

            <RelativeLayout
                android:layout_width="294dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="199dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tituloFavoritas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:text="@string/label_favoritas"
                            android:textColor="@color/azulfavoritas"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@+id/tituloFavoritas"
                            android:gravity="right"
                            android:text="@string/label_suas_apostas_sorte_apenas_clique"
                            android:textColor="@color/cinza"
                            android:textSize="13sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="95dp"
                        android:layout_height="60dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/icon_favoritas" />
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/relativeLayoutContentRepassados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.0">

            <RelativeLayout
                android:layout_width="294dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="199dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/valorRepassesPrincipal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:textColor="@color/verdeazul"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textoRepassados"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_below="@+id/valorRepassesPrincipal"
                            android:textColor="@color/cinza"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="95dp"
                        android:layout_height="60dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/icon_repassados" />
                    </RelativeLayout>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/relativeContentPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.yarolegovich.discretescrollview.DiscreteScrollView
            android:id="@+id/home_carousel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="116dp"
            app:dsv_orientation="horizontal" />
    </RelativeLayout>


    <TextView
        android:id="@+id/textViewHomeMinimumPurchaseValue"
        style="@style/editTextArialMTTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="2dp"
        android:textColor="@color/azulescuro"
        android:textSize="10sp"
        tools:text="valor mínimo da compra: R$0,00"
        android:layout_alignParentBottom="true"
        android:paddingBottom="44dp"/>


    <RelativeLayout
        android:id="@+id/relativeBlankView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/textViewHomeMinimumPurchaseValue"
        android:alpha="0.0"
        android:background="@color/branco"
        android:visibility="visible" />

    <Button
        android:id="@+id/buttonHomeBet"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="68dp"
        android:layout_marginEnd="88dp"
        android:layout_marginStart="88dp"
        android:background="@color/verdesenaclaro"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp"
        tools:text="Aposta\npor R$ 2,00" />

    <RelativeLayout
        android:id="@+id/id_fg_somador_carrinho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>

</RelativeLayout>
