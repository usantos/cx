<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    tools:context=".view.fragment.MeioPagamentoFragment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fundoCartao"
    card_view:cardElevation="3dp"
    app:cardCornerRadius="4dp"
    card_view:cardPreventCornerOverlap="false"
    card_view:cardUseCompatPadding="true">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Título"
        android:fontFamily="@font/caixa_std_bold"
        android:textSize="14sp"
        android:visibility="gone"
        android:textColor="@color/azul_alterar"
        android:layout_marginStart="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/textoPagarVia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pagarVia"
            android:importantForAccessibility="yes"
            android:focusable="true"
            android:textColor="@color/cinzaescuro"
            android:textSize="13sp"
            android:fontFamily="@font/caixa_std_regular"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/textoBandeiras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bandeirasAceitas"
            android:fontFamily="@font/caixa_std_regular"
            android:textColor="@color/cinzaescuro"
            android:accessibilityTraversalAfter="@id/imagemMeioPagamento"
            android:textSize="13sp"
            android:importantForAccessibility="yes"
            android:focusable="true"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/containerBandeiras"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imagemMeioPagamento"
            android:layout_width="wrap_content"
            android:accessibilityTraversalAfter="@id/textoPagarVia"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/textoPagarVia"
            app:layout_constraintStart_toStartOf="@+id/textoPagarVia"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerBandeiras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@id/containerCartoes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoBandeiras">

            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/flowBandeiras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:constraint_referenced_ids="imgBandeira1,imgBandeira2,imgBandeira3,imgBandeira4,imgBandeira5,imgBandeira6"
                app:flow_horizontalAlign="center"
                app:flow_horizontalGap="@dimen/activity_horizontal_margin"
                android:layout_marginTop="4dp"
                app:flow_horizontalStyle="packed"
                app:flow_maxElementsWrap="3"
                app:flow_wrapMode="chain"
                app:layout_constraintBaseline_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgBandeira1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/amex"
                app:layout_constraintEnd_toStartOf="@+id/imgBandeira2"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                tools:src="@drawable/ic_bandeira_amex" />

            <ImageView
                android:id="@+id/imgBandeira2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/elo"
                app:layout_constraintEnd_toStartOf="@+id/imgBandeira3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imgBandeira1"
                tools:src="@drawable/elo_fundo_claro" />

            <ImageView
                android:id="@+id/imgBandeira3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/hipercard"
                app:layout_constraintEnd_toStartOf="@+id/imgBandeira4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imgBandeira2"
                tools:src="@drawable/ic_hipercard" />

            <ImageView
                android:id="@+id/imgBandeira4"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/mastercard"
                app:layout_constraintEnd_toStartOf="@+id/imgBandeira5"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imgBandeira3"
                tools:src="@drawable/ic_master_card" />

            <ImageView
                android:id="@+id/imgBandeira5"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/visa"
                app:layout_constraintEnd_toStartOf="@+id/imgBandeira6"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imgBandeira4"
                tools:src="@drawable/ic_bandeira_visa" />

            <ImageView
                android:id="@+id/imgBandeira6"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/imgBandeira5"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerCartoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#ECFAFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imagemMeioPagamento">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaCartoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintHeight_min="120dp"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/textoSemCartao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/semCartaoRecargaPay"
                android:textColor="@color/cinzaescuro"
                android:textSize="16sp"
                android:fontFamily="@font/caixa_std_regular"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <TextView
                android:id="@+id/linkAdicionaCartao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adicionarCartao"
                android:textColor="@color/link_cartoes"
                android:textColorLink="@color/link_cartoes"
                android:fontFamily="@font/caixa_std_regular"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                app:layout_constraintTop_toBottomOf="@+id/listaCartoes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <TextView
                android:id="@+id/linkListarMaisMenos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/listarMais"
                android:textColor="@color/link_cartoes"
                android:textColorLink="@color/link_cartoes"
                android:fontFamily="@font/caixa_std_regular"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:layout_marginEnd="48dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
