<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/background_gradient_cinza"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/id_cabecalho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EDF6FB"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/id_veja_aqui"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Veja aqui"
            android:textSize="18sp"
            android:textColor="@color/azulpush"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/id_image_saco_dinheiro"
            app:layout_constraintHorizontal_chainStyle="packed"
            android:visibility="gone"
            />

        <ImageView
            android:id="@+id/id_image_saco_dinheiro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_money_bolao"
            android:backgroundTint="@color/azulpush"
            app:layout_constraintStart_toEndOf="@id/id_veja_aqui"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/id_modalidade"
            android:visibility="gone"
            />

        <TextView
            android:id="@+id/id_modalidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bolões da Mega-sena"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/azulpush"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/id_image_saco_dinheiro"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/descritivo_tela_bolao"
            android:textSize="18sp"
            android:textColor="@color/azulpush"
            android:layout_marginTop="4dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            app:layout_constraintTop_toBottomOf="@id/id_image_saco_dinheiro"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/id_btn_continuar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_round_outlined"
        android:textAllCaps="false"
        android:textColor="@color/azulpush"
        android:textSize="16sp"
        android:text="Continuar sem filtro"
        android:layout_marginStart="88dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@+id/id_btn_alterar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/rounded_card"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp"
        android:text="@string/alterar_pesquisa"
        android:layout_marginStart="88dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/id_btn_continuar"/>

    <View
        android:id="@+id/id_view_divisao"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        app:layout_constraintTop_toTopOf="@id/id_btn_alterar"
        app:layout_constraintBottom_toBottomOf="@id/id_btn_alterar"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_card"
        android:backgroundTint="@color/branco"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/id_cabecalho"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/id_view_divisao">

        <TextView
            android:id="@+id/id_ops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ops!"
            android:textColor="@color/azulpush"
            android:textStyle="bold"
            android:textSize="32sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        
        <ImageView
            android:id="@+id/id_trevo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/trevo_caixa_filtro"
            android:layout_marginTop="42dp"
            app:layout_constraintTop_toBottomOf="@id/id_ops"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        
        <View
            android:id="@+id/id_view_div"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="@id/id_trevo"
            app:layout_constraintEnd_toEndOf="@id/id_trevo"/>
        
        <ImageView
            android:id="@+id/id_lupa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/lupa_filtro"
            app:layout_constraintStart_toStartOf="@id/id_view_div"
            app:layout_constraintBottom_toBottomOf="@id/id_trevo"/>

        <TextView
            android:id="@+id/id_descricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/descricao_filtro_vazio"
            android:textColor="@color/azulpush"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginTop="64dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/id_trevo"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>