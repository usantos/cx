<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_marginStart="2dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/card_detalhe_combo"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCardDetalheCombo"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:importantForAccessibility="yes"
            android:focusable="true"
            android:contentDescription="@string/card_de_aposta_contida_neste_combo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <ImageView
                android:id="@+id/imgBackgroundDetalheCombo"
                android:layout_width="40dp"
                android:layout_height="37dp"
                android:src="@drawable/trevo_background_lista_combo"
                android:layout_marginStart="1dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/txtQtdJogosDetalheCombo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="2 jogos"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginTop="6dp"
                android:elevation="4dp"
                android:fontFamily="@font/caixa_std_regular"
                android:importantForAccessibility="yes"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/txtModalidadeDetalheCombo" />

        <TextView
                android:id="@+id/txtModalidadeDetalheCombo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="lotofacil da independencia"
                android:textSize="14sp"
                android:textAlignment="center"
                android:paddingStart="30dp"
                android:paddingEnd="15dp"
                android:elevation="4dp"
                android:importantForAccessibility="yes"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtQtdJogosDetalheCombo"
                app:layout_constraintBottom_toTopOf="@+id/txtConcursoDetalheCombo" />

        <TextView
                android:id="@+id/txtConcursoDetalheCombo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/caixa_std_regular"
                tools:text="concurso 2002 a 2005"
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginBottom="6dp"
                android:elevation="4dp"
                android:importantForAccessibility="yes"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtModalidadeDetalheCombo"
                app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>