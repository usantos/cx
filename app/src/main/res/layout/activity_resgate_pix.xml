<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient_cinza_claro"
    tools:context=".ResgatePixActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contuedo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_pix"
        android:paddingStart="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl_toolbar"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/app_bar_degrade_pesquisa" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_toolbar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="?attr/actionBarSize" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cabecalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/gl_toolbar"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgPix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_pix"
                android:layout_marginStart="42dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <View
                android:id="@+id/linhaRodape"
                android:layout_width="match_parent"
                android:layout_height="0.2dp"
                android:background="@color/cinza"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/branco"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cabecalho"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/txtChaves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/escolha_o_tipo_de_chave"
                android:fontFamily="@font/futura_std_bold"
                android:textColor="@color/azul_alterar"
                android:layout_marginTop="16dp"
                android:layout_marginStart="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <View
                android:id="@+id/linhaRodapeChaves"
                android:layout_width="match_parent"
                android:layout_height="0.2dp"
                android:background="@color/cinza"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/txtChaves"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaChaves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/linhaRodapeChaves"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/containerFavoritas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/listaChaves"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtChaveFavorita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/chaves_favoritas"
                    android:fontFamily="@font/futura_std_bold"
                    android:textColor="@color/azul_alterar"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="20dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <View
                    android:id="@+id/linhaRodapeChavesFavoritas"
                    android:layout_width="match_parent"
                    android:layout_height="0.2dp"
                    android:background="@color/cinza"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/txtChaveFavorita"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaChavesFavoritas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/linhaRodapeChavesFavoritas"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>