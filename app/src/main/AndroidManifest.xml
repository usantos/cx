<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="br.gov.caixa.loterias.apostar.interno">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE"/>

    <uses-feature android:name="android.hardware.camera" />

    <application
        android:name=".utils.Aplicacao"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".view.ResgatePremioLotericaActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"/>
        <activity
            android:name=".view.CartoesActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"/>
        <activity
            android:name=".view.DetalhesCarrinhoFavoritoActivity"
            android:screenOrientation="portrait"/>
        <activity
            android:name=".view.CarrinhosFavoritosActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.SelecaoModalidadesResultados"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.VisualizarResultadosActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />
        <activity
            android:name=".view.TutorialRapidaoActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.AppIndisponivelActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.AtualizacaoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:screenOrientation="portrait"
                android:value=".view.SplashScreenActivity" />
        </activity>

        <provider
            android:name="android.support.v4.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/images_path" />
        </provider>

        <activity
            android:name=".view.SplashScreenActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.IntroducaoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.LoginActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_login"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.CadastrarActivity_"
            android:configChanges="orientation"
            android:parentActivityName=".view.IntroducaoActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".view.CadastrarPasso2Activity_"
            android:configChanges="orientation"
            android:parentActivityName=".view.CadastrarActivity_"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:screenOrientation="portrait"
                android:value=".view.CadastrarActivity_" />
        </activity>
        <activity
            android:name=".view.SimularApostaActivity_"
            android:configChanges="orientation"
            android:label="@string/title_activity_home"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".view.ConfirmadoInclusaoCarrinhoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.CarrinhoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.FormaPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_forma_pagamento"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.ConfirmacaoPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_confirmacao_pagamento"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".view.NovaFormaPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_forma_pagamento"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.PrincipalActivity_"
            android:label=""
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.BrancoActionBar" />
        <activity
            android:name=".view.TermosUsoActivity"
            android:label="@string/title_activity_termos_uso"
            android:parentActivityName=".view.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.RepassesSociaisActivity"
            android:label="@string/title_activity_repasses_sociais"
            android:parentActivityName=".view.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.ListaRapidaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:parentActivityName=".view.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".view.PrincipalActivity" />
        </activity>
        <activity
            android:name=".view.RapidaoConfigActivity_"
            android:label="@string/title_activity_lista_rapidao"
            android:parentActivityName=".view.ListaRapidaoActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize|adjustPan">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".view.ListaRapidaoActivity" />
        </activity>
        <activity
            android:name=".view.SelecaoModalidadesRapidaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.NumerosRapidaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.AjudaActivity"
            android:parentActivityName=".view.SimularApostaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".view.SimularApostaActivity" />
        </activity>
        <activity
            android:name=".view.FavoritasActivity"
            android:label="@string/title_activity_favoritas"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".view.ListaComprasActivity"
            android:label="@string/title_activity_lista_compras"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.LerBilhetesActivity"
            android:screenOrientation="landscape"
            android:theme="@style/AppFullScreenTheme" />
        <activity
            android:name=".view.LerBilhetesEscolhaJogoActivity"
            android:label="@string/title_activity_ler_bilhetes_escolha_jogo"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.ResultadoLerBilhetesActivity_"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.DetalhesComprasActivity"
            android:label="@string/title_activity_detalhes_compras"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.InsercaoManualCodBarrasActivity"
            android:label=""
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.DetalheDuvidaActivity_"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.ApostasConfirmadasActivity_"
            android:label="@string/title_activity_minhas_apostas"
            android:parentActivityName=".view.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:screenOrientation="portrait"
                android:value=".view.PrincipalActivity" />
        </activity>
        <activity
            android:name=".view.JogosConfirmadosPremioActivity"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.JogosConfirmadosPremioMercadoPagoActivity"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".view.RestritoDezoitoAnosActivity"
            android:label="@string/title_activity_termos_uso"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.ApostaConfirmadaDetalhesActivity_"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.ResultadoApostaConfirmadaActivity_"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait" />
        <activity android:name=".view.ResgatePremioLotericaAgenciaActivity_" />
        <activity
            android:name=".view.DadosPessoaisActivity"
            android:label="@string/title_activity_dados_pessoais"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name=".view.DadosPessoaisConfirmacaoActivity"
            android:label="@string/title_activity_dados_pessoais"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.CadastrarConfirmacao"
            android:label="@string/title_activity_toolbar"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.AlterarDadosLoginCaixaActivity"
            android:label="@string/title_activity_alterar_dados_login_caixa"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name=".view.TokenActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${hostName}"
                    android:path="${path}"
                    android:scheme="${scheme}" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.RapidaoApostaFavoritasSelecaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize|adjustPan">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".view.RapidaoConfigActivity_" />
        </activity>
    </application>

</manifest>