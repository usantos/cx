<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="br.gov.caixa.loterias.apostas">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <uses-feature android:name="android.hardware.camera" />

    <application
        android:name="br.gov.caixa.loterias.apostas.utils.Aplicacao"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">
        <activity android:name=".controllers.LocalizacaoActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".controllers.TutorialSuperSeteActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name=".controllers.JogoResponsavelActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.JogoResponsavel" />
        <activity
            android:name=".controllers.ConfiguracaoRapidaoActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ResgatePremioLotericaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.CartoesActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustNothing" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.DetalhesCarrinhoFavoritoActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.CarrinhosFavoritosActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.SelecaoModalidadesResultados"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.VisualizarResultadosActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustNothing" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.AppIndisponivelActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.AtualizacaoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:screenOrientation="portrait"
                android:value="br.gov.caixa.loterias.apostas.controllers.SplashScreenActivity" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/images_path" />
        </provider>

        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.SplashScreenActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.IntroducaoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.LoginActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_login"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.CadastrarActivity_"
            android:configChanges="orientation"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.IntroducaoActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.CadastrarPasso2Activity_"
            android:configChanges="orientation"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.CadastrarActivity_"
            android:screenOrientation="portrait">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:screenOrientation="portrait"
                android:value="br.gov.caixa.loterias.apostas.controllers.CadastrarActivity_" />
        </activity>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.SimularApostaActivity_"
            android:configChanges="orientation"
            android:label="@string/title_activity_home"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ConfirmadoInclusaoCarrinhoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.CarrinhoActivity"
            android:configChanges="orientation"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ConfirmacaoPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_confirmacao_pagamento"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.NovaFormaPagamentoActivity"
            android:configChanges="orientation"
            android:label="@string/title_activity_forma_pagamento"
            android:screenOrientation="portrait" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.PrincipalActivity_"
            android:label=""
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.BrancoActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.TermosUsoActivity"
            android:label="@string/title_activity_termos_uso"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.RepassesSociaisActivity"
            android:label="@string/title_activity_repasses_sociais"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ListaRapidaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="br.gov.caixa.loterias.apostas.controllers.PrincipalActivity" />
        </activity>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.RapidaoConfigActivity_"
            android:label="@string/title_activity_lista_rapidao"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.ListaRapidaoActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize|adjustPan">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="br.gov.caixa.loterias.apostas.controllers.ListaRapidaoActivity" />
        </activity>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.SelecaoModalidadesRapidaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.NumerosRapidaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.AjudaActivity"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.SimularApostaActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="br.gov.caixa.loterias.apostas.controllers.SimularApostaActivity" />
        </activity>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.FavoritasActivity"
            android:label="@string/title_activity_favoritas"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ListaComprasActivity"
            android:label="@string/title_activity_lista_compras"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.LerBilhetesActivity"
            android:screenOrientation="landscape"
            android:theme="@style/AppFullScreenTheme" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.LerBilhetesEscolhaJogoActivity"
            android:label="@string/title_activity_ler_bilhetes_escolha_jogo"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ResultadoLerBilhetesActivity_"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.DetalhesComprasActivity"
            android:label="@string/title_activity_detalhes_compras"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.InsercaoManualCodBarrasActivity"
            android:label=""
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.DetalheDuvidaActivity_"
            android:screenOrientation="portrait" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.MinhasApostasActivity_"
            android:label="@string/title_activity_minhas_apostas"
            android:parentActivityName="br.gov.caixa.loterias.apostas.controllers.PrincipalActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:screenOrientation="portrait"
                android:value="br.gov.caixa.loterias.apostas.controllers.PrincipalActivity" />
        </activity>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.JogosConfirmadosPremioActivity"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.JogosConfirmadosPremioMercadoPagoActivity"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.RestritoDezoitoAnosActivity"
            android:label="@string/title_activity_termos_uso"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ApostaConfirmadaDetalhesActivity_"
            android:screenOrientation="portrait" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.ResultadoApostaConfirmadaActivity_"
            android:label="@string/title_activity_resultado_ler_bilhetes"
            android:screenOrientation="portrait" />
        <activity android:name="br.gov.caixa.loterias.apostas.controllers.ResgatePremioLotericaAgenciaActivity_" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.DadosPessoaisActivity"
            android:label="@string/title_activity_dados_pessoais"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateHidden" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.DadosPessoaisConfirmacaoActivity"
            android:label="@string/title_activity_dados_pessoais"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.CadastrarConfirmacaoActivity"
            android:label="@string/title_activity_toolbar"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar" />
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.AlterarDadosLoginCaixaActivity"
            android:label="@string/title_activity_alterar_dados_login_caixa"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:hardwareAccelerated="true"/>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.TokenActivity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${hostName}"
                    android:path="${path}"
                    android:scheme="${scheme}" />
            </intent-filter>
        </activity>
        <activity
            android:name="br.gov.caixa.loterias.apostas.controllers.RapidaoApostaFavoritasSelecaoActivity"
            android:label="@string/title_activity_lista_rapidao"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.DegradeActionBar"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize|adjustPan">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="br.gov.caixa.loterias.apostas.controllers.RapidaoConfigActivity_" />
        </activity>
    </application>

</manifest>