<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="350dp"
    android:layout_height="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/branco">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTitulo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/gradiente_titulo_caixa"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tituloDialogCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="17dp"
            android:text="@string/label_atencao"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/descricaoDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Informe o valor "
        android:textSize="18sp"
        android:layout_gravity="center"
        android:padding="14dp"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toBottomOf="@+id/layoutTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <EditText
        android:id="@+id/edtNumero"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:hint="Informe o valor"
        android:textAlignment="center"
        android:inputType="number"
        android:layout_gravity="center"
        android:padding="14dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toBottomOf="@+id/descricaoDialog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <View
        android:id="@+id/linhaDivisaoBotoes"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cinza2"
        app:layout_constraintTop_toBottomOf="@id/edtNumero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/btnOk"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@color/verdeazul"
        android:text="OK"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="12sp"
        android:fontFamily="@font/caixa_std_bold"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/linhaDivisaoBotoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
