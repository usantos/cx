<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/pix_copia_cola"
            android:fontFamily="@font/caixa_std_bold"
            android:textSize="14sp"
            android:textColor="@color/azul_alterar"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <EditText
            android:id="@+id/numero_copiar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:fontFamily="@font/caixa_std_regular"
            android:hint="  12345678910111213141516"
            android:maxLines="1"
            android:inputType="text"
            android:scrollHorizontally="true"
            android:ellipsize="end"
            android:background="@drawable/shape_input_pix_copia_cola"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:paddingStart="16dp"
            app:layout_constraintTop_toBottomOf="@+id/titulo"
            app:layout_constraintStart_toStartOf="@+id/titulo"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btn_copiar_colar"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_button_copia"
            app:layout_constraintTop_toTopOf="@+id/numero_copiar"
            app:layout_constraintBottom_toBottomOf="@+id/numero_copiar"
            app:layout_constraintEnd_toEndOf="@+id/numero_copiar"
            />

        <TextView
            android:id="@+id/txt_alerta_codigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/caixa_std_regular"
            android:text="@string/pix_codigo_pago_unica_vez"
            android:textSize="14sp"
            android:textColor="@color/azul_alterar"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@+id/numero_copiar"
            app:layout_constraintTop_toBottomOf="@+id/numero_copiar"/>

        <TextView
            android:id="@+id/txt_voce_tem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="@string/pix_voce_tem"
            android:textSize="14sp"
            android:textColor="@color/azul_alterar"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/txt_alerta_codigo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txt_voce_tem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <ImageView
                android:id="@+id/img_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ic_timer"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/txt_contador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/caixa_std_bold"
                android:text=""
                android:textSize="24sp"
                android:textColor="@color/azul_alterar"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/img_timer"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/txt_para_efetuar_pagamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="@string/pix_para_efetuar_pagamento"
            android:textSize="14sp"
            android:textColor="@color/azul_alterar"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="56dp"
            app:layout_constraintTop_toBottomOf="@id/timer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/icon_atualizar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/verde_acompanha_compras"
            android:background="@drawable/btn_rounded_green_outlined"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:text="@string/verificar_pagamento"
            android:visibility="visible"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="4dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/txt_para_efetuar_pagamento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/txt_para_efetuar_pagamento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btn_minhas_compras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/verde_acompanha_compras"
            android:background="@drawable/btn_rounded_green_outlined"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:fontFamily="@font/caixa_std_regular"
            tools:text="@string/ir_para_minhas_compras"
            android:visibility="gone"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/txt_para_efetuar_pagamento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/id_atencao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atenção:"
            android:textColor="@color/azul_alterar"
            android:fontFamily="@font/caixa_std_bold"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icon_atualizar"/>

        <TextView
            android:id="@+id/atencao_descricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="@string/atencao_descricao_gerar_pix"
            android:textColor="@color/azul_alterar"
            android:layout_margin="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/id_atencao"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
