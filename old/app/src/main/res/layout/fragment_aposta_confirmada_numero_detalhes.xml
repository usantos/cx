<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_premio_pago"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="15dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/v_separador_esq"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginRight="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_premio_pago_tit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_premio_pago_tit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tit_premio_pago"
            tools:textColor="@color/black"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:fontFamily="@font/caixa_std_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/v_separador_dir"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="20dp"
            android:alpha="0.5"
            android:background="@color/branco"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_premio_pago_tit"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/cl_premio_pago">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:layout_marginBottom="@dimen/activity_vertical_margin"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/concursoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/caixa_std_bold"
                android:text="@string/concurso"
                tools:textColor="@color/black"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/concursoTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/concursoLabel"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="12sp"
                tools:textColor="@color/black"
                android:textColor="@color/branco"
                tools:text="1234" />

            <TextView
                android:id="@+id/quantidadeApostadasTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_horizontal_margin"
                android:layout_marginTop="8dp"
                android:layout_toEndOf="@id/concursoLabel"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/branco"
                tools:textColor="@color/black"
                android:textSize="12sp"
                tools:text="4 apostas" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@id/concursoTxt"
                android:weightSum="1">

                <TextView
                    android:id="@+id/dataAposta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/divider"
                    android:text="@string/label_data_aposta"
                    android:fontFamily="@font/caixa_std_bold"
                    tools:textColor="@color/black"
                    android:textColor="@color/branco"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/dataApostaTxt"
                    android:layout_width="wrap_content"
                    android:maxWidth="300dp"
                    app:layout_constraintTop_toBottomOf="@+id/dataAposta"
                    app:layout_constraintStart_toStartOf="@id/dataAposta"
                    android:layout_height="wrap_content"
                    android:text="@string/label_data_aposta"
                    tools:textColor="@color/black"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_regular"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/divider"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/cl_data"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@color/branco"
                    tools:background="@color/black"/>

                <TextView
                    android:id="@+id/statusApostaTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/divider"
                    android:text="@string/label_coluna"
                    android:visibility="gone"
                    tools:textColor="@color/black"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:fontFamily="@font/caixa_std_bold" />

                <TextView
                    android:id="@+id/resultTxt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:textColor="@color/black"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:fontFamily="@font/caixa_std_bold"
                    tools:text="Aguardando" />

                <TextView
                    android:id="@+id/tv_val_premio_tit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/val_premio"
                    app:layout_constraintTop_toBottomOf="@+id/resultTxt"
                    app:layout_constraintStart_toStartOf="@+id/divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    tools:textColor="@color/black"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:fontFamily="@font/caixa_std_regular"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_val_premio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/tv_val_premio_tit"
                    app:layout_constraintStart_toStartOf="@+id/divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="10dp"
                    tools:textColor="@color/black"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    android:fontFamily="@font/caixa_std_bold"
                    android:visibility="gone"
                    tools:text="@string/r_0_00" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clResgatePremio"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:layout_below="@id/cl_data"
                android:background="@drawable/rounded_text_view_colunas"
                android:backgroundTint="#FFA829"
                android:layout_centerInParent="true">

                <ImageView
                    android:id="@+id/ivResgatePremio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_icone_resgate"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resgatar prêmio"
                    android:textColor="@color/branco"
                    android:fontFamily="@font/caixa_std_regular"
                    android:layout_marginStart="16sp"
                    app:layout_constraintStart_toEndOf="@+id/ivResgatePremio"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


        <RelativeLayout
            android:id="@+id/informacaoAdicionalLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cl_data"
            android:layout_marginTop="70dp"
            android:paddingBottom="16dp"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

        <LinearLayout
            android:id="@+id/ll_informacaoAdicional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center">

        <TextView
            android:id="@+id/labelInformacaoAdicionalTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_regular"
            android:text="@string/label_time_coracao"
            android:textSize="12sp"
            tools:textColor="@color/black"
            android:textColor="@color/branco"
            android:padding="5dp"
            android:includeFontPadding="false"/>

        <TextView
            android:id="@+id/informacaoAdicionalTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/caixa_std_bold"
            android:textSize="12sp"
            tools:textColor="@color/black"
            android:textColor="@color/branco"
            tools:text="@string/label_time_coracao"
            android:padding="5dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
</RelativeLayout>

    </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_vertical_margin">

            <br.gov.caixa.loterias.apostas.view.fragment.TipoApostaLinhaView
                android:id="@+id/tipo_aposta_linha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/activity_vertical_margin">

            <TextView
                android:id="@+id/modalidadeTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/caixa_std_bold"
                android:text="@string/label_teimosinha"
                android:textSize="14sp"
                android:textColor="@color/branco"
                tools:textColor="@color/black"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_sua_aposta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/caixa_std_regular"
                android:gravity="center"
                android:text="@string/seus_numeros"
                tools:textColor="@color/black"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_alignParentLeft="true"
            />

            <RelativeLayout
                android:id="@+id/rl_fg_numeros_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_sua_aposta"
                android:visibility="visible"
                />

            <RelativeLayout
                android:id="@+id/rl_fg_numeros_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/rl_fg_numeros_1"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/rl_div_top_numeros_sorteados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rl_fg_numeros_2"
                android:visibility="gone">

                <View
                    android:id="@+id/v_div_top_numeros_sorteados"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/branco"/>
            </RelativeLayout>


            <TextView
                android:id="@+id/tv_resultado_super_sete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/tv_sua_aposta"
                android:layout_below="@id/rl_div_top_numeros_sorteados"
                android:fontFamily="@font/caixa_std_regular"
                android:gravity="center"
                android:text="@string/numeros_sorteados"
                tools:textColor="@color/black"
                android:textColor="@color/branco"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_colunas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_sua_aposta"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_toStartOf="@id/tv_sua_aposta"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/colunas"
                android:textSize="12sp"
                tools:textColor="@color/black"
                android:textColor="@color/branco"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_colunas_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/activity_horizontal_margin"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_toStartOf="@+id/rl_container_result_1"
                android:layout_alignTop="@+id/rl_container_result_1"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/colunas"
                android:textSize="12sp"
                tools:textColor="@color/black"
                android:textColor="@color/branco"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/rl_container_result_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_resultado_super_sete"
                android:layout_marginTop="15dp"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/rl_container_result_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rl_container_result_1"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/rl_div_bot_numeros_sorteados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rl_container_result_2"
                android:visibility="gone">

                <View
                    android:id="@+id/v_div_bot_numeros_sorteados"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/branco"/>
            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/rl_time_mes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_container_result_1"
                android:layout_marginTop="39dp"
                android:paddingBottom="16dp"
                android:padding="5dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ll_time_mes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal"
                    android:gravity="center">


                    <TextView
                        android:id="@+id/tv_tit_time_mes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:background="@color/branco"
                        android:textColor="@color/timemania_letra_mkp"
                        android:text="@string/label_time_coracao"
                        android:textSize="12sp"
                        android:padding="5dp"
                        android:includeFontPadding="false" />


                    <TextView
                        android:id="@+id/tv_time_mes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_bold"
                        android:background="@color/branco"
                        android:textColor="@color/timemania_letra_mkp"
                        android:textSize="12sp"
                        tools:text="@string/label_time_coracao"
                        android:padding="5dp"
                        android:includeFontPadding="false" />


                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>