<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dados_pessoais_sucesso"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="br.gov.caixa.loterias.apostas.controllers.DadosPessoaisConfirmacaoActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/containerIconeSucesso"
            android:layout_width="64dp"
            android:background="@drawable/bg_circle_sucesso"
            android:layout_height="64dp">

            <ImageView
                android:contentDescription="@string/title_cadastroRealizado"
                android:id="@+id/iconeIlustraCadastroImageView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_check_sucesso"
                android:layout_gravity="center"
                />
        </FrameLayout>

        <TextView
            style="@style/CaixaStdBold"
            android:id="@+id/tituloConfirmacaoCadastroTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:paddingEnd="32dp"
            android:paddingStart="32dp"
            android:text="@string/title_cadastroRealizadoExcelente"
            android:layout_gravity="center_horizontal"
            android:textAlignment="center"
            android:layout_marginTop="17dp"
            android:textColor="@color/branco"
            android:textSize="19sp"
            />

        <View
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/verdeazul"
            android:layout_gravity="center_horizontal" />

        <TextView
            style="@style/CaixaStdRegular"
            android:id="@+id/subtituloConfirmaCadastroTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="3"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:text="@string/aguarde_redirecionamento"
            android:layout_gravity="center_horizontal"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            android:textColor="@color/branco"
            android:textSize="16sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
