<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:background="@color/branco">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_valor_aposta" android:layout_width="0dp" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/container_valor_carrinho"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/textInfoValorAposta" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="@string/mkp_valor_aposta" android:textSize="12sp" android:textColor="@color/mkp_rodape_texto"
            android:fontFamily="@font/caixa_std_regular" android:gravity="center" android:paddingHorizontal="4dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/valorApostaCartela" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="R$ 0,00" android:textSize="13sp" android:textColor="@color/mkp_rodape_texto"
            android:fontFamily="@font/caixa_std_bold" android:gravity="center" android:paddingHorizontal="4dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textInfoValorAposta" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View android:layout_width="1dp" android:layout_height="0dp" android:background="@color/mkp_rodape_divisor"
        android:layout_marginVertical="6dp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/container_valor_aposta" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_valor_carrinho" android:layout_width="0dp" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@id/container_valor_aposta"
        app:layout_constraintEnd_toStartOf="@id/simularApostaLayoutCarrinhoApostas"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:id="@+id/tv_valor_atual_carrinho" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="@string/mkp_total_carrinho" android:textSize="12sp" android:textColor="@color/mkp_rodape_texto"
            android:fontFamily="@font/caixa_std_regular" android:gravity="center" android:paddingHorizontal="4dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/valorAtualCarrinho" android:layout_width="0dp" android:layout_height="wrap_content"
            android:text="R$ 0,00" android:textSize="13sp" android:textColor="@color/mkp_rodape_texto"
            android:fontFamily="@font/caixa_std_bold" android:gravity="center" android:paddingHorizontal="4dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_valor_atual_carrinho" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View android:layout_width="1dp" android:layout_height="0dp" android:background="@color/mkp_rodape_divisor"
        android:layout_marginVertical="6dp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="@id/container_valor_carrinho" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/simularApostaLayoutCarrinhoApostas"
        android:layout_width="60dp" android:layout_height="56dp"
        android:clickable="true" android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/carrinho_apostas"
        app:layout_constraintStart_toEndOf="@id/container_valor_carrinho"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <ImageView android:id="@+id/botaoCarrinho" android:layout_width="34dp" android:layout_height="34dp"
            android:src="@drawable/icon_carrinho" app:tint="@color/mkp_rodape_texto"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
        <ImageView android:id="@+id/circuloQuantidade" android:layout_width="18dp" android:layout_height="18dp"
            android:background="@drawable/ic_shape_oval" android:backgroundTint="@color/laranjacaixa"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="@id/botaoCarrinho" app:layout_constraintTop_toTopOf="@id/botaoCarrinho" />
        <TextView android:id="@+id/tvQuantidadeApostas" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textSize="9sp" android:textColor="@color/mkp_rodape_texto"
            android:fontFamily="@font/caixa_std_bold" android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="@id/circuloQuantidade" app:layout_constraintEnd_toEndOf="@id/circuloQuantidade"
            app:layout_constraintTop_toTopOf="@id/circuloQuantidade" app:layout_constraintBottom_toBottomOf="@id/circuloQuantidade" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
