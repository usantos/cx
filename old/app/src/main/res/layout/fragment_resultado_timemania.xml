<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_numeros_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iv_time_coracao"
        android:layout_width="41dp"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_timecoracao"
        app:layout_constraintStart_toStartOf="@+id/rv_numeros_resultado"
        app:layout_constraintLeft_toLeftOf="@id/rv_numeros_resultado"
        app:layout_constraintTop_toBottomOf="@+id/rv_numeros_resultado" />

    <TextView
        android:id="@+id/tv_titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/caixa_std_regular"
        android:text="@string/label_time_coracao"
        android:textColor="@color/timemania_letra_mkp"
        android:textSize="14.2sp"
        app:layout_constraintStart_toEndOf="@+id/iv_time_coracao"
        app:layout_constraintTop_toTopOf="@+id/iv_time_coracao" />

    <TextView
        android:id="@+id/tv_descricao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/caixa_std_bold"
        android:textColor="@color/timemania_letra_mkp"
        android:textSize="14.2sp"
        app:layout_constraintStart_toEndOf="@+id/iv_time_coracao"
        app:layout_constraintTop_toBottomOf="@+id/tv_titulo"
        tools:text="Flamengo" />

</androidx.constraintlayout.widget.ConstraintLayout>