<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_item_bolao"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_completo"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="@color/transparente"
        android:orientation="vertical">

        <!-- CONTAINER DO CABEÇALHO -->
        <FrameLayout
            android:id="@+id/header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Cabeçalho padrão -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cabecalho_bolao"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:background="@drawable/rounded_card_cabecalho_bolao"
                android:visibility="visible">
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Cabeçalho filtrado -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cabecalho_bolao_filtrado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/mega_verde_claro_mkp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/header_especiais_bolao"
                    android:layout_width="match_parent"
                    android:layout_height="71dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:visibility="gone"/>

                <RelativeLayout
                    android:id="@+id/layout_trevo"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_trapeze_megasena_mkp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"/>

                <ImageView
                    android:id="@+id/trevoImagem"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/trevo"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/layout_trevo"
                    app:layout_constraintEnd_toEndOf="@id/layout_trevo"/>

                <TextView
                    android:id="@+id/textViewCardBolaoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/branco"
                    android:textSize="18.0sp"
                    android:layout_marginRight="10dp"
                    android:autoSizeMaxTextSize="18sp"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/futura_std_bold"
                    android:text="@string/mega_sena"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/layout_trevo"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/layoutFavoritarCabecalho"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:elevation="1dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="-20dp"
            android:background="@drawable/shape_circulo"
            app:layout_constraintTop_toBottomOf="@+id/header_container"
            app:layout_constraintEnd_toEndOf="@+id/header_container">

            <br.gov.caixa.loterias.apostas.view.custom.BotaoFavoritar
                android:id="@+id/btn_favoritar_mkp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="1dp"
                />

        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conteudo_bolao"
            android:layout_width="match_parent"
            android:layout_height="393dp"
            android:layout_marginBottom="50dp"
            android:background="@color/branco"
            android:paddingBottom="32dp"
            app:layout_constraintBottom_toBottomOf="@id/btn_add_carrinho"
            app:layout_constraintTop_toBottomOf="@id/header_container"
            app:layout_constraintVertical_bias="0.0"
            tools:layout_editor_absoluteX="28dp">

            <FrameLayout
                android:id="@+id/lotarica_premio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/layoutLoterica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginStart="37dp"
                    android:layout_marginEnd="38dp"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/loterica_nome"
                        android:layout_width="match_parent"
                        android:layout_height="57dp"
                        android:gravity="bottom|center_horizontal"
                        android:textSize="18sp"
                        android:textColor="@color/cinza130"
                        android:fontFamily="@font/caixa_std_semi_bold"
                        android:text="Lotérica Fé do mês"
                        />

                    <TextView
                        android:id="@+id/loterica_uf"
                        android:layout_width="match_parent"
                        android:layout_height="57dp"
                        android:gravity="top|center_horizontal"
                        android:textSize="18sp"
                        android:paddingTop="8dp"
                        android:textColor="@color/cinza110"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="Brasília - DF"
                        />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPremio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/valor_estimado_premio_card_bolao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/caixa_std_bold"
                        android:text="R$ 0.000"
                        android:textColor="@color/mega_verde_claro_mkp"
                        android:textSize="22sp"/>

                    <TextView
                        android:id="@+id/valor_estimado_premio_card_bolao_por_extenso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_bold"
                        android:text="(R$ 0 Mil)"
                        android:textColor="@color/mega_verde_claro_mkp"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/descricao_numero_concurso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/caixa_std_regular"
                        android:text="Prêmio estimado do concurso 2345"
                        android:textSize="14sp"
                        android:textAlignment="center"/>
                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/descricao_qtd_dezenas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/caixa_std_regular"
                android:text="05 apostas de 20 dezenas"
                android:textAlignment="center"
                android:textColor="@color/cinza90"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lotarica_premio" />

            <Button
                android:id="@+id/detalhes"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_rounded_green_outlined"
                android:fontFamily="@font/caixa_std_regular"
                android:text="Detalhes"
                android:textAllCaps="false"
                android:textColor="@color/mega_verde_claro_mkp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/descricao_qtd_dezenas" />

            <TextView
                android:id="@+id/descricao_qtd_cotas_disponiveis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/caixa_std_regular"
                android:text="25 cotas disponíveis de 100"
                android:textAlignment="center"
                android:textColor="@color/cinza90"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/detalhes" />

            <TextView
                android:id="@+id/valor_cota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/caixa_std_bold"
                android:text="R$ 300,00"
                android:textSize="18sp"
                android:textColor="@color/cinza130"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/descricao_qtd_cotas_disponiveis" />

            <TextView
                android:id="@+id/label_quantidade_cotas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/caixa_std_regular"
                android:text="Quantidade de Cotas"
                android:textSize="16sp"
                android:textColor="@color/cinza90"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/valor_cota" />

            <TextView
                android:id="@+id/quantidade_cotas"
                android:layout_width="50dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/caixa_std_regular"
                android:textSize="18sp"
                android:textColor="@color/cinza110"
                android:gravity="center"
                android:text="@string/_1"
                android:textAlignment="center"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_quantidade_cotas" />

            <View
                android:id="@+id/linha_numero"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:background="@color/mega_verde_escuro_mkp"
                app:layout_constraintBottom_toBottomOf="@id/quantidade_cotas"
                app:layout_constraintEnd_toEndOf="@id/quantidade_cotas"
                app:layout_constraintStart_toStartOf="@id/quantidade_cotas" />

            <Button
                android:id="@+id/diminui_cota"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="0dp"
                android:layout_marginRight="0dp"
                android:background="@drawable/ic_botao_surpresinha"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/menos"
                android:textColor="@color/branco"
                android:textSize="24sp"
                app:layout_constraintRight_toLeftOf="@+id/quantidade_cotas"
                app:layout_constraintTop_toBottomOf="@+id/label_quantidade_cotas" />

            <Button
                android:id="@+id/aumenta_cota"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="0dp"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/ic_botao_surpresinha"
                android:fontFamily="@font/caixa_std_regular"
                android:text="@string/mais"
                android:textColor="@color/branco"
                android:textSize="16sp"
                app:layout_constraintLeft_toRightOf="@+id/quantidade_cotas"
                app:layout_constraintTop_toBottomOf="@+id/label_quantidade_cotas" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <Button
            android:id="@+id/btn_add_carrinho"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="16sp"
            android:text="@string/adicionarAoCarrinho"
            android:background="@drawable/rounded_card"
            android:layout_marginTop="-35dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            app:layout_constraintTop_toBottomOf="@+id/conteudo_bolao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>