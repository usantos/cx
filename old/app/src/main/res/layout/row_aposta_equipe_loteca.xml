<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_row_aposta_partida_loteca"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    android:orientation="horizontal"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_marginTop="2dp"
        android:id="@+id/image_aposta_partida_loteca"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="19dp"
        android:background="@drawable/select_unselect_circle_loteca" />

    <TextView
        android:id="@+id/text_aposta_partida_loteca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14.2sp"
        android:textColor="@color/cinza"
        android:fontFamily="@font/caixa_std_regular"/>

</LinearLayout>