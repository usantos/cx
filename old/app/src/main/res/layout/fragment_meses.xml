<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCartelaFragmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mesesFragmentScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/mesesTituloLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                android:id="@+id/mesesGridView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="8dp"
                android:columnWidth="50dp"
                android:gravity="center"
                android:horizontalSpacing="14dp"
                android:nestedScrollingEnabled="false"
                android:numColumns="2"
                android:layout_marginBottom="8dp"
                android:verticalSpacing="16dp" />
        </RelativeLayout>

    </ScrollView>
</RelativeLayout>