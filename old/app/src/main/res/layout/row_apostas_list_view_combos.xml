<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:background="@color/branco">

    <TextView
        android:id="@+id/descricaoCombo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="18dp"
        android:textSize="14.2sp"
        android:importantForAccessibility="yes"
        android:focusable="true"
        tools:text="Fezinha do Mes"
        android:textColor="@color/black"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/imageViewDetalheCombos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="yes"
        android:focusable="true"
        android:contentDescription="@string/detalhes_combo"
        android:background="@drawable/ic_trevo_carrinho_bolao"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
    />

    <TextView
        android:id="@+id/valorAposta"
        android:layout_width="118dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginEnd="15dp"
        android:text="@string/r_0_00"
        android:textAlignment="textEnd"
        android:importantForAccessibility="yes"
        android:focusable="true"
        android:textSize="14.2sp"
        android:textColor="@color/black"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/excluirApostaCarrinho"
    />

    <ImageButton
        android:id="@+id/excluirApostaCarrinho"
        android:layout_width="18dp"
        android:layout_height="22dp"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="20dp"
        android:background="@color/transparente"
        android:importantForAccessibility="yes"
        android:focusable="true"
        app:tint="@color/colorAccent"
        android:src="@drawable/ic_lixeira_mkp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvQtdApostasCombo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-10dp"
        android:text="apostas"
        android:importantForAccessibility="yes"
        android:focusable="true"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:visibility="visible"
        android:fontFamily="@font/caixa_std_regular"
        app:layout_constraintStart_toStartOf="@+id/imageViewDetalheCombos"
        app:layout_constraintTop_toBottomOf="@+id/imageViewDetalheCombos"
    />

    <br.gov.caixa.loterias.apostas.view.fragment.TipoApostaLinhaView
        android:id="@+id/tipo_aposta_linha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvQtdApostasCombo"
        android:visibility="visible"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:paddingStart="0dp"
        android:importantForAccessibility="no"
        android:background="@color/cinzaclaro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tipo_aposta_linha"/>

</androidx.constraintlayout.widget.ConstraintLayout>
