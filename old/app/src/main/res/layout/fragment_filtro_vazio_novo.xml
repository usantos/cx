<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/background_gradient_cinza"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_card"
        android:backgroundTint="@color/branco"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <TextView
            android:id="@+id/id_ops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ops"
            android:textColor="@color/colorAccent"
            android:fontFamily="@font/caixa_std_bold"
            android:textSize="24sp"
            android:layout_marginTop="44dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/text_estado_vazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/estado_vazio_mkp_descricao"
            android:textColor="@color/colorAccent"
            android:fontFamily="@font/caixa_std_regular"
            android:textAlignment="center"
            android:textSize="16sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="43dp"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@+id/id_ops"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>