<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/linearSituacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:weightSum="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linear_linha1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/situacaoCompraTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:fontFamily="@font/caixa_std_regular"
                tools:text="@string/label_compra_lista_situacao_descricao"
                android:maxWidth="150dp"
                android:textColor="@color/cinza"
                android:textSize="14.2sp" />

            <ImageButton
                android:id="@+id/ib_favoritar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"
                android:backgroundTint="@color/transparente"
                android:src="@drawable/ic_estrela"
                android:tint="@color/azulescuro"
                android:visibility="gone"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.1"
                android:gravity="end"
                android:text="@string/label_compra_lista_valor"
                android:fontFamily="@font/caixa_std_regular"
                android:textColor="@color/cinza"
                android:textSize="14.4dp"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_linha2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dataCompraTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:gravity="start"
                tools:text=""
                android:fontFamily="@font/caixa_std_regular"/>

            <TextView
                android:id="@+id/valorCompra"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.2"
                android:fontFamily="@font/caixa_std_regular"
                android:gravity="end"
                android:text="@string/r_4_50"
                android:textColor="@color/cinza"
                android:textSize="14.2sp"
                />

        </LinearLayout>

        <TextView
                android:id="@+id/horaCompraTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:gravity="start"
                tools:text="00:00:00"
                android:fontFamily="@font/caixa_std_regular"/>

        <LinearLayout
            android:id="@+id/linear_linha3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/meioDePagamento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.7"
                tools:text="@string/label_compra_lista_meio_de_pagamento"
                android:fontFamily="@font/caixa_std_regular"/>

            <ImageView
                android:id="@+id/imageViewRelogio"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.1"
                app:srcCompat="@drawable/relogio_amarelo" />

            <TextView
                android:id="@+id/contadorDown"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:fontFamily="@font/caixa_std_bold"
                android:gravity="end"
                android:text="00:00"
                android:textColor="@color/amarelo_minhas_compras"
                android:textSize="14.2dp" />

        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnMinhasCompras"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="@string/label_compra_lista_alterar_compra"
        android:textColor="@color/branco"
        android:textAllCaps="false"
        android:fontFamily="@font/caixa_std_bold"
        android:background="@color/verde_botao_minhas_compras"
        android:gravity="center_horizontal|center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/linearSituacao"
         />

    <FrameLayout
        android:id="@+id/setaComprasGroup"
        android:layout_width="11dp"
        android:layout_height="20dp"
        android:layout_gravity="end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/seta_direita_cinza"
        android:padding="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/linearSituacao">
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

