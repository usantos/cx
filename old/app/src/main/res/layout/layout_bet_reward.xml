<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:importantForAccessibility="yes"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginHorizontal="24dp"
    android:layout_marginTop="16dp"
    android:background="@drawable/shape_border_rounded_divider"
    android:layout_height="wrap_content">
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clIcon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/background_rounded_azul"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/ivIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/ic_caixa_mm_amarelo_branco"
                android:layout_width="20dp"
                android:layout_height="20dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            style="@style/CaixaStdRegular"
            android:textColor="@color/greyText"
            android:importantForAccessibility="no"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintVertical_chainStyle="packed"
            android:id="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Title"
            app:layout_constraintLeft_toRightOf="@id/clIcon"
            app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
            android:layout_marginStart="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            style="@style/CaixaStdRegular"
            android:textColor="@color/greyText"
            android:importantForAccessibility="no"
            android:textSize="14sp"
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="Subtitle" />

        <ImageView
            android:src="@drawable/seta_direita_preta"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>