<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bolao_gray_stroke"
    tools:context="br.gov.caixa.loterias.apostas.controllers.AutoavaliacaoFormActivity">

    <include layout="@layout/app_bar_degrade" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="?attr/actionBarSize" />


    <androidx.cardview.widget.CardView
        android:id="@+id/cardAuto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@+id/gl_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btnAutoAnterior"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <Button
                        android:id="@+id/btnAutoFecharTop"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/fechar"
                        android:textColor="@color/verdeazul"
                        android:textAllCaps="false"
                        android:textAlignment="center"
                        android:textSize="17sp"
                        android:fontFamily="@font/caixa_std_regular"
                        android:background="@color/branco"
                        android:drawableRight="@drawable/close"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                    />

                    <ImageView
                        android:id="@+id/imagemAutoavaliacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_autoavaliacao"
                        android:layout_marginTop="35dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        />

                    <TextView
                        android:id="@+id/tvAuto1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="35dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/tv_autoavaliacao_1"
                        android:textSize="16sp"
                        android:textColor="@color/blue_caixa"
                        android:fontFamily="@font/caixa_std_regular"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/imagemAutoavaliacao"
                        />

                    <TextView
                        android:id="@+id/tvAuto2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/tv_autoavaliacao_2"
                        android:textSize="16sp"
                        android:textColor="@color/blue_caixa"
                        android:textStyle="normal"
                        android:fontFamily="@font/caixa_std_regular"
                        app:layout_constraintTop_toBottomOf="@+id/tvAuto1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        />

                    <TextView
                        android:id="@+id/tvAuto3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/tv_autoavaliacao_3"
                        android:textSize="12sp"
                        android:textColor="@color/blue_caixa"
                        android:fontFamily="@font/caixa_std_regular"
                        app:layout_constraintTop_toBottomOf="@+id/tvAuto2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        />

                    <TextView
                        android:id="@+id/tvAutoPergunta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="Ao longo da sua vida, ja houve períodos de 2 semanas em que você gastou muito tempo pensando sobre as suas experiências com jogo, planejando futuros investimentos ou apostas "
                        android:textSize="16sp"
                        android:textColor="@color/blue_caixa"
                        android:fontFamily="@font/caixa_std_regular"
                        app:layout_constraintTop_toBottomOf="@+id/tvAuto3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        />

                    <RadioGroup
                        android:id="@+id/rgAutoavaliacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="40dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvAutoPergunta"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">

                        <RadioButton
                            android:id="@+id/rbYes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_sim"
                            android:textColor="@color/blue_caixa"
                            android:fontFamily="@font/caixa_std_bold"
                            />

                        <RadioButton
                            android:id="@+id/rbNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_nao"
                            android:textColor="@color/blue_caixa"
                            android:fontFamily="@font/caixa_std_bold"
                            />

                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="80dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvAutoPergunta"
                    />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>


            <Button
                android:id="@+id/btnAutoAnterior"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/anterior"
                android:textColor="@color/bolao_slider_trilha_ativa"
                android:textAllCaps="false"
                android:textAlignment="center"
                android:fontFamily="@font/caixa_std_bold"
                android:background="@drawable/background_border_verde"
                android:drawableLeft="@drawable/ic_chevron_left"
                android:drawableTint="@color/bolao_slider_trilha_ativa"
                android:visibility="visible"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <Button
                android:id="@+id/btnAutoProximo"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/proximo"
                android:textColor="@color/branco"
                android:textAllCaps="false"
                android:textAlignment="center"
                android:fontFamily="@font/caixa_std_bold"
                android:background="@drawable/button_rounded_verdeazul"
                android:drawableRight="@drawable/ic_chevron_right"
                android:drawableTint="@color/branco"
                android:visibility="visible"
                android:paddingLeft="25dp"
                android:paddingRight="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/btnAutoFechar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/fechar"
                android:textColor="@color/bolao_slider_trilha_ativa"
                android:textAllCaps="false"
                android:textAlignment="center"
                android:fontFamily="@font/caixa_std_bold"
                android:background="@drawable/background_border_verde"
                android:drawableRight="@drawable/close"
                android:drawableTint="@color/bolao_slider_trilha_ativa"
                android:visibility="gone"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"                />

            <Button
                android:id="@+id/btnAutoAjuda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/autoavaliacao_ajuda"
                android:textColor="@color/branco"
                android:textAllCaps="false"
                android:textAlignment="center"
                android:fontFamily="@font/caixa_std_bold"
                android:background="@drawable/button_rounded_verdeazul"
                android:drawableRight="@drawable/ic_interroga"
                android:drawableTint="@color/branco"
                android:visibility="gone"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>