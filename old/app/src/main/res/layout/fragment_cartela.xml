<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCartelaFragmentScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/rl_colunas_super_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cinza"
            android:visibility="gone">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_super_sete_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco">

                <TextView
                    android:id="@+id/tv_colunas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/super_sete_claro_mkp"
                    android:fontFamily="@font/caixa_std_bold"
                    android:padding="10dp"
                    android:text="@string/colunas"
                    android:textAlignment="center"
                    android:textColor="@color/super_sete_letra_mkp"
                    android:textSize="16sp"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/ll_numeros_colunas_super_sete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@color/branco"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/tv_colunas">

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_text_view_colunas"
                        android:fontFamily="@font/caixa_std_bold"
                        android:gravity="center"
                        android:text="@string/_1"
                        android:textColor="@color/branco" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_text_view_colunas"
                        android:fontFamily="@font/caixa_std_bold"
                        android:gravity="center"
                        android:text="@string/_2"
                        android:textColor="@color/branco" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_text_view_colunas"
                        android:fontFamily="@font/caixa_std_bold"
                        android:gravity="center"
                        android:text="@string/_3"
                        android:textColor="@color/branco" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_text_view_colunas"
                        android:fontFamily="@font/caixa_std_bold"
                        android:gravity="center"
                        android:text="@string/_4"
                        android:textColor="@color/branco" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_text_view_colunas"
                        android:fontFamily="@font/caixa_std_bold"
                        android:gravity="center"
                        android:text="@string/_5"
                        android:textColor="@color/branco" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_text_view_colunas"
                        android:fontFamily="@font/caixa_std_bold"
                        android:gravity="center"
                        android:text="@string/_6"
                        android:textColor="@color/branco" />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_text_view_colunas"
                        android:fontFamily="@font/caixa_std_bold"
                        android:gravity="center"
                        android:text="@string/_7"
                        android:textColor="@color/branco" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </RelativeLayout>

    <RelativeLayout
        android:id="@+id/opcaoOutrosNumerosLayout"
        android:layout_width="match_parent"
        android:minHeight="74dp"
        android:layout_height="wrap_content"
        android:background="@color/cinza"
        android:paddingBottom="15dp"
        android:clickable="true"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/selcioneOutrosNumeros"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/check_box_selected"
            android:button="@color/verdeagua"
            android:clickable="false" />

        <TextView
            android:id="@+id/infoSelecioneOutrosNumeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="16dp"
            android:layout_toRightOf="@+id/selcioneOutrosNumeros"
            android:textColor="@color/branco"
            android:textSize="14sp"
            android:fontFamily="@font/caixa_std_regular"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cartelaFragmentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_colunas_super_7"
        android:fillViewport="true"
        android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cartelaFragmentMainLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/branco">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cltGeral"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/layotLabelEscolhaNumeros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listaDezenas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="true"
                        android:layout_marginHorizontal="10dp"
                        android:columnWidth="50dp"
                        android:gravity="center"
                        android:horizontalSpacing="16dp"
                        android:numColumns="auto_fit"
                        android:paddingLeft="10dp"
                        android:paddingTop="40dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="45dp"
                        android:stretchMode="columnWidth"
                        android:verticalSpacing="10dp"
                        app:layout_constraintTop_toBottomOf="@+id/layotLabelEscolhaNumeros" />

                    <View
                        android:id="@+id/rodape_espacamento"
                        android:layout_width="match_parent"
                        android:layout_height="205dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/listaDezenas"/>

                    <ScrollView
                        android:id="@+id/sv_super_sete"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/layotLabelEscolhaNumeros">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="600dp"
                            android:layout_gravity="center"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:paddingBottom="250dp"
                            android:orientation="horizontal">

                            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                                android:id="@+id/ehgv_super_sete_primeiro"
                                android:layout_width="wrap_content"
                                android:layout_height="500dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:background="@color/supersete_claro_transparente"
                                android:columnWidth="50dp"
                                android:gravity="center"
                                android:isScrollContainer="false"
                                android:numColumns="1"
                                android:scrollbars="none"
                                android:stretchMode="columnWidth"
                                android:verticalSpacing="10dp" />

                            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                                android:id="@+id/ehgv_super_sete_segundo"
                                android:layout_width="wrap_content"
                                android:layout_height="500dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:background="@color/supersete_claro_transparente"
                                android:columnWidth="50dp"
                                android:gravity="center"
                                android:isScrollContainer="false"
                                android:numColumns="1"
                                android:scrollbars="none"
                                android:stretchMode="columnWidth"
                                android:verticalSpacing="10dp" />

                            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                                android:id="@+id/ehgv_super_sete_terceiro"
                                android:layout_width="wrap_content"
                                android:layout_height="500dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:background="@color/supersete_claro_transparente"
                                android:columnWidth="50dp"
                                android:gravity="center"
                                android:isScrollContainer="false"
                                android:numColumns="1"
                                android:scrollbars="none"
                                android:stretchMode="columnWidth"
                                android:verticalSpacing="10dp" />

                            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                                android:id="@+id/ehgv_super_sete_quarto"
                                android:layout_width="wrap_content"
                                android:layout_height="500dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:background="@color/supersete_claro_transparente"
                                android:columnWidth="50dp"
                                android:gravity="center"
                                android:isScrollContainer="false"
                                android:numColumns="1"
                                android:scrollbars="none"
                                android:stretchMode="columnWidth"
                                android:verticalSpacing="10dp" />

                            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                                android:id="@+id/ehgv_super_sete_quinto"
                                android:layout_width="wrap_content"
                                android:layout_height="500dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:background="@color/supersete_claro_transparente"
                                android:columnWidth="50dp"
                                android:gravity="center"
                                android:isScrollContainer="false"
                                android:numColumns="1"
                                android:scrollbars="none"
                                android:stretchMode="columnWidth"
                                android:verticalSpacing="10dp" />

                            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                                android:id="@+id/ehgv_super_sete_sexto"
                                android:layout_width="wrap_content"
                                android:layout_height="500dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:background="@color/supersete_claro_transparente"
                                android:columnWidth="50dp"
                                android:gravity="center"
                                android:isScrollContainer="false"
                                android:numColumns="1"
                                android:scrollbars="none"
                                android:stretchMode="columnWidth"
                                android:verticalSpacing="10dp" />

                            <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightGridView
                                android:id="@+id/ehgv_super_sete_setimo"
                                android:layout_width="wrap_content"
                                android:layout_height="500dp"
                                android:layout_weight="1"
                                android:layout_margin="3dp"
                                android:background="@color/supersete_claro_transparente"
                                android:columnWidth="50dp"
                                android:gravity="center"
                                android:isScrollContainer="false"
                                android:numColumns="1"
                                android:scrollbars="none"
                                android:stretchMode="columnWidth"
                                android:verticalSpacing="10dp" />
                        </LinearLayout>
                    </ScrollView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/selecioneTimeCoracao"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="81dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="45dp"
                        android:layout_marginRight="45dp"
                        android:text="@string/label_nome_do_seu_time"
                        android:textColor="@color/azulFormNovoTipoPagamento"
                        android:textSize="16sp"
                        android:fontFamily="@font/caixa_std_regular"/>

                    <EditText
                        android:id="@+id/informe_nome_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="45dp"
                        android:layout_marginRight="45dp"
                        android:maxLines="1"
                        android:textColor="@color/pretoLinhaFormNovoTipoPagamento"
                        android:textSize="16sp"
                        android:fontFamily="@font/caixa_std_regular"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/gridTimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:gravity="center"
                        android:nestedScrollingEnabled="false"
                        android:numColumns="3"
                        android:paddingBottom="119dp"
                        android:stretchMode="columnWidth"
                        android:verticalSpacing="16dp"
                        app:layout_goneMarginBottom="10dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRecyclerViewPartida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:importantForAccessibility="no"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@+id/selecioneTimeCoracao">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:paddingHorizontal="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/layoutTitleLoteca"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start"
                            android:importantForAccessibility="no"
                            android:orientation="horizontal"
                            android:paddingVertical="12dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/titleInformeBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_resultado_das_partidas"
                                android:textColor="@color/blue_caixa"
                                android:importantForAccessibility="yes"
                                android:textSize="16sp"
                                android:fontFamily="@font/caixa_std_bold"/>

                        </LinearLayout>

                        <br.gov.caixa.loterias.apostas.view.custom.ExpandableHeightRecyclerView
                            android:id="@+id/recyclerViewPartida"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:importantForAccessibility="no"
                            android:nestedScrollingEnabled="false"
                            android:orientation="vertical"
                            android:paddingBottom="119dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</RelativeLayout>