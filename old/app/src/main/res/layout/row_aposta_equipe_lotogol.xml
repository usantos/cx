<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_row_aposta_equipe_lotogol"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/imagem_escudo_aposta_partida_lotogol"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="9dp"
        android:background="@drawable/time" />

    <ImageView
        android:id="@+id/imagem_placar_aposta_partida_lotogol"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/lotogol_selecionado_0" />

    <TextView
        style="@style/ArialMT"
        android:id="@+id/texto_aposta_partida_lotogol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="14sp"
        android:textColor="@color/cinza"/>

</LinearLayout>