<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >

    <!-- Colored rectangle-->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="85dp"
                android:height="71dp" />
            <solid android:color="@color/outubro_rosa_secundario" />
        </shape>
    </item>

    <!-- This rectangle for the right side -->
    <!-- Their color should be the same as layout's background -->
    <item
        android:right="-200dp"
        android:left="90dp"
        android:top="-113dp"
        android:bottom="-50dp">
        <rotate
            android:fromDegrees="20">
            <shape android:shape="rectangle">
                <solid android:color="@color/outubro_rosa_primario" />
            </shape>
        </rotate>
    </item>

</layer-list>