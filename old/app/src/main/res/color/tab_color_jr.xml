<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"
        android:state_checked="true"
        android:color="@color/jr_radio_text_selected" /> <!-- pressed -->

    <item android:state_pressed="true"
        android:state_checked="false"
        android:color="@color/jr_radio_text_unselected" /> <!-- pressed -->

    <item android:state_checked="true"
        android:color="@color/jr_radio_text_selected" /> <!-- checked -->

    <item android:color="@color/jr_radio_text_unselected" /> <!-- default -->

</selector>